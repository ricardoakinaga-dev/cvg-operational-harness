# PLAN0374 Fase C (C6) — monthly restore rehearsal into a disposable
# PostgreSQL on an internal Docker network (never the production database).
[Unit]
Description=CVG harness monthly restore drill
Wants=docker.service
After=docker.service

[Service]
Type=oneshot
User=cvg-backup
Group=cvg-backup
EnvironmentFile=/etc/cvg-harness/backup.env
ExecStart=/opt/cvg-harness/deploy/harness/backup/restore-drill.sh
TimeoutStartSec=6h
Nice=10
# OnFailure=cvg-harness-notify@%n.service

[Install]
WantedBy=multi-user.target
