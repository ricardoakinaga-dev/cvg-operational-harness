# Assistente de Plantão — copy to .env and fill in. Never commit .env.
# Runbook: docs/runbooks/assistente-plantao-fase1.md

# waha or evolution (decision D1)
SHIFT_PROVIDER=waha
# Team members: phone=Name;phone=Name*  (the trailing * marks the manager)
SHIFT_MEMBERS=5511900000001=Plantonista Exemplo;5511900000009=Gestor Exemplo*
# 24+ random characters, also configured as the x-cvg-webhook-secret header
SHIFT_WEBHOOK_SECRET=
SHIFT_TICK_SECONDS=60

# WAHA (when SHIFT_PROVIDER=waha)
# Names on the cvg-shift-backend network (see compose.yaml)
WAHA_URL=http://waha:3000
WAHA_API_KEY=
WAHA_SESSION=default

# Evolution API (when SHIFT_PROVIDER=evolution)
EVOLUTION_URL=http://evolution:8080
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=cvg

# Local Whisper with the OpenAI-compatible transcription API (decision D2)
WHISPER_URL=http://whisper:8000
WHISPER_MODEL=large-v3

# Model for note organisation (decision D2). NO_MODEL is in force for shift
# notes: the model gateway denies clinical content before any request, so no
# note, transcript or patient memory reaches a model. The variables stay
# required by the configuration; D2 is a separate decision.
LLM_BASE_URL=https://api.example.com/v1
LLM_API_KEY=
LLM_MODEL=
LLM_LOCATION=external

# Transport deadlines in ms (SPEC 0179 8.2); defaults are the maximums.
# SHIFT_SEND_TIMEOUT_MS=10000
# SHIFT_MEDIA_TIMEOUT_MS=15000
# SHIFT_WHISPER_TIMEOUT_MS=120000
# SHIFT_MODEL_TIMEOUT_MS=60000
# SHIFT_JOB_TIMEOUT_MS=210000
# SHIFT_SHUTDOWN_TIMEOUT_MS=10000
# SHIFT_MAX_MEDIA_BYTES=10485760
# SHIFT_MAX_PENDING_MESSAGES=1000
