#!/usr/sbin/nft -f
# Assistente de Plantão — host egress policy (SPEC 0179 section 9, AUD-0621
# F25). EXAMPLE: the host operator fills in the addresses and applies it;
# nothing in this repository loads it. It complements, never replaces, the
# internal `cvg-shift-backend` network of compose.yaml and the application
# allowlist (src/egress.ts).
#
# It filters traffic FORWARDED on the assistant's bridge (br-cvgshift) for
# IPv4 and IPv6, before Docker's own rules (priority -10 < filter 0). Only
# connections the assistant (10.254.177.4, fixed in compose.yaml) opens to the
# listed WAHA/Evolution and Whisper endpoints are accepted; anything else it
# opens is dropped, including DNS, cloud metadata, other private networks and
# any IPv6. The channel may open connections to the assistant's webhook port
# only. Other bridge members keep their own policies. NO_MODEL is in force: no
# model destination is listed, and none may be added without the separate D2
# decision.
#
# Prove it on the host with counters (`nft list table inet cvg_shift_egress`)
# and scripts/infra-egress-proof.mjs: a denied destination must show drops
# here and zero requests at a synthetic receiver.

define shift_assistant = 10.254.177.4

table inet cvg_shift_egress {
  # Fill in: address and port of each allowed backend service.
  set allowed_v4 {
    type ipv4_addr . inet_service
    elements = {
      10.254.177.2 . 3000,   # WAHA (or Evolution 8080)
      10.254.177.3 . 8000    # Whisper, local
    }
  }

  chain forward {
    type filter hook forward priority -10; policy accept;

    iifname "br-cvgshift" ct state established,related counter accept
    iifname "br-cvgshift" meta nfproto ipv6 counter drop
    iifname "br-cvgshift" ip saddr $shift_assistant ip daddr . tcp dport @allowed_v4 counter accept
    iifname "br-cvgshift" ip saddr $shift_assistant counter drop
    iifname "br-cvgshift" ip daddr $shift_assistant tcp dport 3400 counter accept
    iifname "br-cvgshift" ip daddr $shift_assistant counter drop
  }
}
