# Build context of products/shift-assistant/deploy/Dockerfile (BuildKit reads
# this file instead of the root .dockerignore). Same exclusions as the root,
# plus environment files anywhere in the tree (AUD-0621 F25).
node_modules
**/node_modules
.git
.github
coverage
test-results
playwright-report
blob-report
.gauntlet
.opencode
docs
BRIEFING
certification
*.log
**/*.tsbuildinfo
**/.env
**/.env.*
!**/.env.example
