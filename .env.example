# Local-only baseline. Every value below is synthetic or a placeholder.
# Production requires secret injection and the fail-closed profile guards.

# API / HTTP profile
NODE_ENV=development
PORT=3000
CVG_API_PORT=3100
API_PERSISTENCE_MODE=memory
DATABASE_URL=postgres://user:password@localhost:5432/cvg_agent_secretary_v2
DATABASE_MIGRATION_URL=postgres://migration_user:password@localhost:5432/cvg_agent_secretary_v2
INBOUND_TENANT_ID=tenant_00000000-0000-4000-8000-000000000001
INBOUND_AGENT_ID=agent_00000000-0000-4000-8000-000000000001
WEBHOOK_SIGNING_SECRET=replace_me_webhook_secret
API_ALLOWED_ORIGINS=https://console.example.test
API_REQUIRE_HTTPS=false
API_TRUSTED_PROXY_ADDRESSES=
API_TRUSTED_PROXY_HOPS=0
POSTGRES_AUTO_MIGRATE=false
POSTGRES_SCHEMA=
POSTGRES_RLS_ENFORCEMENT=false
OUTBOX_DURABLE_INBOUND=false

# Identity, replay and rate limiting. Empty keyrings intentionally fail closed
# for trusted token use until local synthetic material is injected by a test.
CVG_IDENTITY_MODE=trusted
CVG_OPERATOR_IDENTITY_KEYRING=
CVG_RATE_LIMIT_KEYRING=

# Controlled worker profile. Blank runtime/adapter keeps the worker disabled.
CVG_WORKER_QUEUE_ADAPTER=
CVG_WORKER_RUNTIME=
CVG_WORKER_RUN_MODE=
CVG_WORKER_CONTROLLED_MODE=false
CVG_WORKER_CONTROLLED_SMOKE=false
CVG_WORKER_TENANT_ID=tenant_00000000-0000-4000-8000-000000000001
CVG_WORKER_AGENT_ID=agent_00000000-0000-4000-8000-000000000001
CVG_WORKER_ID=worker-controlled-local
CVG_WORKER_MAX_EVENTS=10
CVG_WORKER_CONCURRENCY=1
CVG_WORKER_MAX_ATTEMPTS=3
CVG_WORKER_IDLE_WAIT_MS=0
CVG_WORKER_POLL_INTERVAL_MS=25
CVG_WORKER_IDLE_MAX_BACKOFF_MS=5000
CVG_WORKER_ERROR_BACKOFF_MS=500
CVG_WORKER_ERROR_MAX_BACKOFF_MS=30000
CVG_WORKER_LEASE_MS=30000
CVG_WORKER_DRAIN_MS=10000
CVG_WORKER_SUMMARY_INTERVAL_MS=30000
CVG_WORKER_RUNTIME_PROFILE=single_pass
CVG_WORKER_ITERATIVE_SCENARIO=
CVG_WORKER_SYNTHETIC_EFFECT=false
PHASE2_FAULT_POINT=

# Production core (barra 0373; see docs/08_runtime/0802_harness_production_operations.md).
# Operator sessions: dedicated role and private auth schema, required when
# NODE_ENV=production with CVG_IDENTITY_MODE=trusted.
CVG_OPERATOR_SESSION_DATABASE_URL=
CVG_OPERATOR_AUTH_SCHEMA=
CVG_OPERATOR_SESSION_ROLE=
# The worker refuses production unless explicitly enabled with the durable
# continuous kernel (CVG_WORKER_RUN_MODE=continuous, CVG_WORKER_RUNTIME=kernel).
CVG_WORKER_PRODUCTION_ENABLED=false
# Stop alert (API process). Blank URL keeps the monitor off; production logs
# stop_alert.disabled. Secret >= 32 characters; thresholds in milliseconds.
CVG_STOP_ALERT_WEBHOOK_URL=
CVG_STOP_ALERT_WEBHOOK_SECRET=
CVG_STOP_ALERT_TENANT_ID=
CVG_STOP_ALERT_WORKER_STALE_MS=120000
CVG_STOP_ALERT_QUEUE_STALLED_MS=300000
CVG_STOP_ALERT_INTERVAL_MS=30000

# Durable synthetic homologation. Arming remains false in the local baseline.
CVG_HOMOLOG_SYNTHETIC_ONLY=false
CVG_HOMOLOG_SWEEP_INTERVAL_MS=5000
CVG_HOMOLOG_HEALTH_INTERVAL_MS=1000

# Web controlled build flags. Simulation is only valid for an explicit test
# build; the normal local browser profile remains trusted.
VITE_CVG_WEB_IDENTITY_MODE=trusted
VITE_CVG_CONTROLLED_TEST=false

# Provider and real-world action gates. Never place a real provider secret here.
OPENAI_API_KEY=replace_me
ENABLE_REAL_CHANNELS=false
ENABLE_REAL_RAG=false
ENABLE_REAL_PAYMENTS=false
ENABLE_REAL_MEDICAL_RECORDS=false

# Health and telemetry are intentionally code-defined in this version:
# /live and /health are liveness probes; /ready is dependency-gated.
# API/worker observations use bounded redacted JSONL/stdout exporters.
# No exporter URL, credential, or probe-timeout variable is currently read.

# Test/tooling-only variables are intentionally not active above. Examples:
# TEST_DATABASE_URL, AUD19_PG_REQUIRED, PHASE4A_DISPOSABLE_PG,
# PHASE4A_PG_REQUIRED, CI_ARTIFACT_DIR, CI_RUN_ID, CI_CANDIDATE_ID,
# PLAYWRIGHT_JSON_OUTPUT_NAME, MUTATION_MANIFEST_PATH and DOC_LINK_POLICY.
