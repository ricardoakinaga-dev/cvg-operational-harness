{
  "name": "cvg-operational-harness",
  "version": "1.0.0",
  "description": "CVG Operational Harness is a governed runtime foundation for reusable operational AI agents across the CVG ecosystem.",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test": "vitest run --no-file-parallelism --maxWorkers=2",
    "test:coverage": "vitest run --coverage --no-file-parallelism --maxWorkers=2",
    "test:e2e": "playwright test",
    "test:postgres": "vitest run --testTimeout=60000 --no-file-parallelism packages/persistence/src/__tests__/postgres-migration-smoke.test.ts packages/persistence/src/__tests__/tenant-isolation.test.ts packages/persistence/src/__tests__/platform-postgres-smoke.test.ts packages/persistence/src/__tests__/platform-approval-postgres.test.ts packages/persistence/src/__tests__/audit-evidence-checkpoint-postgres.test.ts packages/persistence/src/__tests__/session-version-pinning-postgres.test.ts packages/persistence/src/__tests__/outbox-durability.test.ts packages/persistence/src/__tests__/effect-journal-postgres.test.ts packages/persistence/src/__tests__/channel-effect-journal-postgres.test.ts apps/api/src/__tests__/postgres-persistence-mode.test.ts apps/api/src/__tests__/webhook-security.test.ts apps/api/src/__tests__/journeys-api-postgres.test.ts apps/worker/src/__tests__/postgres-outbox-bridge.integration.test.ts packages/chaos/src/__tests__/chaos-postgres.test.ts packages/persistence/src/__tests__/journeys-postgres.test.ts apps/worker/src/__tests__/continuous-worker-postgres.integration.test.ts apps/worker/src/__tests__/postgres-role-preflight.test.ts packages/persistence/src/__tests__/attendance-approval-postgres.test.ts packages/persistence/src/__tests__/journey-task-atomicity.test.ts packages/persistence/src/__tests__/runtime-approval-store-postgres.test.ts packages/persistence/src/__tests__/operational-execution-postgres.test.ts apps/worker/src/__tests__/operational-harness-process-restart.integration.test.ts apps/worker/src/__tests__/operational-harness-synthetic-effect-postgres.integration.test.ts apps/worker/src/__tests__/operational-harness-capability-postgres.integration.test.ts apps/worker/src/__tests__/kernel-composition-postgres.integration.test.ts apps/worker/src/__tests__/operational-harness-iterative.test.ts apps/worker/src/__tests__/operational-harness-iterative-postgres.integration.test.ts",
    "postgres:baseline": "tsx scripts/baseline-postgres.ts",
    "readiness": "vitest run tests/construction-readiness.test.js",
    "build": "npm run typecheck && npm run build:web",
    "build:harness": "tsc -b packages/shared/tsconfig.json packages/contracts/tsconfig.json packages/orchestrator/tsconfig.json packages/approval-engine/tsconfig.json packages/harness/tsconfig.json",
    "build:web": "vite --config vite.config.mts build apps/web",
    "dev:api": "tsx apps/api/src/main.ts",
    "dev:web": "vite --config vite.config.mts apps/web --host 0.0.0.0",
    "dev:worker": "tsx apps/worker/src/main.ts",
    "demo:phase2": "tsx scripts/phase2-demo.ts",
    "verify:phase2": "node scripts/phase2-verify.mjs",
    "test:worker:startup": "node scripts/worker-startup-smoke.mjs && node scripts/worker-controlled-smoke.mjs",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "audit:security": "npm audit --audit-level=high",
    "verify": "npm run format:check && npm run typecheck && npm run lint && npm run build && npm test && npm run test:coverage && npm run audit:security",
    "docs:audit": "npm test",
    "test:evals": "vitest run packages/agent-evals packages/harness/src/__tests__/agent-loop-evals.test.ts --no-file-parallelism --maxWorkers=2",
    "test:chaos": "vitest run packages/chaos --no-file-parallelism --maxWorkers=2",
    "sbom": "node scripts/generate-sbom.mjs",
    "licenses:check": "node scripts/check-licenses.mjs",
    "certify": "node scripts/phase10-certify.mjs",
    "certification:verify": "node scripts/phase10-verify.mjs",
    "certification:verify:historical": "node scripts/phase10-verify.mjs --historical --base certification/logs/historical/2026-09-11-phase10",
    "certification:self-test": "node scripts/phase10-verify.mjs --self-test && npx prettier --write certification/negative-validation.json",
    "demo:phase3": "tsx scripts/phase3-demo.ts",
    "verify:phase3": "node scripts/phase3-verify.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@tanstack/react-query": "^5.100.6",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.3",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tsx": "^4.23.12",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.6.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.2.1",
    "jsdom": "^29.1.0",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.1",
    "vite": "^8.0.10",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22 <23"
  }
}
