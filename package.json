{
  "name": "cvg-operational-harness",
  "version": "1.0.0",
  "description": "CVG Operational Harness is a governed runtime foundation for reusable operational AI agents across the CVG ecosystem.",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "legacy/packages/*",
    "products/*"
  ],
  "scripts": {
    "test": "vitest run --no-file-parallelism --maxWorkers=2",
    "test:coverage": "vitest run --coverage --no-file-parallelism --maxWorkers=2",
    "test:e2e": "playwright test",
    "test:postgres": "vitest run --testTimeout=60000 --no-file-parallelism packages/persistence/src/__tests__/postgres-migration-smoke.test.ts packages/persistence/src/__tests__/tenant-isolation.test.ts packages/persistence/src/__tests__/platform-postgres-smoke.test.ts packages/persistence/src/__tests__/platform-approval-postgres.test.ts packages/persistence/src/__tests__/audit-evidence-checkpoint-postgres.test.ts packages/persistence/src/__tests__/session-version-pinning-postgres.test.ts packages/persistence/src/__tests__/outbox-durability.test.ts packages/persistence/src/__tests__/effect-journal-postgres.test.ts packages/persistence/src/__tests__/channel-effect-journal-postgres.test.ts apps/api/src/__tests__/postgres-persistence-mode.test.ts apps/api/src/__tests__/webhook-security.test.ts apps/api/src/__tests__/journeys-api-postgres.test.ts apps/worker/src/__tests__/postgres-outbox-bridge.integration.test.ts packages/chaos/src/__tests__/chaos-postgres.test.ts legacy/packages/secretary-journeys/src/__tests__/journeys-postgres.test.ts apps/worker/src/__tests__/continuous-worker-postgres.integration.test.ts apps/worker/src/__tests__/postgres-role-preflight.test.ts packages/persistence/src/__tests__/attendance-approval-postgres.test.ts legacy/packages/secretary-journeys/src/__tests__/journey-task-atomicity.test.ts packages/persistence/src/__tests__/runtime-approval-store-postgres.test.ts packages/persistence/src/__tests__/operational-execution-postgres.test.ts apps/worker/src/__tests__/operational-harness-process-restart.integration.test.ts apps/worker/src/__tests__/operational-harness-synthetic-effect-postgres.integration.test.ts apps/worker/src/__tests__/operational-harness-capability-postgres.integration.test.ts apps/worker/src/__tests__/kernel-composition-postgres.integration.test.ts apps/worker/src/__tests__/operational-harness-iterative.test.ts apps/worker/src/__tests__/operational-harness-iterative-postgres.integration.test.ts apps/api/src/__tests__/approval-decision-atomicity-postgres.test.ts packages/persistence/src/__tests__/outbox-content-binding-postgres.test.ts apps/api/src/__tests__/tenant-schema-inventory-postgres.test.ts apps/api/src/__tests__/trusted-replay-distributed-postgres.test.ts apps/api/src/__tests__/rate-limit-distributed-postgres.test.ts apps/worker/src/__tests__/operational-harness-homolog.integration.test.ts apps/api/src/__tests__/homolog-correlation-postgres.test.ts apps/worker/src/__tests__/homolog-health-postgres.test.ts",
    "postgres:baseline": "tsx scripts/baseline-postgres.ts",
    "readiness": "vitest run tests/construction-readiness.test.js",
    "build": "npm run typecheck && npm run build:web",
    "build:harness": "tsc -b packages/shared/tsconfig.json packages/contracts/tsconfig.json packages/orchestrator/tsconfig.json packages/approval-engine/tsconfig.json packages/harness/tsconfig.json",
    "build:runtime": "node scripts/build-runtime.mjs",
    "build:web": "vite --config vite.config.mts build apps/web",
    "dev:api": "tsx apps/api/src/main.ts",
    "dev:web": "vite --config vite.config.mts apps/web --host 0.0.0.0",
    "dev:worker": "tsx apps/worker/src/main.ts",
    "demo:phase2": "tsx scripts/phase2-demo.ts",
    "verify:phase2": "node scripts/phase2-verify.mjs",
    "test:worker:startup": "node scripts/worker-startup-smoke.mjs && node scripts/worker-controlled-smoke.mjs",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "audit:security": "npm audit --audit-level=high",
    "verify": "node scripts/node-version-preflight.mjs && npm run format:check && npm run typecheck && npm run lint && npm run build && npm test && npm run test:coverage && npm run audit:security",
    "docs:audit": "npm test",
    "test:evals": "vitest run packages/agent-evals packages/harness/src/__tests__/agent-loop-evals.test.ts --no-file-parallelism --maxWorkers=2",
    "evals:report": "tsx scripts/phase10-eval-report.ts",
    "evals:bar": "npm run test:evals && npm run evals:report",
    "coverage:critical": "node scripts/critical-coverage.mjs",
    "mutation:guard": "node scripts/mutation-guard.mjs",
    "skip:governance": "node scripts/skip-inventory.mjs --verify",
    "test:chaos": "vitest run packages/chaos --no-file-parallelism --maxWorkers=2",
    "test:load": "tsx scripts/phase10-load.ts --events=10000",
    "test:restore": "tsx scripts/phase10-restore-check.ts",
    "test:postgres:proof": "tsx scripts/rem21-010-postgres-proof.ts",
    "test:observability:proof": "tsx scripts/rem21-011-observability-proof.ts",
    "diff:check": "node scripts/ci-diff-check.mjs",
    "sbom": "node scripts/generate-sbom.mjs",
    "licenses:check": "node scripts/check-licenses.mjs",
    "certify": "node scripts/node-version-preflight.mjs && node scripts/phase10-certify.mjs",
    "certification:verify": "node scripts/phase10-verify.mjs",
    "certification:verify:historical": "node scripts/phase10-verify.mjs --historical --base certification/logs/historical/2026-09-11-phase10",
    "certification:self-test": "node scripts/phase10-verify.mjs --self-test && npx prettier --write certification/negative-validation.json",
    "demo:phase3": "tsx scripts/phase3-demo.ts",
    "verify:phase3": "node scripts/phase3-verify.mjs",
    "demo:phase4a": "tsx scripts/phase4a-demo.ts",
    "verify:phase4a": "node scripts/phase4a-verify.mjs",
    "verify:phase4a:identity": "node scripts/phase4a-gate-identity.mjs",
    "docs:check-links": "node scripts/check-doc-links.mjs README.md AGENTS.md docs products && node scripts/check-evidence-hygiene.mjs",
    "evidence:check-hygiene": "node scripts/check-evidence-hygiene.mjs",
    "evidence:phase4a:golden": "tsx scripts/phase4a-golden-evidence.ts",
    "evidence:phase4a:performance": "tsx scripts/phase4a-performance.ts",
    "test:e2e:rem21-014": "node scripts/rem21-014-browser-proof.mjs",
    "test:phase4a": "PHASE4A_PG_REQUIRED=1 vitest run packages/conversation/src/__tests__ tests/phase4a packages/persistence/src/__tests__/conversation-intelligence-migration.test.ts --reporter=dot",
    "certify:phase4a": "node scripts/phase4a-certify.mjs",
    "sentinel:phase4a": "node scripts/phase4a-certify.mjs --sentinel",
    "ci:bar:contract": "node scripts/ci-bar-contract-self-test.mjs",
    "test:core": "vitest run --exclude \"products/**\" --no-file-parallelism --maxWorkers=2",
    "test:shift-assistant": "npm test --workspace @cvg/shift-assistant",
    "build:shift-assistant": "npm run build --workspace @cvg/shift-assistant",
    "demo:shift-assistant": "npm run demo --workspace @cvg/shift-assistant",
    "chat:shift-assistant": "npm run chat --workspace @cvg/shift-assistant",
    "boundary:products": "node scripts/check-product-boundary.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@tanstack/react-query": "^5.100.6",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.5",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.6.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.11",
    "axe-core": "^4.13.0",
    "eslint": "^10.2.1",
    "jsdom": "^29.1.0",
    "prettier": "^3.8.3",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.1",
    "vite": "^8.0.10",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22 <23"
  }
}
