{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "declaration": true,
    "sourceMap": true,
    "composite": true,
    "ignoreDeprecations": "6.0",
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@cvg/harness-contracts": ["packages/contracts/src/index.ts"],
      "@cvg/harness-orchestrator": ["packages/orchestrator/src/index.ts"],
      "@cvg/harness": ["packages/harness/src/index.ts"],
      "@cvg/shared": ["packages/shared/src/index.ts"],
      "@cvg/persistence": ["packages/persistence/src/index.ts"],
      "@cvg/agent-core": ["packages/agent-core/src/index.ts"],
      "@cvg/policy": ["packages/policy/src/index.ts"],
      "@cvg/tools": ["packages/tools/src/index.ts"],
      "@cvg/workflows": ["packages/workflows/src/index.ts"],
      "@cvg/adapters": ["packages/adapters/src/index.ts"],
      "@cvg/memory": ["packages/memory/src/index.ts"],
      "@cvg/rag": ["packages/rag/src/index.ts"],
      "@cvg/platform": ["packages/platform/src/index.ts"],
      "@cvg/model-gateway": ["packages/model-gateway/src/index.ts"],
      "@cvg/policy-engine": ["packages/policy-engine/src/index.ts"],
      "@cvg/approval-engine": ["packages/approval-engine/src/index.ts"],
      "@cvg/channel-gateway": ["packages/channel-gateway/src/index.ts"],
      "@cvg/observability": ["packages/observability/src/index.ts"],
      "@cvg/agent-runtime": ["packages/agent-runtime/src/index.ts"],
      "@cvg/agent-evals": ["packages/agent-evals/src/index.ts"],
      "@cvg/chaos": ["packages/chaos/src/index.ts"],
      "@cvg/conversation": ["packages/conversation/src/index.ts"]
    }
  }
}
