+// @vitest-environment node
+import * as fs from 'node:fs'
+import { createServer, type Server } from 'node:http'
+import type { AddressInfo } from 'node:net'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { spawnSync } from 'node:child_process'
+import { afterEach, describe, expect, it, vi } from 'vitest'
+import { ShiftStore, type CommitExpected } from '../store.ts'
+import { ShiftAssistant } from '../assistant.ts'
+import {
+  WahaClient,
+  EvolutionClient,
+  type WhatsAppClient,
+  type SendResult
+} from '../whatsapp.ts'
+import { buildShiftServer } from '../server.ts'
+import { ModelOrganizer, type Organizer } from '../organizer.ts'
+import { canonical, sha256, type JournalIO } from '../journal.ts'
+import { type V2Event, type OrganizedV2 } from '../domain.ts'
+import { RAW, RESPONSE, staticOrganizer } from './vertical-test-fixture.ts'
+import { validateOrganization } from '../source-evidence.ts'
+import { inputDigest } from '../vertical-state.ts'
+import { composeShiftApp } from '../compose.ts'
+import { loadShiftConfig } from '../config.ts'
+const ANA = '5511900000001',
+  BRUNO = '5511900000002',
+  MANAGER = '5511900000009'
+const members = [
+  { phone: ANA, name: 'Ana', manager: false },
+  { phone: BRUNO, name: 'Bruno', manager: false },
+  { phone: MANAGER, name: 'Manager', manager: true }
+]
+const SECRET = 'synthetic-webhook-secret-12345'
+const closers: (() => Promise<void> | void)[] = []
+afterEach(async () => {
+  for (const close of closers.reverse()) await close()
+  closers.length = 0
+})
+function volume() {
+  return fs.mkdtempSync(join(tmpdir(), 'product-vertical-'))
+}
+function bind(s: Server) {
+  return new Promise<string>((resolve) =>
+    s.listen(0, '127.0.0.1', () =>
+      resolve(`http://127.0.0.1:${(s.address() as AddressInfo).port}`)
+    )
+  )
+}
+function closeServer(s: Server) {
+  s.closeAllConnections()
+  return new Promise<void>((r) => s.close(() => r()))
+}
+async function setup(
+  o: {
+    provider?: 'waha' | 'evolution'
+    dir?: string
+    organizer?: Organizer
+    io?: JournalIO
+    transport?: () => Promise<SendResult | void>
+    modelTimeoutMs?: number
+  } = {}
+) {
+  const dir = o.dir ?? volume()
+  let now = new Date('2026-10-03T18:00:00Z')
+  let mode = 'accepted'
+  const sent: { path: string; body: Record<string, unknown> }[] = []
+  const receiver = createServer((req, res) => {
+    void (async () => {
+      let data = ''
+      for await (const chunk of req) data += String(chunk)
+      sent.push({ path: req.url!, body: JSON.parse(data) })
+      if (mode === 'disconnect') {
+        req.socket.destroy()
+        return
+      }
+      if (mode === '5xx') {
+        res.writeHead(503)
+        res.end('{}')
+        return
+      }
+      if (mode === 'hang') return
+      res.writeHead(201, { 'content-type': 'application/json' })
+      res.end(
+        JSON.stringify(
+          o.provider === 'evolution'
+            ? { key: { id: 'synthetic-' + sent.length } }
+            : { id: 'synthetic-' + sent.length }
+        )
+      )
+    })()
+  })
+  const base = await bind(receiver)
+  closers.push(() => closeServer(receiver))
+  const client: WhatsAppClient =
+    o.provider === 'evolution'
+      ? new EvolutionClient({
+          baseUrl: base,
+          instance: 'fixture',
+          apiKey: 'synthetic',
+          fetch: async (u, i) => fetch(u, i),
+          sendTimeoutMs: 50
+        })
+      : new WahaClient({
+          baseUrl: base,
+          session: 'fixture',
+          apiKey: 'synthetic',
+          fetch: async (u, i) => fetch(u, i),
+          sendTimeoutMs: 50
+        })
+  if (o.transport) client.sendText = o.transport
+  const store = new ShiftStore(dir, o.io ? { io: o.io } : {})
+  closers.push(() => store.close())
+  const assistant = new ShiftAssistant({
+    store,
+    members,
+    whatsapp: client,
+    organizer: o.organizer ?? staticOrganizer,
+    transcriber: {
+      async transcribe() {
+        return RAW
+      }
+    },
+    clock: () => now,
+    ...(o.modelTimeoutMs ? { modelTimeoutMs: o.modelTimeoutMs } : {})
+  })
+  closers.push(() => assistant.stop())
+  const server = buildShiftServer({
+    assistant,
+    store,
+    whatsapp: client,
+    webhookSecret: SECRET,
+    clock: () => now
+  })
+  const url = await bind(server)
+  closers.push(() => closeServer(server))
+  const body = (id: string, text: string, phone = ANA) =>
+    o.provider === 'evolution'
+      ? {
+          event: 'messages.upsert',
+          instance: 'fixture',
+          data: {
+            key: { id, remoteJid: phone + '@s.whatsapp.net' },
+            message: { conversation: text }
+          }
+        }
+      : {
+          event: 'message',
+          session: 'fixture',
+          payload: { id, from: phone + '@c.us', body: text }
+        }
+  const post = async (id: string, text: string, phone = ANA) =>
+    fetch(url + '/webhooks/' + (o.provider ?? 'waha'), {
