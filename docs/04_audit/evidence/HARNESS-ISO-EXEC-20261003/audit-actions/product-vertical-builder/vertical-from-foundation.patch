@@ -0,0 +1,128 @@
+import fs from 'node:fs'
+import path from 'node:path'
+import { fileURLToPath } from 'node:url'
+import { spawnSync } from 'node:child_process'
+import { createHash } from 'node:crypto'
+// Read immutable shared sources; all generated inputs/artifacts remain under the product.
+// No root build config, package, lock, shared dist or source is changed.
+const product = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..')
+const root = path.resolve(product, '../..')
+fs.mkdirSync(path.join(product, 'dist'), { recursive: true })
+const work = fs.mkdtempSync(path.join(product, 'dist/public-'))
+const copies = []
+function run(args) {
+  const p = spawnSync(process.execPath, args, { cwd: work, stdio: 'inherit' })
+  if (p.status !== 0) throw new Error('public_build_failed:' + p.status)
+}
+function copySources(from, to) {
+  fs.mkdirSync(to, { recursive: true })
+  for (const entry of fs.readdirSync(from, { withFileTypes: true })) {
+    const source = path.join(from, entry.name),
+      target = path.join(to, entry.name)
+    if (entry.isDirectory()) {
+      if (entry.name !== '__tests__' && entry.name !== 'sandbox')
+        copySources(source, target)
+    } else if (entry.name.endsWith('.ts') && !entry.name.endsWith('.test.ts')) {
+      fs.copyFileSync(source, target)
+      copies.push({
+        source: path.relative(root, source),
+        sha256: createHash('sha256')
+          .update(fs.readFileSync(source))
+          .digest('hex')
+      })
+    }
+  }
+}
+function compile(dir) {
+  const config = {
+    extends: path.join(root, 'tsconfig.base.json'),
+    compilerOptions: {
+      paths: {},
+      rootDir: path.join(dir, 'src'),
+      outDir: path.join(dir, 'dist'),
+      tsBuildInfoFile: path.join(dir, 'dist/public.tsbuildinfo'),
+      typeRoots: [path.join(root, 'node_modules/@types')],
+      noEmitOnError: true
+    },
+    include: [path.join(dir, 'src/**/*.ts')],
+    exclude: [],
+    references: []
+  }
+  fs.writeFileSync(
+    path.join(dir, 'build.json'),
+    JSON.stringify(config, null, 2) + '\n'
+  )
+  run([
+    path.join(root, 'node_modules/typescript/bin/tsc'),
+    '-p',
+    path.join(dir, 'build.json'),
+    '--pretty',
+    'false'
+  ])
+}
+fs.mkdirSync(path.join(product, 'dist'), { recursive: true })
+for (const name of ['shared', 'model-gateway']) {
+  const source = path.join(root, 'packages', name),
+    destination = path.join(work, 'node_modules/@cvg', name)
+  fs.mkdirSync(destination, { recursive: true })
+  fs.copyFileSync(
+    path.join(source, 'package.json'),
+    path.join(destination, 'package.json')
+  )
+  copySources(path.join(source, 'src'), path.join(destination, 'src'))
+  compile(destination)
+}
+const app = path.join(work, 'app')
+fs.mkdirSync(app)
+fs.copyFileSync(
+  path.join(product, 'package.json'),
+  path.join(app, 'package.json')
+)
+copySources(path.join(product, 'src'), path.join(app, 'src'))
+compile(app)
+const esbuild = await import(
+  path.join(root, 'node_modules/esbuild/lib/main.js')
+)
+await esbuild
+  .build({
+    entryPoints: [path.join(app, 'dist/main.js')],
+    bundle: true,
+    platform: 'node',
+    target: 'node22',
+    format: 'esm',
+    legalComments: 'none',
+    banner: {
+      js: "import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);"
+    },
+    metafile: true,
+    outfile: path.join(product, 'dist/shift-assistant.mjs')
+  })
+  .then((result) =>
+    fs.writeFileSync(
+      path.join(product, 'dist/public-inputs.json'),
+      JSON.stringify(result.metafile, null, 2) + '\n'
+    )
+  )
+
+fs.writeFileSync(
+  path.join(product, 'dist/public-source-copies.json'),
+  JSON.stringify(
+    {
+      publicExports: true,
+      sourceAliases: false,
+      sharedWrites: false,
+      sources: copies
+    },
+    null,
+    2
+  ) + '\n'
+)
+console.log(
+  JSON.stringify({
+    publicExports: true,
+    sourceAliases: false,
+    sharedWrites: false,
+    closure: ['@cvg/shared', '@cvg/model-gateway', '@cvg/shift-assistant'],
+    artifact: 'products/shift-assistant/dist/shift-assistant.mjs'
+  })
+)
diff --git a/products/shift-assistant/scripts/vertical-bundle-smoke.mjs b/products/shift-assistant/scripts/vertical-bundle-smoke.mjs
new file mode 100644
--- /dev/null
+++ b/products/shift-assistant/scripts/vertical-bundle-smoke.mjs
@@ -0,0 +1,179 @@
+import assert from 'node:assert/strict'
+import fs from 'node:fs'
+import { createServer } from 'node:http'
+import { spawn } from 'node:child_process'
+import { tmpdir } from 'node:os'
+import path from 'node:path'
+import { fileURLToPath } from 'node:url'
+const product = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..')
+const dir = fs.mkdtempSync(path.join(tmpdir(), 'cvg-vertical-bundle-'))
+let sends = 0,
+  modelRequests = 0
+const receiver = createServer((req, res) => {
+  req.resume()
+  sends++
+  res.writeHead(201, { 'content-type': 'application/json' })
+  res.end(JSON.stringify({ id: 'synthetic-' + sends }))
+})
+const model = createServer((req, res) => {
+  req.resume()
+  modelRequests++
+  res.end('{}')
+})
+const bind = (server) =>
+  new Promise((resolve) =>
+    server.listen(0, '127.0.0.1', () =>
+      resolve('http://127.0.0.1:' + server.address().port)
+    )
+  )
+const close = (server) =>
+  new Promise((resolve) => {
+    server.closeAllConnections()
+    server.close(() => resolve())
+  })
+const waUrl = await bind(receiver),
+  modelUrl = await bind(model)
+const phone = '5511900000001',
+  secret = 'synthetic-bundle-webhook-12345'
+const child = spawn(
+  process.execPath,
+  [path.join(product, 'dist/shift-assistant.mjs')],
+  {
+    env: {
+      ...process.env,
+      SHIFT_PROVIDER: 'waha',
+      SHIFT_MEMBERS: phone + '=Ana;5511900000009=Manager*',
+      SHIFT_WEBHOOK_SECRET: secret,
+      SHIFT_DATA_DIR: dir,
+      SHIFT_PORT: '0',
+      SHIFT_HOST: '127.0.0.1',
+      WAHA_URL: waUrl,
+      WAHA_API_KEY: 'synthetic-only',
+      WHISPER_URL: 'http://127.0.0.1:1',
+      LLM_BASE_URL: modelUrl,
+      LLM_LOCATION: 'local',
+      LLM_MODEL: 'synthetic'
+    },
+    stdio: ['ignore', 'pipe', 'pipe']
+  }
+)
+const exited = new Promise((resolve, reject) => {
+  child.once('error', reject)
+  child.once('exit', (code, signal) => resolve({ code, signal }))
+})
+let stdout = '',
+  stderr = ''
+child.stderr.on('data', (c) => {
+  stderr += c
+})
+const deadline = setTimeout(() => child.kill('SIGKILL'), 10000)
+try {
+  const port = await new Promise((resolve, reject) => {
+    child.stdout.on('data', (chunk) => {
+      stdout += chunk
+      for (const line of stdout.split('\n')) {
+        try {
+          const v = JSON.parse(line)
+          if (v.event === 'shift.started') resolve(v.port)
+        } catch {
+          /* incomplete log line */
+        }
+      }
+    })
+    child.once('exit', () => reject(new Error('bundle_exited_before_start')))
+  })
+  assert.notEqual(port, 3400)
+  assert.notEqual(port, 3401)
+  const raw = 'Paciente Sintético, ID 101. Evolução: alerta.'
+  const post = async (id, text) => {
+    const res = await fetch(`http://127.0.0.1:${port}/webhooks/waha`, {
+      method: 'POST',
+      headers: {
+        'content-type': 'application/json',
+        'x-cvg-webhook-secret': secret
+      },
+      body: JSON.stringify({
+        event: 'message',
+        payload: { id, from: phone + '@c.us', body: text }
+      })
+    })
+    assert.equal(res.status, 200)
+    return res.json()
+  }
+  const transactions = () => {
+    const manifest = JSON.parse(
+      fs.readFileSync(path.join(dir, 'journal/manifest.json'), 'utf8')
+    )
+    return manifest.segments.flatMap((segment) =>
+      fs
+        .readFileSync(path.join(dir, segment.path), 'utf8')
+        .trim()
+        .split('\n')
+        .filter(Boolean)
+        .map((line) => JSON.parse(line))
+    )
+  }
+  const events = () => transactions().flatMap((t) => t.changes)
+  const waitFor = async (predicate) => {
+    for (let n = 0; n < 200; n++) {
+      if (predicate()) return
+      await new Promise((resolve) => setTimeout(resolve, 10))
+    }
+    throw new Error('smoke_deadline')
+  }
+  assert.deepEqual(await post('note', raw), { accepted: true })
+  await waitFor(() =>
+    events().some(
+      (e) => e.type === 'outbox_result' && e.state === 'provider_accepted'
+    )
+  )
+  const note = events().find((e) => e.type === 'draft_prepared').note
+  assert.equal(note.rawText, raw)
+  assert.deepEqual(note.warnings, ['policy_denied'])
+  assert.deepEqual(note.tasks, [])
+  assert.deepEqual(await post('confirm', 'ok nota ' + note.token), {
+    accepted: true
+  })
+  await waitFor(
+    () =>
+      sends === 2 &&
+      events().filter(
+        (e) => e.type === 'outbox_result' && e.state === 'provider_accepted'
+      ).length === 2
+  )
+  const confirmed = events().find((e) => e.type === 'confirmation_committed')
+  assert.deepEqual(confirmed.tasks, [])
+  assert.equal(confirmed.hash, note.organizedSha256)
+  assert.equal(modelRequests, 0)
+  const ready = await fetch(`http://127.0.0.1:${port}/health/ready`)
+  assert.equal(ready.status, 200)
+  child.kill('SIGTERM')
+  const result = await exited
+  assert.equal(result.code, 0)
+  assert.equal(result.signal, null)
+  assert.equal(fs.existsSync(path.join(dir, 'store.lock')), false)
+  console.log(
+    JSON.stringify({
+      status: 'PASS',
+      artifact: 'dist/shift-assistant.mjs',
+      publicBundle: true,
+      modelRequests,
+      sends,
+      sourcePreserved: true,
+      rawDocumentConfirmed: true,
+      derivedTasks: 0,
+      lockReleased: true,
+      exit: result,
+      transactions: transactions().length,
+      synthetic: true
+    })
+  )
+} finally {
+  clearTimeout(deadline)
+  if (child.exitCode === null && child.signalCode === null)
+    child.kill('SIGKILL')
+  await exited
+  await close(receiver)
+  await close(model)
+  if (stderr) process.stderr.write(stderr)
+}
