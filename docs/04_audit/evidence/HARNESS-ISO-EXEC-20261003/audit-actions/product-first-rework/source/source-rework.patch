+interface BoundField {
+  field: string
+  start: number
+  end: number
+  literal: string
+}
+// Values are extracted from the complete persisted block, never from a potentially
+// shortened quote. Only surrounding field separators are removed; units, signs,
+// scale, negation and all free prose remain literal.
+function fieldRange(
+  raw: string,
+  field: string,
+  start: number,
+  end: number
+): BoundField {
+  while (start < end && /\s/u.test(raw[start]!)) start++
+  while (end > start && /\s/u.test(raw[end - 1]!)) end--
+  if (/[.,;]/u.test(raw[end - 1] ?? '')) end--
+  while (end > start && /\s/u.test(raw[end - 1]!)) end--
+  return { field, start, end, literal: raw.slice(start, end) }
+}
