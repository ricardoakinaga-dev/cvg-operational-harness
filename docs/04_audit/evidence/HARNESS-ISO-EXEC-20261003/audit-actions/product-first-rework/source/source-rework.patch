+// @vitest-environment node
+import { describe, expect, it } from 'vitest'
+import { validateOrganization } from '../source-evidence.ts'
+import { parseOrganizerResponse } from '../organizer.ts'
+import {
+  applyVertical,
+  emptyVertical,
+  revisionToken
+} from '../vertical-state.ts'
+import { canonical, sha256 } from '../journal.ts'
+import type { NoteV2, OrganizedV2 } from '../domain.ts'
+import { RAW, RESPONSE } from './vertical-test-fixture.ts'
+import { ADMISSION, THOR_AUDIO, BOB_AUDIO } from './e2e-v2-fixtures.ts'
+import { LEGACY_RAW, LEGACY_RESPONSE } from './legacy-v2-fixture.ts'
+
+const at = '2026-10-03T18:00:00Z'
+function check(raw: string, response: OrganizedV2) {
+  return validateOrganization(
+    raw,
+    parseOrganizerResponse(JSON.stringify(response)),
+    [],
+    at
+  )
+}
+function evolution(
+  source: string,
+  output = source,
+  quote = 'Evolução: ' + source
+) {
+  const response = structuredClone(RESPONSE)
+  response.pacientes[0]!.evolucao = output
+  response.evidence[3]!.quote = quote
+  return { raw: RAW.replace('alerta', source), response }
+}
+function bed(source: string, output: string, quote = 'leito ' + source) {
+  const response = structuredClone(RESPONSE)
+  response.pacientes[0]!.id = '2'
+  response.pacientes[0]!.leito = output
+  response.pendencias[0]!.pacienteId = '2'
+  response.evidence[0]!.quote = 'Paciente Rex, leito ' + source + ', ID 2'
+  response.evidence[1]!.quote = 'ID 2'
+  response.evidence[2]!.quote = quote
+  return {
+    raw: RAW.replace('ID 20202, leito 4', 'leito ' + source + ', ID 2'),
+    response
+  }
+}
+function blocked(raw: string, response: OrganizedV2, field: string) {
+  const result = check(raw, response)
+  expect(
+    result.issues.some((i) => i.path === field && i.severity === 'blocking')
+  ).toBe(true)
+  return result
+}
+function replay(raw: string, response: OrganizedV2, forgeIssues = false) {
+  const organized = parseOrganizerResponse(response)
+  const validation = validateOrganization(raw, organized, [], at)
+  // This reducer is the real journal caller; no store/app mutation, model or HTTP seam.
+  // Empty pending list makes the test focus on recomputation of field provenance.
+  const state = emptyVertical()
+  const key = JSON.stringify(['waha', 'source-regression', 'note'])
+  const phone = '5511900000001'
+  state.inbox.set(key, {
+    key,
+    digest: '0'.repeat(64),
+    provider: 'waha',
+    session: 'source-regression',
+    messageId: 'note',
+    memberPhone: phone,
+    kind: 'text',
+    text: raw,
+    receivedAt: at,
+    state: 'processing',
+    stage: 'organize',
+    attempt: 1
+  })
+  const note: NoteV2 = {
+    id: 'source-note',
+    messageKey: key,
+    authorPhone: phone,
+    revision: 1,
+    createdAt: at,
+    rawText: raw,
+    rawTextSha256: sha256(raw),
+    organized,
+    organizedSha256: sha256(canonical(organized)),
+    token: '',
+    state: 'draft',
+    replacementPending: false,
+    evidence: validation.evidence,
+    bindings: validation.bindings,
+    issues: forgeIssues ? [] : validation.issues,
+    warnings: [],
+    tasks: [],
+    previewIds: ['source-preview']
+  }
+  note.token = revisionToken(note)
+  applyVertical(
+    state,
+    {
+      v: 2,
+      type: 'draft_prepared',
+      at,
+      actor: { kind: 'member', memberPhone: phone },
+      key,
+      note,
+      outboxes: [
+        {
+          id: 'source-preview',
+          purpose: 'preview',
+          sourceTransitionId: 'source-draft',
+          recipientMemberId: phone,
+          noteId: note.id,
+          noteRevision: 1,
+          payloadText: 'synthetic preview',
+          payloadSha256: sha256('synthetic preview'),
+          state: 'queued',
+          attempt: 0
+        }
+      ]
+    },
+    0,
+    false
+  )
+  return state
+}
