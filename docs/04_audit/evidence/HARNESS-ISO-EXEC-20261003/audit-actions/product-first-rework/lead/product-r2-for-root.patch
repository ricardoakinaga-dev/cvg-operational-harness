+function fieldEquivalent(
+  source: string,
+  output: string,
+  field: string
+): boolean {
+  if (source === output) return true
+  if (field === 'id' || field === 'leito' || field === 'quando') {
+    const a = numeralValue(source),
+      b = numeralValue(output)
