+  let offset = 0
+  try {
+    const total = bytes ?? fs.fstatSync(fd).size
+    while (offset < total) {
+      const count = fs.readSync(
+        fd,
+        buffer,
+        0,
+        Math.min(buffer.length, total - offset),
+        offset
+      )
+      if (!count) throw new StoreError('STORAGE_UNAVAILABLE')
+      digest.update(buffer.subarray(0, count))
+      offset += count
+    }
+  } finally {
+    fs.closeSync(fd)
+  }
