+  const sent: { path: string; body: Record<string, unknown> }[] = []
+  const receiver = createServer((req, res) => {
+    void (async () => {
+      let data = ''
+      for await (const chunk of req) data += String(chunk)
+      sent.push({ path: req.url!, body: JSON.parse(data) })
+      if (mode === 'disconnect') {
+        req.socket.destroy()
+        return
+      }
+      if (mode === '5xx') {
+        res.writeHead(503)
+        res.end('{}')
+        return
+      }
+      if (mode === 'hang') return
+      res.writeHead(201, { 'content-type': 'application/json' })
+      res.end(
+        JSON.stringify(
+          o.provider === 'evolution'
+            ? { key: { id: 'synthetic-' + sent.length } }
+            : { id: 'synthetic-' + sent.length }
+        )
+      )
+    })()
+  })
