+async function boundedSend(
+  fetchImpl: FetchLike,
+  url: string,
+  headers: Record<string, string>,
+  payload: Record<string, unknown>,
+  timeout: number,
+  external?: AbortSignal
+): Promise<SendResult> {
+  if (
+    Buffer.byteLength(String(payload.text)) > 32768 ||
+    external?.aborted ||
+    !Number.isFinite(timeout) ||
+    timeout <= 0 ||
+    timeout > 10000
+  )
+    return { status: 'definitely_not_accepted', code: 'local_validation' }
+  const c = new AbortController()
+  const timer = setTimeout(() => c.abort(), timeout)
+  const abort = () => c.abort()
+  external?.addEventListener('abort', abort, { once: true })
+  if (external?.aborted) c.abort()
+  let reader: ReadableStreamDefaultReader<Uint8Array> | undefined
+  try {
+    const response = await fetchImpl(url, {
+      method: 'POST',
+      headers,
+      body: JSON.stringify(payload),
+      signal: c.signal,
+      redirect: 'manual'
+    })
+    // No qualified provider idempotency or nonacceptance contract: all post-start errors are uncertain.
+    if (!response.ok) {
+      await response.body?.cancel()
+      return { status: 'uncertain', code: 'http_' + response.status }
+    }
+    reader = response.body?.getReader()
+    const chunks: Uint8Array[] = []
+    let total = 0
+    if (reader)
+      while (true) {
+        const { value, done } = await reader.read()
+        if (done) break
+        if (value.length > 65536 - total) throw new Error('response_too_large')
+        total += value.length
+        chunks.push(value)
+      }
+    const body = Buffer.concat(chunks)
+    const decoded = new TextDecoder('utf-8', { fatal: true }).decode(body)
+    const parsed: unknown = decoded ? JSON.parse(decoded) : {}
+    const json = obj(parsed)
+    if (!json) throw new Error('invalid_receipt')
+    const providerId = str(json.id) ?? str(obj(json.key)?.id)
+    return {
+      status: 'provider_accepted',
+      receipt: {
+        status: response.status,
+        at: new Date().toISOString(),
+        sha256: sha256(body),
+        ...(providerId && providerId.length <= 256 ? { providerId } : {})
+      }
+    }
+  } catch {
+    return { status: 'uncertain', code: 'post_start_failure' }
+  } finally {
+    clearTimeout(timer)
+    external?.removeEventListener('abort', abort)
+    try {
+      await reader?.cancel()
+    } catch {
+      /* closed */
+    }
+    reader?.releaseLock()
+  }
+}
