+/** Bounded byte streaming; only LF-delimited records are decoded. */
+export function* lines(
+  path: string,
+  max: number,
+  limit?: number
+): Generator<{ bytes: Buffer; end: number; delimited: boolean }> {
+  const fd = fs.openSync(path, fs.constants.O_RDONLY | fs.constants.O_NOFOLLOW)
+  let offset = 0
+  let length = 0
+  let chunks: Buffer[] = []
+  const buffer = Buffer.alloc(64 * 1024)
+  try {
+    const total = limit ?? fs.fstatSync(fd).size
+    while (offset < total) {
+      const count = fs.readSync(
+        fd,
+        buffer,
+        0,
+        Math.min(buffer.length, total - offset),
+        offset
+      )
+      if (!count) throw new StoreError('STORAGE_UNAVAILABLE')
+      let begin = 0
+      for (let i = 0; i < count; i++) {
+        if (buffer[i] !== 10) continue
+        const part = Buffer.from(buffer.subarray(begin, i))
+        length += part.length
+        if (length + 1 > max)
+          throw new StoreError(
+            'STORAGE_UNAVAILABLE',
+            'Record exceeds replay budget'
+          )
+        chunks.push(part)
+        yield {
+          bytes: Buffer.concat(chunks, length),
+          end: offset + i + 1,
+          delimited: true
+        }
+        chunks = []
+        length = 0
+        begin = i + 1
+      }
+      const part = Buffer.from(buffer.subarray(begin, count))
+      length += part.length
+      if (length > max)
+        throw new StoreError(
+          'STORAGE_UNAVAILABLE',
+          'Record exceeds replay budget'
+        )
+      if (part.length) chunks.push(part)
+      offset += count
+    }
+    if (length)
+      yield {
+        bytes: Buffer.concat(chunks, length),
+        end: offset,
+        delimited: false
+      }
+  } finally {
+    fs.closeSync(fd)
+  }
