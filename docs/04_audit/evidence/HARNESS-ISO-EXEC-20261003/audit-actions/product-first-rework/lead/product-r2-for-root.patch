+import type { OrganizedV2 } from '../domain.ts'
+function fixture(
+  name: string,
+  id: string | null,
+  bed: string | null,
+  evolution: string | null,
+  pending: string | null,
+  time: string | null,
+  extra: {
+    species?: string
+    tutor?: string
+    reason?: string
+    exams?: string[]
+  } = {}
+): { raw: string; response: OrganizedV2 } {
+  const anchor = `Paciente ${name}${id ? ', ID ' + id : ''}${bed ? ', leito ' + bed : ''}${extra.species ? ', ' + extra.species : ''}.`
+  const parts = [
+    anchor,
+    ...(extra.tutor ? ['Tutor: ' + extra.tutor + '.'] : []),
+    ...(extra.reason ? ['Motivo: ' + extra.reason + '.'] : []),
+    ...(evolution ? ['Evolução: ' + evolution + '.'] : []),
+    ...(extra.exams ? ['Exames: ' + extra.exams.join('; ') + '.'] : []),
+    ...(pending
+      ? ['Pendência: ' + pending + (time ? ' às ' + time : '') + '.']
+      : [])
+  ]
+  const evidence: OrganizedV2['evidence'] = [
+    { path: 'pacientes.p1.nome', patientRef: 'p1', quote: anchor }
+  ]
+  const add = (path: string, quote: string) =>
+    evidence.push({ path, patientRef: 'p1', quote })
+  if (id) add('pacientes.p1.id', 'ID ' + id)
+  if (bed) add('pacientes.p1.leito', 'leito ' + bed)
+  if (extra.species) add('pacientes.p1.especie', extra.species)
+  if (extra.tutor) add('pacientes.p1.tutor', 'Tutor: ' + extra.tutor)
+  if (extra.reason) add('pacientes.p1.motivo', 'Motivo: ' + extra.reason)
+  if (evolution) add('pacientes.p1.evolucao', 'Evolução: ' + evolution)
+  extra.exams?.forEach((_, i) =>
+    add(
+      'pacientes.p1.exames_pedidos.' + i,
+      'Exames: ' + extra.exams!.join('; ')
+    )
+  )
+  if (pending)
+    add(
+      'pendencias.t1.descricao',
+      'Pendência: ' + pending + (time ? ' às ' + time : '')
+    )
+  if (time) add('pendencias.t1.quando', 'Pendência: ' + pending + ' às ' + time)
+  return {
+    raw: parts.join(' '),
+    response: {
+      schemaVersion: 2,
+      pacientes: [
+        {
+          localRef: 'p1',
+          nome: name,
+          id,
+          leito: bed,
+          especie: extra.species ?? null,
+          tutor: extra.tutor ?? null,
+          motivo: extra.reason ?? null,
+          evolucao: evolution,
+          exames_pedidos: extra.exams ?? [],
+          condutas: []
+        }
+      ],
+      pendencias: pending
+        ? [
+            {
+              localRef: 't1',
+              descricao: pending,
+              pacienteRef: 'p1',
+              pacienteId: id,
+              quando: time ? '2026-10-01T' + time + ':00-03:00' : null
+            }
+          ]
+        : [],
+      duvidas: [],
+      evidence
+    }
+  }
+}
