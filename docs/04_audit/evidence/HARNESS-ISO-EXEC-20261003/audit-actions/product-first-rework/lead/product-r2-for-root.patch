+  return fs.mkdtempSync(join(tmpdir(), 'product-vertical-'))
+}
+function bind(s: Server) {
+  return new Promise<string>((resolve) =>
+    s.listen(0, '127.0.0.1', () =>
+      resolve(`http://127.0.0.1:${(s.address() as AddressInfo).port}`)
+    )
