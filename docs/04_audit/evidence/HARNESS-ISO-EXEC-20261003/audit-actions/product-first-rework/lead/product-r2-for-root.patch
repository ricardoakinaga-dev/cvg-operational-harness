+  closers.push(() => closeServer(receiver))
+  const client: WhatsAppClient =
+    o.provider === 'evolution'
+      ? new EvolutionClient({
+          baseUrl: base,
+          instance: 'fixture',
+          apiKey: 'synthetic',
+          fetch: async (u, i) => fetch(u, i),
