+    text.replace(fieldNumericPattern, (literal, at: number) => {
+      const value = numeralValue(literal)
+      const before = text.slice(0, at),
+        after = text.slice(at + literal.length)
+      // Do not partially canonicalize signed quantities, fractions, intervals,
+      // percentages, exponents or decimals outside C2 by converting their pieces.
+      const compound =
+        /[-+/%^.,]\s*$/u.test(before) ||
+        /^\s*[-+/%^.,]\s*[\p{L}\p{N}]/u.test(after) ||
+        /^\s*[/%^]/u.test(after) ||
+        /(?:menos|mais|a|até)\s$/iu.test(before) ||
+        /^\s+(?:por cento|a|até)\s?/iu.test(after)
