+function commit(store: ShiftStore, id: string, e: V2Event) {
+  const expected: CommitExpected = {}
+  for (const [entity, key] of store.references(e)) {
+    expected[entity] ??= {}
+    expected[entity]![String(key)] = store.revision(entity, key)
+  }
+  return store.commit({ transitionId: id, expected, changes: [e] })
