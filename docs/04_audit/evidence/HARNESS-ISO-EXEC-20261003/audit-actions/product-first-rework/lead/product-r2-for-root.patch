+        path + '.json',
+        Buffer.from(canonical(parsed) + '\n'),
+        this.io
+      )
+      this.io.checkpoint?.('after_media_sidecar_sync')
+      return parsed
+    } catch (error) {
+      this.fail(error)
+      throw new StoreError('STORAGE_UNAVAILABLE')
+    }
+  }
+  verifyMedia(path: string): MediaDescriptor {
+    const full = safePath(this.root, path)
+    const data = mediaDescriptor.parse(
+      decodeJSON(fs.readFileSync(full + '.json'))
+    )
+    if (
+      data.path !== path ||
+      fs.statSync(full).size !== data.bytes ||
+      fileHash(full) !== data.sha256
+    )
+      throw new StoreError('STORAGE_UNAVAILABLE')
+    return data
+  }
+  mediaInventory(): { valid: MediaDescriptor[]; retained: string[] } {
+    const valid: MediaDescriptor[] = []
+    const retained: string[] = []
+    for (const name of fs.readdirSync(join(this.root, 'media'))) {
