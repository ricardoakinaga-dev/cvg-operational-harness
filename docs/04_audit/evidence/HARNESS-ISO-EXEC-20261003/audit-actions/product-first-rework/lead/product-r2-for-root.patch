+      if (e.error) b.error = e.error
+      if (e.state === 'provider_accepted' && b.taskNumber) {
+        const t = s.tasks.get(b.taskNumber)
+        if (t && t.generation === b.taskGeneration) t.remindedCount++
+      }
+      break
+    }
+  }
+}
+export function inputDigest(
