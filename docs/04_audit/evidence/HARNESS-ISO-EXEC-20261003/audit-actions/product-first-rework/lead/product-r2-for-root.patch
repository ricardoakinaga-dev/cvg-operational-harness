+          syncDir(this.root)
+        }
+      } catch (error) {
+        // A partial lock cannot be identified by its UUID. Preserve it for operator review.
+        this.fail(error)
+      } finally {
+        fs.closeSync(this.#lockFd)
+        this.#lockFd = undefined
+      }
+    }
+  }
+}
