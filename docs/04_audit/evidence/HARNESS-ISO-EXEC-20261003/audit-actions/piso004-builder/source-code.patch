+export const MAX_V2_LINE = 1024 * 1024
+export const MAX_V1_LINE = 128 * 1024 * 1024
+
+export function sha256(bytes: string | Uint8Array): string {
+  return createHash('sha256').update(bytes).digest('hex')
+}
+export const EMPTY_SHA256 = sha256(Buffer.alloc(0))
+
+export function canonical(value: unknown): string {
+  if (value === null || typeof value === 'string' || typeof value === 'boolean')
+    return JSON.stringify(value)
+  if (typeof value === 'number' && Number.isFinite(value))
+    return JSON.stringify(value)
+  if (Array.isArray(value)) return '[' + value.map(canonical).join(',') + ']'
+  if (
+    typeof value === 'object' &&
+    Object.getPrototypeOf(value) === Object.prototype
+  ) {
+    const record = value as Record<string, unknown>
+    return (
+      '{' +
+      Object.keys(record)
+        .sort()
+        .map((key) => JSON.stringify(key) + ':' + canonical(record[key]))
+        .join(',') +
+      '}'
+    )
+  }
+  throw new StoreError('INVALID_TRANSITION')
+}
+
+export interface JournalIO {
+  write?: (
+    fd: number,
+    bytes: Uint8Array,
+    offset: number,
+    length: number
+  ) => number
+  sync?: (fd: number) => void
+  checkpoint?: (point: string) => void
+}
+export function syncDir(path: string, io: JournalIO = {}): void {
+  const fd = fs.openSync(
+    path,
+    fs.constants.O_RDONLY | fs.constants.O_DIRECTORY | fs.constants.O_NOFOLLOW
+  )
+  try {
+    ;(io.sync ?? fs.fsyncSync)(fd)
+  } finally {
+    fs.closeSync(fd)
+  }
+}
+export function writeAll(
+  fd: number,
+  bytes: Uint8Array,
+  io: JournalIO = {}
+): void {
+  let offset = 0
+  while (offset < bytes.length) {
+    const written = io.write
+      ? io.write(fd, bytes, offset, bytes.length - offset)
+      : fs.writeSync(fd, bytes, offset, bytes.length - offset)
+    if (
+      !Number.isInteger(written) ||
+      written <= 0 ||
+      written > bytes.length - offset
+    )
+      throw new StoreError('STORAGE_UNAVAILABLE')
+    offset += written
+  }
+}
+export function exclusiveFile(
+  path: string,
+  bytes: Uint8Array,
+  io: JournalIO = {}
+): void {
+  const fd = fs.openSync(
+    path,
+    fs.constants.O_WRONLY |
+      fs.constants.O_CREAT |
+      fs.constants.O_EXCL |
+      fs.constants.O_NOFOLLOW,
+    0o600
+  )
+  try {
+    writeAll(fd, bytes, io)
+    ;(io.sync ?? fs.fsyncSync)(fd)
+  } finally {
+    fs.closeSync(fd)
+  }
+  syncDir(dirname(path), io)
+}
+export function safePath(root: string, path: string): string {
+  relative.parse(path)
+  let current = resolve(root)
+  for (const part of path.split('/')) {
+    current = join(current, part)
+    // lstat catches dangling symlinks too.
+    try {
+      if (fs.lstatSync(current).isSymbolicLink())
+        throw new StoreError('STORAGE_UNAVAILABLE', 'Symlink in storage path')
+    } catch (error) {
+      if ((error as NodeJS.ErrnoException).code !== 'ENOENT') throw error
+    }
+  }
+  return current
+}
+export function fileHash(path: string, bytes?: number): string {
+  const fd = fs.openSync(path, fs.constants.O_RDONLY | fs.constants.O_NOFOLLOW)
+  const digest = createHash('sha256')
+  const buffer = Buffer.alloc(64 * 1024)
+  let offset = 0
+  try {
+    const total = bytes ?? fs.fstatSync(fd).size
+    while (offset < total) {
+      const count = fs.readSync(
+        fd,
+        buffer,
+        0,
+        Math.min(buffer.length, total - offset),
+        offset
+      )
+      if (!count) throw new StoreError('STORAGE_UNAVAILABLE')
+      digest.update(buffer.subarray(0, count))
+      offset += count
+    }
+  } finally {
+    fs.closeSync(fd)
+  }
+  return digest.digest('hex')
+}
+export function copySynced(
+  source: string,
+  destination: string,
+  io: JournalIO = {},
+  start = 0
+): void {
+  const input = fs.openSync(
+    source,
+    fs.constants.O_RDONLY | fs.constants.O_NOFOLLOW
+  )
+  let output: number | undefined
+  try {
+    output = fs.openSync(
+      destination,
+      fs.constants.O_WRONLY |
+        fs.constants.O_CREAT |
+        fs.constants.O_EXCL |
+        fs.constants.O_NOFOLLOW,
+      0o600
+    )
+    const buffer = Buffer.alloc(64 * 1024)
+    let offset = start
+    while (true) {
+      const count = fs.readSync(input, buffer, 0, buffer.length, offset)
+      if (!count) break
+      writeAll(output, buffer.subarray(0, count), io)
+      offset += count
+    }
+    ;(io.sync ?? fs.fsyncSync)(output)
+  } finally {
+    fs.closeSync(input)
+    if (output !== undefined) fs.closeSync(output)
+  }
+  syncDir(dirname(destination), io)
+  if (start === 0 && fileHash(source) !== fileHash(destination))
+    throw new StoreError('STORAGE_UNAVAILABLE')
+}
