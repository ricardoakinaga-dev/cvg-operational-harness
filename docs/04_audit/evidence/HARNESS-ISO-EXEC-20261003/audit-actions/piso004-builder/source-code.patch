+export type RevisionEntity =
+  | 'inbox'
+  | 'notes'
+  | 'tasks'
+  | 'outbox'
+  | 'operation'
+export type CommitExpected = Partial<
+  Record<RevisionEntity, Record<string, number>>
+>
+export interface CommitRequest {
+  transitionId: string
+  expected: CommitExpected
+  changes: readonly ShiftEvent[]
+}
+export interface CommitResult {
+  seq: number
+  sha256: string
+}
+export interface StoreOptions extends MigrationOptions {
+  io?: JournalIO
+}
+
+function affected(event: JournalEvent): [RevisionEntity, string | number][] {
+  switch (event.type) {
+    case 'message_received':
+      return [['inbox', event.message.messageId]]
+    case 'message_processed':
+      return [['inbox', event.messageId]]
+    case 'note_created':
+      return [
+        ['notes', event.note.id],
+        ['inbox', event.note.messageId]
+      ]
+    case 'note_confirmed':
+      return [['notes', event.noteId]]
+    case 'note_superseded':
+      return [
+        ['notes', event.noteId],
+        ['notes', event.by]
+      ]
+    case 'task_created':
+      return [
+        ['tasks', event.task.number],
+        ...(event.task.noteId
+          ? [['notes', event.task.noteId] as [RevisionEntity, string]]
+          : [])
+      ]
+    case 'task_done':
+    case 'task_cancelled':
+    case 'task_snoozed':
+    case 'task_reminded':
+      return [['tasks', event.number]]
+    case 'paused':
+    case 'resumed':
+      return [['operation', 'state']]
+    case 'migration_applied':
+    case 'recovery_recorded':
+      return []
+  }
+}
