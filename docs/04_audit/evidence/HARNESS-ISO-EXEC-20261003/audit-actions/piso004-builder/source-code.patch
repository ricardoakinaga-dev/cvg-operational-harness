+        this.seq = transaction.seq
+        this.head = transaction.sha256
+        this.transitions.set(transaction.transitionId, transaction)
+        prefixBytes = line.end
+      }
+    }
+    for (const segment of this.manifest!.segments) {
+      const fd = fs.openSync(
+        safePath(this.root, segment.path),
+        fs.constants.O_RDONLY | fs.constants.O_NOFOLLOW
+      )
+      try {
+        ;(this.io.sync ?? fs.fsyncSync)(fd)
+      } finally {
+        fs.closeSync(fd)
+      }
+    }
+    const pending = this.manifest!.pendingRecovery
+    if (pending) {
+      const id =
+        'recovery:' + pending.originalSha256 + ':' + pending.prefixBytes
+      if (!this.transitions.has(id)) apply(this.append(id, [pending]))
+    }
+  }
+  isolateTail(segment: z.infer<typeof descriptor>, prefixBytes: number): void {
+    const manifest = this.manifest!
+    const original = safePath(this.root, segment.path)
+    const originalSha256 = fileHash(original)
+    const dir = 'recovery/' + randomUUID()
+    fs.mkdirSync(safePath(this.root, dir))
+    syncDir(join(this.root, 'recovery'), this.io)
+    const copyPath = dir + '/original-' + originalSha256 + '.jsonl'
+    const tailPath = dir + '/tail.jsonl'
+    copySynced(original, safePath(this.root, copyPath), this.io)
+    copySynced(original, safePath(this.root, tailPath), this.io, prefixBytes)
+    const prefixSha256 = fileHash(original, prefixBytes)
+    const pendingRecovery: z.infer<typeof recoveryEvent> = {
+      type: 'recovery_recorded',
+      at: new Date().toISOString(),
+      originalPath: segment.path,
+      originalSha256,
+      copyPath,
+      tailPath,
+      prefixBytes,
+      prefixSha256,
+      reason: 'NONDELIMITED_TAIL'
+    }
+    this.io.checkpoint?.('recovery_copies_synced')
+    this.publishManifest({
+      ...manifest,
+      revision: manifest.revision + 1,
+      segments: manifest.segments
+        .map((item) =>
+          item.path === segment.path
+            ? {
+                ...item,
+                bytes: prefixBytes,
+                prefixSha256,
+                sealed: true,
+                fullSha256: originalSha256,
+                reason: 'NONDELIMITED_TAIL'
+              }
+            : item
+        )
+        .concat(this.newSegment()),
+      pendingRecovery
+    })
+    this.diagnostic = 'NONDELIMITED_TAIL_RETAINED'
+  }
+  append(
+    transitionId: string,
+    changes: readonly JournalEvent[]
+  ): JournalTransaction {
+    this.assertWritable()
+    const body = {
+      v: 2 as const,
+      seq: this.seq + 1,
+      transitionId,
+      at: changes[0]!.at,
+      prevSha256: this.head,
+      changes: [...changes]
+    }
+    const transaction = transactionSchema.parse({
+      ...body,
+      sha256: sha256(canonical(body))
+    })
+    const bytes = Buffer.from(canonical(transaction) + '\n')
+    if (bytes.length > MAX_V2_LINE)
+      throw new StoreError('INVALID_TRANSITION', 'Record exceeds V2 budget')
+    try {
+      if (this.#activeFd === undefined)
+        this.#activeFd = fs.openSync(
+          safePath(this.root, this.manifest!.segments.at(-1)!.path),
+          fs.constants.O_WRONLY |
+            fs.constants.O_APPEND |
+            fs.constants.O_NOFOLLOW
+        )
+      this.io.checkpoint?.('before_journal_write')
+      writeAll(this.#activeFd, bytes, this.io)
+      this.io.checkpoint?.('after_journal_lf')
+      ;(this.io.sync ?? fs.fsyncSync)(this.#activeFd)
+      this.io.checkpoint?.('after_journal_sync')
+      this.seq = transaction.seq
+      this.head = transaction.sha256
+      this.transitions.set(transitionId, transaction)
+      return transaction
+    } catch (error) {
+      this.fail(error)
+      throw new StoreError('STORAGE_UNAVAILABLE')
+    }
+  }
+  verifyRecovery(
+    event: Extract<JournalEvent, { type: 'recovery_recorded' }>
+  ): void {
+    const original = safePath(this.root, event.originalPath)
+    const copy = safePath(this.root, event.copyPath)
+    const tail = safePath(this.root, event.tailPath)
+    if (
+      fileHash(original) !== event.originalSha256 ||
+      fileHash(copy) !== event.originalSha256 ||
+      fileHash(original, event.prefixBytes) !== event.prefixSha256 ||
+      fs.statSync(tail).size !== fs.statSync(original).size - event.prefixBytes
+    )
+      throw new StoreError('STORAGE_UNAVAILABLE')
+    const source = fs.openSync(
+      original,
+      fs.constants.O_RDONLY | fs.constants.O_NOFOLLOW
+    )
+    const target = fs.openSync(
+      tail,
+      fs.constants.O_RDONLY | fs.constants.O_NOFOLLOW
+    )
+    try {
+      const a = Buffer.alloc(64 * 1024)
+      const b = Buffer.alloc(64 * 1024)
+      let offset = 0
+      while (offset < fs.fstatSync(target).size) {
+        const count = fs.readSync(target, b, 0, b.length, offset)
+        if (
+          fs.readSync(source, a, 0, count, event.prefixBytes + offset) !==
+            count ||
+          !a.subarray(0, count).equals(b.subarray(0, count))
+        )
+          throw new StoreError('STORAGE_UNAVAILABLE')
+        offset += count
+      }
+    } finally {
+      fs.closeSync(source)
+      fs.closeSync(target)
+    }
+  }
+
+  saveMedia(
+    bytes: Uint8Array,
+    mime: MediaDescriptor['mime'],
+    messageKey: string
+  ): MediaDescriptor {
+    this.assertWritable()
+    const extensions: Record<MediaDescriptor['mime'], string> = {
+      'audio/ogg': 'ogg',
+      'audio/mpeg': 'mp3',
+      'audio/mp4': 'm4a',
+      'audio/wav': 'wav',
+      'image/jpeg': 'jpg',
+      'image/png': 'png',
+      'application/octet-stream': 'bin'
+    }
+    const parsed = mediaDescriptor.parse({
+      messageKey,
+      mime,
+      bytes: bytes.length,
+      sha256: sha256(bytes),
+      path: 'media/' + randomUUID() + '.' + extensions[mime],
+      stage: 'published'
+    })
+    const path = safePath(this.root, parsed.path)
+    try {
+      const temporary = safePath(this.root, 'media/' + randomUUID() + '.tmp')
+      this.io.checkpoint?.('before_media_write')
+      exclusiveFile(temporary, bytes, this.io)
+      this.io.checkpoint?.('after_media_sync')
+      exclusiveFile(path, Buffer.alloc(0), this.io)
+      fs.renameSync(temporary, path)
+      syncDir(join(this.root, 'media'), this.io)
+      exclusiveFile(
+        path + '.json',
+        Buffer.from(canonical(parsed) + '\n'),
+        this.io
+      )
+      this.io.checkpoint?.('after_media_sidecar_sync')
+      return parsed
+    } catch (error) {
+      this.fail(error)
+      throw new StoreError('STORAGE_UNAVAILABLE')
+    }
+  }
+  verifyMedia(path: string): MediaDescriptor {
+    const full = safePath(this.root, path)
+    const data = mediaDescriptor.parse(
+      decodeJSON(fs.readFileSync(full + '.json'))
+    )
+    if (
+      data.path !== path ||
+      fs.statSync(full).size !== data.bytes ||
+      fileHash(full) !== data.sha256
+    )
+      throw new StoreError('STORAGE_UNAVAILABLE')
+    return data
+  }
+  mediaInventory(): { valid: MediaDescriptor[]; retained: string[] } {
+    const valid: MediaDescriptor[] = []
+    const retained: string[] = []
+    for (const name of fs.readdirSync(join(this.root, 'media'))) {
+      const path = 'media/' + name
+      if (!name.endsWith('.json')) {
+        retained.push(path)
+        continue
+      }
+      try {
+        valid.push(this.verifyMedia(path.slice(0, -5)))
+      } catch {
+        retained.push(path)
+      }
+    }
+    return { valid, retained }
+  }
+  close(): void {
+    if (this.#closed) return
+    this.#closed = true
+    if (this.#activeFd !== undefined) fs.closeSync(this.#activeFd)
+    if (this.#lockFd !== undefined) {
+      const path = safePath(this.root, 'store.lock')
+      try {
+        const record = decodeJSON(fs.readFileSync(path)) as {
+          instanceId?: string
+        }
+        if (
+          record.instanceId === this.instanceId &&
+          fs.statSync(path).ino === fs.fstatSync(this.#lockFd).ino
+        ) {
+          fs.unlinkSync(path)
+          syncDir(this.root)
+        }
+      } catch (error) {
+        // A partial lock cannot be identified by its UUID. Preserve it for operator review.
+        this.fail(error)
+      } finally {
+        fs.closeSync(this.#lockFd)
+        this.#lockFd = undefined
+      }
+    }
+  }
+}
