+/** Bounded byte streaming; only LF-delimited records are decoded. */
+export function* lines(
+  path: string,
+  max: number,
+  limit?: number
+): Generator<{ bytes: Buffer; end: number; delimited: boolean }> {
+  const fd = fs.openSync(path, fs.constants.O_RDONLY | fs.constants.O_NOFOLLOW)
+  let offset = 0
+  let length = 0
+  let chunks: Buffer[] = []
+  const buffer = Buffer.alloc(64 * 1024)
+  try {
+    const total = limit ?? fs.fstatSync(fd).size
+    while (offset < total) {
+      const count = fs.readSync(
+        fd,
+        buffer,
+        0,
+        Math.min(buffer.length, total - offset),
+        offset
+      )
+      if (!count) throw new StoreError('STORAGE_UNAVAILABLE')
+      let begin = 0
+      for (let i = 0; i < count; i++) {
+        if (buffer[i] !== 10) continue
+        const part = Buffer.from(buffer.subarray(begin, i))
+        length += part.length
+        if (length + 1 > max)
+          throw new StoreError(
+            'STORAGE_UNAVAILABLE',
+            'Record exceeds replay budget'
+          )
+        chunks.push(part)
+        yield {
+          bytes: Buffer.concat(chunks, length),
+          end: offset + i + 1,
+          delimited: true
+        }
+        chunks = []
+        length = 0
+        begin = i + 1
+      }
+      const part = Buffer.from(buffer.subarray(begin, count))
+      length += part.length
+      if (length > max)
+        throw new StoreError(
+          'STORAGE_UNAVAILABLE',
+          'Record exceeds replay budget'
+        )
+      if (part.length) chunks.push(part)
+      offset += count
+    }
+    if (length)
+      yield {
+        bytes: Buffer.concat(chunks, length),
+        end: offset,
+        delimited: false
+      }
+  } finally {
+    fs.closeSync(fd)
+  }
+}
+export function decodeJSON(bytes: Uint8Array): unknown {
+  return JSON.parse(new TextDecoder('utf-8', { fatal: true }).decode(bytes))
+}
+
+export class Journal {
+  readonly root: string
+  readonly io: JournalIO
+  readonly instanceId = randomUUID()
+  manifest: JournalManifest | undefined
+  seq = 0
+  head = EMPTY_SHA256
+  available = true
+  diagnostic: string | undefined
+  readonly transitions = new Map<string, JournalTransaction>()
+  #lockFd: number | undefined
+  #activeFd: number | undefined
+  #closed = false
+
+  constructor(root: string, io: JournalIO = {}) {
+    this.root = resolve(root)
+    this.io = io
+    fs.mkdirSync(this.root, { recursive: true })
+    if (fs.lstatSync(this.root).isSymbolicLink())
+      throw new StoreError('STORAGE_UNAVAILABLE')
+    const lockPath = safePath(this.root, 'store.lock')
+    try {
+      this.#lockFd = fs.openSync(
+        lockPath,
+        fs.constants.O_WRONLY |
+          fs.constants.O_CREAT |
+          fs.constants.O_EXCL |
+          fs.constants.O_NOFOLLOW,
+        0o600
+      )
+    } catch (error) {
+      if ((error as NodeJS.ErrnoException).code === 'EEXIST')
+        throw new StoreError('STORE_LOCKED')
+      throw new StoreError('STORAGE_UNAVAILABLE')
+    }
+    try {
+      const bootId = fs
+        .readFileSync('/proc/sys/kernel/random/boot_id', 'utf8')
+        .trim()
+      writeAll(
+        this.#lockFd,
+        Buffer.from(
+          canonical({ instanceId: this.instanceId, pid: process.pid, bootId })
+        ),
+        io
+      )
+      ;(io.sync ?? fs.fsyncSync)(this.#lockFd)
+      syncDir(this.root, io)
+      for (const dir of ['journal', 'media', 'recovery', 'journal/manifests']) {
+        fs.mkdirSync(safePath(this.root, dir), { recursive: true })
+        syncDir(dirname(join(this.root, dir)), io)
+      }
+      const path = safePath(this.root, 'journal/manifest.json')
+      if (fs.existsSync(path)) {
+        this.manifest = manifestSchema.parse(decodeJSON(fs.readFileSync(path)))
+        const prior = safePath(
+          this.root,
+          'journal/manifests/revision-' + this.manifest.revision + '.json'
+        )
+        if (!fs.existsSync(prior) || fileHash(prior) !== fileHash(path))
+          throw new StoreError('STORAGE_UNAVAILABLE', 'Divergent manifest')
+      }
+    } catch (error) {
+      this.fail(error)
+    }
+  }
+  fail(error: unknown): void {
+    this.available = false
+    this.diagnostic =
+      error instanceof StoreError ? error.code : 'STORAGE_UNAVAILABLE'
+  }
+  assertWritable(): void {
+    if (!this.available || this.#closed)
+      throw new StoreError('STORAGE_UNAVAILABLE')
+  }
+  initialize(
+    legacy?: z.infer<typeof descriptor>,
+    record?: MigrationRecord,
+    pendingRecovery?: JournalManifest['pendingRecovery']
+  ): void {
+    this.assertWritable()
+    const segment = this.newSegment()
+    this.publishManifest({
+      v: 2,
+      journalId: randomUUID(),
+      revision: 1,
+      ...(legacy ? { legacy } : {}),
+      ...(record ? { migration: record } : {}),
+      segments: [segment],
+      ...(pendingRecovery ? { pendingRecovery } : {})
+    })
+    this.head = legacy?.prefixSha256 ?? EMPTY_SHA256
+  }
+  newSegment(): z.infer<typeof descriptor> {
+    const path = 'journal/segment-' + randomUUID() + '.jsonl'
+    exclusiveFile(safePath(this.root, path), Buffer.alloc(0), this.io)
+    this.io.checkpoint?.('segment_synced')
+    return { path, bytes: 0, prefixSha256: EMPTY_SHA256, sealed: false }
+  }
+  publishManifest(candidate: JournalManifest): void {
+    const parsed = manifestSchema.parse(candidate)
+    const bytes = Buffer.from(canonical(parsed) + '\n')
+    const prior = safePath(
+      this.root,
+      'journal/manifests/revision-' + parsed.revision + '.json'
+    )
+    exclusiveFile(prior, bytes, this.io)
+    const tmp = safePath(this.root, 'journal/manifest-' + randomUUID() + '.tmp')
+    exclusiveFile(tmp, bytes, this.io)
+    this.io.checkpoint?.('before_manifest_rename')
+    fs.renameSync(tmp, safePath(this.root, 'journal/manifest.json'))
+    this.io.checkpoint?.('after_manifest_rename')
+    syncDir(join(this.root, 'journal'), this.io)
+    this.manifest = parsed
+  }
+  verifyDescriptor(item: z.infer<typeof descriptor>): void {
+    const path = safePath(this.root, item.path)
+    if (
+      !fs.statSync(path).isFile() ||
+      fs.statSync(path).size < item.bytes ||
+      fileHash(path, item.bytes) !== item.prefixSha256 ||
+      (item.sealed && (!item.fullSha256 || fileHash(path) !== item.fullSha256))
+    )
+      throw new StoreError('STORAGE_UNAVAILABLE')
+  }
+  replay(apply: (transaction: JournalTransaction) => void): void {
+    this.assertWritable()
+    const manifest = this.manifest
+    if (
+      !manifest ||
+      manifest.segments.at(-1)!.sealed ||
+      new Set(manifest.segments.map((s) => s.path)).size !==
+        manifest.segments.length ||
+      manifest.segments.some(
+        (s) => !/^journal\/segment-[a-f0-9-]+\.jsonl$/.test(s.path)
+      ) ||
+      (manifest.legacy &&
+        (manifest.legacy.path !== 'events.jsonl' || !manifest.migration)) ||
+      (!manifest.legacy && manifest.migration)
+    )
+      throw new StoreError('STORAGE_UNAVAILABLE')
+    this.head = manifest.legacy?.prefixSha256 ?? EMPTY_SHA256
+    if (manifest.legacy) this.verifyDescriptor(manifest.legacy)
+    for (let index = 0; index < manifest.segments.length; index++) {
+      const segment = manifest.segments[index]!
+      this.verifyDescriptor(segment)
+      if (!segment.sealed && index !== manifest.segments.length - 1)
+        throw new StoreError('STORAGE_UNAVAILABLE')
+      let prefixBytes = 0
+      for (const line of lines(
+        safePath(this.root, segment.path),
+        MAX_V2_LINE,
+        segment.sealed ? segment.bytes : undefined
+      )) {
+        if (!line.delimited) {
+          this.isolateTail(segment, prefixBytes)
+          break
+        }
+        const transaction = transactionSchema.parse(decodeJSON(line.bytes))
+        const { sha256: checksum, ...body } = transaction
+        if (
+          transaction.seq !== this.seq + 1 ||
+          transaction.prevSha256 !== this.head ||
+          sha256(canonical(body)) !== checksum ||
+          this.transitions.has(transaction.transitionId)
+        )
+          throw new StoreError('STORAGE_UNAVAILABLE')
