+// @vitest-environment node
+import * as fs from 'node:fs'
+import { createServer, type Server } from 'node:http'
+import type { AddressInfo } from 'node:net'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { afterEach, describe, expect, it, vi } from 'vitest'
+import { ShiftAssistant } from '../assistant.ts'
+import { ShiftStore } from '../store.ts'
+import { ModelOrganizer, type Organizer } from '../organizer.ts'
+import { WahaClient, EvolutionClient } from '../whatsapp.ts'
+import { buildShiftServer } from '../server.ts'
+import { canonical, sha256 } from '../journal.ts'
+import { RAW, RESPONSE } from './vertical-test-fixture.ts'
+
+const PHONE = '5511900000001'
+const SECRET = 'synthetic-pv10-webhook-12345'
+const AT = '2026-10-03T18:00:00.000Z'
+const DELAYS = [30000, 120000, 600000, 1800000]
+const closers: (() => Promise<void> | void)[] = []
+afterEach(async () => {
+  for (const close of closers.splice(0).reverse()) await close()
+})
+const bind = (server: Server) =>
+  new Promise<string>((resolve) =>
+    server.listen(0, '127.0.0.1', () =>
+      resolve('http://127.0.0.1:' + (server.address() as AddressInfo).port)
+    )
+  )
+const closeServer = (server: Server) =>
+  new Promise<void>((resolve) => {
+    server.closeAllConnections()
+    server.close(() => resolve())
+  })
+async function setup(
+  provider: 'waha' | 'evolution',
+  organizer: Organizer,
+  dir = fs.mkdtempSync(join(tmpdir(), 'cvg-pv10-'))
+) {
+  let now = new Date(AT)
+  const sent: unknown[] = []
+  const receiver = createServer((req, res) => {
+    void (async () => {
+      let body = ''
+      for await (const chunk of req) body += String(chunk)
+      sent.push(JSON.parse(body))
+      res.writeHead(201, { 'content-type': 'application/json' })
+      res.end(JSON.stringify({ id: 'receipt', key: { id: 'receipt' } }))
+    })()
+  })
+  const baseUrl = await bind(receiver)
+  closers.push(() => closeServer(receiver))
+  const options = {
+    baseUrl,
+    session: 'pv10',
+    instance: 'pv10',
+    apiKey: 'synthetic',
+    fetch: async (url: string, init?: RequestInit) => fetch(url, init)
+  }
+  const whatsapp =
+    provider === 'waha' ? new WahaClient(options) : new EvolutionClient(options)
+  const store = new ShiftStore(dir)
+  closers.push(() => store.close())
+  const transcribe = vi.fn(async () => RAW)
+  const assistant = new ShiftAssistant({
+    store,
+    whatsapp,
+    organizer,
+    members: [
+      { phone: PHONE, name: 'Ana', manager: false },
+      { phone: '5511900000009', name: 'Manager', manager: true }
+    ],
+    transcriber: { transcribe },
+    clock: () => now
+  })
+  closers.push(() => assistant.stop())
+  const server = buildShiftServer({
+    store,
+    assistant,
+    whatsapp,
+    webhookSecret: SECRET,
+    clock: () => now
+  })
+  const url = await bind(server)
+  closers.push(() => closeServer(server))
+  const post = async (id: string, text = RAW, audio = false) => {
+    const response = await fetch(url + '/webhooks/' + provider, {
+      method: 'POST',
+      headers: {
+        'content-type': 'application/json',
+        'x-cvg-webhook-secret': SECRET
+      },
+      body: JSON.stringify(
+        provider === 'waha'
+          ? {
+              event: 'message',
+              session: 'pv10',
+              payload: {
+                id,
+                from: PHONE + '@c.us',
+                body: audio ? '' : text,
+                ...(audio
+                  ? {
+                      hasMedia: true,
+                      media: { mimetype: 'audio/ogg', url: baseUrl + '/audio' }
+                    }
+                  : {})
+              }
+            }
+          : {
+              event: 'messages.upsert',
+              instance: 'pv10',
+              data: {
+                key: { id, remoteJid: PHONE + '@s.whatsapp.net' },
+                message: audio
+                  ? { audioMessage: { mimetype: 'audio/ogg' } }
+                  : { conversation: text }
+              }
+            }
+      )
+    })
+    return { status: response.status, ack: await response.json() }
+  }
+  const say = async (id: string, text = RAW) => {
+    const result = await post(id, text)
+    await assistant.idle()
+    return result
+  }
+  return {
+    dir,
+    store,
+    assistant,
+    whatsapp,
+    server,
+    sent,
+    transcribe,
+    post,
+    say,
+    advance(ms: number) {
+      now = new Date(+now + ms)
+    }
+  }
+}
+function events(dir: string) {
+  const manifest = JSON.parse(
+    fs.readFileSync(join(dir, 'journal/manifest.json'), 'utf8')
+  )
+  return manifest.segments.flatMap((segment: { path: string }) =>
+    fs
+      .readFileSync(join(dir, segment.path), 'utf8')
+      .split('\n')
+      .filter(Boolean)
+      .flatMap((line) => JSON.parse(line).changes)
+  )
+}
+function terminal(
+  e: Awaited<ReturnType<typeof setup>>,
+  error: string,
+  attempt = 1
+) {
+  const inbox = e.store.inboxes().at(-1)!
+  expect(inbox).toMatchObject({
+    state: 'review_required',
+    error,
+    attempt,
+    stage: 'organize',
+    draftAt: AT
+  })
+  expect(inbox.nextAttemptAt).toBeUndefined()
+  expect(e.store.tasksV2()).toEqual([])
+  expect(e.store.notesV2()).toEqual([])
+  const failure = events(e.dir).findLast(
+    (event: { type: string }) => event.type === 'processing_retry_scheduled'
+  )
+  expect(failure).toMatchObject({
+    key: inbox.key,
+    state: 'review_required',
+    error,
+    attempt
+  })
+  expect(failure.outbox).toMatchObject({ purpose: 'response' })
+  expect(e.store.outbox(failure.outbox.id)?.state).toBe('provider_accepted')
+  expect(
+    events(e.dir).some(
+      (event: { type: string }) => event.type === 'draft_prepared'
+    )
+  ).toBe(false)
+  return inbox
+}
