+        (values.id ? ', ID ' + values.id : '') +
+        (values.leito ? ', leito ' + values.leito : '') +
+        '. Evolução: alerta.'
+      const response: OrganizedV2 = structuredClone(RESPONSE)
+      response.pendencias = []
+      const p = response.pacientes[0]!
+      p.id = values.id
+      p.leito = values.leito
+      p.nome = values.nome ?? 'Rex'
+      if (output === 'omitted') Reflect.deleteProperty(p, field)
+      else if (output === 'null') Object.assign(p, { [field]: null })
+      else
+        Object.assign(p, {
+          [field]:
+            output === 'coincident'
+              ? (values[field] ?? sourceValues[field])
+              : otherValues[field] === values[field]
+                ? sourceValues[field]
+                : otherValues[field]
+        })
+      const anchor = raw.split('. ')[0]!
+      response.evidence = [
+        { path: 'pacientes.p1.nome', patientRef: 'p1', quote: anchor },
+        {
+          path: 'pacientes.p1.evolucao',
+          patientRef: 'p1',
+          quote: 'Evolução: alerta'
+        }
+      ]
+      for (const f of ['id', 'leito'] as const)
+        if (p[f])
+          response.evidence.push({
+            path: 'pacientes.p1.' + f,
+            patientRef: 'p1',
+            quote: (f === 'id' ? 'ID ' : 'leito ') + p[f]
+          })
+      if (field === 'nome' && ['omitted', 'null'].includes(output)) {
+        // Name is required by the strict V2 schema, so omission never reaches memory.
+        expect(() => parseOrganizerResponse(response)).toThrow()
+        return
+      }
+      const result = validateOrganization(
+        raw,
+        parseOrganizerResponse(response),
+        [history],
+        at
+      )
+      const matching = output === 'coincident' && source !== 'absent'
+      const safeAbsent =
+        source === 'absent' &&
+        field !== 'nome' &&
+        ['omitted', 'null'].includes(output)
+      const expectedValid =
+        field === 'id'
+          ? matching || safeAbsent
+          : field === 'leito'
+            ? safeAbsent || (matching && source === 'coincident')
+            : matching && source === 'coincident'
+      if (expectedValid) {
+        expect(result.issues).toEqual([])
+        expect(result.bindings[0]?.idLiteral).toBe(
+          field === 'id' && matching ? values.id : '20202'
+        )
+        expect(result.bindings[0]?.provenance).toBe(
+          field === 'id' && matching
+            ? 'source_explicit'
+            : 'confirmed_history_candidate'
+        )
+      } else {
+        expect(result.issues.some((i) => i.severity === 'blocking')).toBe(true)
+        expect(
+          result.bindings.every(
+            (b) =>
+              b.provenance === 'unresolved' && !b.idLiteral && !b.normalizedId
+          )
+        ).toBe(true)
+      }
+    }
+  )
+})
