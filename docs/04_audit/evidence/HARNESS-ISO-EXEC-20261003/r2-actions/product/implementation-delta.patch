+          code: 'UNSOURCED_ID',
+          path: 'pacientes.p1.id',
+          severity: 'blocking'
+        })
+      )
+      expect(result.bindings[0]).toMatchObject({ provenance: 'unresolved' })
+      expect(result.bindings[0]?.idLiteral).toBeUndefined()
+      expect(result.bindings[0]?.normalizedId).toBeUndefined()
+    }
+  )
+  it.each(rows)(
+    '$field / source $source / output $output',
+    ({ field, source, output }) => {
+      const history = confirmedHistory()
+      const sourceValues = { id: '20202', leito: '4', nome: 'Rex' }
+      const otherValues = { id: '99999', leito: '7', nome: 'Lua' }
+      const values: Record<string, string | undefined> = { ...sourceValues }
+      // For the bed/name properties, leave the ID genuinely absent, so the
+      // confirmed-history branch is exercised rather than masked by explicit ID.
+      if (field !== 'id') delete values.id
+      values[field] =
+        source === 'absent'
+          ? undefined
+          : source === 'coincident'
+            ? sourceValues[field]
+            : otherValues[field]
+      const raw =
