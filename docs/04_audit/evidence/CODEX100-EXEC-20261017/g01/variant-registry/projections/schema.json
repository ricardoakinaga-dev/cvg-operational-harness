  "canonical_digest": "UTF8 JSON; sort_keys=True; ensure_ascii=False; separators=(',', ':'); no NaN",
  "identity": "src:SHA256(UTF8(inputpath + NUL + JSONpointer)); <bytes> sentinel for nonJSON",
  "dereference": "input-manifest authenticated by 9 parent manifests + checkpoint474; JSON RFC6901 against full original input, no span copying",
  "binding_selectors": [
    "direct requirement/requirement_id/CDX100 id + DX100 owner",
    "binding.existing_requirements + binding.owner",
    "baseline_record.requirement + owner",
    "entry_requirement + future_variant_family as SURFACE_ENTRY",
    "requirements[] as explicit entry binding",
    "effect_requirement_candidates[] as candidates only",
    "owner_bindings[] as DECLARED_COMPONENT_OWNER; no inferred requirement",
    "requirement_relationship/mapping_status/disposition prefixes PROPOSED_ or CANDIDATE_ retain source links as candidate-only OPEN; all semantic_owner_status OPEN_NOT_QUALIFIED"
  ],
  "qualification": "NOT_RUN; zero functional receipts; no independent approval"
