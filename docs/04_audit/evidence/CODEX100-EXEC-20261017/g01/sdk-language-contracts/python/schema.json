{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Python source-only SDK inventory v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "authenticated_ts_census_not_analyzed",
    "baseline_public_api",
    "baseline_sha256",
    "call_edges",
    "catalog_sha256",
    "census_discrepancy",
    "contract_sha256",
    "counts",
    "definitions",
    "full_codex_parity_claim",
    "full_g01_closure",
    "functional_receipts",
    "imports",
    "lifecycle",
    "limitations",
    "modules",
    "notification_registry",
    "open_gaps",
    "owner_joins",
    "packaging",
    "parent_contract_sha256",
    "pin",
    "previous_packages",
    "receipt",
    "root_exports",
    "rpc",
    "rpc_method_parameters",
    "schema_version",
    "sources",
    "status",
    "task",
    "version_boundary"
  ],
  "properties": {
    "authenticated_ts_census_not_analyzed": {
      "type": "array"
    },
    "baseline_public_api": {
      "type": "array"
    },
    "baseline_sha256": {
      "type": "string"
    },
    "call_edges": {
      "type": "array"
    },
    "catalog_sha256": {
      "type": "string"
    },
    "census_discrepancy": {
      "type": "object"
    },
    "contract_sha256": {
      "const": "d349bb9bbcbb8740db5ba61b029e974df80b808404efa522af4985bd15977740"
    },
    "counts": {
      "type": "object"
    },
    "definitions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "module",
          "kind",
          "source",
          "runtime",
          "type_references"
        ],
        "properties": {
          "source": {
            "$ref": "#/$defs/source_span"
          },
          "kind": {
            "enum": ["class", "function", "value_or_alias"]
          }
        }
      }
    },
    "full_codex_parity_claim": {
      "const": false
    },
    "full_g01_closure": {
      "const": false
    },
    "functional_receipts": {
      "const": 0
    },
    "imports": {
      "type": "array"
    },
    "lifecycle": {
      "type": "array"
    },
    "limitations": {
      "type": "array"
    },
    "modules": {
      "type": "array"
    },
    "notification_registry": {
      "type": "array"
    },
    "open_gaps": {
      "type": "array"
    },
    "owner_joins": {
      "type": "array"
    },
    "packaging": {
      "type": "array"
    },
    "parent_contract_sha256": {
      "const": "182723fb6159aad4c13d769c106d250ab8d7dec0f7edaadc861553a3757ff2a7"
    },
    "pin": {
      "type": "string"
    },
    "previous_packages": {
      "type": "array"
    },
    "receipt": {
      "type": "null"
    },
    "root_exports": {
      "type": "array"
    },
    "rpc": {
      "type": "array"
    },
    "rpc_method_parameters": {
      "type": "array"
    },
    "schema_version": {
      "type": "integer"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "git_blob", "sha256", "bytes", "mode", "scope"]
      }
    },
    "status": {
      "const": "IMPLEMENTED"
    },
    "task": {
      "type": "string"
    },
    "version_boundary": {
      "type": "object"
    }
  },
  "$defs": {
    "source_span": {
      "type": "object",
      "required": [
        "path",
        "byte_start",
        "byte_end",
        "line_start",
        "line_end",
        "sha256",
        "git_blob"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "byte_start": {
          "type": "integer",
          "minimum": 0
        },
        "byte_end": {
          "type": "integer",
          "minimum": 0
        },
        "line_start": {
          "type": "integer",
          "minimum": 1
        },
        "line_end": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "git_blob": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      },
      "additionalProperties": false
    }
  },
  "$comment": "Nested source facts are checked against deterministic regeneration by reader.py --check; no runtime API schema is asserted."
}
