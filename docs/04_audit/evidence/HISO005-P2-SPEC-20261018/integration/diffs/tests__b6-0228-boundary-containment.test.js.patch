diff --git a/tests/b6-0228-boundary-containment.test.js b/tests/b6-0228-boundary-containment.test.js
new file mode 100644
index 0000000000000000000000000000000000000000..adcddcaa2c9f73040ec7a70c93e487e910ad3c00
--- /dev/null
+++ b/tests/b6-0228-boundary-containment.test.js
@@ -0,0 +1,228 @@
+import { afterEach, describe, expect, it } from 'vitest'
+import fs from 'node:fs'
+import os from 'node:os'
+import path from 'node:path'
+import { spawnSync } from 'node:child_process'
+import { auditProductBoundary } from '../scripts/check-product-boundary.mjs'
+import { createInstalledPackageVerifier } from '../scripts/boundary-manifests.mjs'
+
+const roots = []
+function fixture() {
+  const root = fs.mkdtempSync(path.join(os.tmpdir(), 'cvg-b6-0228-'))
+  roots.push(root)
+  const write = (file, value) => {
+    const target = path.join(root, file)
+    fs.mkdirSync(path.dirname(target), { recursive: true })
+    fs.writeFileSync(target, value)
+  }
+  write(
+    'package.json',
+    JSON.stringify({ workspaces: ['packages/*', 'products/*'] })
+  )
+  write('packages/core/package.json', JSON.stringify({ name: 'core' }))
+  write('packages/core/src/index.ts', 'export const neutral = 1\n')
+  write(
+    'products/shift-assistant/package.json',
+    JSON.stringify({ name: '@cvg/shift-assistant' })
+  )
+  write('products/shift-assistant/src/index.ts', 'export const product = 1\n')
+  const vendor = (
+    version = '1.0.0',
+    source = 'module.exports = 1\n',
+    dependencies = {}
+  ) => {
+    write(
+      'package-lock.json',
+      JSON.stringify({
+        lockfileVersion: 3,
+        packages: {
+          'node_modules/vendor': {
+            version: '1.0.0',
+            resolved: 'https://registry.npmjs.org/vendor/-/vendor-1.0.0.tgz',
+            integrity: 'sha512-YQ=='
+          }
+        }
+      })
+    )
+    write(
+      'node_modules/vendor/package.json',
+      JSON.stringify({
+        name: 'vendor',
+        version,
+        main: 'index.js',
+        dependencies
+      })
+    )
+    write('node_modules/vendor/index.js', source)
+    write(
+      'packages/core/src/index.ts',
+      "import value from 'vendor'; export { value }\n"
+    )
+  }
+  return { root, write, vendor }
+}
+afterEach(() => {
+  for (const root of roots.splice(0))
+    fs.rmSync(root, { recursive: true, force: true })
+})
+
+const splitProduct =
+  "module.exports = require('../../' + 'products/' + 'shift-assistant/src/index.ts')\n"
+describe('SPEC0228 conservative boundary contract', () => {
+  it('keeps the neutral positive and direct-product negative controls', () => {
+    const { root, write } = fixture()
+    expect(auditProductBoundary(root).status).toBe('PASS')
+    write(
+      'packages/core/src/index.ts',
+      "export * from '../../../products/shift-assistant/src/index.ts'\n"
+    )
+    expect(auditProductBoundary(root).status).toBe('FAIL')
+  })
+  it.each([
+    ['1.0.0', 'UNVERIFIED_INSTALLED_CONTENT'],
+    ['9.9.9', 'INSTALLED_VERSION_MISMATCH']
+  ])(
+    'never verifies metadata-only installed content at %s',
+    (version, reason) => {
+      const { root, vendor } = fixture()
+      vendor(version)
+      const verifier = createInstalledPackageVerifier(root)
+      const verdict = verifier.verify(
+        path.join(root, 'node_modules/vendor'),
+        'node_modules/vendor'
+      )
+      expect(verdict).toMatchObject({
+        verified: false,
+        reason,
+        dependencies: []
+      })
+      expect(verdict).not.toHaveProperty('source')
+      const audit = auditProductBoundary(root)
+      expect(audit.status).toBe('INCOMPLETE')
+      expect(audit.diagnostics).toContainEqual({
+        file: 'node_modules/vendor/package.json',
+        reason: 'UNVERIFIED_INSTALLED_PACKAGE',
+        detail: reason
+      })
+      expect(audit.installedLockDrift).toEqual(
+        version === '1.0.0'
+          ? []
+          : [
+              {
+                package: 'node_modules/vendor',
+                installedVersion: version,
+                lockfileVersion: '1.0.0'
+              }
+            ]
+      )
+    }
+  )
+  it.each(['1.0.0', '9.9.9'])(
+    'refuses the B6 concatenated product path at version %s without executing it',
+    (version) => {
+      const { root, vendor } = fixture()
+      vendor(version, splitProduct)
+      expect(auditProductBoundary(root).status).toBe('INCOMPLETE')
+    }
+  )
+  it('retains FAIL and drift when literal product evidence coexists with unverified bytes', () => {
+    const { root, vendor } = fixture()
+    vendor(
+      '9.9.9',
+      "module.exports = require('../../products/shift-assistant/src/index.ts')\n"
+    )
+    const audit = auditProductBoundary(root)
+    expect(audit.status).toBe('FAIL')
+    expect(
+      audit.diagnostics.some(
+        (d) => d.reason === 'INSTALLED_PACKAGE_REFERENCES_PRODUCT'
+      )
+    ).toBe(true)
+    expect(
+      audit.diagnostics.some((d) => d.detail === 'INSTALLED_VERSION_MISMATCH')
+    ).toBe(true)
+    expect(audit.installedLockDrift).toHaveLength(1)
+  })
+  it('expands a declared product successor despite refused installed content', () => {
+    const { root, vendor } = fixture()
+    vendor('1.0.0', 'module.exports = 1\n', { '@cvg/shift-assistant': '1.0.0' })
+    fs.mkdirSync(path.join(root, 'node_modules/@cvg'), { recursive: true })
+    fs.symlinkSync(
+      path.join(root, 'products/shift-assistant'),
+      path.join(root, 'node_modules/@cvg/shift-assistant'),
+      'dir'
+    )
+    const audit = auditProductBoundary(root)
+    expect(audit.status).toBe('FAIL')
+    expect(
+      audit.violations.some(
+        (v) =>
+          v.trail.includes('node_modules/vendor/package.json') &&
+          v.trail.includes('products/shift-assistant/package.json')
+      )
+    ).toBe(true)
+    expect(
+      audit.diagnostics.some((d) => d.detail === 'UNVERIFIED_INSTALLED_CONTENT')
+    ).toBe(true)
+  })
+  it.each([
+    [
+      'apps/api/src/main.ts',
+      "const shutdown = { install(source:any) { source.getBuiltinModule('module').createRequire(__filename)('../../../products/shift-assistant/src/index.ts') } }\nshutdown.install(process)\n"
+    ],
+    [
+      'apps/web/src/__tests__/app.test.tsx',
+      "const vi = { spyOn(source:any, _method:string) { source.process.getBuiltinModule('module').createRequire('/tmp/entry.cjs')('/tmp/products/shift-assistant/src/index.ts'); return { mockImplementation(_callback:any) {} } } }\nvi.spyOn(globalThis, 'fetch').mockImplementation((input) => {\n})\n"
+    ]
+  ])(
+    'refuses substituted receiver at %s in normal, strict and CLI paths',
+    (file, source) => {
+      const { root, write } = fixture()
+      write(
+        'packages/shared/src/lifecycle.ts',
+        fs.readFileSync('packages/shared/src/lifecycle.ts')
+      )
+      write(file, source)
+      const normal = auditProductBoundary(root)
+      const strict = auditProductBoundary(root, { exceptions: false })
+      expect(normal.status).toBe('INCOMPLETE')
+      expect(normal.exceptionsApplied).toBe(false)
+      expect(normal.exceptions).toEqual([])
+      expect(normal.diagnostics).toEqual(strict.diagnostics)
+      for (const flags of [[], ['--strict']]) {
+        const result = spawnSync(
+          process.execPath,
+          ['scripts/check-product-boundary.mjs', root, ...flags],
+          { encoding: 'utf8', timeout: 30000 }
+        )
+        expect(result.status).toBe(1)
+        expect(JSON.parse(result.stdout).diagnostics).toEqual(
+          normal.diagnostics
+        )
+      }
+    }
+  )
+  it('refuses an explicit legacy exception request even on a neutral fixture', () => {
+    const { root } = fixture()
+    const audit = auditProductBoundary(root, { exceptions: true })
+    expect(audit.status).toBe('INCOMPLETE')
+    expect(audit.exceptionsApplied).toBe(false)
+    expect(audit.diagnostics).toContainEqual({
+      file: 'package.json',
+      reason: 'UNAPPROVED_EXCEPTION_REQUEST'
+    })
+  })
+  it('never weakens a known FAIL when legacy exceptions are requested', () => {
+    const { root, write } = fixture()
+    write(
+      'packages/core/src/index.ts',
+      "export * from '../../../products/shift-assistant/src/index.ts'\n"
+    )
+    const audit = auditProductBoundary(root, { exceptions: true })
+    expect(audit.status).toBe('FAIL')
+    expect(
+      audit.diagnostics.some((d) => d.reason === 'UNAPPROVED_EXCEPTION_REQUEST')
+    ).toBe(true)
+    expect(audit.exceptions).toEqual([])
+  })
+})
