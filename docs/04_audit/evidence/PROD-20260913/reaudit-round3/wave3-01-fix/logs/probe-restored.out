{
  "scenarioA_freshHeaders": {
    "first": {
      "status": 400,
      "code": "invalid_action"
    },
    "replay": {
      "status": 401,
      "code": "unauthorized"
    },
    "firstExpected": "400 invalid_action (business outcome)",
    "replayExpected": "401 unauthorized (cross-request replay)"
  },
  "scenarioB_headersObjectIdentity": {
    "sameObjectAcrossRequests": false,
    "note": "true would mean one request memo could leak into another"
  },
  "scenarioC_literalHeaderObjectReuse": {
    "first": {
      "status": 400,
      "code": "invalid_action"
    },
    "second": {
      "status": 401,
      "code": "unauthorized"
    },
    "secondExpected": "401 unauthorized (server sees distinct headers objects)"
  },
  "scenarioD_tenantLess": {
    "status": 401,
    "code": "unauthorized",
    "expected": "401 unauthorized"
  },
  "scenarioE_concurrentSameToken": {
    "statuses": [
      400,
      401
    ],
    "codes": [
      "invalid_action",
      "unauthorized"
    ],
    "expected": "[400, 401] - exactly one request consumes the token"
  }
}
