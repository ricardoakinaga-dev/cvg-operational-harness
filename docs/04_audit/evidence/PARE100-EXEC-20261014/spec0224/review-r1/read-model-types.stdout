72-   * loop because maxSteps and maxDurationMs remain mandatory.
73-   */
74-  readonly maxKnowledgeCalls?: number
75-  readonly maxReplans?: number
76-  readonly maxVerificationCalls?: number
77-  readonly maxDecisionRepairs?: number
