88: export async function publishedDbNow(client: PostgresQueryable): Promise<Date> {
89:   const result = await client.query<{ now: Date | string }>(
90:     'SELECT clock_timestamp() AS now'
91:   )
92:   const now = result.rows[0]?.now
93:   if (now === undefined) publishedFenceError()
