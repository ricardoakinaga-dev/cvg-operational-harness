FILE /tmp/cvg-pare100-exec-20261014-6az3hlay/spec0225/packet-r1/source/packages/persistence/migrations/0029_controlled_published_kernel.sql
161: -- Bind lookups to the trigger's schema, never a mutable caller search_path.
162: CREATE FUNCTION cvg_controlled_bound_writer() RETURNS trigger LANGUAGE plpgsql AS $$
163: DECLARE
164:   t text; x text; bound boolean; parent record; mode text; owner text; fence text;
165:   controlled boolean;
166: BEGIN
167:   t := COALESCE(to_jsonb(NEW)->>'tenant_id',to_jsonb(OLD)->>'tenant_id');
168:   IF TG_TABLE_NAME='operational_executions' THEN
169:     x := COALESCE(to_jsonb(NEW)->>'id',to_jsonb(OLD)->>'id');
170:     controlled := COALESCE(to_jsonb(NEW)#>>'{request,runtime,context,values,adapterVersion}','')='controlled-published-v1'
171:       OR COALESCE(to_jsonb(OLD)#>>'{request,runtime,context,values,adapterVersion}','')='controlled-published-v1';
172:   ELSIF TG_TABLE_NAME='operational_effect_journal' THEN
173:     EXECUTE format('SELECT id FROM %I.operational_executions WHERE tenant_id=$1 AND request#>>''{runtime,context,values,adapterVersion}''=''controlled-published-v1'' AND left($2,length(id)+2)=id||'':s'' LIMIT 1',TG_TABLE_SCHEMA)
174:       INTO x USING t,COALESCE(to_jsonb(NEW)->>'operation_key',to_jsonb(OLD)->>'operation_key');
175:     controlled := x IS NOT NULL;
176:   ELSE
177:     x := COALESCE(to_jsonb(NEW)->>'execution_id',to_jsonb(OLD)->>'execution_id');
178:     EXECUTE format('SELECT EXISTS(SELECT 1 FROM %I.operational_executions WHERE tenant_id=$1 AND id=$2 AND request#>>''{runtime,context,values,adapterVersion}''=''controlled-published-v1'')',TG_TABLE_SCHEMA)
179:       INTO controlled USING t,x;
180:   END IF;
181:   -- The reserved parent marker is only a deny discriminator. Ordinary roles
182:   -- must not need grants on private sidecars to keep writing unbound work.
183:   IF x IS NULL OR NOT controlled THEN RETURN COALESCE(NEW,OLD); END IF;
184:   EXECUTE format('SELECT EXISTS(SELECT 1 FROM %I.controlled_published_bindings WHERE tenant_id=$1 AND execution_id=$2)',TG_TABLE_SCHEMA)
185:     INTO bound USING t,x;
186:   IF NOT bound THEN RETURN COALESCE(NEW,OLD); END IF;
187:   mode := current_setting('cvg.published_mode',true);
188:   owner := current_setting('cvg.published_worker',true);
189:   fence := current_setting('cvg.published_attempt',true);
190:   IF current_setting('cvg.published_execution',true) IS DISTINCT FROM x
191:      OR current_setting('cvg.tenant_id',true) IS DISTINCT FROM t
192:      OR mode IS NULL OR mode NOT IN ('active','settlement','claim','close','cancel','cancel_close')
193:      OR fence IS NULL OR fence !~ '^[0-9]+$' THEN
194:     RAISE EXCEPTION 'bound execution requires controlled fence context' USING ERRCODE='42501';
195:   END IF;
196:   EXECUTE format('SELECT state,attempt,lease_owner,lease_until FROM %I.operational_executions WHERE tenant_id=$1 AND id=$2',TG_TABLE_SCHEMA)
197:     INTO parent USING t,x;
198:   IF parent IS NULL THEN RAISE EXCEPTION 'bound execution parent missing' USING ERRCODE='42501'; END IF;
199:   IF mode='cancel_close' THEN
200:     IF TG_TABLE_NAME NOT IN ('controlled_published_bindings','controlled_published_evidence')
201:        OR parent.state<>'CANCELLED' OR parent.attempt::text IS DISTINCT FROM fence THEN
202:       RAISE EXCEPTION 'invalid cancellation closure writer' USING ERRCODE='42501';
203:     END IF;
204:     EXECUTE format('SELECT EXISTS(SELECT 1 FROM %I.operational_execution_events WHERE tenant_id=$1 AND execution_id=$2 AND event_type=''CANCELLED'' AND attempt=$3 AND sequence::text=$4)',TG_TABLE_SCHEMA)
205:       INTO bound USING t,x,parent.attempt,current_setting('cvg.published_cancel_event',true);
206:     IF NOT bound THEN RAISE EXCEPTION 'cancellation event binding missing' USING ERRCODE='42501'; END IF;
207:   ELSIF mode='cancel' THEN
208:     IF TG_TABLE_NAME NOT IN ('operational_executions','operational_execution_outbox','operational_execution_events')
209:        OR parent.state NOT IN ('QUEUED','FAILED_RETRYABLE','CANCELLED')
210:        OR parent.attempt::text IS DISTINCT FROM fence THEN
211:       RAISE EXCEPTION 'invalid bound cancellation writer' USING ERRCODE='42501';
212:     END IF;
213:   ELSIF mode='claim' THEN
214:     IF TG_TABLE_NAME NOT IN ('operational_executions','operational_execution_outbox','operational_execution_events','controlled_published_bindings','controlled_published_evidence')
215:        OR parent.state NOT IN ('QUEUED','FAILED_RETRYABLE','CLAIMED','RUNNING')
216:        OR parent.attempt > fence::bigint
217:        OR parent.attempt < fence::bigint-1
218:        OR (parent.state IN ('CLAIMED','RUNNING') AND parent.lease_until>clock_timestamp()
219:             AND (parent.lease_owner IS DISTINCT FROM owner OR parent.attempt::text IS DISTINCT FROM fence)) THEN
220:       RAISE EXCEPTION 'invalid bound claim writer' USING ERRCODE='42501';
221:     END IF;
222:   ELSIF mode='close' AND parent.state IN ('SUCCEEDED','FAILED_TERMINAL','CANCELLED') THEN
223:     IF TG_TABLE_NAME NOT IN ('operational_execution_outbox','operational_execution_events')
224:        OR parent.attempt::text IS DISTINCT FROM fence THEN
225:       RAISE EXCEPTION 'closed execution rejects further writes' USING ERRCODE='42501';
226:     END IF;
227:   ELSE
228:     IF parent.state NOT IN ('CLAIMED','RUNNING') OR parent.lease_owner IS DISTINCT FROM owner
229:        OR parent.attempt::text IS DISTINCT FROM fence OR parent.lease_until<=clock_timestamp() THEN
230:       RAISE EXCEPTION 'bound execution fence expired or lost' USING ERRCODE='42501';
231:     END IF;
232:   END IF;
233:   IF TG_OP='DELETE' THEN RAISE EXCEPTION 'bound execution cannot be deleted' USING ERRCODE='42501'; END IF;
234:   RETURN NEW;
235: END $$;
236: 
237: CREATE TRIGGER controlled_bound_execution_writer BEFORE UPDATE OR DELETE ON operational_executions
238:  FOR EACH ROW EXECUTE FUNCTION cvg_controlled_bound_writer();
239: CREATE TRIGGER controlled_bound_queue_writer BEFORE INSERT OR UPDATE OR DELETE ON operational_execution_outbox
240:  FOR EACH ROW EXECUTE FUNCTION cvg_controlled_bound_writer();
241: CREATE TRIGGER controlled_bound_event_writer BEFORE INSERT OR UPDATE OR DELETE ON operational_execution_events
242:  FOR EACH ROW EXECUTE FUNCTION cvg_controlled_bound_writer();
243: CREATE TRIGGER controlled_bound_step_writer BEFORE INSERT OR UPDATE OR DELETE ON operational_execution_steps
244:  FOR EACH ROW EXECUTE FUNCTION cvg_controlled_bound_writer();
245: CREATE TRIGGER controlled_bound_checkpoint_writer BEFORE INSERT OR UPDATE OR DELETE ON operational_execution_checkpoints
246:  FOR EACH ROW EXECUTE FUNCTION cvg_controlled_bound_writer();
247: CREATE TRIGGER controlled_bound_journal_writer BEFORE INSERT OR UPDATE OR DELETE ON operational_effect_journal
248:  FOR EACH ROW EXECUTE FUNCTION cvg_controlled_bound_writer();
249: CREATE TRIGGER controlled_bound_binding_writer BEFORE UPDATE ON controlled_published_bindings
250:  FOR EACH ROW EXECUTE FUNCTION cvg_controlled_bound_writer();
251: CREATE TRIGGER controlled_bound_evidence_writer BEFORE INSERT ON controlled_published_evidence
252:  FOR EACH ROW EXECUTE FUNCTION cvg_controlled_bound_writer();