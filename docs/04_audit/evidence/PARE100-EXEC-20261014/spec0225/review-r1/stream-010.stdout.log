273: async function transaction<T>(
274:   client: PostgresQueryable,
275:   operation: () => Promise<T>
276: ): Promise<T> {
277:   await client.query('BEGIN')
278:   try {
279:     const result = await operation()
280:     await client.query('COMMIT')
281:     return result
282:   } catch (error) {
283:     await client.query('ROLLBACK').catch(() => undefined)
284:     throw error
285:   }
286: }
