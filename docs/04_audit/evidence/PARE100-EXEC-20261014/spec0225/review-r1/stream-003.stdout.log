17: /** Strict JSON snapshot. No property reads, hooks, coercion or Unicode normalization. */
18: export function canonicalizeCompleteJson(
19:   value: unknown,
20:   limits: CompleteJsonLimits = {}
21: ): string {
22:   const maxBytes = limits.maxBytes ?? 32768
23:   const maxDepth = limits.maxDepth ?? 32
24:   const maxNodes = limits.maxNodes ?? 10000
25:   for (const limit of [maxBytes, maxDepth, maxNodes]) {
26:     if (!Number.isSafeInteger(limit) || limit < 0)
27:       throw new CompleteJsonError('RESULT_COMPLEXITY', 'Invalid JSON limit')
28:   }
29:   const chunks: string[] = []
30:   let bytes = 0,
31:     nodes = 0
32:   const ancestors = new Set<object>()
33:   const invalid = (): never => {
34:     throw new CompleteJsonError('INVALID_JSON', 'Value is not strict JSON')
35:   }
36:   const complexity = (): never => {
37:     throw new CompleteJsonError(
38:       'RESULT_COMPLEXITY',
39:       'JSON complexity limit exceeded'
40:     )
41:   }
42:   const append = (part: string): void => {
43:     bytes += Buffer.byteLength(part, 'utf8')
44:     if (bytes > maxBytes)
45:       throw new CompleteJsonError(
46:         'RESULT_TOO_LARGE',
47:         'JSON byte limit exceeded'
48:       )
49:     chunks.push(part)
50:   }
51:   const string = (text: string): void => {
52:     // UTF-16 units are a lower bound on escaped UTF-8 size, before scanning/allocation.
53:     if (text.length + 2 > maxBytes - bytes)
54:       throw new CompleteJsonError(
55:         'RESULT_TOO_LARGE',
56:         'JSON byte limit exceeded'
57:       )
58:     let encodedBytes = 2
59:     for (let i = 0; i < text.length; i++) {
60:       const unit = text.charCodeAt(i)
61:       if (unit >= 0xd800 && unit <= 0xdbff) {
62:         const next = text.charCodeAt(++i)
63:         if (!(next >= 0xdc00 && next <= 0xdfff)) invalid()
64:         encodedBytes += 4
65:       } else if (unit >= 0xdc00 && unit <= 0xdfff) invalid()
66:       else if (unit === 34 || unit === 92 || [8, 9, 10, 12, 13].includes(unit))
67:         encodedBytes += 2
68:       else if (unit < 32) encodedBytes += 6
69:       else encodedBytes += unit < 128 ? 1 : unit < 2048 ? 2 : 3
70:       if (encodedBytes > maxBytes - bytes)
71:         throw new CompleteJsonError(
72:           'RESULT_TOO_LARGE',
73:           'JSON byte limit exceeded'
74:         )
75:     }
76:     append(JSON.stringify(text))
77:   }
78:   const visit = (input: unknown, depth: number): void => {
79:     if (++nodes > maxNodes || depth > maxDepth) complexity()
80:     if (input === null) {
81:       append('null')
82:       return
83:     }
84:     switch (typeof input) {
85:       case 'string':
86:         string(input)
87:         return
88:       case 'boolean':
89:         append(input ? 'true' : 'false')
90:         return
91:       case 'number':
92:         if (!Number.isFinite(input) || Object.is(input, -0)) invalid()
93:         append(JSON.stringify(input))
94:         return
95:       case 'object':
96:         break
97:       default:
98:         invalid()
99:     }
100:     const object = input as object
101:     if (ancestors.has(object)) invalid()
102:     const array = Array.isArray(object)
103:     const prototype = Object.getPrototypeOf(object)
104:     if (
105:       array
106:         ? prototype !== Array.prototype
107:         : prototype !== Object.prototype && prototype !== null
108:     )
109:       invalid()
110:     const length = array
111:       ? (Object.getOwnPropertyDescriptor(object, 'length')?.value as number)
112:       : 0
113:     if (array && length > maxNodes - nodes) complexity()
114:     const keys = Reflect.ownKeys(object)
115:     if (keys.some((key) => typeof key !== 'string')) invalid()
116:     if (array && keys.length !== length + 1) invalid()
117:     if (!array && keys.length > maxNodes - nodes) complexity()
118:     ancestors.add(object)
119:     append(array ? '[' : '{')
120:     const names = array ? null : (keys as string[]).sort()
121:     const count = array ? length : names!.length
122:     for (let i = 0; i < count; i++) {
123:       const name = array ? String(i) : names![i]!
124:       const descriptor = Object.getOwnPropertyDescriptor(object, name)
125:       if (!descriptor || !('value' in descriptor)) invalid()
126:       if (i) append(',')
127:       if (!array) {
128:         string(name)
129:         append(':')
130:       }
131:       visit(descriptor!.value, depth + 1)
132:     }
133:     append(array ? ']' : '}')
134:     ancestors.delete(object)
135:   }
136:   visit(value, 1)
137:   return chunks.join('')
138: }

