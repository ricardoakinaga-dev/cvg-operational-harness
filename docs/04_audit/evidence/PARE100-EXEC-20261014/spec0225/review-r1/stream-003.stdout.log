178: function jsonText(value: unknown, label: string): string {
179:   let serialized: string
180:   try {
181:     serialized = JSON.stringify(value)
182:   } catch {
183:     throw new OperationalExecutionError(
184:       'validation_failed',
185:       `${label} is not serializable`
186:     )
187:   }
188:   if (!serialized || Buffer.byteLength(serialized, 'utf8') > 256 * 1024) {
189:     throw new OperationalExecutionError(
190:       'validation_failed',
191:       `${label} exceeds the bounded persistence envelope`
192:     )
193:   }
194:   return serialized
195: }
196: 
197: function text(value: string, label: string, max = 500): string {
198:   if (typeof value !== 'string' || value.trim().length === 0) {
199:     throw new OperationalExecutionError(
200:       'validation_failed',
201:       `${label} is required`
202:     )
203:   }
204:   if (value.length > max) {
205:     throw new OperationalExecutionError(
206:       'validation_failed',
207:       `${label} is too long`
208:     )
209:   }
210:   return value.trim()
211: }
212: 
213: function retryExhaustedFailure(maxAttempts: number): ExecutionFailure {
214:   return {
215:     kind: 'SEMANTIC_TERMINAL',
216:     code: 'retry_exhausted',
217:     message: `Execution exhausted the maximum of ${maxAttempts} attempts.`
218:   }
219: }
220: 

FILE /tmp/cvg-pare100-exec-20261014-6az3hlay/spec0225/packet-r1/source/packages/persistence/migrations/0016_operational_execution_spine.sql
1: -- AAA-21: neutral durable execution identity and queue.
2: --
3: -- This migration is additive. It is intentionally separate from the
4: -- Secretary inbound/outbox tables: the neutral harness owns these rows and
5: -- the worker must consume the execution identity through this authority.
6: 
7: CREATE TABLE IF NOT EXISTS operational_executions (
8:   tenant_id text NOT NULL,
9:   id text NOT NULL,
10:   idempotency_key text NOT NULL,
11:   request_hash text NOT NULL,
12:   request jsonb NOT NULL,
13:   request_protection_version text NOT NULL DEFAULT 'execution-r1',
14:   tenant_isolation_quarantined boolean NOT NULL DEFAULT false,
15:   state text NOT NULL CHECK (
16:     state IN (
17:       'RECEIVED', 'QUEUED', 'CLAIMED', 'RUNNING',
18:       'WAITING_APPROVAL', 'WAITING_USER', 'SUCCEEDED',
19:       'FAILED_RETRYABLE', 'FAILED_TERMINAL', 'CANCELLED'
20:     )
21:   ),
22:   attempt integer NOT NULL DEFAULT 0 CHECK (attempt >= 0),
23:   lease_owner text,
24:   lease_until timestamptz,
25:   result jsonb,
26:   result_protection_version text,
27:   failure jsonb,
28:   approval_id text,
29:   created_at timestamptz NOT NULL DEFAULT now(),
30:   updated_at timestamptz NOT NULL DEFAULT now(),
31:   completed_at timestamptz,
32:   PRIMARY KEY (tenant_id, id),
33:   UNIQUE (tenant_id, idempotency_key),
34:   CHECK (state NOT IN ('CLAIMED', 'RUNNING') OR (lease_owner IS NOT NULL AND lease_until IS NOT NULL)),
35:   CHECK (state NOT IN ('SUCCEEDED', 'FAILED_TERMINAL', 'CANCELLED') OR completed_at IS NOT NULL)
36: );
37: 
38: ALTER TABLE operational_executions
39:   ADD COLUMN IF NOT EXISTS approval_id text;
40: 
41: CREATE TABLE IF NOT EXISTS operational_execution_outbox (
42:   tenant_id text NOT NULL,
43:   execution_id text NOT NULL,
44:   status text NOT NULL CHECK (status IN ('pending', 'processing', 'processed', 'failed', 'dead_letter')),
45:   available_at timestamptz NOT NULL DEFAULT now(),
46:   attempts integer NOT NULL DEFAULT 0 CHECK (attempts >= 0),
47:   lease_owner text,
48:   lease_until timestamptz,
49:   last_error text,
50:   created_at timestamptz NOT NULL DEFAULT now(),
51:   processed_at timestamptz,
52:   tenant_isolation_quarantined boolean NOT NULL DEFAULT false,
53:   PRIMARY KEY (tenant_id, execution_id),
54:   FOREIGN KEY (tenant_id, execution_id) REFERENCES operational_executions (tenant_id, id),
55:   CHECK (status <> 'processing' OR (lease_owner IS NOT NULL AND lease_until IS NOT NULL))
56: );
57: 
58: CREATE TABLE IF NOT EXISTS operational_execution_events (
59:   tenant_id text NOT NULL,
60:   sequence bigint GENERATED BY DEFAULT AS IDENTITY,
61:   execution_id text NOT NULL,
62:   event_type text NOT NULL,
63:   worker_id text,
64:   attempt integer NOT NULL CHECK (attempt >= 0),
65:   reason text,
66:   audit_events jsonb,
67:   created_at timestamptz NOT NULL DEFAULT now(),
68:   tenant_isolation_quarantined boolean NOT NULL DEFAULT false,
69:   PRIMARY KEY (tenant_id, sequence),
70:   FOREIGN KEY (tenant_id, execution_id) REFERENCES operational_executions (tenant_id, id)
71: );
72: 
73: CREATE TABLE IF NOT EXISTS operational_effect_journal (
74:   tenant_id text NOT NULL,
75:   operation_key text NOT NULL,
76:   proposal_hash text NOT NULL,
77:   state text NOT NULL CHECK (state IN ('RESERVED', 'EFFECT_STARTED', 'CONFIRMED', 'FAILED', 'UNCERTAIN')),
78:   attempt_id text NOT NULL,
79:   result jsonb,
80:   error text,
81:   created_at timestamptz NOT NULL DEFAULT now(),
82:   updated_at timestamptz NOT NULL DEFAULT now(),
83:   tenant_isolation_quarantined boolean NOT NULL DEFAULT false,
84:   PRIMARY KEY (tenant_id, operation_key)
85: );
86: 
87: CREATE INDEX IF NOT EXISTS idx_operational_executions_tenant_state
88:   ON operational_executions (tenant_id, state, updated_at);
89: CREATE INDEX IF NOT EXISTS idx_operational_executions_approval
90:   ON operational_executions (tenant_id, approval_id);
91: CREATE INDEX IF NOT EXISTS idx_operational_execution_outbox_claim
92:   ON operational_execution_outbox (tenant_id, status, available_at, created_at);
93: CREATE INDEX IF NOT EXISTS idx_operational_execution_events_lookup
94:   ON operational_execution_events (tenant_id, execution_id, sequence);
95: CREATE INDEX IF NOT EXISTS idx_operational_effect_journal_state
96:   ON operational_effect_journal (tenant_id, state, updated_at);
97: 
98: ALTER TABLE operational_executions ENABLE ROW LEVEL SECURITY;
99: ALTER TABLE operational_executions FORCE ROW LEVEL SECURITY;
100: ALTER TABLE operational_execution_outbox ENABLE ROW LEVEL SECURITY;
101: ALTER TABLE operational_execution_outbox FORCE ROW LEVEL SECURITY;
102: ALTER TABLE operational_execution_events ENABLE ROW LEVEL SECURITY;
103: ALTER TABLE operational_execution_events FORCE ROW LEVEL SECURITY;
104: ALTER TABLE operational_effect_journal ENABLE ROW LEVEL SECURITY;
105: ALTER TABLE operational_effect_journal FORCE ROW LEVEL SECURITY;
106: 
107: DROP POLICY IF EXISTS operational_executions_tenant_isolation ON operational_executions;
108: CREATE POLICY operational_executions_tenant_isolation
109:   ON operational_executions
110:   USING (tenant_isolation_quarantined = false AND tenant_id = NULLIF(current_setting('cvg.tenant_id', true), ''))
111:   WITH CHECK (tenant_isolation_quarantined = false AND tenant_id = NULLIF(current_setting('cvg.tenant_id', true), ''));
112: 
113: DROP POLICY IF EXISTS operational_execution_outbox_tenant_isolation ON operational_execution_outbox;
114: CREATE POLICY operational_execution_outbox_tenant_isolation
115:   ON operational_execution_outbox
116:   USING (tenant_isolation_quarantined = false AND tenant_id = NULLIF(current_setting('cvg.tenant_id', true), ''))
117:   WITH CHECK (tenant_isolation_quarantined = false AND tenant_id = NULLIF(current_setting('cvg.tenant_id', true), ''));
118: 
119: DROP POLICY IF EXISTS operational_execution_events_tenant_isolation ON operational_execution_events;
120: CREATE POLICY operational_execution_events_tenant_isolation
121:   ON operational_execution_events
122:   USING (tenant_isolation_quarantined = false AND tenant_id = NULLIF(current_setting('cvg.tenant_id', true), ''))
123:   WITH CHECK (tenant_isolation_quarantined = false AND tenant_id = NULLIF(current_setting('cvg.tenant_id', true), ''));
124: 
125: DROP POLICY IF EXISTS operational_effect_journal_tenant_isolation ON operational_effect_journal;
126: CREATE POLICY operational_effect_journal_tenant_isolation
127:   ON operational_effect_journal
128:   USING (tenant_isolation_quarantined = false AND tenant_id = NULLIF(current_setting('cvg.tenant_id', true), ''))
129:   WITH CHECK (tenant_isolation_quarantined = false AND tenant_id = NULLIF(current_setting('cvg.tenant_id', true), ''));
130: 
131: REVOKE ALL ON operational_executions FROM PUBLIC;
132: REVOKE ALL ON operational_execution_outbox FROM PUBLIC;
133: REVOKE ALL ON operational_execution_events FROM PUBLIC;
134: REVOKE ALL ON operational_effect_journal FROM PUBLIC;
135: 
136: COMMENT ON TABLE operational_executions IS
137:   'AAA-21 neutral tenant-scoped execution authority; request/result payloads are synthetic or redacted by contract.';
138: COMMENT ON COLUMN operational_executions.approval_id IS
139:   'Tenant-scoped durable approval identity required to resolve WAITING_APPROVAL; API and worker must preserve this binding.';
140: COMMENT ON TABLE operational_execution_outbox IS
141:   'AAA-21 durable queue paired atomically with an operational execution record.';
142: COMMENT ON TABLE operational_execution_events IS
143:   'AAA-21 append-only causal state transitions and recovery evidence.';
144: COMMENT ON TABLE operational_effect_journal IS
145:   'AAA-21 tenant-scoped effect authority; UNCERTAIN outcomes require explicit reconciliation.';

FILE /tmp/cvg-pare100-exec-20261014-6az3hlay/spec0225/packet-r1/source/packages/persistence/migrations/0029_controlled_published_kernel.sql
1: -- SPEC0217: additive, opt-in controlled published inbound continuation.
2: -- No legacy turn is backfilled. Migration0028 remains a dedicated schema.
3: -- The migration owner supplies the serving role's explicit minimal grants:
4: -- bindings SELECT/INSERT/UPDATE; evidence SELECT/INSERT. PUBLIC gets none.
5: 
6: -- messages previously had only a global id PK; a tenant-qualified FK needs
7: -- this explicit composite key. No row is rewritten or backfilled.
8: CREATE UNIQUE INDEX controlled_published_message_tenant_key ON messages (tenant_id,id);
9: 
10: CREATE TABLE controlled_published_bindings (
11:   tenant_id text NOT NULL,
12:   execution_id text NOT NULL,
13:   inbound_message_id text NOT NULL,
14:   conversation_id text NOT NULL,
15:   session_id text NOT NULL,
16:   outbox_id text NOT NULL,
17:   agent_id text NOT NULL,
18:   version_id text NOT NULL,
19:   trace_id text NOT NULL,
20:   correlation_id text NOT NULL,
21:   adapter_version text NOT NULL DEFAULT 'controlled-published-v1'
22:     CHECK (adapter_version = 'controlled-published-v1'),
23:   request_digest text NOT NULL CHECK (request_digest ~ '^sha256-[0-9a-f]{64}$'),
24:   capability_fingerprint text NOT NULL,
25:   admission_input jsonb NOT NULL CHECK (jsonb_typeof(admission_input)='object'),
26:   admission_runtime jsonb NOT NULL CHECK (jsonb_typeof(admission_runtime)='object'),
27:   prepared_runtime jsonb,
28:   runtime_result jsonb,
29:   prepared jsonb CHECK (prepared IS NULL OR jsonb_typeof(prepared) = 'object'),
30:   prepared_digest text CHECK (prepared_digest IS NULL OR prepared_digest ~ '^sha256-[0-9a-f]{64}$'),
31:   state jsonb CHECK (state IS NULL OR jsonb_typeof(state) = 'object'),
32:   state_digest text CHECK (state_digest IS NULL OR state_digest ~ '^sha256-[0-9a-f]{64}$'),
33:   state_revision bigint NOT NULL DEFAULT 0 CHECK (state_revision BETWEEN 0 AND 9007199254740991),
34:   evidence_sequence integer NOT NULL DEFAULT 0 CHECK (evidence_sequence BETWEEN 0 AND 256),
35:   evidence_bytes integer NOT NULL DEFAULT 0 CHECK (evidence_bytes BETWEEN 0 AND 4194304),
36:   evidence_hash text NOT NULL CHECK (evidence_hash ~ '^sha256-[0-9a-f]{64}$'),
37:   started_at timestamptz,
38:   expires_at timestamptz,
39:   dispatch_closed boolean NOT NULL DEFAULT false,
40:   fault jsonb CHECK (fault IS NULL OR jsonb_typeof(fault) = 'object'),
41:   closed_trace jsonb CHECK (closed_trace IS NULL OR jsonb_typeof(closed_trace) = 'object'),
42:   closed_trace_digest text CHECK (closed_trace_digest IS NULL OR closed_trace_digest ~ '^sha256-[0-9a-f]{64}$'),
43:   phase_state text NOT NULL DEFAULT 'IDLE_SEALED'
44:     CHECK (phase_state IN ('IDLE_SEALED', 'OPEN', 'FAULTED', 'CLOSED')),
45:   phase_revision bigint NOT NULL DEFAULT 0 CHECK (phase_revision BETWEEN 0 AND 9007199254740991),
46:   seal_id text NOT NULL,
47:   seal_checkpoint_digest text,
48:   sealed_checkpoint jsonb CHECK (sealed_checkpoint IS NULL OR jsonb_typeof(sealed_checkpoint)='object'),
49:   seal_state_digest text,
50:   sealed_through_sequence integer NOT NULL DEFAULT 0 CHECK (sealed_through_sequence BETWEEN 0 AND 256),
51:   consumed_seal_id text,
52:   open_phase_id text,
53:   open_phase_type text,
54:   open_phase_input_digest text,
55:   open_phase_attempt integer,
56:   open_phase_acked boolean NOT NULL DEFAULT false,
57:   active_outer_attempt integer,
58:   active_outer_worker_id text,
59:   active_outer_attempt_row_id bigint,
60:   approval_receipt jsonb CHECK (approval_receipt IS NULL OR jsonb_typeof(approval_receipt) = 'object'),
61:   created_at timestamptz NOT NULL DEFAULT clock_timestamp(),
62:   tenant_isolation_quarantined boolean NOT NULL DEFAULT false,
63:   PRIMARY KEY (tenant_id, execution_id),
64:   UNIQUE (tenant_id, inbound_message_id),
65:   UNIQUE (tenant_id, trace_id),
66:   FOREIGN KEY (tenant_id, execution_id) REFERENCES operational_executions (tenant_id, id),
67:   FOREIGN KEY (tenant_id, inbound_message_id) REFERENCES messages (tenant_id, id),
68:   FOREIGN KEY (tenant_id, conversation_id) REFERENCES conversations (tenant_id, id),
69:   FOREIGN KEY (tenant_id, session_id) REFERENCES sessions (tenant_id, id),
70:   FOREIGN KEY (tenant_id, outbox_id) REFERENCES outbox_events (tenant_id, id),
71:   FOREIGN KEY (tenant_id, agent_id) REFERENCES platform_agents (tenant_id, id),
72:   FOREIGN KEY (tenant_id, version_id) REFERENCES platform_agent_versions (tenant_id, id),
73:   CHECK ((prepared IS NULL) = (prepared_digest IS NULL)),
74:   CHECK ((state IS NULL) = (state_digest IS NULL)),
75:   CHECK ((closed_trace IS NULL) = (closed_trace_digest IS NULL)),
76:   CHECK ((sealed_checkpoint IS NULL) = (seal_checkpoint_digest IS NULL)),
77:   CHECK ((started_at IS NULL) = (expires_at IS NULL)),
78:   CHECK (expires_at IS NULL OR (expires_at > started_at AND expires_at <= started_at + interval '120 seconds')),
79:   CHECK (prepared IS NULL OR octet_length(prepared::text) <= 1048576),
80:   CHECK (state IS NULL OR octet_length(state::text) <= 1048576),
81:   CHECK (phase_state <> 'IDLE_SEALED' OR open_phase_id IS NULL),
82:   CHECK (phase_state <> 'CLOSED' OR (dispatch_closed AND closed_trace IS NOT NULL)),
83:   CHECK (active_outer_attempt IS NULL OR active_outer_attempt > 0),
84:   CHECK (active_outer_attempt_row_id IS NULL OR active_outer_attempt_row_id > 0),
85:   CHECK ((active_outer_attempt IS NULL) = (active_outer_worker_id IS NULL)),
86:   CHECK ((active_outer_attempt IS NULL) = (active_outer_attempt_row_id IS NULL))
87: );
88: 
89: CREATE TABLE controlled_published_evidence (
90:   tenant_id text NOT NULL,
91:   execution_id text NOT NULL,
92:   sequence integer NOT NULL CHECK (sequence BETWEEN 1 AND 256),
93:   event_key text NOT NULL CHECK (length(event_key) BETWEEN 1 AND 500),
94:   event_type text NOT NULL CHECK (length(event_type) BETWEEN 1 AND 100),
95:   canonical_payload jsonb NOT NULL CHECK (jsonb_typeof(canonical_payload) = 'object'),
96:   payload_digest text NOT NULL CHECK (payload_digest ~ '^sha256-[0-9a-f]{64}$'),
97:   previous_hash text NOT NULL CHECK (previous_hash ~ '^sha256-[0-9a-f]{64}$'),
98:   event_hash text NOT NULL CHECK (event_hash ~ '^sha256-[0-9a-f]{64}$'),
99:   originating_attempt integer NOT NULL CHECK (originating_attempt >= 0),
100:   created_at timestamptz NOT NULL,
101:   tenant_isolation_quarantined boolean NOT NULL DEFAULT false,
102:   PRIMARY KEY (tenant_id, execution_id, sequence),
103:   UNIQUE (tenant_id, execution_id, event_key),
104:   FOREIGN KEY (tenant_id, execution_id) REFERENCES controlled_published_bindings (tenant_id, execution_id),
105:   CHECK (octet_length(canonical_payload::text) <= 1048576)
106: );
107: 
108: ALTER TABLE controlled_published_bindings ENABLE ROW LEVEL SECURITY;
109: ALTER TABLE controlled_published_bindings FORCE ROW LEVEL SECURITY;
110: ALTER TABLE controlled_published_evidence ENABLE ROW LEVEL SECURITY;
111: ALTER TABLE controlled_published_evidence FORCE ROW LEVEL SECURITY;
112: CREATE POLICY controlled_published_bindings_tenant_isolation ON controlled_published_bindings
113:  USING (tenant_isolation_quarantined = false AND tenant_id = NULLIF(current_setting('cvg.tenant_id',true),''))
114:  WITH CHECK (tenant_isolation_quarantined = false AND tenant_id = NULLIF(current_setting('cvg.tenant_id',true),''));
115: CREATE POLICY controlled_published_evidence_tenant_isolation ON controlled_published_evidence
116:  USING (tenant_isolation_quarantined = false AND tenant_id = NULLIF(current_setting('cvg.tenant_id',true),''))
117:  WITH CHECK (tenant_isolation_quarantined = false AND tenant_id = NULLIF(current_setting('cvg.tenant_id',true),''));
118: REVOKE ALL ON controlled_published_bindings, controlled_published_evidence FROM PUBLIC;
119: 
120: CREATE FUNCTION cvg_controlled_evidence_append_only() RETURNS trigger LANGUAGE plpgsql AS $$
121: BEGIN
122:   RAISE EXCEPTION 'controlled published evidence is append only' USING ERRCODE = '42501';
123: END $$;
124: CREATE TRIGGER controlled_published_evidence_append_only
125:  BEFORE UPDATE OR DELETE OR TRUNCATE ON controlled_published_evidence
126:  FOR EACH STATEMENT EXECUTE FUNCTION cvg_controlled_evidence_append_only();
127: 
128: CREATE FUNCTION cvg_controlled_binding_immutable() RETURNS trigger LANGUAGE plpgsql AS $$
129: BEGIN
130:   IF TG_OP = 'DELETE' THEN
131:     RAISE EXCEPTION 'controlled binding cannot be deleted' USING ERRCODE='42501';
132:   END IF;
133:   IF ROW(NEW.tenant_id,NEW.execution_id,NEW.inbound_message_id,NEW.conversation_id,
134:          NEW.session_id,NEW.outbox_id,NEW.agent_id,NEW.version_id,NEW.trace_id,
135:          NEW.correlation_id,NEW.adapter_version,NEW.request_digest,NEW.capability_fingerprint,NEW.created_at,NEW.admission_input,NEW.admission_runtime)
136:      IS DISTINCT FROM
137:      ROW(OLD.tenant_id,OLD.execution_id,OLD.inbound_message_id,OLD.conversation_id,
138:          OLD.session_id,OLD.outbox_id,OLD.agent_id,OLD.version_id,OLD.trace_id,
139:          OLD.correlation_id,OLD.adapter_version,OLD.request_digest,OLD.capability_fingerprint,OLD.created_at,OLD.admission_input,OLD.admission_runtime)
140:      OR (OLD.prepared IS NOT NULL AND ROW(NEW.prepared,NEW.prepared_digest,NEW.started_at,NEW.expires_at,NEW.prepared_runtime)
141:            IS DISTINCT FROM ROW(OLD.prepared,OLD.prepared_digest,OLD.started_at,OLD.expires_at,OLD.prepared_runtime))
142:      OR (OLD.dispatch_closed AND NOT NEW.dispatch_closed)
143:      OR (OLD.fault IS NOT NULL AND NEW.fault IS DISTINCT FROM OLD.fault)
144:      OR (OLD.closed_trace IS NOT NULL AND ROW(NEW.closed_trace,NEW.closed_trace_digest)
145:            IS DISTINCT FROM ROW(OLD.closed_trace,OLD.closed_trace_digest))
146:      OR NEW.state_revision < OLD.state_revision OR NEW.phase_revision < OLD.phase_revision
147:      OR NEW.evidence_sequence < OLD.evidence_sequence OR NEW.evidence_bytes < OLD.evidence_bytes
148:      OR (OLD.phase_state='CLOSED' AND NEW IS DISTINCT FROM OLD)
149:      OR (OLD.phase_state='FAULTED' AND NEW.phase_state NOT IN ('FAULTED','CLOSED')) THEN
150:     RAISE EXCEPTION 'controlled binding immutable or monotonic field changed' USING ERRCODE='23514';