  "original_gaps_preserved": [
    {
      "id": "G01",
      "status": "OPEN_NOT_RUNTIME_MEASURED",
      "kind": "HANDLE_API_ABSENT",
      "observation": "CVG public SessionEventStore exposes openSession/append/read, no per-session read/write handle or matching service create/open/flush/stat/list/dispose contract.",
      "owner_task": "P100-020"
    },
    {
      "id": "G02",
      "status": "OPEN_NOT_RUNTIME_MEASURED",
      "kind": "PUBLIC_CONTRACT_PROJECTION_UNSPECIFIED",
      "observation": "Public context identity/exports and typed reference error categories need an explicit versioned CVG bridge; no alias by similar name proves parity.",
      "owner_task": "P100-020"
    },
    {
      "id": "G03",
      "status": "OPEN_NOT_RUNTIME_MEASURED",
      "kind": "HEADER_AND_SNAPSHOT_METADATA_GAP",
      "observation": "CVG SessionStream carries tenantId/sessionId/formatVersion, without the immutable header/snapshot metadata promised by the reference contract.",
      "owner_task": "P100-020"
    },
    {
      "id": "G04",
      "status": "OPEN_NOT_RUNTIME_MEASURED",
      "kind": "CREATE_VS_IDEMPOTENT_OPEN",
      "observation": "CVG openSession is idempotent; reference create rejects duplicates, and absent stat/open semantics differ. No silent upsert substitution.",
      "owner_task": "P100-020"
    },
    {
      "id": "G05",
      "status": "OPEN_NOT_RUNTIME_MEASURED",
      "kind": "FORMAT_AND_OFFSET_PROJECTION_UNSPECIFIED",
      "observation": "Reference logical seq starts0 and has its own current format; CVG event sequence starts1 and read is afterSequence-exclusive. A lossless explicit projection is required; numeric renumbering is not interoperability.",
      "owner_task": "P100-020"
    },
    {
      "id": "G06",
      "status": "OPEN_NOT_RUNTIME_MEASURED",
      "kind": "SESSION_WRITER_OWNERSHIP_GAP",
      "observation": "Operational execution leases217 do not establish session-handle single-writer ownership/release semantics.",
      "owner_task": "P100-020"
    },
    {
      "id": "G07",
      "status": "OPEN_NOT_RUNTIME_MEASURED",
      "kind": "REFERENCE_NATIVE_LOSS_CAPABILITY_NOT_EXECUTED",
      "observation": "OwnershipLostError is exported, but its documentation notes declared cross-process-layer availability. Selected backend behavior needs execution, not inference from the export.",
      "owner_task": "P100-020"
    },
    {
      "id": "G08",
      "status": "OPEN_NOT_RUNTIME_MEASURED",
      "kind": "BATCH_AND_STORAGE_VALIDATION_PROJECTION",
      "observation": "CVG per-event digest/deduplication differs from exact caller-supplied contiguous batch seq and required event vocabulary validation; design and differential evidence pending.",
      "owner_task": "P100-020"
    },
    {
      "id": "G09",
      "status": "OPEN_NOT_RUNTIME_MEASURED",
      "kind": "READ_OWNERSHIP_AND_FRESHNESS_CONTRACT_GAP",
      "observation": "CVG read returns only an array, without eventState/read-handle monotonicity semantics. Existing validation/fresh objects are static leads, not functional evidence.",
      "owner_task": "P100-020"
    },
    {
      "id": "G10",
      "status": "OPEN_NOT_RUNTIME_MEASURED",
      "kind": "OBSERVATION_REVISION_API_GAP",
      "observation": "No corresponding public stat/list/opaque revision contract exists on current SessionEventStore.",
      "owner_task": "P100-020"
    },
    {
      "id": "G11",
      "status": "OPEN_NOT_RUNTIME_MEASURED",
      "kind": "DURABILITY_BRIDGE_NOT_QUALIFIED",
      "observation": "PG per-append transaction may satisfy a stronger durability point, but handle/global flush, empty-session materialization and close barriers need explicit mapping and native crash tests. In-memory store cannot prove cross-process durability.",
      "owner_task": "P100-020"
    },
    {
      "id": "G12",
      "status": "OPEN_NOT_RUNTIME_MEASURED",
      "kind": "CANCELLATION_AND_AGGREGATE_FLUSH_GAP",
      "observation": "Current SessionEventStore options lack signal parameters and service-wide flush/partial failure contract.",
      "owner_task": "P100-020"
    },
    {
      "id": "G13",
      "status": "OPEN_NOT_RUNTIME_MEASURED",
      "kind": "FORMAT_ERROR_AND_RECOVERY_PROJECTION_GAP",
      "observation": "CVG schema fingerprints/format registry/error codes require a lossless contract for reference refusal/corruption/physical-tail semantics. Historical formats/migration are still outside this finite proposal.",
      "owner_task": "P100-020"
    }
  ]
}
