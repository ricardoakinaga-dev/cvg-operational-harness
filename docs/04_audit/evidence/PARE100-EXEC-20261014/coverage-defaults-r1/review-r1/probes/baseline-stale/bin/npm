#!/home/ricardo/.nvm/versions/node/v22.23.2/bin/node
import fs from 'node:fs';
fs.writeFileSync('observed.json',JSON.stringify({flag:process.env.CVG_COVERAGE_PER_FILE,scope:process.env.CVG_TEST_SCOPE,marker:process.env.REVIEW_MARKER,argv:process.argv.slice(2)}));
if(process.env.MODE==='fail')process.exit(7);
if(process.env.MODE!=='write')process.exit(0);
fs.mkdirSync('coverage',{recursive:true});fs.writeFileSync('coverage/coverage-summary.json',fs.readFileSync('input.json'));
