576:       return this.earlyFinish(
577:         input,
578:         `Kernel could not start: ${errorMessage(error)}.`,
579:         'INTERNAL_FAILURE',
580:         startedAtMs
581:       )
582:       /* v8 ignore stop */
583:     }
