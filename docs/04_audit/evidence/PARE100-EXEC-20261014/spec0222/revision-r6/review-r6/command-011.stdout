547:       return this.earlyFinish(
548:         input,
549:         'Capability composition fingerprint does not match the runtime.',
550:         'STATE_CONFLICT',
551:         startedAtMs
552:       )
553:     }
554:     if (input.budget.maxSteps < 1) {
555:       return this.earlyFinish(
