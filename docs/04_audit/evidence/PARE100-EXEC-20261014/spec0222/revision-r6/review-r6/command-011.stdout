960:         executionId: run.executionId,
961:         tenantId: run.input.tenantId,
962:         conversationId: run.input.conversationId,
963:         correlationId: run.input.correlationId,
964:         traceId: run.input.traceId,
965:         userMessage: run.input.userMessage,
966:         context: run.input.context,
967:         objective: run.input.agent.objective,
968:         instructions: run.input.agent.instructions,
969:         agentId: run.input.agent.id,
970:         agentVersion: run.input.agent.version
971:       },
972:       profile: 'iterative',
973:       stepNumber,
974:       goal: run.state.goal,
975:       state: stateForContext,
976:       capabilities: this.availableTools(run),
977:       knowledgeAvailable: Boolean(this.options.knowledge),
978:       completionStrategy: run.input.agent.completionStrategy ?? 'DETERMINISTIC',
979:       allowedDecisionTypes: this.allowedDecisionTypes(run),
980:       budget: run.input.budget,
981:       budgetUsage: run.usage,
982:       ...(run.usage.decisionRepairs > 0
983:         ? {
984:             decisionRepair: {
985:               attempt: run.usage.decisionRepairs,
986:               errors: run.lastDecisionErrors
987:             }
988:           }
989:         : {})
990:     })
991:     const decisionAbortController = new AbortController()
992:     const decisionOrDeadline = await this.withDeadline(
993:       this.options.orchestrator.decide({
994:         context,
995:         signal: decisionAbortController.signal
996:       }),
997:       remaining
998:     )
999:     if (decisionOrDeadline === DEADLINE_EXCEEDED) {
1000:       decisionAbortController.abort()
1001:       return {
1002:         outcome: this.stop(
1003:           'MAX_DURATION',
1004:           'Duration budget exhausted while deciding the next step.'
1005:         )
1569:   private async finalize(
1570:     run: LoopRun,
1571:     outcome: Extract<DispatchOutcome, { kind: 'stop' }>,
1572:     startedAtMs: number
1573:   ): Promise<RuntimeResult> {
1574:     let stopReason: StopReason = outcome.stopReason
1575:     run.usage.activeDurationMs += Date.now() - startedAtMs
1576:     if (!outcome.preserveCheckpoint && TERMINAL_STOPS.has(stopReason)) {
1577:       try {
1578:         await this.closePendingStep(run, stopReason)
1579:       } catch {
1580:         // The open step could not be closed: the terminal checkpoint must not
1581:         // claim a clean stop while the step store disagrees.
1582:         stopReason = 'INSUFFICIENT_EVIDENCE'
1583:       }
1584:     }
1585:     run.state = { ...run.state, stopReason }
1586:     let checkpointProven = true
1587:     if (outcome.preserveCheckpoint) {
1588:       // Intentional no-write: the durable pause must stay resumable after a
1589:       // rejected resume binding.
1590:     } else {
1591:       try {
1592:         await this.persistCheckpoint(run)
1593:       } catch {
1594:         checkpointProven = false
1595:       }
1596:     }
1597:     const claimedReason: StopReason = checkpointProven
1598:       ? stopReason
1599:       : 'INSUFFICIENT_EVIDENCE'
1600:     if (!checkpointProven) {
1601:       run.state = { ...run.state, stopReason: claimedReason }
1602:     }
1603:     const result: RuntimeResult = {
1604:       response: outcome.response,
1605:       stopReason: claimedReason,
1606:       ...(outcome.kind === 'stop' && outcome.approvalId
1607:         ? { approvalId: outcome.approvalId }
1608:         : {}),
1609:       steps: run.usage.steps,
1610:       modelCalls: run.usage.modelCalls,
1611:       toolCalls: run.usage.toolCalls,
1612:       usage: {
1613:         inputTokens: run.usage.inputTokens,
1614:         outputTokens: run.usage.outputTokens,
1615:         costUsd: run.usage.costUsd
1616:       },
1617:       ...(run.lastToolObservation
1618:         ? {
1619:             toolResult: {
1620:               /* v8 ignore next -- only a successful tool observation is stored */
1621:               status:
1622:                 (run.lastToolObservation.payload as { status?: string } | null)
1623:                   ?.status === 'SUCCEEDED'
1624:                   ? ('SUCCEEDED' as const)
1625:                   : ('REJECTED' as const),
1626:               output: (
1627:                 run.lastToolObservation.payload as {
1628:                   output?: unknown
1629:                 } | null
1630:               )?.output
1631:             }
1632:           }
1633:         : {})
1634:     }
1635:     const finalResult = await this.recordAuditOutcome(
1636:       run,
1637:       result,
1638:       claimedReason
1639:     )
1640:     this.recordTelemetry(run, finalResult, startedAtMs)
1641:     return finalResult
1642:   }
1643: 
1644:   private async recordAuditOutcome(
1645:     run: LoopRun,
1646:     result: RuntimeResult,
1647:     stopReason: StopReason
1648:   ): Promise<RuntimeResult> {
1649:     const action =
1650:       stopReason === 'COMPLETED'
1651:         ? 'runtime.completed'
1652:         : stopReason === 'NEEDS_USER_INPUT' ||
1653:             stopReason === 'APPROVAL_REQUIRED'
1654:           ? 'runtime.paused'
1655:           : 'runtime.stopped'
1656:     // Audit always gets at least a bounded grace window, so a budget stop
1657:     // (possibly after an effect) is still recorded. If even that fails, the
1658:     // result is degraded like any other unaudited outcome (ENG-008).
1659:     try {
1660:       const deadlineMs = Math.max(this.remainingDuration(run), AUDIT_GRACE_MS)
1661:       const auditOrDeadline = await this.withDeadline(
1662:         this.options.audit.append({
1663:           actor: run.input.agent.id,
1664:           agent: run.input.agent.id,
1665:           tenant: run.input.tenantId,
1666:           action,
1667:           policy: null,
1668:           approval: (result.approvalId as ApprovalId | undefined) ?? null,
1669:           tool: run.lastToolObservation?.provenance.sourceId ?? null,
1670:           result: stopReason,
1671:           timestamp: this.clock().toISOString(),
1672:           traceId: run.input.traceId,
1673:           correlationId: run.input.correlationId
1674:         }),
1675:         deadlineMs
1676:       )
1677:       if (auditOrDeadline === DEADLINE_EXCEEDED) {
1678:         throw new Error('audit deadline exceeded')
1679:       }
1680:       return result
1681:     } catch {
1682:       return {
1683:         ...result,
1684:         response:
1685:           'Execution could not be completed because audit recording failed.',
1686:         stopReason: 'INSUFFICIENT_EVIDENCE'
1687:       }
1688:     }
1689:   }
1690: 
1691:   private recordTelemetry(
1692:     run: LoopRun,
1693:     result: RuntimeResult,
1694:     startedAtMs: number
1695:   ): void {
1696:     const telemetry: TelemetryEvent = {
1697:       name: 'harness.iterative',
1698:       latencyMs: Date.now() - startedAtMs,
1699:       errors: result.stopReason === 'COMPLETED' ? 0 : 1,
1700:       costUsd: result.usage.costUsd,
1701:       inputTokens: result.usage.inputTokens,
1702:       outputTokens: result.usage.outputTokens,
1703:       provider: null,
1704:       toolDurationMs: 0,
1705:       steps: result.steps,
1706:       traceId: run.input.traceId,
1707:       correlationId: run.input.correlationId,
1708:       attributes: {
1709:         outcome: result.stopReason,
1710:         model_calls: result.modelCalls,
1711:         tool_calls: result.toolCalls,
1712:         knowledge_calls: run.usage.knowledgeCalls,
1713:         replans: run.usage.replans,
1714:         verification_calls: run.usage.verificationCalls
1715:       }
1716:     }
1717:     try {
1718:       this.options.telemetry.record(telemetry)
1719:     } catch {
1720:       // telemetry is best effort
1721:     }
1722:   }
1723: 
1724:   private async earlyFinish(
1725:     input: RuntimeInput,
1726:     response: string,
1727:     stopReason: StopReason,
1728:     startedAtMs: number
1729:   ): Promise<RuntimeResult> {
1730:     void startedAtMs
1731:     const result: RuntimeResult = {
1732:       response,
1733:       stopReason,
1734:       steps: 0,
1735:       modelCalls: 0,
1736:       toolCalls: 0,
1737:       usage: { inputTokens: 0, outputTokens: 0, costUsd: 0 }
1738:     }
1739:     try {
1740:       await this.options.audit.append({
1741:         actor: input.agent.id,
1742:         agent: input.agent.id,
1743:         tenant: input.tenantId,
1744:         action: 'runtime.stopped',
1745:         policy: null,
1746:         approval: null,
1747:         tool: null,
1748:         result: stopReason,
1749:         timestamp: this.clock().toISOString(),
1750:         traceId: input.traceId,
1751:         correlationId: input.correlationId
1752:       })
1753:     } catch {
1754:       return {
1755:         ...result,
1756:         response:
1757:           'Execution could not be completed because audit recording failed.',
1758:         stopReason: 'INSUFFICIENT_EVIDENCE'
1759:       }
1760:     }
1761:     return result
1762:   }
1763: 
1764:   private async withDeadline<T>(
1765:     operation: Promise<T>,
1766:     remainingMs: number
1767:   ): Promise<T | typeof DEADLINE_EXCEEDED> {
1768:     if (remainingMs <= 0) return DEADLINE_EXCEEDED
1769:     let timer!: ReturnType<typeof setTimeout>
1770:     const deadline = new Promise<typeof DEADLINE_EXCEEDED>((resolve) => {
1771:       timer = setTimeout(() => resolve(DEADLINE_EXCEEDED), remainingMs)
1772:     })
1773:     try {
1774:       return await Promise.race([operation, deadline])
1775:     } finally {
1776:       clearTimeout(timer)
1777:     }
1778:   }
1779: }
