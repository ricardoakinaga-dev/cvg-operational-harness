459:   /**
460:    * Kernel view of the current run: the iterative active-duration budget and
461:    * the caller's cancel signal drive the shared pipelines.
462:    */
463:   private turnFor(run: LoopRun): TurnState {
464:     const entry = this.#turns.get(run)
465:     /* v8 ignore next -- defensive: the loop only asks for its own bound run */
466:     if (!entry) throw new Error('Kernel turn is not bound to this run.')
467:     return createTurnState(
468:       run.input,
469:       run.startedAtMs,
470:       {
471:         remainingMs: () => this.remainingDuration(run),
472:         withDeadline: async (operation, ms = this.remainingDuration(run)) => {
473:           const outcome = await this.withDeadline(
474:             ms <= 0 ? new Promise<never>(() => undefined) : operation(),
475:             ms
476:           )
477:           return outcome === DEADLINE_EXCEEDED ? DEADLINE : outcome
478:         },
479:         beginModelRequest: () => {
480:           // Single pre-model gate (PDSH-004 / I11): consume one slot.
481:           if (run.usage.modelCalls + 1 > run.input.budget.maxModelCalls) {
482:             return {
483:               kind: 'stop',
484:               stopReason: 'MAX_MODEL_CALLS',
485:               response:
486:                 'Model-call budget exhausted before the call was started.'
487:             }
488:           }
489:           this.accountUsage(run, {
490:             modelCalls: 1,
491:             inputTokens: 0,
492:             outputTokens: 0,
493:             costUsd: 0
494:           })
495:           return undefined
496:         },
497:         recordModelResult: (result) => {
498:           // Single post-result accounting site (PDSH-004).
499:           this.accountUsage(run, {
500:             modelCalls: 0,
501:             inputTokens: result.inputTokens,
502:             outputTokens: result.outputTokens,
503:             costUsd: result.costUsd
504:           })
505:           if (
506:             run.usage.inputTokens + run.usage.outputTokens >
507:             run.input.budget.maxTokens
508:           ) {
509:             return {
510:               kind: 'stop',
511:               stopReason: 'MAX_TOKENS',
512:               response:
513:                 'Token budget exhausted before a response could be completed.'
514:             }
515:           }
516:           if (run.usage.costUsd > run.input.budget.maxCostUsd) {
517:             return {
518:               kind: 'stop',
519:               stopReason: 'MAX_COST',
520:               response:
521:                 'Cost budget exhausted before a response could be completed.'
522:             }
523:           }
524:           return undefined
525:         }
526:       },
527:       entry.signal
528:     )
529:   }
