358: export class IterativeGovernedRuntime {
359:   public readonly runtimeVersion = RUNTIME_V2_VERSION
360:   public readonly orchestratorVersion: string
361:   private readonly contextEngine: ContextEngine
362:   private readonly completionEvaluatorOverride: CompletionEvaluator | undefined
363:   private readonly completionEvaluators = new Map<string, CompletionEvaluator>()
364:   private readonly clock: () => Date
365:   private readonly repeatThreshold: number
366:   private readonly maxSignatures: number
367:   private readonly maxObservationPayloadChars: number
368:   #kernel: Promise<KernelHost> | undefined
369:   readonly #turns = new WeakMap<
