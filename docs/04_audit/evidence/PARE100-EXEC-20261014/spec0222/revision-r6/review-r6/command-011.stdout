374:   public constructor(
375:     private readonly options: IterativeGovernedRuntimeOptions
376:   ) {
377:     this.contextEngine = options.contextEngine ?? new DefaultContextEngine()
378:     this.completionEvaluatorOverride = options.completionEvaluator
379:     this.clock = options.clock ?? (() => new Date())
380:     this.repeatThreshold = Math.max(
381:       1,
382:       options.loopDetection?.repeatThreshold ?? 2
383:     )
384:     this.maxSignatures = options.loopDetection?.maxSignatures ?? 12
385:     this.maxObservationPayloadChars =
386:       options.maxObservationPayloadChars ?? 4_000
387:     this.orchestratorVersion =
388:       options.orchestratorVersion ?? HYBRID_ORCHESTRATOR_VERSION
389:   }
390: 
391:   /**
392:    * Dependency surface handed to the extracted dispatch domain. It is built
393:    * here, where private members are accessible, so the exported class keeps
394:    * its exact public contract and the module never touches instance state
395:    * directly.
396:    */
397:   private get dispatchContext(): IterativeDispatchContext {
398:     return {
399:       options: this.options,
400:       maxObservationPayloadChars: this.maxObservationPayloadChars,
401:       stop: (stopReason, response) => this.stop(stopReason, response),
402:       operationKey: (run, stepNumber, toolId) =>
403:         this.operationKey(run, stepNumber, toolId),
404:       remainingDuration: (run) => this.remainingDuration(run),
405:       makeObservation: (run, input) => this.makeObservation(run, input),
406:       checkAfterUsage: (run) => this.checkAfterUsage(run),
407:       allowedDecisionTypes: (run) => this.allowedDecisionTypes(run),
408:       evaluatorFor: (run) => this.evaluatorFor(run),
409:       validateClaims: (run, responseText) =>
410:         this.validateClaims(run, responseText),
411:       withDeadline: (operation, remainingMs) =>
412:         this.withDeadline(operation, remainingMs),
413:       recordObservation: (run, observation) =>
414:         this.recordObservation(run, observation),
415:       recordStep: (run, input) => this.recordStep(run, input),
416:       persistCheckpoint: (run) => this.persistCheckpoint(run),
417:       safeAudit: (run, action, extras) => this.safeAudit(run, action, extras),
418:       composeResponse: (run, decision) => this.composeResponse(run, decision),
419:       kernel: (run) => this.kernelFor(run),
420:       turn: (run) => this.turnFor(run)
421:     }
422:   }
