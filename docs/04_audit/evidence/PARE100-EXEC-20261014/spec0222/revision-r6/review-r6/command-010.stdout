106: /** Appends to the kernel log; a failing log stops the turn (fail-closed). */
107: export async function appendLog(
108:   host: KernelHost,
139: export async function race<T>(
140:   turn: TurnState,
141:   operation: () => Promise<T>
142: ): Promise<T | typeof DEADLINE | typeof CANCELLED> {
143:   const signal = turn.signal
144:   if (signal.aborted) return CANCELLED
145:   let onAbort!: () => void
146:   const cancelled = new Promise<typeof CANCELLED>((resolve) => {
147:     onAbort = () => resolve(CANCELLED)
148:     signal.addEventListener('abort', onAbort, { once: true })
149:   })
150:   try {
151:     return await Promise.race([turn.budget.withDeadline(operation), cancelled])
152:   } finally {
153:     signal.removeEventListener('abort', onAbort)
154:   }
155: }
156: 
157: /**
158:  * Like `race`, but always starts the operation first: used once the kernel has
159:  * committed to dispatch, so the cancel signal is passed to the body instead of
160:  * skipping it.
161:  */
162: async function raceInvoked<T>(
163:   turn: TurnState,
164:   operation: () => Promise<T>
165: ): Promise<T | typeof DEADLINE | typeof CANCELLED> {
166:   const running = operation()
167:   // The operation may start and then find an exhausted deadline at race time;
168:   // its later rejection must never surface as an unhandled rejection.
169:   void running.catch(() => undefined)
170:   const signal = turn.signal
171:   let onAbort!: () => void
172:   const cancelled = new Promise<typeof CANCELLED>((resolve) => {
173:     if (signal.aborted) resolve(CANCELLED)
174:     onAbort = () => resolve(CANCELLED)
175:     signal.addEventListener('abort', onAbort, { once: true })
176:   })
177:   try {
178:     return await Promise.race([
179:       turn.budget.withDeadline(() => running),
180:       cancelled
181:     ])
182:   } finally {
183:     signal.removeEventListener('abort', onAbort)
184:   }
185: }
