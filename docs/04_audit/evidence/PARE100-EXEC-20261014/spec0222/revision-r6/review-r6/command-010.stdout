32: export const CANCELLED = Symbol('kernel-cancelled')
33: export const CANCELLED_RESPONSE = 'Execution was cancelled by the caller.'
34: 
35: export type GatePoint =
36:   | 'turn/before-step'
37:   | 'model/before-call'
38:   | 'tool/pre-execute'
