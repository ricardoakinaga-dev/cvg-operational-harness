40: /** A fresh turn: identity, budget view and the linked cancel signal. */
41: export function createTurnState(
42:   input: RuntimeInput,
43:   startedAt: number,
44:   budget: TurnBudget,
45:   signal: AbortSignal
46: ): TurnState {
47:   return {
48:     input,
49:     startedAt,
50:     signal,
51:     budget,
52:     metadata: {
53:       policy: null,
54:       approval: null,
55:       tool: null,
56:       provider: null,
57:       inputTokens: 0,
58:       outputTokens: 0,
59:       costUsd: 0,
60:       toolDurationMs: 0
61:     }
62:   }
63: }
