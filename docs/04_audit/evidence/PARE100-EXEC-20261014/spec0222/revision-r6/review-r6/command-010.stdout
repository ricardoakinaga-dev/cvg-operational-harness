65: /** Detached copy for the log, so later mutation cannot rewrite history. */
66: function snapshot<T>(value: T): T {
67:   try {
68:     return structuredClone(value)
69:   } catch {
70:     return value
71:   }
72: }
73: 
74: function errorMessage(error: unknown): string {
75:   return error instanceof Error ? error.message : 'unknown failure'
76: }
