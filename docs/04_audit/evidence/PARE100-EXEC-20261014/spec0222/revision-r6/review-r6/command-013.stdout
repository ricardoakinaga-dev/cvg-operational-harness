78: /** Read current Loader entries and optional preset compositions.
79:  * @param ctx Context with the Loader service.
80:  * @returns Current inventory with optional display metadata and no separate runtime cache.
81:  */
82: export async function readPluginInventory(ctx: Context): Promise<PluginInventorySnapshot> {
83:   const entries: PluginInventoryEntry[] = []
84:   const packages = ctx.get('pluginPackages')
85:   for (const entry of ctx.loader.entries()) {
86:     if (entry.options.group) continue
87:     const base = entry.parent.tree.ctx.baseUrl
88:     const meta = base === undefined ? undefined : packages?.metaOf(entry.options.name, base)
89:     entries.push({
90:       entryId: pluginEntryId(entry.id),
91:       moduleName: entry.options.name,
92:       enabled: !entry.disabled,
93:       fiberPhase: entry.fiber === undefined ? null : FIBER_PHASE[entry.fiber.state],
94:       ...meta === undefined ? {} : { meta },
95:     })
96:   }
97:   const presets = ctx.get('agentPresets')
98:   const management = ctx.get('pluginManager') === undefined ? {} : { managementAvailable: true }
99:   if (presets === undefined) return { entries, ...management }
100:   const agentPresets: AgentPresetPluginGroup[] = (await presets.compositionInventory()).map(
101:     composition => ({
102:       ...composition,
103:       rows: composition.rows.map(({ fiberState, ...row }) => {
104:         const meta = ctx.baseUrl === undefined ? undefined : packages?.metaOf(row.moduleName, ctx.baseUrl)
105:         return {
106:           ...row,
107:           fiberPhase: fiberState === undefined ? null : FIBER_PHASE[fiberState],
108:           ...meta === undefined ? {} : { meta },
109:         }
110:       }),
111:     }),
112:   )
113:   return { entries, agentPresets, ...management }
114: }
