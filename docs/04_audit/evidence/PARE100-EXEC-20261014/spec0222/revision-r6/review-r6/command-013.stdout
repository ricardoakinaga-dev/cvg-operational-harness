6: import type { Context } from '@deepseek-ai/cordis'
7: import type { InvariantInstaller } from '@deepseek-ai/dsh-invariants'
8: // Type-only: resolves the `system-prompt/assemble` waterfall this companion
9: // joins, and the `agent` field `dsh-agent` merges into its context.
10: import type {} from '@deepseek-ai/dsh-system-prompt'
11: import type {} from '@deepseek-ai/dsh-agent'
12: // Imported through the package name, not `./mount.ts`: a module shared between
13: // the two build entry points becomes a third chunk that the published `files`
14: // list does not carry, which `verify-built-package-invariants` rejects.
15: import { leakedServices, livePresetMounts } from '@deepseek-ai/dsh-agent-preset-registry'
17: const PACKAGE_NAME = '@deepseek-ai/dsh-agent-preset-registry'
19: /** Cordis companion plugin name. */
20: export const name = 'agent-presets-invariant'
21: /** Service required before the companion can reserve package ownership. */
22: export const inject = ['invariants']
24: /**
25:  * Assert that no installed preset composition reaches the root service realm,
26:  * and that a deployment configuring a roster composes every agent from it.
27:  *
28:  * `mountPreset` proves the first once, when the subtree settles. A row that
29:  * publishes later — from a timer, or an asynchronous continuation after its
30:  * plugin returned — would escape that one-shot audit, so re-check every live
31:  * mount whenever a service registration changes.
32:  */
33: const install: InvariantInstaller = (ctx, fail) => {
34:   ctx.on('internal/service', function (this: Context, name) {
35:     for (const mount of livePresetMounts()) {
36:       const leaked = leakedServices(ctx, mount.fiber)
37:       if (leaked.length === 0) continue
38:       fail(
39:         `preset "${mount.presetId}" published process-global service(s) [${leaked.join(', ')}] `
40:         + `after its mount was audited (observed while notifying "${name}") — `
41:         + 'a preset service must sit behind an `isolate` realm or move to the host composition',
42:       )
43:     }
44:   }, { global: true })
46:   // Bare Agents are valid until model assembly. Cold scoped reads carry no
47:   // Agent and do not require a session binding.
48:   ctx.on('system-prompt/assemble', (_assembly, context, next) => {
49:     const presets = ctx.get('agentPresets')
50:     const agent = context.agent
51:     if (presets !== undefined
52:       && agent !== undefined && presets.composedPreset(agent.ctx) === undefined) {
53:       fail(
54:         `agent "${agent.id}" addressed a model without joining any agent preset while a roster is `
55:         + 'composed; its tools, prompt sections, and skill catalog resolve against the empty global layer',
56:       )
57:     }
58:     return next()
59:   })
60: }
62: /**
63:  * Register this package's invariant companion.
64:  * @param ctx - Cordis context carrying the invariant service.
65:  * @returns the installed registration's disposer after setup succeeds.
66:  */
67: export const apply = (ctx: Context): Promise<() => void> =>
68:   Promise.resolve(ctx.invariants.register(PACKAGE_NAME, install))
