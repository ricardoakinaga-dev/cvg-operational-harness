FILE cvg/packages/sdk/src/composition.ts
1: import { InMemorySessionEventStore } from '@cvg/harness'
2: import type { SessionEvent } from '@cvg/harness-contracts'
3: import {
4:   createInProcessTransport,
5:   createSdkClient,
6:   type SdkClient,
7:   type SdkReadEventsOptions
8: } from './client.ts'
9: import {
10:   createSdkServer,
11:   type SdkServer,
12:   type SdkServerOptions
13: } from './server.ts'
14: import type {
15:   SdkHelloResult,
16:   SessionOpenResult,
17:   TurnSendResult
18: } from './protocol.ts'
20: export type SdkCompositionOptions = SdkServerOptions
22: export interface SdkFacade {
23:   readonly server: SdkServer
24:   readonly client: SdkClient
25:   hello(): Promise<SdkHelloResult>
26:   openSession(sessionId: string): Promise<SessionOpenResult>
27:   sendTurn(sessionId: string, userMessage: string): Promise<TurnSendResult>
28:   readEvents(
29:     sessionId: string,
30:     options?: SdkReadEventsOptions
31:   ): Promise<readonly SessionEvent[]>
32: }
34: /**
35:  * Full SDK composition: session events enabled. The store defaults to the
36:  * in-memory fixture; hosts inject a durable store for multi-process use.
37:  */
38: export function createSdk(options: SdkCompositionOptions): SdkFacade {
39:   const server = createSdkServer({
40:     ...options,
41:     sessions: options.sessions ?? new InMemorySessionEventStore()
42:   })
43:   const client = createSdkClient(createInProcessTransport(server))
44:   return {
45:     server,
46:     client,
47:     hello: () => client.hello(),
48:     openSession: (sessionId) => client.openSession(sessionId),
49:     sendTurn: (sessionId, userMessage) =>
50:       client.sendTurn(userMessage, sessionId),
51:     readEvents: (sessionId, readOptions) =>
52:       client.readEvents(sessionId, readOptions)
53:   }
54: }
56: /** Session methods are not part of the minimal composition. */
57: export type SdkMinimalOptions = Omit<SdkServerOptions, 'sessions'>
59: export interface SdkMinimalFacade {
60:   readonly server: SdkServer
61:   readonly client: SdkClient
62:   hello(): Promise<SdkHelloResult>
63:   sendTurn(userMessage: string): Promise<TurnSendResult>
64: }
66: /** Minimal SDK composition: stateless turns, no session store. */
67: export function createSdkMinimal(options: SdkMinimalOptions): SdkMinimalFacade {
68:   const server = createSdkServer(options)
69:   const client = createSdkClient(createInProcessTransport(server))
70:   return {
71:     server,
72:     client,
73:     hello: () => client.hello(),
74:     sendTurn: (userMessage) => client.sendTurn(userMessage)
75:   }
76: }
