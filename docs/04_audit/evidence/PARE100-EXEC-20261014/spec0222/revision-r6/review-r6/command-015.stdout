208:   private async retain(id?: string): Promise<Generation> {
209:     const wanted = id ?? this.defaultId
210:     while (true) {
211:       const record = this.definitions.get(wanted)
212:       if (record === undefined) throw new RemoteError('agent-preset/not-found', `Unknown agent preset: ${wanted}`,
213:         { agentPreset: wanted, available: [...this.definitions.keys()] })
214:       const broken = await this.diagnostic(record)
215:       if (this.definitions.get(wanted) !== record) continue
216:       const generation = record.generation
217:       if (broken !== undefined || generation === undefined) {
218:         const reason = broken as string
219:         throw new RemoteError('agent-preset/invalid', reason, { agentPreset: wanted, reason })
220:       }
221:       generation.users++
222:       return generation
223:     }
224:   }
225: 
226:   private async bind(ctx: Context, generation: Generation): Promise<void> {
227:     const key = scopeOf(ctx)
228:     if (key === undefined) throw new Error('Agent preset binding requires a scoped context')
229:     const binding = this.bindings.get(key)
230:     if (binding?.generation === generation) return
231:     if (binding !== undefined) {
232:       binding.parent.rebind(generation.key)
233:       const old = binding.generation
234:       generation.users++
235:       binding.generation = generation
236:       old.users--
237:       await this.collect(old)
238:     } else this.join(ctx, key, generation)
239:   }
240: 
241:   private join(ctx: Context, key: ScopeKey, generation: Generation): void {
242:     const binding = { parent: bindScopeParent(key, generation.key), generation }
243:     generation.users++
244:     this.bindings.set(key, binding)
245:     ctx.effect(() => async () => {
246:       this.bindings.delete(key)
247:       binding.generation.users--
248:       await this.collect(binding.generation)
249:     }, 'agent-preset.binding')
250:   }
251: 
252:   /** Bind an unpublished Agent to the current preset revision.
253:    * @param ctx Agent context from its setup callback.
254:    * @param id Requested preset, or the default.
255:    * @returns Bound preset identity.
256:    */
257:   async mount(ctx: Context, id?: string): Promise<AgentPreset> {
258:     const generation = await this.retain(id)
259:     try {
260:       await this.bind(ctx, generation)
261:       return { id: generation.mount.presetId }
262:     } finally {
263:       generation.users--
264:       await this.collect(generation)
265:     }
266:   }
