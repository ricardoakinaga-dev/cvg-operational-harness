155:   /** Watch a configuration path through the same queue as module replacement.
156:    * @param filename Absolute path, which may not exist yet.
157:    * @param refresh Rebuilds configuration from its current files and awaits Loader completion.
158:    * @returns Disposer closing this registration and waiting for its pending refresh.
159:    */
160:   async watchConfig(filename: string, refresh: () => Promise<void>): Promise<() => Promise<void>> {
161:     const paths = [resolve(filename), canonicalPath(filename)]
162:     if (paths.some(path => this.configPaths.has(path))) throw new Error(`config path already registered: ${filename}`)
163:     for (const path of paths) this.configPaths.add(path)
164:     try {
165:       const dispose = await this.executing.exit(() => watchExactConfig(
166:         this.ownerContext, filename, this.config, () => this.runReload(refresh), () => this.executing.getStore() === true,
167:       ))
168:       return async () => {
169:         await dispose()
170:         for (const path of paths) this.configPaths.delete(path)
171:       }
172:     } catch (error) {
173:       for (const path of paths) this.configPaths.delete(path)
174:       throw error
175:     }
