135:   /** Serialize a caller-owned mutation with all automatic reload paths.
136:    * @param operation Work that must not overlap module or configuration replacement.
137:    * @returns The operation result after its asynchronous work completes.
138:    */
139:   runExclusive<T>(operation: () => Promise<T>): Promise<T> {
140:     if (this.executing.getStore()) return Promise.reject(new Error('HMR transactions cannot be nested'))
141:     const task = this.operations.then(async () => {
142:       if (this.closing) throw new Error('HMR is disposed')
143:       return this.executing.run(true, operation)
144:     })
145:     this.operations = task.catch(() => {})
146:     return task
147:   }
