120:   /**
121:    * Current activation diagnostic of a definition.
122:    *
123:    * A mount failure is final. A mounted tree is re-audited on every read: a
124:    * row waiting for a Host service activates by itself once that provider
125:    * finishes, so the audit waits for the Host Loader tree to settle before
126:    * reporting the row as unusable. Callers therefore must not run inside a
127:    * Host row's own activation, which the settlement would wait on.
128:    * @param record - the definition to audit.
129:    * @returns one line per unusable row, or undefined when the definition is usable.
130:    */
131:   private async diagnostic(record: Definition): Promise<string | undefined> {
132:     await record.ready
133:     if (record.generation === undefined) return record.broken
134:     const tree = record.generation.mount.tree
135:     let audit = await auditRows(tree)
136:     if (audit.pending.length > 0) {
137:       await this.owner.loader.await()
138:       audit = await auditRows(tree)
139:     }
140:     const lines = [...audit.failed, ...audit.pending]
141:     return lines.length === 0 ? undefined : lines.join('\n')
142:   }
143: 
144:   private async collect(generation: Generation): Promise<void> {
145:     if (!generation.retired || generation.users !== 0) return
146:     this.generations.delete(generation.key)
147:     await generation.scope.dispose()
148:   }
