1: export type ShutdownSignal = 'SIGTERM' | 'SIGINT'
2: 
3: export interface SignalSource {
4:   once(event: string, listener: () => void): unknown
5: }
6: 
7: export interface ShutdownEvent {
8:   type:
9:     | 'shutdown.started'
10:     | 'shutdown.completed'
11:     | 'shutdown.failed'
12:     | 'shutdown.timeout'
13:     | 'shutdown.ignored'
14:   signal?: ShutdownSignal
15:   code?: number
16:   error?: string
17: }
18: 
19: export interface ShutdownControllerOptions {
20:   close: () => Promise<void> | void
21:   flush?: () => Promise<void> | void
22:   exit: (code: number) => void
23:   log?: (event: ShutdownEvent) => void
24:   timeoutMs?: number
25:   signals?: ShutdownSignal[]
26: }
27: 
28: export interface ShutdownController {
29:   shutdown(signal?: ShutdownSignal, code?: number): Promise<void>
30:   install(source: SignalSource): void
31:   isShuttingDown(): boolean
32: }
33: 
34: /**
35:  * Graceful shutdown: stop accepting work (caller closes the server/pool),
36:  * flush telemetry, then exit. Repeated signals are ignored; a hung close is
37:  * bounded by a timeout that still exits non-zero.
38:  */
39: export function createShutdownController(
40:   options: ShutdownControllerOptions
41: ): ShutdownController {
42:   const timeoutMs = options.timeoutMs ?? 15_000
43:   const signals = options.signals ?? ['SIGTERM', 'SIGINT']
44:   let shuttingDown = false
45: 
46:   const emit = (event: ShutdownEvent): void => {
47:     options.log?.(event)
48:   }
49: 
50:   const shutdown = async (
51:     signal: ShutdownSignal = 'SIGTERM',
52:     code = 0
53:   ): Promise<void> => {
54:     if (shuttingDown) {
55:       emit({ type: 'shutdown.ignored', signal })
56:       return
57:     }
58:     shuttingDown = true
59:     emit({ type: 'shutdown.started', signal })
60:     let settled = false
61:     const timer = setTimeout(() => {
62:       if (settled) return
63:       settled = true
64:       emit({ type: 'shutdown.timeout', signal })
65:       options.exit(1)
66:     }, timeoutMs)
67:     timer.unref?.()
68:     try {
69:       await options.close()
70:       await options.flush?.()
71:       if (settled) return
72:       settled = true
73:       clearTimeout(timer)
74:       emit({ type: 'shutdown.completed', signal, code })
75:       options.exit(code)
76:     } catch (error) {
77:       if (settled) return
78:       settled = true
79:       clearTimeout(timer)
80:       emit({
81:         type: 'shutdown.failed',
82:         signal,
83:         error: error instanceof Error ? error.message : 'unknown_error'
84:       })
85:       options.exit(1)
86:     }
87:   }
88: 
89:   const install = (source: SignalSource): void => {
90:     for (const signal of signals) {
91:       source.once(signal, () => {
92:         void shutdown(signal)
93:       })
94:     }
95:   }
96: 
97:   return {
98:     shutdown,
99:     install,
100:     isShuttingDown: () => shuttingDown
101:   }
102: }
