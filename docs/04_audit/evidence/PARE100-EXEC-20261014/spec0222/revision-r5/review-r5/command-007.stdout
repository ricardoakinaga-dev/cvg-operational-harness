1: import type {
2:   ApprovalEngine,
3:   AuditSink,
4:   ModelGateway,
5:   Orchestrator,
6:   PolicyEngine,
7:   SandboxGate,
8:   TelemetrySink,
9:   ToolRegistry
10: } from '@cvg/harness-contracts'
11: import {
12:   approvalsControl,
13:   auditControl,
14:   budgetControl,
15:   effectsControl,
16:   logControl,
17:   modelCapability,
18:   pauseControl,
19:   plannerCapability,
20:   policyControl,
21:   sandboxControl,
22:   telemetryCapability,
23:   toolsCapability
24: } from './controls.ts'
25: import { KernelRuntime } from './kernel-runtime.ts'
26: import type {
27:   EffectLedger,
28:   KernelLog,
29:   KernelPlugin,
30:   PauseSwitch
31: } from './types.ts'
32: 
33: export interface StandardKernelOptions {
34:   readonly orchestrator: Orchestrator
35:   readonly modelGateway: ModelGateway
36:   readonly policy: PolicyEngine
37:   readonly approvals: ApprovalEngine
38:   readonly tools: ToolRegistry
39:   readonly capabilityFingerprint?: string
40:   readonly audit: AuditSink
41:   readonly telemetry: TelemetrySink
42:   readonly pause?: PauseSwitch
43:   readonly log?: KernelLog
44:   readonly effects?: EffectLedger
45:   /** Optional containment gate; absent means fail-closed for contained tools. */
46:   readonly sandbox?: SandboxGate
47:   /** Audit action and telemetry event name; defaults to `harness.kernel`. */
48:   readonly eventName?: string
49:   /** Extra plugins mounted after the standard profile. */
50:   readonly plugins?: readonly KernelPlugin[]
51: }
52: 
53: /**
54:  * The standard profile: every control the kernel requires (I1), in a fixed
55:  * order, followed by the capabilities of the single-turn loop.
56:  */
57: export function standardKernelPlugins(
58:   options: StandardKernelOptions
59: ): KernelPlugin[] {
60:   const eventName = options.eventName ?? 'harness.kernel'
61:   return [
62:     budgetControl(),
63:     pauseControl(options.pause),
64:     logControl(options.log),
65:     effectsControl(options.effects),
66:     policyControl(options.policy),
67:     approvalsControl(
68:       options.approvals,
69:       options.capabilityFingerprint
70:         ? { capabilityFingerprint: options.capabilityFingerprint }
71:         : {}
72:     ),
73:     auditControl(options.audit, { action: eventName }),
74:     ...(options.sandbox ? [sandboxControl(options.sandbox)] : []),
75:     plannerCapability(options.orchestrator),
76:     modelCapability(options.modelGateway),
77:     toolsCapability(options.tools),
78:     telemetryCapability(options.telemetry, { name: eventName }),
79:     ...(options.plugins ?? [])
80:   ]
81: }
82: 
83: /** Kernel runtime with the standard profile, booted on first use. */
84: export function createKernelRuntime(
85:   options: StandardKernelOptions
86: ): KernelRuntime {
87:   return KernelRuntime.lazy(standardKernelPlugins(options))
88: }
