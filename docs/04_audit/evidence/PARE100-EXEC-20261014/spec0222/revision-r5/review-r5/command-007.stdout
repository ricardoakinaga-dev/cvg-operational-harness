302: export type ServiceKey = keyof Services
303: 
304: /** Services only control plugins may provide (SPEC 0181 I1/I2). */
305: export const CONTROL_SERVICES = [
306:   'policy',
307:   'approvals',
308:   'effects',
309:   'audit',
310:   'budget',
311:   'pause',
312:   'log'
313: ] as const satisfies readonly ServiceKey[]
314: 
315: /**
316:  * Containment is optional (SPEC 0195): the pipeline resolves it via
317:  * `host.get('sandbox')` and fails closed when it is absent, so it must never
318:  * join REQUIRED_SERVICES.
319:  */
320: export const OPTIONAL_SERVICES = [
321:   'sandbox'
322: ] as const satisfies readonly ServiceKey[]
323: 
324: /** Capabilities the single-turn loop needs to run. */
325: export const LOOP_CAPABILITIES = [
326:   'planner',
327:   'model',
328:   'tools',
329:   'telemetry'
330: ] as const satisfies readonly ServiceKey[]
331: 
332: export interface KernelContext {
333:   provide<K extends ServiceKey>(key: K, service: Services[K]): Disposer
334:   get<K extends ServiceKey>(key: K): Services[K]
335:   on<P extends HookPoint>(point: P, listener: HookMap[P]): Disposer
336:   /** Control plugins only. */
337:   guard(guard: ToolGuard): Disposer
338:   /** Register teardown work for resources the plugin owns. */
339:   effect(dispose: Disposer): void
340: }
341: 
342: export interface KernelPlugin {
