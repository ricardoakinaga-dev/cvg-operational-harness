686:  * Audit is fail-closed (I10): a failed or late record turns the result into
687:  * `INSUFFICIENT_EVIDENCE`, and it keeps a minimum window after the budget ran
688:  * out so an effect is never left unrecorded.
689:  */
690: export function auditControl(
691:   audit: AuditSink,
692:   options: AuditControlOptions = {}
693: ): KernelPlugin {
694:   const action = options.action ?? 'harness.kernel'
695:   return {
696:     name: 'control.audit',
697:     kind: 'control',
698:     provides: ['audit'],
699:     requires: ['budget'],
700:     apply(ctx) {
701:       ctx.provide('audit', audit)
702:       ctx.on('turn/end', async (turn, result) => {
703:         try {
704:           const window = Math.max(turn.budget.remainingMs(), AUDIT_GRACE_MS)
705:           const recorded = await turn.budget.withDeadline(
706:             () =>
707:               audit.append({
708:                 actor: turn.input.agent.id,
709:                 agent: turn.input.agent.id,
710:                 tenant: turn.input.tenantId,
711:                 action,
712:                 policy: turn.metadata.policy,
713:                 approval: turn.metadata.approval,
714:                 tool: turn.metadata.tool,
715:                 result: result.stopReason,
716:                 timestamp: new Date().toISOString(),
717:                 traceId: turn.input.traceId,
718:                 correlationId: turn.input.correlationId
719:               }),
720:             window
721:           )
722:           if (recorded === DEADLINE) throw new Error('audit deadline exceeded')
723:           return result
724:         } catch {
725:           return {
726:             ...result,
727:             response:
728:               'Execution could not be completed because audit recording failed.',
729:             stopReason: 'INSUFFICIENT_EVIDENCE'
730:           }
731:         }
732:       })
733:     }
734:   }
735: }
