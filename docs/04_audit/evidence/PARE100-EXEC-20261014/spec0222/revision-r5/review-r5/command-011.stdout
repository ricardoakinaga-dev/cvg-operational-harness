1764:   private async withDeadline<T>(
1765:     operation: Promise<T>,
1766:     remainingMs: number
1767:   ): Promise<T | typeof DEADLINE_EXCEEDED> {
1768:     if (remainingMs <= 0) return DEADLINE_EXCEEDED
1769:     let timer!: ReturnType<typeof setTimeout>
1770:     const deadline = new Promise<typeof DEADLINE_EXCEEDED>((resolve) => {
1771:       timer = setTimeout(() => resolve(DEADLINE_EXCEEDED), remainingMs)
1772:     })
1773:     try {
1774:       return await Promise.race([operation, deadline])
1775:     } finally {
1776:       clearTimeout(timer)
1777:     }
1778:   }
1779: }
