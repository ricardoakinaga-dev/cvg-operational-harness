FILE reference/packages/preset/agent-preset-registry/src/mount.ts 258 313
258: export async function mountPreset(ctx: Context, id: string, plugins: PresetDefinition['plugins']): Promise<PresetMount> {
259:   if (scopeOf(ctx) === undefined) throw new Error('agent-preset: mounting requires a scope')
260:   await ctx.fiber.await()
261:   const tree = new PresetTree(ctx)
262:   ctx.effect(() => () =>{  tree.root.stop() }, 'agent-preset.tree')
263:   await tree.root.update(prepareProfileEntries(ctx, plugins as EntryOptions[], ctx.baseUrl))
264:   const audit = await auditRows(tree)
265:   const leaked = leakedServices(ctx, ctx.fiber)
266:   if (audit.failed.length > 0) throw new Error(audit.failed.join('\n'))
267:   if (leaked.length > 0) throw new Error(`Preset services require isolate realms: ${leaked.join(', ')}`)
268:   const mount = { presetId: id, fiber: ctx.fiber, tree, key: scopeOf(ctx) }
269:   mounts.add(mount)
270:   ctx.effect(() => () => { mounts.delete(mount) }, 'agent-preset.mount')
271:   return mount
272: }

