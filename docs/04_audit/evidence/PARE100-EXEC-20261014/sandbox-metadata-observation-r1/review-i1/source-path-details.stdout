187: /** Monotonic guards: the first denial wins; a throwing guard denies. */
188: export async function runGuards(
189:   host: KernelHost,
190:   call: ToolCallState
191: ): Promise<KernelStop | undefined> {
192:   for (const guard of host.guards()) {
193:     let verdict: GuardVerdict
194:     try {
195:       verdict = await guard(call)
196:     } catch (error) {
197:       verdict = `A guard failed: ${errorMessage(error)}.`
198:     }
199:     if (typeof verdict === 'string') return stop('POLICY_DENIED', verdict)
200:     if (verdict) {
201:       return stop(
202:         verdict.stopReason,
203:         verdict.reason,
204:         verdict.cause ? { cause: verdict.cause } : {}
205:       )
206:     }
207:   }
208:   return undefined
209: }
210: 
211: /**
212:  * Guards and cancellation, re-run at every point where the world may have
213:  * changed before dispatch: after the loop's checkpoint and after the approval
214:  * reservation (AUD-0597 F01/F02).
215:  */
216: export async function revalidate(
217:   host: KernelHost,
218:   call: ToolCallState
219: ): Promise<KernelStop | undefined> {
220:   return (
221:     (await runGuards(host, call)) ??
222:     (call.turn.signal.aborted
223:       ? stop('CANCELLED', CANCELLED_RESPONSE)
224:       : undefined)
225:   )
226: }
