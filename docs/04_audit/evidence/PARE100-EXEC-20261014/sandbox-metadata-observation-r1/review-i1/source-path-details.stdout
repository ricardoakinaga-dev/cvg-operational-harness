355:       ctx.on('tool/pre-execute', async (call, next) => {
356:         const { turn, tool, invocation } = call
357:         let decision
358:         try {
359:           const decisionOrDeadline = await turn.budget.withDeadline(() =>
360:             policy.evaluate({
361:               tenantId: turn.input.tenantId,
362:               agentId: turn.input.agent.id,
363:               action: 'tool.execute',
364:               tool,
365:               invocation,
366:               correlationId: turn.input.correlationId
367:             })
368:           )
369:           if (decisionOrDeadline === DEADLINE) {
370:             return stop(
371:               'MAX_DURATION',
372:               'Duration budget exhausted during policy evaluation.'
373:             )
374:           }
375:           decision = decisionOrDeadline
376:           turn.metadata.policy = decision.outcome
377:           call.policyDecision = decision
