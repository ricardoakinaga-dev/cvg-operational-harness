106: interface ResultValues {
107:   readonly response: string
108:   readonly stopReason: RuntimeResult['stopReason']
109:   readonly approvalId?: RuntimeResult['approvalId']
110:   readonly modelCalls: number
111:   readonly toolCalls: number
112:   readonly inputTokens?: number
113:   readonly outputTokens?: number
114:   readonly costUsd?: number
115:   readonly toolResult?: ToolResult
116: }
117: 
118: function result(values: ResultValues): RuntimeResult {
119:   return {
120:     response: values.response,
121:     stopReason: values.stopReason,
122:     ...(values.approvalId !== undefined
123:       ? { approvalId: values.approvalId }
124:       : {}),
125:     steps: 1,
126:     modelCalls: values.modelCalls,
127:     toolCalls: values.toolCalls,
128:     usage: {
129:       inputTokens: values.inputTokens ?? 0,
130:       outputTokens: values.outputTokens ?? 0,
131:       costUsd: values.costUsd ?? 0
132:     },
133:     ...(values.toolResult ? { toolResult: values.toolResult } : {})
134:   }
135: }
136: 
137: function fromStop(gate: KernelStop): RuntimeResult {
138:   return result({
139:     response: gate.response,
140:     stopReason: gate.stopReason,
141:     ...(gate.approvalId !== undefined ? { approvalId: gate.approvalId } : {}),
142:     modelCalls: gate.modelCalls ?? 0,
143:     toolCalls: gate.toolCalls ?? 0,
144:     ...(gate.usage ?? {})
145:   })
146: }
