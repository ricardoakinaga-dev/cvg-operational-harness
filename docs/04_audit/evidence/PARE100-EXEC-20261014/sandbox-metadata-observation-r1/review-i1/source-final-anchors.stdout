9: export type EffectJournalState =
10:   | 'RESERVED'
11:   | 'EFFECT_STARTED'
12:   | 'CONFIRMED'
13:   | 'FAILED'
14:   | 'UNCERTAIN'
15: 
16: export interface EffectJournalRecord {
17:   readonly tenantId: string
18:   readonly operationKey: string
19:   readonly proposalHash: string
20:   readonly state: EffectJournalState
21:   readonly attemptId: string
22:   readonly result?: unknown
23:   readonly error?: string
24:   readonly createdAt: string
25:   readonly updatedAt: string
26: }
27: 
28: export interface EffectJournal {
29:   reserve(input: {
30:     tenantId: string
31:     operationKey: string
32:     proposalHash: string
33:     attemptId: string
34:   }): Promise<EffectJournalRecord>
35:   markStarted(input: {
36:     tenantId: string
37:     operationKey: string
38:     attemptId: string
39:   }): Promise<EffectJournalRecord>
40:   confirm(input: {
41:     tenantId: string
42:     operationKey: string
43:     attemptId: string
44:     result: unknown
45:   }): Promise<EffectJournalRecord>
46:   fail(input: {
47:     tenantId: string
48:     operationKey: string
49:     attemptId: string
50:     error: string
51:   }): Promise<EffectJournalRecord>
52:   markUncertain(input: {
53:     tenantId: string
54:     operationKey: string
55:     attemptId: string
56:     reason: string
57:   }): Promise<EffectJournalRecord>
58:   get(
59:     tenantId: string,
60:     operationKey: string
61:   ): Promise<EffectJournalRecord | null>
62: }
