106: /** Appends to the kernel log; a failing log stops the turn (fail-closed). */
107: export async function appendLog(
108:   host: KernelHost,
109:   event: KernelLogEvent
110: ): Promise<KernelStop | undefined> {
111:   try {
112:     await host.get('log').append(event)
113:     return undefined
114:   } catch (error) {
115:     return stop(
116:       'INSUFFICIENT_EVIDENCE',
117:       `Kernel log could not record the turn: ${errorMessage(error)}.`
118:     )
119:   }
120: }
