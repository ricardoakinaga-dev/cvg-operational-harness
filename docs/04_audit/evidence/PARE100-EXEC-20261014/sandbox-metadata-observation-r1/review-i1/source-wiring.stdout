44: /**
45:  * Plugin host (SPEC 0181 §2). Plugins find each other by service key, load in
46:  * dependency order and register reversible effects. After boot the host is
47:  * sealed: no plugin, agent or configuration can add, remove or reorder a
48:  * registration while turns run (I2).
49:  */
50: export class KernelHost {
51:   readonly #services = new Map<ServiceKey, { owner: string; value: unknown }>()
