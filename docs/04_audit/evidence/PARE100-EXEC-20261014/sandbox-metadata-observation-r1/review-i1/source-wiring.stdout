320:     validateInput = (
321:       implementation.validateInput as CapabilityImplementation['validateInput']
322:     ).bind(value)
323:     execute = (
324:       implementation.execute as CapabilityImplementation['execute']
325:     ).bind(value)
326:     validateOutput = (
327:       implementation.validateOutput as CapabilityImplementation['validateOutput']
328:     ).bind(value)
329:   } catch {
330:     throw new CapabilityRegistryError(
331:       'invalid_implementation',
332:       'Capability implementation requires input validation, execution, and output validation'
333:     )
334:   }
335:   return Object.freeze({
336:     validateInput,
337:     execute,
338:     validateOutput
