122: /**
123:  * A call that was blocked and whose closing record was then lost: the turn
124:  * reports the missing evidence without hiding why the call was blocked
125:  * (AUD-0598 R04, AUD-0599 F01).
126:  */
127: export function unrecordedBlock(
128:   lost: KernelStop,
129:   blocked: KernelStop
130: ): KernelStop {
131:   return stop(
132:     'INSUFFICIENT_EVIDENCE',
133:     `${lost.response} The call was blocked before it started: ${blocked.response}`,
134:     blocked.approvalId !== undefined ? { approvalId: blocked.approvalId } : {}
135:   )
136: }
