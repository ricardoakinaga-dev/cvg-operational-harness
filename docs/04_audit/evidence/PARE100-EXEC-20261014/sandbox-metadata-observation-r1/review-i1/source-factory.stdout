87: export interface Phase3ToolObserver {
88:   (event: { toolId: string; operationKey: string; input: unknown }): void
89: }
90: 
91: export function createPhase3ToolRegistry(options: {
92:   readonly availability: 'AVAILABLE' | 'UNAVAILABLE'
93:   readonly reserveFails?: boolean
94:   readonly observe?: Phase3ToolObserver
95: }): ToolRegistry {
96:   const availabilityTool: ToolDefinition = {
97:     id: PHASE3_TOOL_AVAILABILITY,
98:     version: 'v1',
99:     description: 'Checks the synthetic resource availability.',
100:     inputSchema: { type: 'object' },
101:     outputSchema: { type: 'object' },
102:     risk: 'LOW',
103:     sideEffect: 'READ',
104:     idempotent: true,
105:     requiresApproval: false,
106:     execute: async (input, context): Promise<ToolResult> => {
107:       options.observe?.({
108:         toolId: availabilityTool.id,
109:         operationKey: context.operationKey ?? '',
110:         input
111:       })
112:       return {
113:         status: 'SUCCEEDED',
114:         output:
115:           options.availability === 'AVAILABLE'
116:             ? { available: true }
117:             : { available: false, reason: 'occupied' }
118:       }
119:     }
120:   }
121:   const reserveTool: ToolDefinition = {
122:     id: PHASE3_TOOL_RESERVE,
123:     version: 'v1',
124:     description: 'Creates a synthetic reservation.',
125:     inputSchema: { type: 'object' },
126:     outputSchema: { type: 'object' },
127:     risk: 'MEDIUM',
128:     sideEffect: 'WRITE',
129:     idempotent: false,
130:     requiresApproval: false,
131:     execute: async (input, context): Promise<ToolResult> => {
132:       options.observe?.({
133:         toolId: reserveTool.id,
134:         operationKey: context.operationKey ?? '',
135:         input
136:       })
137:       if (options.reserveFails) {
138:         return { status: 'FAILED', error: 'synthetic failure' }
139:       }
140:       return {
141:         status: 'SUCCEEDED',
142:         output: { reservationRef: 'reservation-0001', applied: true }
143:       }
144:     }
145:   }
146:   const tools = [availabilityTool, reserveTool]
147:   return {
148:     list: () => tools,
149:     resolve: (toolId, version) =>
150:       tools.find(
151:         (tool) =>
152:           tool.id === toolId &&
153:           (version === undefined || tool.version === version)
154:       )
155:   }
156: }
