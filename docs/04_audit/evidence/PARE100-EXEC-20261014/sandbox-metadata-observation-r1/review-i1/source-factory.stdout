199: /** Requires all requested categories to be present before SUFFICIENT. */
200: export class CategorySufficiencyEvaluator implements SufficiencyEvaluator {
201:   public async evaluate(input: {
202:     readonly query: string
203:     readonly requestedCategories: readonly string[]
204:     readonly observations: readonly {
205:       readonly payload: unknown
206:     }[]
207:   }): Promise<SufficiencyEvaluation> {
208:     const found = new Map<string, Set<string>>()
209:     for (const observation of input.observations) {
210:       const payload = observation.payload as {
211:         items?: readonly {
212:           itemId: string
213:           category?: string
214:           sourceId: string
215:         }[]
216:       } | null
217:       for (const item of payload?.items ?? []) {
218:         const category = item.category ?? 'unknown'
219:         const sources = found.get(category) ?? new Set<string>()
220:         sources.add(item.sourceId)
221:         found.set(category, sources)
222:       }
223:     }
224:     const requested =
225:       input.requestedCategories.length > 0
226:         ? input.requestedCategories
227:         : [...found.keys()]
228:     const missing = requested.filter((category) => !found.has(category))
229:     const conflicting = requested.filter(
230:       (category) => (found.get(category)?.size ?? 0) > 1
231:     )
232:     const covered = requested.filter((category) => found.has(category))
233:     if (missing.length === 0 && conflicting.length === 0) {
234:       return {
235:         level: 'SUFFICIENT',
236:         reasonCode: 'ALL_CATEGORIES_COVERED',
237:         missingCategories: [],
238:         conflictingSources: [],
239:         coveredCategories: covered
240:       }
241:     }
242:     if (missing.length === 0) {
243:       return {
244:         level: 'CONFLICTING',
245:         reasonCode: 'CONFLICTING_SOURCES',
246:         missingCategories: [],
247:         conflictingSources: conflicting,
248:         coveredCategories: covered
249:       }
250:     }
251:     return {
252:       level: covered.length > 0 ? 'PARTIAL' : 'INSUFFICIENT',
253:       reasonCode: 'MISSING_CATEGORIES',
254:       missingCategories: missing,
255:       conflictingSources: conflicting,
256:       coveredCategories: covered
257:     }
258:   }
259: }
