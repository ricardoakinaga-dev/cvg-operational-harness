96: def check_run(folder):
97:     meta = json.loads((folder / 'process.json').read_text())
98:     require(meta['exitCode'] == 0 and meta['joined'] and not meta['remainingProcessGroup'] and meta['violation'] is None and meta['subreaper'], 'process lifecycle')
99:     require(meta['sourcesUnchanged'] and not meta['newSourcePaths'] and meta['pins'] == 465, 'source integrity metadata')
100:     before = json.loads((folder / 'sources-before.json').read_text())
101:     after = json.loads((folder / 'sources-after.json').read_text())
102:     require(before == after and len(before) == meta['sourceFiles'], 'source sentinel')
103:     for file, expected in before.items():
104:         require(hashlib.sha256(Path(file).read_bytes()).hexdigest() == expected, 'live source drift: ' + file)
105:     stream = folder / 'stdout.txt'
106:     raw = stream.read_bytes()
107:     require(0 < len(raw) <= 1048576 and len(raw) == meta['streams']['stdout']['bytes'] and hashlib.sha256(raw).hexdigest() == meta['streams']['stdout']['sha256'], 'stdout integrity')
108:     require(meta['streams']['stderr'] == {'bytes': 0, 'status': 'expected_empty', 'file_omitted': True}, 'stderr not empty')
109:     return json.loads(raw), meta
110: 
111: if __name__ == '__main__':
112:     folder = Path(sys.argv[1])
113:     data, process = check_run(folder)
114:     result = evaluate(data)
115:     mutations = []
116:     def reject(name, change):
117:         mutant = copy.deepcopy(data)
118:         change(mutant)
119:         try:
120:             evaluate(mutant)
121:         except (ValueError, KeyError, TypeError, IndexError):
122:             mutations.append({'name': name, 'result': 'REJECTED'})
123:             return
124:         raise ValueError('Invalid observation accepted: ' + name)
125:     reject('missing target', lambda d: d['cases'].pop(1))
