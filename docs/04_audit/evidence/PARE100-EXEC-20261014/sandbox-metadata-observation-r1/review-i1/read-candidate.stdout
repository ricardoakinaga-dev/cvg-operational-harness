129:     reject('missing direct gate', lambda d: d['cases'][0]['gateCalls'].clear())
130:     reject('extra model call', lambda d: d['cases'][1]['modelCalls'].append({}))
131:     reject('extra approval', lambda d: d['cases'][1]['approvalRequests'].append({}))
132:     reject('forged metadata retention', lambda d: d['cases'][1]['submittedDescriptor'].__setitem__('sandbox', 'WORKSPACE'))
133:     reject('changed echo', lambda d: d['cases'][1]['nativeResult']['toolResult']['output'].__setitem__('text', 'forged'))
134:     reject('lost kernel event', lambda d: d['cases'][1]['kernelLogEvents'].pop(1))
135:     reject('wrong requested key', lambda d: d['cases'][1]['input']['requestedTool'].__setitem__('operationKey', 'forged'))
