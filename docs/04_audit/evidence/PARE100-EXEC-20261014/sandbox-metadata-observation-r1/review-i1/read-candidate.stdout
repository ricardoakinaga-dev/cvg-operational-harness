31: // Explicitly preserve otherwise non-JSON data; no silent function/undefined loss.
32: function capture(value: unknown, depth = 0): unknown {
33:   if (depth > 64) throw new Error("observation depth exceeded");
34:   if (value === undefined) return { $type: "undefined" };
35:   if (typeof value === "function") return { $type: "function" };
36:   if (
37:     value === null ||
38:     typeof value === "string" ||
39:     typeof value === "boolean"
40:   ) {
41:     return value;
42:   }
43:   if (typeof value === "number" && Number.isFinite(value)) return value;
44:   if (value instanceof AbortSignal) {
45:     return {
46:       $type: "AbortSignal",
47:       aborted: value.aborted,
48:       reason: capture(value.reason, depth + 1),
49:     };
50:   }
51:   if (Array.isArray(value))
52:     return value.map((item) => capture(item, depth + 1));
53:   if (typeof value !== "object")
54:     throw new Error("unsupported observation value");
55:   const proto: unknown = Object.getPrototypeOf(value);
56:   if (proto !== Object.prototype && proto !== null) {
57:     throw new Error("unsupported observation object");
58:   }
59:   const result: Record<string, unknown> = {};
60:   for (const key of Reflect.ownKeys(value)) {
61:     if (typeof key !== "string") throw new Error("unsupported observation key");
62:     const property = Object.getOwnPropertyDescriptor(value, key);
63:     if (!property || !("value" in property)) {
64:       throw new Error("observation getter refused");
65:     }
66:     result[key] = capture(property.value, depth + 1);
67:   }
68:   return result;
69: }
70: 
71: async function observe(route: "direct" | "capability", mode: SandboxMode) {
72:   const caseId = `${route}-${mode}`;
73:   const bodyCalls: unknown[] = [];
74:   const gateCalls: unknown[] = [];
75:   const modelCalls: unknown[] = [];
76:   const decisions: unknown[] = [];
77:   const operationKey = `sandbox-metadata-${caseId}`;
78:   const descriptor: CapabilityDescriptor = {
79:     id,
80:     version,
81:     description: "Synthetic memory-only metadata observation",
82:     inputSchema: { type: "object", required: ["text"] },
83:     outputSchema: { type: "object", required: ["text"] },
84:     risk: "LOW",
85:     sideEffect: "NONE",
86:     sandbox: mode,
87:     idempotent: true,
88:     requiresApproval: false,
89:     origin: "core",
90:     providerId: "synthetic-memory",
91:     providerVersion: "1.0.0",
92:   };
93:   const execute = async (
94:     input: unknown,
95:     context: ToolExecutionContext,
96:   ): Promise<ToolResult> => {
97:     bodyCalls.push(capture({ input, context }));
98:     return { status: "SUCCEEDED", output: { ...echo } };
99:   };
100:   const registry =
101:     route === "capability"
102:       ? createCapabilityRegistry().register({
103:           descriptor,
104:           implementation: {
105:             validateInput: (input) =>
106:               typeof input === "object" &&
107:               input !== null &&
108:               Object.keys(input).length === 1 &&
109:               (input as Record<string, unknown>).text === echo.text,
110:             execute,
111:             validateOutput: (output) =>
112:               typeof output === "object" &&
113:               output !== null &&
114:               Object.keys(output).length === 1 &&
115:               (output as Record<string, unknown>).text === echo.text,
116:           },
117:         })
118:       : undefined;
119:   const rawTool: ToolDefinition = { ...descriptor, execute };
120:   const gate: SandboxGate = {
121:     evaluate: async (input) => {
122:       gateCalls.push(capture(input));
123:       return { kind: "denied", reason: "synthetic deny, no native backend" };
124:     },
125:   };
126:   const modelGateway: ModelGateway = {
127:     complete: async (request) => {
128:       modelCalls.push(capture(request));
129:       throw new Error("This fixture must never call a model");
130:     },
131:   };
132:   const invocation = {
133:     toolId: id,
134:     toolVersion: version,
135:     operationKey,
136:     input: echo,
137:   };
138:   const orchestrator: Orchestrator = {
139:     decideNextStep: async (input) => {
140:       const decision = {
141:         action: "CALL_TOOL" as const,
142:         toolInvocation: invocation,
143:       };
144:       decisions.push(capture({ input, decision }));
145:       return decision;
146:     },
147:   };
148:   const audit = new RecordingAuditSink();
149:   const telemetry = new RecordingTelemetrySink();
150:   const policy = new ScriptedPolicyEngine();
151:   const approvals = new InMemoryApprovalEngine();
152:   const journal = new InMemoryEffectJournal();
153:   const log = new InMemoryKernelLog();
154:   const harness = createOperationalHarness({
155:     modelGateway,
156:     orchestrator,
157:     policy,
158:     approvals,
159:     audit,
160:     telemetry,
161:     effectJournal: journal,
162:     log,
163:     sandbox: gate,
164:     ...(registry
165:       ? { capabilities: registry }
166:       : {
167:           tools: {
168:             list: () => [rawTool],
169:             resolve: (toolId: string, toolVersion?: string) =>
170:               toolId === id &&
171:               (toolVersion === undefined || toolVersion === version)
172:                 ? rawTool
173:                 : undefined,
174:           },
175:         }),
176:   });
177:   const { executionId: omittedExecutionId, ...base } = phase3RuntimeInput({
178:     runtimeProfile: "single_pass",
179:     agent: phase3AgentProfile({ tools: [id] }),
180:     requestedTool: invocation,
181:   });
182:   void omittedExecutionId;
183:   const input: RuntimeInput = base;
184:   const nativeInput = capture(input);
185:   const beforeDescriptor = capture(descriptor);
186:   const registeredDescriptors = capture(registry?.listDescriptors());
187:   const nativeResult = await harness.run(input);
188:   return capture({
189:     caseId,
190:     route,
191:     mode,
192:     input: nativeInput,
193:     beforeDescriptor,
194:     registeredDescriptors,
195:     submittedDescriptor: registry ? registry.listDescriptors()[0] : rawTool,
196:     capabilityFingerprint: harness.capabilityFingerprint,
197:     nativeResult,
198:     gateCalls,
199:     bodyCalls,
200:     modelCalls,
201:     decisions,
202:     policyEvaluations: policy.evaluations,
203:     approvalRequests: approvals.requests,
204:     auditEvents: audit.events,
205:     telemetryEvents: telemetry.events,
206:     kernelLogEvents: log.events,
207:     journalRecord: await journal.get(input.tenantId, operationKey),
208:   });
209: }
210: 
211: const cases = [];
212: for (const [route, mode] of [
213:   ["direct", "WORKSPACE"],
214:   ["capability", "WORKSPACE"],
215:   ["capability", "NONE"],
216: ] as const) {
217:   cases.push(await observe(route, mode));
218: }
