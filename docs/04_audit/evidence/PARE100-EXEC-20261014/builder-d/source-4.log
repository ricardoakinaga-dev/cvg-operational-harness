import { describe, expect, it } from 'vitest'
import type {
  ModelGateway,
  Orchestrator,
  OrchestratorDecision,
  PolicyEngine,
  RuntimeInput,
  SandboxGate,
  SandboxMode,
  ToolDefinition,
  ToolRegistry
} from '@cvg/harness-contracts'
import { SinglePassGovernedRuntime } from '../runtime.ts'
import {
  InMemoryApprovalEngine,
  RecordingAuditSink,
  RecordingTelemetrySink,
  ScriptedPolicyEngine,
  phase3AgentProfile,
  phase3RuntimeInput
} from './fixtures/phase3-fixtures.ts'

const defaultModel: ModelGateway = {
  complete: async () => ({
    text: 'model response',
    provider: 'synthetic-provider',
    model: 'synthetic-model',
    inputTokens: 2,
    outputTokens: 3,
    costUsd: 0.01
  })
}

let executed = 0

function tool(
  overrides: Partial<ToolDefinition> & {
    readonly sandbox?: SandboxMode
  } = {}
): ToolDefinition {
  const { sandbox = 'WORKSPACE', ...rest } = overrides
  return {
    id: 'synthetic.sandbox.tool',
    version: 'v1',
    description: 'Synthetic sandbox tool',
    inputSchema: { type: 'object' },
    outputSchema: { type: 'object' },
    risk: 'LOW',
    sideEffect: 'WRITE',
    sandbox,
    idempotent: false,
    requiresApproval: false,
    execute: async () => {
      executed += 1
      return { status: 'SUCCEEDED', output: { ok: true } }
    },
    ...rest
  }
}

function registry(...tools: ToolDefinition[]): ToolRegistry {
  return {
    list: () => tools,
    resolve: (id, version) =>
      tools.find(
        (candidate) =>
          candidate.id === id &&
          (version === undefined || candidate.version === version)
      )
  }
}

function orchestrator(decision: OrchestratorDecision): Orchestrator {
  return { decideNextStep: async () => decision }
}

const allowGate: SandboxGate = {
  evaluate: async (input) => ({
    kind: 'allowed',
    mode: input.policy?.requiredMode ?? 'WORKSPACE',
    handle: {
      mode: input.policy?.requiredMode ?? 'WORKSPACE',
      allowNetwork: false,
      allowSubprocess: false
    }
  })
}

const unavailableGate: SandboxGate = {
  evaluate: async () => ({
    kind: 'unavailable',
    reason: 'containment backend is not provisioned'
  })
}

const deniedGate: SandboxGate = {
  evaluate: async () => ({
    kind: 'denied',
    reason: 'workspace write path is blocked'
  })
}

const throwingGate: SandboxGate = {
  evaluate: async () => {
    throw new Error('synthetic sandbox outage')
  }
}

function build(options: {
  readonly decision: OrchestratorDecision
  readonly tools: ToolRegistry
  readonly sandbox?: SandboxGate
  readonly policy?: PolicyEngine
}): SinglePassGovernedRuntime {
  return new SinglePassGovernedRuntime({
    orchestrator: orchestrator(options.decision),
    modelGateway: defaultModel,
    policy: options.policy ?? new ScriptedPolicyEngine(),
    approvals: new InMemoryApprovalEngine(),
    tools: options.tools,
    audit: new RecordingAuditSink(),
    telemetry: new RecordingTelemetrySink(),
    ...(options.sandbox ? { sandbox: options.sandbox } : {})
  })
}

function input(
  toolId: string,
  overrides: Partial<RuntimeInput> = {}
): RuntimeInput {
  return phase3RuntimeInput({
    agent: phase3AgentProfile({ tools: [toolId] }),
    runtimeProfile: 'single_pass',
    ...overrides
  })
}

function callDecision(toolId: string): OrchestratorDecision {
  return {
    action: 'CALL_TOOL',
    toolInvocation: {
      toolId,
      input: { value: 'synthetic' },
      operationKey: `sandbox-${toolId}`
    }
  }
}

describe('PDSH-010 sandbox seam (SPEC 0195)', () => {
  it('fails closed when a contained tool runs with no sandbox gate configured', async () => {
    const runtimeTool = tool()
    executed = 0
    const runtime = build({
      decision: callDecision(runtimeTool.id),
      tools: registry(runtimeTool)
    })
    await expect(runtime.execute(input(runtimeTool.id))).resolves.toMatchObject(
      {
        stopReason: 'UNSAFE_REQUEST',
        response: expect.stringContaining('no sandbox gate is configured')
      }
    )
    expect(executed).toBe(0)
  })

  it('fails closed when the gate reports the required mode unavailable', async () => {
    const runtimeTool = tool()
    executed = 0
    const runtime = build({
      decision: callDecision(runtimeTool.id),
      tools: registry(runtimeTool),
      sandbox: unavailableGate
    })
    await expect(runtime.execute(input(runtimeTool.id))).resolves.toMatchObject(
      {
        stopReason: 'UNSAFE_REQUEST',
        response: expect.stringContaining('unavailable')
      }
    )
    expect(executed).toBe(0)
  })

  it('fails closed when the gate denies', async () => {
    const runtimeTool = tool()
    executed = 0
    const runtime = build({
      decision: callDecision(runtimeTool.id),
      tools: registry(runtimeTool),
      sandbox: deniedGate
    })
    await expect(runtime.execute(input(runtimeTool.id))).resolves.toMatchObject(
      {
        stopReason: 'UNSAFE_REQUEST',
        response: expect.stringContaining('denied')
      }
    )
    expect(executed).toBe(0)
  })

  it('fails closed when the gate throws', async () => {
    const runtimeTool = tool()
    executed = 0
    const runtime = build({
      decision: callDecision(runtimeTool.id),
      tools: registry(runtimeTool),
      sandbox: throwingGate
    })
    await expect(runtime.execute(input(runtimeTool.id))).resolves.toMatchObject(
      {
        stopReason: 'UNSAFE_REQUEST',
        response: expect.stringContaining('Sandbox gate failed')
      }
    )
    expect(executed).toBe(0)
  })

  it('allows a contained tool once the gate grants a handle', async () => {
    const runtimeTool = tool()
    executed = 0
    const runtime = build({
      decision: callDecision(runtimeTool.id),
      tools: registry(runtimeTool),
      sandbox: allowGate
    })
    await expect(runtime.execute(input(runtimeTool.id))).resolves.toMatchObject(
      {
        stopReason: 'COMPLETED'
      }
    )
    expect(executed).toBe(1)
  })

  it('skips the gate entirely for a pure (mode NONE) capability', async () => {
    const pureTool = tool({
      sideEffect: 'NONE',
      sandbox: 'NONE',
      id: 'synthetic.pure.tool'
    })
    executed = 0
    const runtime = build({
      decision: callDecision(pureTool.id),
      tools: registry(pureTool)
    })
    await expect(runtime.execute(input(pureTool.id))).resolves.toMatchObject({
      stopReason: 'COMPLETED'
    })
    expect(executed).toBe(1)
  })

  it('requires EGRESS containment for a tool that declares it', async () => {
    const externalTool = tool({
      sideEffect: 'EXTERNAL',
      sandbox: 'EGRESS',
      id: 'synthetic.ext.tool'
    })
    executed = 0
    const seenModes: string[] = []
    const gate: SandboxGate = {
      evaluate: async (evaluation) => {
        seenModes.push(evaluation.policy?.requiredMode ?? 'NONE')
        return {
          kind: 'denied',
          reason: 'egress is never granted in this guard'
        }
      }
    }
    const runtime = build({
      decision: callDecision(externalTool.id),
      tools: registry(externalTool),
      sandbox: gate
    })
    await expect(
      runtime.execute(input(externalTool.id))
    ).resolves.toMatchObject({ stopReason: 'UNSAFE_REQUEST' })
    expect(seenModes).toEqual(['EGRESS'])
    expect(executed).toBe(0)
  })
})
import { mkdtempSync, rmSync } from 'node:fs'
import { tmpdir } from 'node:os'
import { join } from 'node:path'
import { afterEach, describe, expect, it } from 'vitest'
import type {
  ModelGateway,
  RuntimeInput,
  ToolDefinition,
  ToolRegistry
} from '@cvg/harness-contracts'
import {
  createLocalSandboxGate,
  createShellTool,
  hostProbe
} from '@cvg/sandbox'
import { createOperationalHarness } from '../createOperationalHarness.ts'
import {
  InMemoryApprovalEngine,
  RecordingAuditSink,
  RecordingTelemetrySink,
  ScriptedPolicyEngine,
  phase3AgentProfile,
  phase3RuntimeInput
} from './fixtures/phase3-fixtures.ts'

const defaultModel: ModelGateway = {
  complete: async () => ({
    text: 'model response',
    provider: 'synthetic-provider',
    model: 'synthetic-model',
    inputTokens: 2,
    outputTokens: 3,
    costUsd: 0.01
  })
}

const tempDirs: string[] = []

function tempWorkspace(): string {
  const dir = mkdtempSync(join(tmpdir(), 'cvg-shell-int-'))
  tempDirs.push(dir)
  return dir
}

afterEach(() => {
  while (tempDirs.length > 0) {
    rmSync(tempDirs.pop() as string, { recursive: true, force: true })
  }
})

function registry(tools: readonly ToolDefinition[]): ToolRegistry {
  return {
    list: () => tools,
    resolve: (id, version) =>
      tools.find(
        (candidate) =>
          candidate.id === id &&
          (version === undefined || candidate.version === version)
      )
  }
}

function harnessFor(
  root: string,
  approvals: InMemoryApprovalEngine,
  options: { readonly withSandbox?: boolean; readonly runner?: unknown } = {}
): ReturnType<typeof createOperationalHarness> {
  const tool = createShellTool({
    workspaceRoot: root,
    ...(options.runner !== undefined ? { run: options.runner as never } : {})
  })
  return createOperationalHarness({
    modelGateway: defaultModel,
    policy: new ScriptedPolicyEngine(),
    approvals,
    tools: registry([tool]),
    audit: new RecordingAuditSink(),
    telemetry: new RecordingTelemetrySink(),
    orchestrator: {
      decideNextStep: async ({ runtime }) => ({
        action: 'CALL_TOOL' as const,
        toolInvocation: runtime.requestedTool ?? {
          toolId: 'shell.run',
          input: {},
          operationKey: 'pdsh-013-shell.run'
        }
      })
    },
    ...(options.withSandbox !== false
      ? {
          sandbox: createLocalSandboxGate({
            capabilities: {
              bubblewrap: true,
              landlock: true,
              mode: 'PROCESS',
              partial: []
            },
            workspaceBase: root
          })
        }
      : {})
  })
}

function input(toolInput: unknown): RuntimeInput {
  return phase3RuntimeInput({
    agent: phase3AgentProfile({ tools: ['shell.run'] }),
    runtimeProfile: 'single_pass',
    requestedTool: {
      toolId: 'shell.run',
      input: toolInput,
      operationKey: 'pdsh-013-shell.run'
    }
  })
}

const bwrapWorks = hostProbe.probeBubblewrap()

describe('PDSH-013 shell tool in the operational harness (SPEC 0198 §2)', () => {
  it('stops with APPROVAL_REQUIRED when the approval is pending', async () => {
    const root = tempWorkspace()
    const approvals = new InMemoryApprovalEngine()
    const harness = harnessFor(root, approvals, {
      runner: async () => ({
        exitCode: 0,
        stdout: 'não deveria rodar',
        stderr: '',
        truncated: false
      })
    })
    const result = await harness.execute(
      input({ argv: ['echo', 'x'], intent: 'aguardando approval' })
    )
    expect(result.stopReason).toBe('APPROVAL_REQUIRED')
    expect(approvals.requests).toHaveLength(1)
    expect(approvals.requests[0]?.toolId).toBe('shell.run')
  })

  it('fails closed with UNSAFE_REQUEST when no sandbox gate is configured', async () => {
    const root = tempWorkspace()
    const approvals = new InMemoryApprovalEngine()
    approvals.approveOnRequest = true
    const harness = harnessFor(root, approvals, {
      withSandbox: false,
      runner: async () => ({
        exitCode: 0,
        stdout: 'não deveria rodar',
        stderr: '',
        truncated: false
      })
    })
    const result = await harness.execute(
      input({ argv: ['echo', 'x'], intent: 'sem gate' })
    )
    expect(result.stopReason).toBe('UNSAFE_REQUEST')
  })

  it.skipIf(!bwrapWorks)(
    'executes an approved command inside the workspace sandbox',
    async () => {
      const root = tempWorkspace()
      const approvals = new InMemoryApprovalEngine()
      approvals.approveOnRequest = true
      const harness = harnessFor(root, approvals)
      const result = await harness.execute(
        input({
          argv: ['/bin/echo', 'sintetico'],
          intent: 'fumaça de integração com approval'
        })
      )
      expect(result.stopReason).toBe('COMPLETED')
      expect(result.response).toContain('sintetico')
    }
  )

  it('rejects a command string through the governed pipeline (no interpolation)', async () => {
    const root = tempWorkspace()
    const approvals = new InMemoryApprovalEngine()
    approvals.approveOnRequest = true
    const harness = harnessFor(root, approvals, {
      runner: async () => ({
        exitCode: 0,
        stdout: 'não deveria rodar',
        stderr: '',
        truncated: false
      })
    })
    const result = await harness.execute(
      input({ command: 'echo pwned', intent: 'interpolação negada' })
    )
    expect(result.stopReason).toBe('TOOL_FAILURE')
  })
})
import { describe, expect, it } from 'vitest'
import type { RuntimeInput } from '@cvg/harness-contracts'
import {
  ScriptedModelGateway,
  ScriptedOrchestrator
} from '@cvg/harness-orchestrator'
import {
  InMemoryExecutionStepStore,
  createOperationalHarness
} from '../index.ts'
import { readExecutionTrajectory } from '../trajectory.ts'
import {
  InMemoryApprovalEngine,
  RecordingAuditSink,
  RecordingTelemetrySink,
  ScriptedPolicyEngine,
  createPhase3ToolRegistry,
  decision,
  phase3AgentProfile,
  phase3RuntimeInput
} from './fixtures/phase3-fixtures.ts'

function withoutProfile(input: RuntimeInput): RuntimeInput {
  const { runtimeProfile: _runtimeProfile, ...rest } = input
  void _runtimeProfile
  return rest as RuntimeInput
}

function ports() {
  return {
    modelGateway: new ScriptedModelGateway({ responses: ['ok'] }),
    policy: new ScriptedPolicyEngine(),
    approvals: new InMemoryApprovalEngine(),
    tools: createPhase3ToolRegistry({ availability: 'AVAILABLE' }),
    audit: new RecordingAuditSink(),
    telemetry: new RecordingTelemetrySink()
  }
}

describe('P3-COMPAT — runtime profile selection through the public factory', () => {
  it('P3-COMPAT-001 runs single-pass and iterative through the same factory', async () => {
    const stepStore = new InMemoryExecutionStepStore()
    const harness = createOperationalHarness({
      ...ports(),
      iterativeOrchestrator: new ScriptedOrchestrator({
        script: [
          decision({
            decisionType: 'RESPOND',
            reasonCode: 'GOAL_SATISFIED',
            responseText: 'iterative answer'
          })
        ]
      }),
      stepStore
    })

    const iterativeInput: RuntimeInput = phase3RuntimeInput({
      agent: phase3AgentProfile(),
      runtimeProfile: 'iterative'
    })
    const iterative = await harness.execute(iterativeInput)
    expect(iterative.stopReason).toBe('COMPLETED')
    expect(iterative.response).toBe('iterative answer')
    expect(iterative.steps).toBe(1)

    const singlePassInput: RuntimeInput = phase3RuntimeInput({
      agent: phase3AgentProfile(),
      runtimeProfile: 'single_pass'
    })
    const singlePass = await harness.execute(singlePassInput)
    expect(singlePass.stopReason).toBe('COMPLETED')
    expect(singlePass.steps).toBe(1)

    expect(harness.resolveProfile(iterativeInput)).toBe('iterative')
    expect(harness.resolveProfile(singlePassInput)).toBe('single_pass')
    expect(harness.resolveProfile(withoutProfile(phase3RuntimeInput()))).toBe(
      'single_pass'
    )
  })

  it('P3-COMPAT-002 fails closed when the iterative profile is unconfigured', async () => {
    const harness = createOperationalHarness({ ...ports() })
    const result = await harness.execute(
      phase3RuntimeInput({
        agent: phase3AgentProfile(),
        runtimeProfile: 'iterative'
      })
    )
    expect(result.stopReason).toBe('STATE_CONFLICT')
    expect(result.steps).toBe(0)
  })

  it('P3-COMPAT-003 drops authority fields injected by the orchestrator', async () => {
    const stepStore = new InMemoryExecutionStepStore()
    const injected = {
      decisionType: 'RESPOND',
      reasonCode: 'GOAL_SATISFIED',
      responseText: 'ok',
      policyDecision: 'ALLOW',
      budgetOverride: 999
    } as never
    const harness = createOperationalHarness({
      ...ports(),
      iterativeOrchestrator: new ScriptedOrchestrator({ script: [injected] }),
      stepStore
    })
    const input = phase3RuntimeInput({
      agent: phase3AgentProfile(),
      runtimeProfile: 'iterative'
    })
    const result = await harness.execute(input)
    expect(result.stopReason).toBe('COMPLETED')
    const checkpoint = await stepStore.loadCheckpoint(
      input.tenantId,
      'exec_phase3_fixture'
    )
    const serialized = JSON.stringify(checkpoint)
    expect(serialized).not.toContain('policyDecision')
    expect(serialized).not.toContain('budgetOverride')
  })

  it('P3-COMPAT-004 exports a trajectory without payloads', async () => {
    const stepStore = new InMemoryExecutionStepStore()
    const harness = createOperationalHarness({
      ...ports(),
      iterativeOrchestrator: new ScriptedOrchestrator({
        script: [
          decision({
            decisionType: 'CALL_TOOL',
            toolId: 'synthetic.phase3.availability',
            toolInput: { resource: 'resource-x' }
          }),
          decision({
            decisionType: 'RESPOND',
            reasonCode: 'GOAL_SATISFIED',
            responseText: 'done'
          })
        ]
      }),
      stepStore
    })
    const input = phase3RuntimeInput({
      agent: phase3AgentProfile(),
      runtimeProfile: 'iterative'
    })
    const result = await harness.execute(input)
    expect(result.stopReason).toBe('COMPLETED')
    const trajectory = await readExecutionTrajectory(
      stepStore,
      input.tenantId,
      'exec_phase3_fixture'
    )
    expect(trajectory?.runtimeVersion).toBe('2.0.0')
    expect(trajectory?.steps.map((step) => step.stepType)).toEqual([
      'TOOL',
      'RESPOND'
    ])
    expect(JSON.stringify(trajectory)).not.toContain('resource-x')
    expect(JSON.stringify(trajectory)).not.toContain('"output":')
  })
})
