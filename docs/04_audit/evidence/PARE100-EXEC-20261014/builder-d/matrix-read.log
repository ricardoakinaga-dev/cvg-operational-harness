        timeoutMs: 25
      })
      expect(Object.isFrozen(calls[0]?.handle)).toBe(true)
      expect(calls[0]?.handle).not.toBe(granted)
    } finally {
      rmSync(root, { recursive: true, force: true })
    }
  })
})

