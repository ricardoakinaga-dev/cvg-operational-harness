          finished: () => Promise.reject(new Error('synthetic ledger failure'))
        }
      })
    })
    expect(await runToolCall(host, toolCallStub(turn) as never)).toMatchObject({
      kind: 'settled',
      outcome: { kind: 'succeeded' }
    })
  })
})

