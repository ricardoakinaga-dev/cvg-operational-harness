import { mkdirSync, mkdtempSync, rmSync, symlinkSync } from 'node:fs'
import { tmpdir } from 'node:os'
import { join } from 'node:path'
import { afterEach, describe, expect, it } from 'vitest'
import {
  createShellTool,
  hostProbe,
  type ShellLimits,
  type ShellRunRequest,
  type ShellRunResult
} from '../index.ts'

const tempDirs: string[] = []

function tempWorkspace(): string {
  const dir = mkdtempSync(join(tmpdir(), 'cvg-shell-'))
  tempDirs.push(dir)
  return dir
}

afterEach(() => {
  while (tempDirs.length > 0) {
    rmSync(tempDirs.pop() as string, { recursive: true, force: true })
  }
})

interface RunnerProbe {
  readonly tool: ReturnType<typeof createShellTool>
  readonly calls: ShellRunRequest[]
}

function probeTool(
  root: string,
  result: ShellRunResult,
  limits?: Partial<ShellLimits>
): RunnerProbe {
  const calls: ShellRunRequest[] = []
  const tool = createShellTool({
    workspaceRoot: root,
    ...(limits !== undefined ? { limits } : {}),
    run: async (request) => {
      calls.push(request)
      return result
    }
  })
  return { tool, calls }
}

const okRun: ShellRunResult = {
  exitCode: 0,
  stdout: 'ok\n',
  stderr: '',
  truncated: false
}

const context = {
  tenantId: 'tenant_00000000-0000-4000-8000-000000000001' as never,
  agentId: 'agent_00000000-0000-4000-8000-000000000001' as never,
  correlationId: 'corr_1' as never,
  traceId: 'trace_1' as never,
  operationKey: 'pdsh-013-shell.run'
}

describe('PDSH-013 shell tool boot (SPEC 0198 §1)', () => {
  it('fails closed when workspaceRoot is not an existing directory', () => {
    expect(() =>
      createShellTool({ workspaceRoot: join(tmpdir(), 'no-such-root-xyz') })
    ).toThrow(/workspaceRoot/)
  })

  it('fails closed when workspaceRoot is relative', () => {
    expect(() => createShellTool({ workspaceRoot: 'relative/path' })).toThrow(
      /workspaceRoot/
    )
  })
})

describe('PDSH-013 shell input validation (SPEC 0198 §3)', () => {
  it('rejects string-command fields — no interpolation path exists', async () => {
    const { tool } = probeTool(tempWorkspace(), okRun)
    for (const key of ['command', 'cmd', 'shell']) {
      const result = await tool.execute(
        { [key]: 'echo pwned', intent: 'x' },
        context
      )
      expect(result.status).toBe('REJECTED')
      expect(result.error).toMatch(/string commands/)
    }
  })

  it('rejects malformed argv (missing, empty, non-string, empty element, NUL)', async () => {
    const { tool } = probeTool(tempWorkspace(), okRun)
    const bad: unknown[] = [
      undefined,
      'echo hi',
      [],
      [42],
      [''],
      ['echo\0hi'],
      [null]
    ]
    for (const argv of bad) {
      const result = await tool.execute({ argv, intent: 'x' }, context)
      expect(result.status, JSON.stringify(argv)).toBe('REJECTED')
    }
  })

  it('rejects argv over the count/length/total-byte limits', async () => {
    const root = tempWorkspace()
    const { tool } = probeTool(root, okRun, {
      maxArgs: 2,
      maxArgLength: 4,
      maxTotalArgBytes: 7
    })
    expect(
      (await tool.execute({ argv: ['a', 'b', 'c'], intent: 'x' }, context))
        .status
    ).toBe('REJECTED')
    expect(
      (await tool.execute({ argv: ['abcde'], intent: 'x' }, context)).status
    ).toBe('REJECTED')
    expect(
      (await tool.execute({ argv: ['abcd', 'efgh'], intent: 'x' }, context))
        .status
    ).toBe('REJECTED')
  })

  it('rejects a missing or oversized intent before any spawn', async () => {
    const { tool, calls } = probeTool(tempWorkspace(), okRun, {
      maxIntentLength: 5
    })
    for (const intent of [undefined, '   ', 'abcdefg']) {
      const result = await tool.execute({ argv: ['true'], intent }, context)
      expect(result.status, String(intent)).toBe('REJECTED')
    }
    expect(calls).toHaveLength(0)
  })

  it('rejects cwd that escapes the workspace (absolute, .., symlink out)', async () => {
    const root = tempWorkspace()
    const outside = tempWorkspace()
    symlinkSync(outside, join(root, 'escape-link'))
    const { tool, calls } = probeTool(root, okRun)
    for (const cwd of ['..', '../..', '/etc', 'escape-link']) {
      const result = await tool.execute(
        { argv: ['true'], cwd, intent: 'x' },
        context
      )
      expect(result.status, cwd).toBe('REJECTED')
    }
    expect(calls).toHaveLength(0)
  })

  it('rejects a cwd that does not exist or is not a directory', async () => {
    const root = tempWorkspace()
    mkdirSync(join(root, 'dir'))
    const { tool } = probeTool(root, okRun)
    expect(
      (
        await tool.execute(
          { argv: ['true'], cwd: 'missing-dir', intent: 'x' },
          context
        )
      ).status
    ).toBe('REJECTED')
    // A file used as cwd: create one via fs tool-free helper.
    const { writeFileSync } = await import('node:fs')
    writeFileSync(join(root, 'arquivo.txt'), 'x', 'utf8')
    expect(
      (
        await tool.execute(
          { argv: ['true'], cwd: 'arquivo.txt', intent: 'x' },
          context
        )
      ).status
    ).toBe('REJECTED')
  })

  it('rejects oversized stdin', async () => {
    const { tool } = probeTool(tempWorkspace(), okRun, { maxStdinBytes: 4 })
    const result = await tool.execute(
      { argv: ['true'], stdin: '12345', intent: 'x' },
      context
    )
    expect(result.status).toBe('REJECTED')
  })
})

describe('PDSH-013 shell execution mapping (SPEC 0198 §4)', () => {
  it('passes a confined cwd, clamped timeout and pure argv to the runner', async () => {
    const root = tempWorkspace()
    mkdirSync(join(root, 'sub'))
    const { tool, calls } = probeTool(root, okRun, {
      defaultTimeoutMs: 1000,
      maxTimeoutMs: 2000
    })
    const result = await tool.execute(
      {
        argv: ['echo', 'sintetico'],
        cwd: 'sub',
        timeoutMs: 99_999,
        stdin: 'dados',
        intent: 'executar comando sintetico'
      },
      context
    )
    expect(result.status).toBe('SUCCEEDED')
    expect(calls).toHaveLength(1)
    expect(calls[0]?.argv).toEqual(['echo', 'sintetico'])
    expect(calls[0]?.cwd).toBe(join(root, 'sub'))
    expect(calls[0]?.timeoutMs).toBe(2000)
    expect(calls[0]?.stdin).toBe('dados')
  })

  it('clamps an invalid timeout to the default', async () => {
    const root = tempWorkspace()
    const { tool, calls } = probeTool(root, okRun, { defaultTimeoutMs: 500 })
    await tool.execute({ argv: ['true'], timeoutMs: -5, intent: 'x' }, context)
    expect(calls[0]?.timeoutMs).toBe(500)
  })

  it('surfaces a non-zero exit code as SUCCEEDED (consumer interprets)', async () => {
    const { tool } = probeTool(tempWorkspace(), {
      exitCode: 1,
      stdout: '',
      stderr: 'no match',
      truncated: false
    })
    const result = await tool.execute(
      { argv: ['grep', 'x'], intent: 'x' },
      context
    )
    expect(result.status).toBe('SUCCEEDED')
    expect(result.output).toMatchObject({ exitCode: 1, stderr: 'no match' })
  })

  it('maps spawn_failed to FAILED (containment failure, never an exit code)', async () => {
    const { tool } = probeTool(tempWorkspace(), {
      exitCode: 'spawn_failed',
      stdout: '',
      stderr: 'bwrap: exec failed',
      truncated: false
    })
    const result = await tool.execute({ argv: ['true'], intent: 'x' }, context)
    expect(result.status).toBe('FAILED')
    expect(result.error).toMatch(/containment failed/)
  })

  it('maps timeout to FAILED with the effective budget', async () => {
    const { tool } = probeTool(tempWorkspace(), {
      exitCode: 'timeout',
      stdout: '',
      stderr: '',
      truncated: false
    })
    const result = await tool.execute(
      { argv: ['sleep', '99'], timeoutMs: 1000, intent: 'x' },
      context
    )
    expect(result.status).toBe('FAILED')
    expect(result.error).toMatch(/timed out after 1000ms/)
  })

  it('maps a throwing runner to FAILED', async () => {
    const tool = createShellTool({
      workspaceRoot: tempWorkspace(),
      run: async () => {
        throw new Error('runner exploded')
      }
    })
    const result = await tool.execute({ argv: ['true'], intent: 'x' }, context)
    expect(result.status).toBe('FAILED')
    expect(result.error).toMatch(/runner exploded/)
  })
})

describe('PDSH-013 shell descriptor (SPEC 0198 §2)', () => {
  it('declares PROCESS containment and mandatory approval', () => {
    const tool = createShellTool({ workspaceRoot: tempWorkspace() })
    expect(tool.id).toBe('shell.run')
    expect(tool.sandbox).toBe('PROCESS')
    expect(tool.requiresApproval).toBe(true)
    expect(tool.risk).toBe('HIGH')
    expect(tool.sideEffect).toBe('WRITE')
    expect(tool.idempotent).toBe(false)
  })
})

describe('PDSH-013 shell default runner (SPEC 0198 §1, host smoke)', () => {
  const bwrapWorks = hostProbe.probeBubblewrap()

  it.skipIf(!bwrapWorks)(
    'runs a command inside the namespace with workspace bind',
    async () => {
      const root = tempWorkspace()
      const tool = createShellTool({ workspaceRoot: root })
      const result = await tool.execute(
        { argv: ['/bin/echo', 'sintetico'], intent: 'fumaça do host' },
        context
      )
      expect(result.status).toBe('SUCCEEDED')
      expect(result.output).toMatchObject({
        exitCode: 0,
        stdout: 'sintetico\n'
      })
    }
  )

  it.skipIf(!bwrapWorks)(
    'writes inside the workspace are visible outside the namespace',
    async () => {
      const root = tempWorkspace()
      const tool = createShellTool({ workspaceRoot: root })
      const result = await tool.execute(
        {
          argv: ['/bin/sh', '-c', 'echo sintetico > inside.txt'],
          intent: 'provar bind gravável do workspace'
        },
        context
      )
      expect(result.status).toBe('SUCCEEDED')
      const { readFileSync } = await import('node:fs')
      expect(readFileSync(join(root, 'inside.txt'), 'utf8')).toBe('sintetico\n')
    }
  )
})
import { existsSync, realpathSync } from 'node:fs'
import { dirname, isAbsolute, join, relative, resolve, sep } from 'node:path'

/** Reserved namespace for atomic-write temp files (SPEC 0197 §3). */
export const TEMP_PREFIX = '.cvg-fs-tmp-'

/**
 * Resolves a caller path inside the workspace root, refusing absolute paths,
 * `..` escapes and symlinks that leave the root (SPEC 0197 §3). Shared by the
 * fs tools and the shell tool as defense in depth alongside the WORKSPACE /
 * PROCESS gate. Returns the normalized relative path and the absolute path
 * under the real root.
 */
export function confinePath(
  root: string,
  raw: unknown
):
  | { readonly ok: true; readonly rel: string; readonly abs: string }
  | { readonly ok: false; readonly error: string } {
  if (typeof raw !== 'string' || raw.trim().length === 0) {
    return { ok: false, error: 'path is required' }
  }
  const path = raw.trim()
  if (path.length > 4096) {
    return { ok: false, error: 'path exceeds maxPathLength' }
  }
  if (isAbsolute(path) || path.includes('\0')) {
    return { ok: false, error: 'path must be relative and free of NUL' }
  }
  const abs = resolve(root, path)
  if (abs !== root && !abs.startsWith(root + sep)) {
    return { ok: false, error: 'path escapes the workspace root' }
  }
  // Walk to the deepest existing ancestor and realpath it so a symlink that
  // points outside the workspace is refused even when it does not exist yet.
  let probe = abs
  const tail: string[] = []
  for (;;) {
    if (existsSync(probe)) break
    const parent = dirname(probe)
    if (parent === probe) {
      return { ok: false, error: 'path has no existing ancestor' }
    }
    tail.unshift(probe.slice(parent.length + 1))
    probe = parent
  }
  let real: string
  try {
    real = realpathSync(probe)
  } catch {
    return { ok: false, error: 'path cannot be resolved' }
  }
  const rebuilt = tail.length > 0 ? join(real, ...tail) : real
  if (rebuilt !== root && !rebuilt.startsWith(root + sep)) {
    return { ok: false, error: 'path resolves outside the workspace root' }
  }
  const rel = relative(root, rebuilt)
  if (rel.split(sep).some((part) => part.startsWith(TEMP_PREFIX))) {
    return { ok: false, error: 'path uses the reserved temp namespace' }
  }
  return { ok: true, rel: rel === '' ? '.' : rel, abs: rebuilt }
}
import { spawn } from 'node:child_process'
import { existsSync, statSync } from 'node:fs'
import { resolve, sep } from 'node:path'
import type { SandboxHandle } from '@cvg/harness-contracts'

export interface ContainedRunRequest {
  /** Pure argv array — never a shell string, never interpolated. */
  readonly argv: readonly string[]
  /** Handle granted by the sandbox gate; must allow subprocesses. */
  readonly handle: SandboxHandle
  readonly cwd?: string
  /** Defaults to `handle.deadlineMs`, then 30s. */
  readonly timeoutMs?: number
  readonly stdin?: string
  /** Override for tests/detection; defaults to `bwrap` on PATH. */
  readonly bwrapPath?: string
  /** Per-stream output cap; default 1 MiB. */
  readonly maxOutputBytes?: number
}

export interface ContainedRunResult {
  readonly exitCode: number | 'timeout' | 'spawn_failed'
  readonly stdout: string
  readonly stderr: string
  readonly truncated: boolean
}

const DEFAULT_TIMEOUT_MS = 30_000
const DEFAULT_MAX_OUTPUT_BYTES = 1024 * 1024

/**
 * Runs argv inside a bubblewrap namespace per the granted handle (SPEC 0196
 * §5): PID/IPC/UTS isolated, network unshared off, root read-only, workspace
 * bound read-write. `spawn_failed` (bwrap missing, namespace setup refused)
 * is not an exit code — callers must map it to `unavailable`, never to a
 * normal result.
 */
export function runContained(
  request: ContainedRunRequest
): Promise<ContainedRunResult> {
  const { handle } = request
  const [program, ...rest] = request.argv
  const maxOutputBytes = request.maxOutputBytes ?? DEFAULT_MAX_OUTPUT_BYTES

  const refused = (reason: string): Promise<ContainedRunResult> =>
    Promise.resolve({
      exitCode: 'spawn_failed',
      stdout: '',
      stderr: reason,
      truncated: false
    })

  if (!handle.allowSubprocess) {
    return refused('handle does not allow subprocesses')
  }
  if (program === undefined) {
    return refused('argv vazio')
  }

  const workspace = handle.workspaceRoot
  const cwd = request.cwd !== undefined ? resolve(request.cwd) : workspace
  if (cwd !== undefined) {
    if (workspace !== undefined) {
      const prefix = workspace.endsWith(sep) ? workspace : workspace + sep
      if (cwd !== workspace && !cwd.startsWith(prefix)) {
        return refused(`cwd fora do workspace: ${cwd}`)
      }
    }
    if (!existsSync(cwd) || !statSync(cwd).isDirectory()) {
      return refused(`cwd inexistente: ${cwd}`)
    }
  }

  const bwrapArgs = [
    '--new-session',
    '--die-with-parent',
    '--unshare-pid',
    '--unshare-ipc',
    '--unshare-uts',
    '--unshare-net',
    '--ro-bind',
    '/',
    '/',
    // Mount order matters: a tmpfs over /tmp placed after the workspace bind
    // would shadow a workspace that lives under /tmp (SPEC 0196 §5).
    '--tmpfs',
    '/tmp'
  ]
  if (workspace !== undefined) {
    bwrapArgs.push('--bind', workspace, workspace)
  }
  bwrapArgs.push(
    '--proc',
    '/proc',
    '--dev',
    '/dev',
    ...(cwd !== undefined ? ['--chdir', cwd] : []),
    '--',
    program,
    ...rest
  )

  const timeoutMs = request.timeoutMs ?? handle.deadlineMs ?? DEFAULT_TIMEOUT_MS

  return new Promise<ContainedRunResult>((resolvePromise) => {
    let settled = false
    let timedOut = false
    const stdoutChunks: Buffer[] = []
    const stderrChunks: Buffer[] = []
    let stdoutBytes = 0
    let stderrBytes = 0
    let truncated = false

    const child = spawn(request.bwrapPath ?? 'bwrap', bwrapArgs, {
      stdio: ['pipe', 'pipe', 'pipe']
    })

    const timer = setTimeout(() => {
      timedOut = true
      child.kill('SIGKILL')
    }, timeoutMs)

    const drain = (stream: 'stdout' | 'stderr', chunk: Buffer): void => {
      let bytes = stream === 'stdout' ? stdoutBytes : stderrBytes
      if (bytes >= maxOutputBytes) {
        truncated = true
        return
      }
      const room = maxOutputBytes - bytes
      const taken = chunk.length > room ? chunk.subarray(0, room) : chunk
      bytes += taken.length
      if (stream === 'stdout') {
        stdoutChunks.push(taken)
        stdoutBytes = bytes
      } else {
        stderrChunks.push(taken)
        stderrBytes = bytes
      }
      if (chunk.length > taken.length) truncated = true
    }

    child.stdout.on('data', (chunk: Buffer) => drain('stdout', chunk))
    child.stderr.on('data', (chunk: Buffer) => drain('stderr', chunk))

    const finish = (exitCode: number | 'timeout' | 'spawn_failed'): void => {
      if (settled) return
      settled = true
      clearTimeout(timer)
      resolvePromise({
        exitCode,
        stdout: Buffer.concat(stdoutChunks).toString('utf8'),
        stderr: Buffer.concat(stderrChunks).toString('utf8'),
        truncated
      })
    }

    child.on('error', () => {
      // ENOENT (bwrap ausente) and any other spawn fault are containment
      // failures, never a child exit status.
      finish('spawn_failed')
    })

    child.on('close', (code: number | null) => {
      if (timedOut) {
        finish('timeout')
        return
      }
      const stderrText = Buffer.concat(stderrChunks).toString('utf8')
      // bwrap reports namespace/setup faults itself before the child runs;
      // that is a containment failure, not the child's exit status.
      if (stderrText.startsWith('bwrap:')) {
        finish('spawn_failed')
        return
      }
      finish(code ?? 'spawn_failed')
    })

    if (request.stdin !== undefined) {
      child.stdin.end(request.stdin)
    } else {
      child.stdin.end()
    }
  })
}
import { realpathSync, existsSync, statSync } from 'node:fs'
import { isAbsolute } from 'node:path'
import type {
  SandboxEvaluationInput,
  SandboxGate,
  SandboxGateOutcome,
  SandboxHandle,
  SandboxMode
} from '@cvg/harness-contracts'
import type { SandboxCapabilities } from './capabilities.ts'

export interface SandboxJournalEntry {
  readonly toolId: string
  readonly mode: SandboxMode
  readonly outcome: SandboxGateOutcome['kind']
  readonly reason?: string
}

export interface LocalSandboxGateOptions {
  readonly capabilities: SandboxCapabilities
  /** Absolute tenant-workspace base; validated by realpath on every grant. */
  readonly workspaceBase?: string
  /** Refuse fs modes when the kernel LSM cannot back them (defense in depth). */
  readonly requireLandlock?: boolean
  /** Modes this composition always denies, regardless of platform. */
  readonly denyModes?: readonly SandboxMode[]
  /** Caller hook: return a reason to deny this evaluation (policy, not platform). */
  readonly deny?: (input: SandboxEvaluationInput) => string | undefined
  /** Decision audit; a throwing journal fails the evaluation closed. */
  readonly journal?: (entry: SandboxJournalEntry) => void
}

const unavailable = (reason: string): SandboxGateOutcome => ({
  kind: 'unavailable',
  reason
})

/**
 * Local implementation of the `SandboxGate` port (SPEC 0195) using the
 * platform capabilities of SPEC 0196. Every failure path returns
 * `denied`/`unavailable` — never `allowed` — so the seam's fail-closed
 * enforcement in `kernel/pipeline.ts` holds.
 */
export function createLocalSandboxGate(
  options: LocalSandboxGateOptions
): SandboxGate {
  const { capabilities } = options

  const resolveWorkspaceRoot = (): string | undefined => {
    const base = options.workspaceBase
    if (base === undefined) return undefined
    if (
      !isAbsolute(base) ||
      !existsSync(base) ||
      !statSync(base).isDirectory()
    ) {
      throw new Error(`workspace base inválida: ${base}`)
    }
    return realpathSync(base)
  }

  const grant = (
    input: SandboxEvaluationInput,
    mode: SandboxMode,
    handle: Omit<SandboxHandle, 'mode'>,
    reason?: string
  ): SandboxGateOutcome => {
    const outcome: SandboxGateOutcome = {
      kind: 'allowed',
      mode,
      handle: { mode, ...handle }
    }
    record(input, outcome, reason)
    return outcome
  }

  const record = (
    input: SandboxEvaluationInput,
    outcome: SandboxGateOutcome,
    reason?: string
  ): void => {
    if (!options.journal) return
    options.journal({
      toolId: input.descriptor.id,
      mode: input.policy?.requiredMode ?? input.descriptor.sandbox ?? 'NONE',
      outcome: outcome.kind,
      ...(reason !== undefined
        ? { reason }
        : outcome.kind !== 'allowed'
          ? { reason: outcome.reason }
          : {})
    })
  }

  const evaluate = async (
    input: SandboxEvaluationInput
  ): Promise<SandboxGateOutcome> => {
    const mode: SandboxMode =
      input.policy?.requiredMode ?? input.descriptor.sandbox ?? 'NONE'
    try {
      const denyReason = options.deny?.(input)
      if (denyReason !== undefined) {
        const outcome: SandboxGateOutcome = {
          kind: 'denied',
          reason: denyReason
        }
        record(input, outcome)
        return outcome
      }
      if (options.denyModes?.includes(mode)) {
        const outcome: SandboxGateOutcome = {
          kind: 'denied',
          reason: `modo ${mode} negado por composição`
        }
        record(input, outcome)
        return outcome
      }

      const base = resolveWorkspaceRoot()
      const timeoutMs = input.policy?.timeoutMs

      switch (mode) {
        case 'NONE': {
          return grant(
            input,
            'NONE',
            { allowNetwork: false, allowSubprocess: false },
            'capability pura; sem contenção requerida'
          )
        }
        case 'IN_PROCESS': {
          if (capabilities.mode === 'unsupported') {
            return fail(
              input,
              unavailable('partial: IN_PROCESS (host sem contenção)')
            )
          }
          if (options.requireLandlock && !capabilities.landlock) {
            return fail(
              input,
              unavailable('partial: IN_PROCESS (Landlock ausente)')
            )
          }
          return grant(
            input,
            'IN_PROCESS',
            {
              allowNetwork: false,
              allowSubprocess: false,
              ...(timeoutMs !== undefined ? { deadlineMs: timeoutMs } : {})
            },
            capabilities.landlock
              ? undefined
              : 'sem Landlock; allowlist do canal é a defesa'
          )
        }
        case 'WORKSPACE': {
          if (capabilities.mode === 'unsupported') {
            return fail(
              input,
              unavailable('partial: WORKSPACE (host sem contenção)')
            )
          }
          if (base === undefined) {
            return fail(
              input,
              unavailable(
                'partial: WORKSPACE (sem base de workspace configurada)'
              )
            )
          }
          if (options.requireLandlock && !capabilities.landlock) {
            return fail(
              input,
              unavailable('partial: WORKSPACE (Landlock ausente)')
            )
          }
          return grant(
            input,
            'WORKSPACE',
            {
              workspaceRoot: base,
              allowNetwork: false,
              allowSubprocess: false,
              ...(timeoutMs !== undefined ? { deadlineMs: timeoutMs } : {})
            },
            capabilities.landlock
              ? undefined
              : 'sem Landlock; allowlist verificável do workspace é a defesa'
          )
        }
        case 'PROCESS': {
          if (capabilities.mode === 'unsupported') {
            return fail(
              input,
              unavailable('partial: PROCESS (host sem contenção)')
            )
          }
          if (!capabilities.bubblewrap) {
            return fail(
              input,
              unavailable('partial: PROCESS (bubblewrap ausente)')
            )
          }
          return grant(input, 'PROCESS', {
            ...(base !== undefined ? { workspaceRoot: base } : {}),
            allowNetwork: false,
            allowSubprocess: true,
            ...(timeoutMs !== undefined ? { deadlineMs: timeoutMs } : {})
          })
        }
        case 'EGRESS': {
          // Out of scope for this package (PDSH-016): never allowed here.
          return fail(
            input,
            unavailable(
              'partial: EGRESS (não suportado por este gate; PDSH-016)'
            )
          )
        }
        default: {
          return fail(
            input,
            unavailable(`modo de sandbox desconhecido: ${String(mode)}`)
          )
        }
      }
    } catch (error) {
      return fail(
        input,
        unavailable(
          `gate local falhou: ${error instanceof Error ? error.message : 'erro desconhecido'}`
        )
      )
    }
  }

  const fail = (
    input: SandboxEvaluationInput,
    outcome: SandboxGateOutcome
  ): SandboxGateOutcome => {
    try {
      record(input, outcome)
    } catch {
      // A journal that throws must not surface as `allowed`; the outcome
      // below is already fail-closed, so swallow only the audit fault here.
      return {
        kind: 'unavailable',
        reason: 'journal de sandbox falhou durante o registro de recusa'
      }
    }
    return outcome
  }

  return { evaluate }
}
