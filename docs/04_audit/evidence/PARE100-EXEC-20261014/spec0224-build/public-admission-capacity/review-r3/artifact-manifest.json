  "omissions": [
    {
      "path": "artifact-manifest.json",
      "kind": "self",
      "reason": "No recursive self-hash; all other primary outputs are byte/SHA-bound."
    },
    {
      "path": "i1-cache/**",
      "kind": "derived",
      "reason": "Disposable Vitest/Vite cache; not primary evidence."
    },
    {
      "path": "i1-tmp/**",
      "kind": "derived",
      "reason": "Disposable toolchain temporary files; no copied source input."
    },
    {
      "path": "__pycache__/**",
      "kind": "derived",
      "reason": "If present, Python interpreter cache; not primary evidence."
    },
    {
      "path": "sealed source/proof copies",
      "kind": "external inputs",
      "reason": "Not duplicated into review outputs; exact declared paths/bytes/SHA in pre/post manifests."
    },
    {
      "path": "unused node_modules/**",
      "kind": "unread/omitted",
      "reason": "Not inventoried; only registered actual dependency reads hashed."
    },
    {
      "path": "OS/runtime loader internals and native toolchain binaries",
      "kind": "toolchain boundary",
      "reason": "Outside source-input hash census; Node version observed, no syscall-level completeness claim."
    }
  ],
