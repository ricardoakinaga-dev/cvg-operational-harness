 259:   private async replace(record: DecisionAdmissionRecord): Promise<void> {
 260:     const state = this.state()
 261:     this.options.run.state.toolResultContext = {
 262:       ...state,
 263:       pendingDecisionAdmission:
 264:         record.status === 'RESERVED' ? record.admissionId : null,
 265:       decisionAdmissions: state.decisionAdmissions.map((value) =>
 266:         value.admissionId === record.admissionId ? record : value
 267:       )
 268:     }
 269:     try {
 270:       await this.options.persist()
 271:     } catch (error) {
 272:       this.options.run.state.toolResultContext = state
 273:       throw error
 274:     }
 275:   }
