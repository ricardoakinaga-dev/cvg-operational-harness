 104: export function assertCompleteToolObservation(observation: Observation): void {
 105:   if (observation.type !== 'TOOL_RESULT') return
 106:   const raw = observation.payload
 107:   // Validate plain JSON before reading individual fields; never invoke accessors.
 108:   completeSnapshot(raw)
 109:   const payload = raw as CompleteToolObservationPayload
 110:   if (
 111:     !payload ||
 112:     payload.schemaVersion !== 1 ||
 113:     observation.source !== 'TOOL' ||
 114:     observation.trust !== 'UNTRUSTED' ||
 115:     !['NONE', 'READ', 'WRITE', 'EXTERNAL'].includes(payload.sideEffect)
 116:   ) {
 117:     throw new ToolResultContextError(
 118:       'STATE_CONFLICT',
 119:       'Invalid complete tool envelope.',
 120:       'STATE_CONFLICT'
 121:     )
 122:   }
 123:   if (payload.status === 'SUCCEEDED' && payload.completion === 'COMPLETE') {
 124:     const value = canonicalizeCompleteJson(payload.output)
 125:     if (
 126:       payload.resultAvailability !== 'AVAILABLE' ||
 127:       payload.outputBytes !== Buffer.byteLength(value, 'utf8') ||
 128:       payload.outputSha256 !==
 129:         createHash('sha256').update(value).digest('hex') ||
 130:       Object.keys(payload).sort().join(',') !==
 131:         'completion,output,outputBytes,outputSha256,resultAvailability,schemaVersion,sideEffect,status'
 132:     ) {
 133:       throw new ToolResultContextError(
 134:         'STATE_CONFLICT',
 135:         'Tool result integrity mismatch.',
 136:         'STATE_CONFLICT'
 137:       )
 138:     }
 139:   } else if (
 140:     payload.status === 'SUCCEEDED' &&
 141:     payload.completion === 'UNAVAILABLE'
 142:   ) {
 143:     if (
 144:       payload.resultAvailability !== 'UNAVAILABLE' ||
 145:       !['INVALID_JSON', 'RESULT_TOO_LARGE', 'RESULT_COMPLEXITY'].includes(
 146:         payload.reason
 147:       ) ||
 148:       Object.keys(payload).sort().join(',') !==
 149:         'completion,reason,resultAvailability,schemaVersion,sideEffect,status'
 150:     ) {
 151:       throw new ToolResultContextError(
 152:         'STATE_CONFLICT',
 153:         'Invalid unavailable result.',
 154:         'STATE_CONFLICT'
 155:       )
 156:     }
 157:   } else if (
 158:     (payload.status !== 'FAILED' && payload.status !== 'REJECTED') ||
 159:     payload.completion !== 'NOT_APPLICABLE' ||
 160:     payload.resultAvailability !== 'UNAVAILABLE' ||
 161:     typeof payload.error !== 'string' ||
 162:     payload.error.length > 512 ||
 163:     Object.keys(payload).sort().join(',') !==
 164:       'completion,error,resultAvailability,schemaVersion,sideEffect,status'
 165:   ) {
 166:     throw new ToolResultContextError(
 167:       'STATE_CONFLICT',
 168:       'Invalid failed tool result.',
 169:       'STATE_CONFLICT'
 170:     )
 171:   }
 172: 
 173:   const identifiers = [
 174:     observation.observationId,
 175:     observation.executionId,
 176:     observation.stepId,
 177:     observation.provenance.sourceId,
 178:     observation.provenance.sourceVersion,
 179:     observation.provenance.operationKey,
 180:     observation.provenance.effectRef
 181:   ]
 182:   if (
 183:     identifiers.some(
 184:       (value) =>
 185:         value !== undefined &&
 186:         (typeof value !== 'string' ||
 187:           value.length > 512 ||
 188:           value.includes('\0'))
 189:     )
 190:   ) {
 191:     throw new ToolResultContextError(
 192:       'STATE_CONFLICT',
 193:       'Invalid tool result metadata.',
 194:       'STATE_CONFLICT'
 195:     )
 196:   }
 197:   const encoded = completeSnapshot(observation)
 198:   const outputBytes =
 199:     payload.completion === 'COMPLETE' ? payload.outputBytes : 0
 200:   if (Buffer.byteLength(encoded, 'utf8') - outputBytes > 4_096) {
 201:     throw new ToolResultContextError(
 202:       'CONTEXT_OVERFLOW',
 203:       'Tool result metadata exceeds its envelope limit.'
 204:     )
 205:   }
 206: }
