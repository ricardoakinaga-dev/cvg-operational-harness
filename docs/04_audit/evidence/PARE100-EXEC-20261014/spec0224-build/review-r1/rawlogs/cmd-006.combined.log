 208: export function completeToolItem(observation: Observation): ContextItem {
 209:   assertCompleteToolObservation(observation)
 210:   return {
 211:     contextId: `tool.${observation.observationId}`,
 212:     priority: 'FRESH_TOOL_RESULTS',
 213:     trust: 'UNTRUSTED',
 214:     source: observation.provenance.sourceId,
 215:     content: completeSnapshot(observation),
 216:     // Informational only. Qualified whole-request admission owns the real bound.
 217:     tokenEstimate: 0,
 218:     evidenceRefs: [observation.observationId]
 219:   }
 220: }
