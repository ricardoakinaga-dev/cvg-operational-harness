  62: /** Native, checkpoint-backed decision accounting. The model cannot issue receipts. */
  63: export class CompleteDecisionAdmission implements DecisionAdmissionPort {
  64:   private queue: Promise<unknown> = Promise.resolve()
  65:   private closed = false
  66: 
  67:   public constructor(private readonly options: AdmissionOptions) {}
  68: 
  69:   private serial<T>(operation: () => Promise<T>): Promise<T> {
  70:     const next = this.queue.then(operation)
  71:     this.queue = next.catch(() => undefined)
  72:     return next
  73:   }
  74: 
  75:   public reserve(
  76:     input: DecisionAdmissionReserveInput
  77:   ): Promise<DecisionAdmissionRecord> {
  78:     return this.serial(() => this.reserveNow(input))
  79:   }
  80: 
  81:   public settle(
  82:     input: DecisionAdmissionSettlement
  83:   ): Promise<DecisionAdmissionRecord> {
  84:     return this.serial(() => this.settleNow(input))
  85:   }
  86: 
  87:   /** Close synchronously, then persist uncertainty before accepting a late result. */
  88:   public close(reason = 'decision_closed'): Promise<void> {
  89:     this.closed = true
  90:     return this.serial(async () => {
  91:       const state = this.state()
  92:       if (state.pendingDecisionAdmission) {
  93:         const record = state.decisionAdmissions.find(
  94:           (value) => value.admissionId === state.pendingDecisionAdmission
  95:         )
  96:         if (!record || record.status !== 'RESERVED') throw this.conflict()
  97:         await this.unknown(record, reason)
  98:       }
  99:     })
 100:   }
 101: 
 102:   private state() {
 103:     const state = this.options.run.state.toolResultContext
 104:     if (!state || state.version !== 1) throw this.conflict()
 105:     return state
 106:   }
 107: 
 108:   private conflict(): ToolResultContextError {
 109:     return new ToolResultContextError(
 110:       'STATE_CONFLICT',
 111:       'Decision admission identity or state conflicts.',
 112:       'STATE_CONFLICT'
 113:     )
 114:   }
 115: 
 116:   private async reserveNow(
 117:     input: DecisionAdmissionReserveInput
 118:   ): Promise<DecisionAdmissionRecord> {
 119:     const { run, stepNumber, signal } = this.options
 120:     if (this.closed || signal.aborted) {
 121:       throw new ToolResultContextError(
 122:         'DECISION_USAGE_UNKNOWN',
 123:         'Decision admission is closed.',
 124:         'CANCELLED'
 125:       )
 126:     }
 127:     if (this.options.remainingMs() <= 0) {
 128:       throw new ToolResultContextError(
 129:         'DECISION_USAGE_UNKNOWN',
 130:         'Decision deadline elapsed.',
 131:         'MAX_DURATION'
 132:       )
 133:     }
 134:     const state = this.state()
 135:     if (
 136:       state.pendingDecisionAdmission ||
 137:       state.decisionAdmissions.some((value) => value.status === 'UNKNOWN')
 138:     )
 139:       throw this.conflict()
 140:     const { request, measurement } = input
 141:     const purpose = request.purpose
 142:     if (
 143:       (purpose !== 'ORCHESTRATION' && purpose !== 'REPAIR') ||
 144:       request.correlationId !== run.input.correlationId ||
 145:       request.maxOutputTokens !== COMPLETE_DECISION_OUTPUT_TOKENS ||
 146:       !Number.isSafeInteger(input.attempt) ||
 147:       input.attempt < 0 ||
 148:       !Number.isSafeInteger(measurement.inputUpperBoundTokens) ||
 149:       measurement.inputUpperBoundTokens < 0 ||
 150:       !Number.isSafeInteger(measurement.contextWindowTokens) ||
 151:       measurement.contextWindowTokens < 1 ||
 152:       !Number.isFinite(measurement.costUpperBoundUsd) ||
 153:       measurement.costUpperBoundUsd < 0 ||
 154:       [
 155:         measurement.counterId,
 156:         measurement.counterVersion,
 157:         measurement.provider,
 158:         measurement.model,
 159:         measurement.formattingVersion
 160:       ].some(
 161:         (value) =>
 162:           typeof value !== 'string' ||
 163:           !value ||
 164:           value.length > 512 ||
 165:           value.includes('\0')
 166:       )
 167:     )
 168:       throw new ToolResultContextError(
 169:         'ADMISSION_UNAVAILABLE',
 170:         'Invalid qualified decision measurement.'
 171:       )
 172:     const requestSha256 = digest(request)
 173:     const inputTokens = measurement.inputUpperBoundTokens
 174:     if (
 175:       inputTokens > this.options.tokenBudget ||
 176:       inputTokens + COMPLETE_DECISION_OUTPUT_TOKENS >
 177:         measurement.contextWindowTokens
 178:     ) {
 179:       throw new ToolResultContextError(
 180:         'CONTEXT_OVERFLOW',
 181:         'The complete decision input does not fit its qualified context.'
 182:       )
 183:     }
 184:     if (run.usage.modelCalls + 1 > run.input.budget.maxModelCalls) {
 185:       throw new ToolResultContextError(
 186:         'CONTEXT_OVERFLOW',
 187:         'No decision model-call slot remains.',
 188:         'MAX_MODEL_CALLS'
 189:       )
 190:     }
 191:     if (
 192:       run.usage.inputTokens +
 193:         run.usage.outputTokens +
 194:         inputTokens +
 195:         COMPLETE_DECISION_OUTPUT_TOKENS >
 196:       run.input.budget.maxTokens
 197:     ) {
 198:       throw new ToolResultContextError(
 199:         'CONTEXT_OVERFLOW',
 200:         'Insufficient decision token reserve.',
 201:         'MAX_TOKENS'
 202:       )
 203:     }
 204:     if (
 205:       run.usage.costUsd + measurement.costUpperBoundUsd >
 206:       run.input.budget.maxCostUsd
 207:     ) {
 208:       throw new ToolResultContextError(
 209:         'CONTEXT_OVERFLOW',
 210:         'Insufficient decision cost reserve.',
 211:         'MAX_COST'
 212:       )
 213:     }
 214:     if (
 215:       purpose === 'REPAIR' &&
 216:       run.usage.decisionRepairs + 1 > (run.input.budget.maxDecisionRepairs ?? 1)
 217:     ) {
 218:       throw new ToolResultContextError(
 219:         'ADMISSION_UNAVAILABLE',
 220:         'Decision repair limit exhausted.',
 221:         'MODEL_FAILURE'
 222:       )
 223:     }
 224:     const record: DecisionAdmissionRecord = {
 225:       admissionId: `admission_${randomUUID()}`,
 226:       tenantId: run.input.tenantId,
 227:       executionId: run.executionId,
 228:       stepNumber,
 229:       attempt: state.decisionAdmissions.filter(
 230:         (value) => value.stepNumber === stepNumber
 231:       ).length,
 232:       purpose,
 233:       requestSha256,
 234:       measurement: structuredClone(measurement),
 235:       reserved: {
 236:         modelCalls: 1,
 237:         inputTokens,
 238:         outputTokens: COMPLETE_DECISION_OUTPUT_TOKENS,
 239:         costUsd: measurement.costUpperBoundUsd
 240:       },
 241:       status: 'RESERVED'
 242:     }
 243:     run.usage.modelCalls += 1
 244:     run.usage.inputTokens += record.reserved.inputTokens
 245:     run.usage.outputTokens += record.reserved.outputTokens
 246:     run.usage.costUsd += record.reserved.costUsd
 247:     if (purpose === 'REPAIR') run.usage.decisionRepairs += 1
 248:     run.state.toolResultContext = {
 249:       ...state,
 250:       pendingDecisionAdmission: record.admissionId,
 251:       decisionAdmissions: [...state.decisionAdmissions, record]
 252:     }
 253:     await this.options.persist()
 254:     await this.options.audit('decision.admission.reserved', requestSha256)
 255:     // The receipt is returned only after the checkpoint commit and audit.
 256:     return structuredClone(record)
 257:   }
