  18: interface AdmissionOptions {
  19:   readonly run: LoopRun
  20:   readonly stepNumber: number
  21:   readonly tokenBudget: number
  22:   readonly signal: AbortSignal
  23:   readonly remainingMs: () => number
  24:   readonly persist: () => Promise<void>
  25:   readonly audit: (action: string, result: string) => Promise<void>
  26: }
  27: 
  28: function digest(value: unknown): string {
  29:   return createHash('sha256')
  30:     .update(
  31:       canonicalizeCompleteJson(value, {
  32:         maxBytes: COMPLETE_DECISION_REQUEST_MAX_BYTES,
  33:         maxDepth: 64,
  34:         maxNodes: 20_000
  35:       })
  36:     )
  37:     .digest('hex')
  38: }
  39: 
  40: function finiteUsage(result: ModelResult): ModelUsage | null {
  41:   if (
  42:     !result ||
  43:     typeof result.text !== 'string' ||
  44:     typeof result.provider !== 'string' ||
  45:     typeof result.model !== 'string' ||
  46:     !Number.isSafeInteger(result.inputTokens) ||
  47:     result.inputTokens < 0 ||
  48:     !Number.isSafeInteger(result.outputTokens) ||
  49:     result.outputTokens < 0 ||
  50:     !Number.isFinite(result.costUsd) ||
  51:     result.costUsd < 0
  52:   )
  53:     return null
  54:   return {
  55:     modelCalls: 1,
  56:     inputTokens: result.inputTokens,
  57:     outputTokens: result.outputTokens,
  58:     costUsd: result.costUsd
  59:   }
  60: }
