  25: 
  26: /** Before legacy serialization/validators can coerce or invoke output data. */
  27: export function prepareCompleteToolResult(raw: unknown): ToolResult {
  28:   let safe: Record<string, unknown>
  29:   try {
  30:     const text = canonicalizeCompleteJson(raw, LARGE_LIMITS)
  31:     safe = JSON.parse(text) as Record<string, unknown>
  32:     if (
  33:       !safe ||
  34:       Array.isArray(safe) ||
  35:       !['SUCCEEDED', 'FAILED', 'REJECTED'].includes(safe.status as string)
  36:     )
  37:       throw new Error('shape')
  38:     if (
  39:       safe.error !== undefined &&
  40:       (typeof safe.error !== 'string' || safe.error.length > 512)
  41:     )
  42:       throw new Error('error')
  43:   } catch {
  44:     // The body may already have acted; do not turn capture failure into safe replay.
  45:     throw new Error('unknown_effect: complete_result_not_representable')
  46:   }
  47:   return {
  48:     status: safe.status as ToolResult['status'],
  49:     ...(Object.hasOwn(safe, 'output') ? { output: safe.output } : {}),
  50:     ...(typeof safe.error === 'string' ? { error: safe.error } : {})
  51:   }
  52: }
  53: 
  54: export function prepareCompleteToolRegistry(
  55:   registry: ToolRegistry
  56: ): ToolRegistry {
  57:   const prepare = (tool: ReturnType<ToolRegistry['resolve']>) =>
  58:     tool
  59:       ? {
  60:           ...tool,
  61:           execute: async (...args: Parameters<typeof tool.execute>) =>
  62:             prepareCompleteToolResult(await tool.execute(...args))
  63:         }
  64:       : undefined
  65:   return {
  66:     list: () => registry.list().map((tool) => prepare(tool)!),
  67:     resolve: (id, version) => prepare(registry.resolve(id, version))
  68:   }
  69: }
  70: 
  71: export function completeSnapshot(value: unknown): string {
  72:   return canonicalizeCompleteJson(value, LARGE_LIMITS)
  73: }
  74: 
  75: export function completeToolPayload(
  76:   output: unknown,
  77:   sideEffect: SideEffect
  78: ): CompleteToolObservationPayload {
  79:   try {
  80:     const serialized = canonicalizeCompleteJson(output)
  81:     return {
  82:       schemaVersion: 1,
  83:       status: 'SUCCEEDED',
  84:       sideEffect,
  85:       completion: 'COMPLETE',
  86:       resultAvailability: 'AVAILABLE',
  87:       output: JSON.parse(serialized) as CompleteJsonValue,
  88:       outputBytes: Buffer.byteLength(serialized, 'utf8'),
  89:       outputSha256: createHash('sha256').update(serialized).digest('hex')
  90:     }
  91:   } catch (error) {
  92:     if (!(error instanceof CompleteJsonError)) throw error
  93:     return {
  94:       schemaVersion: 1,
  95:       status: 'SUCCEEDED',
  96:       sideEffect,
  97:       completion: 'UNAVAILABLE',
  98:       resultAvailability: 'UNAVAILABLE',
  99:       reason: error.code
 100:     }
 101:   }
 102: }
