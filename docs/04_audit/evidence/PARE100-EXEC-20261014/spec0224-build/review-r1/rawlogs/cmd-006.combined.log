 277:   private async unknown(
 278:     record: DecisionAdmissionRecord,
 279:     reason: string,
 280:     actual?: ModelUsage
 281:   ): Promise<DecisionAdmissionRecord> {
 282:     const next: DecisionAdmissionRecord = {
 283:       ...record,
 284:       status: 'UNKNOWN',
 285:       unknownReason: /^[a-zA-Z0-9_:-]{1,128}$/.test(reason)
 286:         ? reason
 287:         : 'decision_model_failed',
 288:       ...(actual ? { actual } : {})
 289:     }
 290:     if (actual) {
 291:       const usage = this.options.run.usage
 292:       usage.inputTokens +=
 293:         Math.max(record.reserved.inputTokens, actual.inputTokens) -
 294:         record.reserved.inputTokens
 295:       usage.outputTokens +=
 296:         Math.max(record.reserved.outputTokens, actual.outputTokens) -
 297:         record.reserved.outputTokens
 298:       usage.costUsd +=
 299:         Math.max(record.reserved.costUsd, actual.costUsd) -
 300:         record.reserved.costUsd
 301:     }
 302:     await this.replace(next)
 303:     return structuredClone(next)
 304:   }
 305: 
 306:   private async settleNow(
 307:     input: DecisionAdmissionSettlement
 308:   ): Promise<DecisionAdmissionRecord> {
 309:     const { run } = this.options
 310:     const record = this.state().decisionAdmissions.find(
 311:       (value) => value.admissionId === input.admissionId
 312:     )
 313:     if (
 314:       !record ||
 315:       record.tenantId !== run.input.tenantId ||
 316:       record.executionId !== run.executionId ||
 317:       record.requestSha256 !== input.requestSha256
 318:     )
 319:       throw this.conflict()
 320:     if (record.status === 'SETTLED') {
 321:       if (
 322:         input.kind !== 'RESULT' ||
 323:         digest(input.result) !== record.resultSha256
 324:       )
 325:         throw this.conflict()
 326:       return structuredClone(record)
 327:     }
 328:     if (
 329:       record.status !== 'RESERVED' ||
 330:       this.state().pendingDecisionAdmission !== record.admissionId
 331:     )
 332:       throw this.conflict()
 333:     if (input.kind === 'UNKNOWN') return this.unknown(record, input.reason)
 334:     if (
 335:       this.closed ||
 336:       this.options.signal.aborted ||
 337:       this.options.remainingMs() <= 0
 338:     ) {
 339:       await this.unknown(record, 'decision_closed')
 340:       throw new ToolResultContextError(
 341:         'DECISION_USAGE_UNKNOWN',
 342:         'A late decision result cannot be accepted.'
 343:       )
 344:     }
 345:     const actual = finiteUsage(input.result)
 346:     if (
 347:       !actual ||
 348:       input.result.provider !== record.measurement.provider ||
 349:       input.result.model !== record.measurement.model ||
 350:       actual.inputTokens > record.reserved.inputTokens ||
 351:       actual.outputTokens > record.reserved.outputTokens ||
 352:       actual.costUsd > record.reserved.costUsd
 353:     ) {
 354:       await this.unknown(record, 'ADMISSION_BREACH', actual ?? undefined)
 355:       await this.options.audit(
 356:         'decision.admission.breach',
 357:         record.requestSha256
 358:       )
 359:       throw new ToolResultContextError(
 360:         'ADMISSION_BREACH',
 361:         'The model violated its qualified decision bounds.'
 362:       )
 363:     }
 364:     const resultSha256 = digest(input.result)
 365:     const usage = run.usage
 366:     const previous = {
 367:       inputTokens: usage.inputTokens,
 368:       outputTokens: usage.outputTokens,
 369:       costUsd: usage.costUsd
 370:     }
 371:     usage.inputTokens += actual.inputTokens - record.reserved.inputTokens
 372:     usage.outputTokens += actual.outputTokens - record.reserved.outputTokens
 373:     usage.costUsd += actual.costUsd - record.reserved.costUsd
 374:     const settled: DecisionAdmissionRecord = {
 375:       ...record,
 376:       status: 'SETTLED',
 377:       actual,
 378:       resultSha256
 379:     }
 380:     try {
 381:       await this.replace(settled)
 382:     } catch (error) {
 383:       // No acknowledged settlement: retain the pre-call conservative charge.
 384:       Object.assign(usage, previous)
 385:       throw error
 386:     }
 387:     await this.options.audit('decision.admission.settled', record.requestSha256)
 388:     return structuredClone(settled)
 389:   }
 390: }

