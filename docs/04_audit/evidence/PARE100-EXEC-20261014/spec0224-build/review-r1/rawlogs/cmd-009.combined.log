1892:   private preflightCompleteTool(
1893:     run: LoopRun,
1894:     decision: LoopDecision,
1895:     stepNumber: number
1896:   ): void {
1897:     if (!this.options.toolResultContext) return
1898:     const tool = this.options.tools.resolve(
1899:       decision.toolId ?? '',
1900:       decision.toolVersion
1901:     )
1902:     if (!tool)
1903:       throw new ToolResultContextError(
1904:         'STATE_CONFLICT',
1905:         'Missing native tool.',
1906:         'STATE_CONFLICT'
1907:       )
1908:     if (
1909:       run.observations.filter((value) => value.type === 'TOOL_RESULT').length >=
1910:       MAX_CHECKPOINT_OBSERVATIONS
1911:     ) {
1912:       throw new ToolResultContextError(
1913:         'CONTEXT_OVERFLOW',
1914:         'No retention slot remains before tool dispatch.'
1915:       )
1916:     }
1917:     const placeholder = this.makeObservation(run, {
1918:       stepId: `step_${run.executionId}_${stepNumber}_tool`,
1919:       stepNumber,
1920:       type: 'TOOL_RESULT',
1921:       source: 'TOOL',
1922:       trust: 'UNTRUSTED',
1923:       payload: { status: 'SUCCEEDED', output: 'x'.repeat(32_766) },
1924:       summary: 'x'.repeat(500),
1925:       provenance: {
1926:         sourceId: tool.id,
1927:         sourceVersion: tool.version,
1928:         operationKey: this.operationKey(run, stepNumber, tool.id),
1929:         effectRef: this.operationKey(run, stepNumber, tool.id)
1930:       }
1931:     })
1932:     const prospective = {
1933:       executionId: run.executionId,
1934:       tenantId: run.input.tenantId,
1935:       checkpointVersion: 2,
1936:       runtimeProfile: 'iterative',
1937:       runtimeVersion: RUNTIME_V2_VERSION,
1938:       orchestratorVersion: this.orchestratorVersion,
1939:       stepNumber: run.state.stepNumber,
1940:       state: {
1941:         ...run.state,
1942:         pendingDecision: decision,
1943:         pendingStepNumber: stepNumber,
1944:         observations: retainCompleteObservations([
1945:           ...run.observations,
1946:           placeholder
1947:         ])
1948:       },
1949:       budgetUsage: { ...run.usage, toolCalls: run.usage.toolCalls + 1 }
1950:     }
1951:     try {
1952:       // Optional internal fields are absent on the wire. Real saves use the
1953:       // stricter schema-owned checkpoint codec, not this size-only projection.
1954:       canonicalizeCompleteJson(JSON.parse(JSON.stringify(prospective)), {
1955:         maxBytes: COMPLETE_CHECKPOINT_MAX_BYTES - 65_536,
1956:         maxDepth: 64,
1957:         maxNodes: 1_000_000
1958:       })
1959:     } catch {
1960:       throw new ToolResultContextError(
1961:         'CONTEXT_OVERFLOW',
1962:         'Prospective checkpoint cannot reserve full tool result and step overhead.'
1963:       )
1964:     }
1965:   }
