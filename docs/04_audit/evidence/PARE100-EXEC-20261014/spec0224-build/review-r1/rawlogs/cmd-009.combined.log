 900:   private rejectCheckpoint(
 901:     checkpoint: ExecutionCheckpoint,
 902:     input: RuntimeInput
 903:   ): string | null {
 904:     if (checkpoint.checkpointVersion === 2 && !this.options.toolResultContext) {
 905:       return 'Complete checkpoint requires the explicitly configured complete-tool-v1 mode.'
 906:     }
 907:     if (checkpoint.runtimeProfile !== 'iterative') {
 908:       return 'Execution checkpoint belongs to a different runtime profile.'
 909:     }
 910:     if (checkpoint.runtimeVersion !== RUNTIME_V2_VERSION) {
 966:         // pending approval or question, stays resumable (AUD-0597 F03).
 967:         return {
 968:           ...this.stop(beforeStep.stopReason, beforeStep.response),
 969:           /* v8 ignore next -- the pause control is the only before-step control */
 970:           ...(beforeStep.cause === 'operator_paused'
 971:             ? { preserveCheckpoint: true }
 972:             : {})
 973:         }
 974:       }
 975:       const budgetStop = this.checkBudget(run)
 976:       if (budgetStop) return this.stop(budgetStop.reason, budgetStop.response)
 977: 
 978:       let decision: LoopDecision
 979:       let stepNumber: number
 980:       let decisionAdmissionIds: readonly string[] | undefined
 981:       let modelDecision = false
 982: 
 983:       if (run.state.pendingDecision && run.state.pendingStepNumber) {
 984:         decision = run.state.pendingDecision
 985:         stepNumber = run.state.pendingStepNumber
 986:         run.lastDecision = decision
 987:       } else if (
 988:         this.options.toolResultContext &&
 989:         run.state.toolResultContext?.acceptedDecision
 990:       ) {
 991:         const accepted = run.state.toolResultContext.acceptedDecision
 992:         if (accepted.stepNumber !== run.stepNumber + 1)
 993:           throw new ToolResultContextError(
 994:             'STATE_CONFLICT',
 995:             'Accepted decision is bound to another step.',
 996:             'STATE_CONFLICT'
 997:           )
 998:         decision = accepted.decision
 999:         stepNumber = accepted.stepNumber
1000:         decisionAdmissionIds = accepted.decisionAdmissionIds
1001:         run.lastDecision = decision
1002:       } else {
1003:         stepNumber = run.stepNumber + 1
1004:         if (stepNumber > run.input.budget.maxSteps) {
1005:           return this.stop('MAX_STEPS', 'Step budget exhausted.')
1006:         }
1007:         const decisionResult = await this.decide(run, stepNumber)
1008:         if (decisionResult.outcome) return decisionResult.outcome
1009:         decision = sanitizeLoopDecision(decisionResult.decision)
1010:         decisionAdmissionIds = decisionResult.decisionAdmissionIds
1011:         modelDecision = decisionResult.modelDecision ?? false
1012:         run.lastDecision = decision
1013:       }
1014: 
1015:       const validation = this.validateDecision(run, decision)
1016:       if (!validation.valid) {
1017:         if (!this.options.toolResultContext) run.usage.decisionRepairs += 1
1018:         run.lastDecisionErrors = validation.errors
1019:         const repairBudget = run.input.budget.maxDecisionRepairs ?? 1
1020:         if (
1021:           (this.options.toolResultContext
1022:             ? run.usage.decisionRepairs + 1
1023:             : run.usage.decisionRepairs) <= repairBudget &&
1024:           !run.state.pendingDecision
1025:         ) {
1026:           continue
1027:         }
1028:         const capabilityOnly = validation.errors.every((error) =>
1029:           error.startsWith('capability:')
1030:         )
1031:         return this.stop(
1032:           capabilityOnly ? 'STATE_CONFLICT' : 'MODEL_FAILURE',
1033:           `Orchestrator decision was rejected: ${validation.errors.join('; ')}`
1034:         )
1035:       }
1036:       run.lastDecisionErrors = []
1037:       if (this.options.toolResultContext && !run.state.pendingDecision) {
1038:         const state = run.state.toolResultContext!
1039:         run.state.toolResultContext = {
1040:           ...state,
1041:           deliveredThroughStep: modelDecision
1042:             ? Math.max(
1043:                 state.deliveredThroughStep,
1044:                 ...run.observations
1045:                   .filter((value) => value.type === 'TOOL_RESULT')
1046:                   .map((value) => value.stepNumber)
1047:               )
1048:             : state.deliveredThroughStep,
1049:           acceptedDecision: {
1050:             stepNumber,
1051:             decision,
1052:             decisionAdmissionIds: decisionAdmissionIds ?? []
1053:           }
1054:         }
1055:         await this.persistCheckpoint(run)
1056:       }
1057: 
1058:       const signature = decisionSignature(decision)
1059:       if (decision.decisionType !== 'STOP') {
1060:         const repeats = run.state.loopSignatures.filter(
1061:           (candidate) => candidate === signature
1062:         ).length
1063:         const threshold = this.effectiveRepeatThreshold(run, decision)
1064:         const cycle = detectDecisionCycle(run.state.loopSignatures, signature)
1065:         if (repeats >= threshold || cycle) {
1066:           await this.recordStep(run, {
1067:             stepNumber,
1068:             stepType: 'POLICY',
1069:             status: 'FAILED',
1070:             sideEffecting: false,
1071:             errorCode: 'loop_detected',
1072:             reasonCode: 'LOOP_SUSPECTED'
1073:           })
1074:           return this.stop(
1075:             'LOOP_DETECTED',
1076:             cycle
1077:               ? 'A repeated decision cycle was detected; the loop stopped without executing another effect.'
1078:               : 'Repeated identical decisions were detected; the loop stopped without executing another effect.'
1079:           )
1080:         }
1081:       }
1082: 
1083:       await this.safeAudit(run, 'orchestrator.decided', {
1084:         result: `${decision.decisionType}:${decision.reasonCode}`,
1085:         tool: decision.toolId ?? null
1086:       })
1087: 
1088:       const dispatch = await this.dispatch(run, decision, stepNumber)
1089:       if (dispatch.kind === 'pause') {
1090:         return await this.pause(run, stepNumber, dispatch)
1091:       }
1092:       if (dispatch.kind === 'stop') {
1093:         run.stepNumber = stepNumber
1094:         if (this.options.toolResultContext) {
1095:           run.state.stepNumber = stepNumber
1096:           run.state.toolResultContext = {
1097:             ...run.state.toolResultContext!,
1098:             acceptedDecision: undefined
1099:           }
1100:         }
1101:         return dispatch
1102:       }
1103: 
1104:       const signatures = [...run.state.loopSignatures, signature].slice(
1105:         -this.maxSignatures
1106:       )
1107:       run.stepNumber = stepNumber
1108:       run.state = {
1109:         ...run.state,
1110:         stepNumber,
1111:         loopSignatures: signatures,
1112:         pendingDecision: undefined,
1113:         pendingStepNumber: undefined,
1114:         selectedCapability:
1115:           decision.toolId ??
1116:           decision.selectedCapability ??
1117:           run.state.selectedCapability
1118:       }
1119:       if (this.options.toolResultContext) {
1120:         run.state.toolResultContext = {
1121:           ...run.state.toolResultContext!,
1122:           acceptedDecision: undefined
1123:         }
1124:       }
1125:       await this.persistCheckpoint(run)
1126: 
1127:       if (run.skipEvaluationOnce) {
1128:         run.skipEvaluationOnce = false
1129:         continue
1130:       }
1160:   private async decide(
1161:     run: LoopRun,
1162:     stepNumber: number
1163:   ): Promise<{
1164:     outcome?: Extract<DispatchOutcome, { kind: 'stop' }>
1165:     decision?: LoopDecision
1166:     decisionAdmissionIds?: readonly string[]
1167:     modelDecision?: boolean
1168:   }> {
1169:     const remaining = this.remainingDuration(run)
1170:     if (remaining <= 0) {
1171:       return {
1172:         outcome: this.stop(
1173:           'MAX_DURATION',
1174:           'Duration budget exhausted before the next decision.'
1175:         )
1176:       }
1177:     }
1178: 
1179:     const stateForContext: MutableState = {
1180:       ...run.state,
1181:       observations: run.observations
1182:     }
1183:     const buildInput: ContextBuildInput = {
1184:       runtime: {
1185:         executionId: run.executionId,
1186:         tenantId: run.input.tenantId,
1187:         conversationId: run.input.conversationId,
1188:         correlationId: run.input.correlationId,
1189:         traceId: run.input.traceId,
1190:         userMessage: run.input.userMessage,
1191:         context: run.input.context,
1192:         objective: run.input.agent.objective,
1193:         instructions: run.input.agent.instructions,
1194:         agentId: run.input.agent.id,
1195:         agentVersion: run.input.agent.version
1196:       },
1197:       ...(this.options.toolResultContext
1198:         ? { toolResultContext: this.options.toolResultContext }
1199:         : {}),
1200:       profile: 'iterative',
1201:       stepNumber,
1202:       goal: run.state.goal,
1203:       state: stateForContext,
1204:       capabilities: this.availableTools(run),
1205:       knowledgeAvailable: Boolean(this.options.knowledge),
1206:       completionStrategy: run.input.agent.completionStrategy ?? 'DETERMINISTIC',
1207:       allowedDecisionTypes: this.allowedDecisionTypes(run),
1208:       budget: run.input.budget,
1209:       budgetUsage: run.usage,
1210:       ...((
1211:         this.options.toolResultContext
1212:           ? run.lastDecisionErrors.length > 0
1213:           : run.usage.decisionRepairs > 0
1214:       )
1215:         ? {
1216:             decisionRepair: {
1217:               attempt: this.options.toolResultContext
1218:                 ? run.usage.decisionRepairs + 1
1219:                 : run.usage.decisionRepairs,
1220:               errors: run.lastDecisionErrors
1221:             }
1222:           }
1223:         : {})
1224:     }
1225:     const complete = Boolean(this.options.toolResultContext)
1226:     const nativeInput = complete ? structuredClone(buildInput) : buildInput
1227:     const building = this.contextEngine.build(
1228:       complete ? structuredClone(nativeInput) : nativeInput
1229:     )
1230:     const built = complete
1231:       ? await this.withDeadline(building, this.remainingDuration(run))
1232:       : await building
1233:     if (built === DEADLINE_EXCEEDED) {
1234:       return {
1235:         outcome: this.stop(
1236:           'MAX_DURATION',
1237:           'Context assembly exceeded the execution deadline.'
1238:         )
1239:       }
1240:     }
1241:     const context = built
1242:     if (complete) {
1243:       const native = await new DefaultContextEngine({
1244:         tokenBudget: context.tokenBudget
1245:       }).build(nativeInput)
1246:       validateCompleteStepContext(context, native)
1247:       for (const observation of run.observations) {
1248:         if (observation.type === 'TOOL_RESULT') {
1249:           assertCompleteToolObservation(observation)
1250:           if (
1251:             (observation.payload as { completion: string }).completion ===
1252:             'UNAVAILABLE'
1253:           ) {
1254:             throw new ToolResultContextError(
1255:               'RESULT_UNAVAILABLE',
1256:               'A complete tool result is unavailable.'
1257:             )
1258:           }
1259:         }
1260:       }
1261:     }
1262:     const decisionAbortController = new AbortController()
1263:     const parentSignal = this.#turns.get(run)?.signal
1264:     const abort = () => decisionAbortController.abort()
1265:     if (parentSignal?.aborted) abort()
1266:     parentSignal?.addEventListener('abort', abort, { once: true })
1267:     const priorIds = new Set(
1268:       run.state.toolResultContext?.decisionAdmissions.map(
1269:         (value) => value.admissionId
1270:       )
1271:     )
1272:     const admission = complete
1273:       ? new CompleteDecisionAdmission({
1274:           run,
1275:           stepNumber,
1276:           tokenBudget: context.tokenBudget,
1277:           signal: decisionAbortController.signal,
1278:           remainingMs: () => this.remainingDuration(run),
1279:           persist: () => this.persistCheckpoint(run),
1280:           audit: (action, result) => this.safeAudit(run, action, { result })
1281:         })
1282:       : undefined
1283:     let failed = false
1284:     try {
1285:       const decisionOrDeadline = await this.withDeadline(
1286:         this.options.orchestrator.decide({
1287:           context,
1288:           ...(admission ? { decisionAdmission: admission } : {}),
1289:           signal: decisionAbortController.signal
1290:         }),
1291:         complete ? this.remainingDuration(run) : remaining
1292:       )
1293:       if (decisionOrDeadline === DEADLINE_EXCEEDED) {
1294:         decisionAbortController.abort()
1295:         return {
1296:           outcome: this.stop(
1297:             'MAX_DURATION',
1298:             'Duration budget exhausted while deciding the next step.'
1299:           )
1300:         }
1301:       }
1302:       const turn = decisionOrDeadline
1303:       if (complete) {
1304:         const state = run.state.toolResultContext!
1305:         const expected = state.decisionAdmissions
1306:           .filter(
1307:             (value) =>
1308:               value.stepNumber === stepNumber && value.status === 'SETTLED'
1309:           )
1310:           .map((value) => value.admissionId)
