1850:   private async persistCheckpoint(run: LoopRun): Promise<void> {
1851:     const checkpoint = sealCheckpoint({
1852:       executionId: run.executionId,
1853:       tenantId: run.input.tenantId,
1854:       checkpointVersion: this.options.toolResultContext ? 2 : 1,
1855:       runtimeProfile: 'iterative',
1856:       runtimeVersion: RUNTIME_V2_VERSION,
1857:       orchestratorVersion: this.orchestratorVersion,
1858:       stepNumber: run.state.stepNumber,
1859:       state: {
1860:         ...run.state,
1861:         observations: this.options.toolResultContext
1862:           ? retainCompleteObservations(run.observations)
1863:           : run.observations.slice(-MAX_CHECKPOINT_OBSERVATIONS)
1864:       },
1865:       budgetUsage: { ...run.usage }
1866:     })
1867:     if (this.options.toolResultContext) {
1868:       const result = await this.options.stepStore.compareAndSwapCheckpoint!({
1869:         tenantId: run.input.tenantId,
1870:         executionId: run.executionId,
1871:         expected: run.checkpointToken ?? null,
1872:         next: checkpoint
1873:       })
1874:       if (
1875:         result.status !== 'APPLIED' ||
1876:         result.token.checkpointId !== checkpoint.checkpointId ||
1877:         result.token.digest !== checkpoint.digest
1878:       ) {
1879:         run.checkpointConflict = true
1880:         throw new ToolResultContextError(
1881:           'STATE_CONFLICT',
1882:           'Checkpoint compare-and-swap did not commit this writer.',
1883:           'STATE_CONFLICT'
1884:         )
1885:       }
1886:       run.checkpointToken = result.token
1887:     } else {
1888:       await this.options.stepStore.saveCheckpoint(checkpoint)
1889:     }
1890:   }
