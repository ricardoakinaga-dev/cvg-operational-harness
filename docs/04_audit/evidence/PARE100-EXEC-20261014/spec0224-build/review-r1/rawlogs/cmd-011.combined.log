 115:       agentId: input.runtime.agentId,
 116:       agentVersion: input.runtime.agentVersion,
 117:       objective: input.runtime.objective,
 118:       instructions: input.runtime.instructions,
 119:       goal: input.goal,
 120:       userMessage: input.runtime.userMessage,
 121:       stateSummary: this.stateSummary(input, recentObservations),
 122:       observations: recentObservations,
 123:       capabilities: input.capabilities,
 124:       knowledgeAvailable: input.knowledgeAvailable,
