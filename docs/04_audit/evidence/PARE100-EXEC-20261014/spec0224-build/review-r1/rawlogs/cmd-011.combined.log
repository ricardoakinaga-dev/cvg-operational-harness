 146: // These limits apply to the whole logical request, not the tool output alone.
 147: const REQUEST_JSON_LIMITS = {
 148:   maxBytes: COMPLETE_DECISION_REQUEST_MAX_BYTES,
 149:   maxDepth: 64,
 150:   maxNodes: 1_000_000
 151: } as const
 152: 
 153: function freezeComplete<T>(value: T): T {
 154:   if (value !== null && typeof value === 'object') {
 155:     for (const child of Object.values(value)) freezeComplete(child)
 156:     Object.freeze(value)
 157:   }
 158:   return value
 159: }
 160: 
 161: function completeDigest(value: unknown): string {
 162:   return createHash('sha256')
 163:     .update(canonicalizeCompleteJson(value, REQUEST_JSON_LIMITS))
 164:     .digest('hex')
 165: }
 166: 
 167: function finiteNonnegative(value: number): boolean {
 168:   return Number.isFinite(value) && value >= 0
 169: }
 170: 
 171: function validMeasurement(value: DecisionInputMeasurement): boolean {
 172:   return (
 173:     value !== null &&
 174:     typeof value === 'object' &&
 175:     [
 176:       value.counterId,
 177:       value.counterVersion,
 178:       value.provider,
 179:       value.model,
 180:       value.formattingVersion
 181:     ].every((field) => typeof field === 'string' && field.trim().length > 0) &&
 182:     Number.isSafeInteger(value.inputUpperBoundTokens) &&
 183:     value.inputUpperBoundTokens >= 0 &&
 184:     Number.isSafeInteger(value.contextWindowTokens) &&
 185:     value.contextWindowTokens > 0 &&
 186:     finiteNonnegative(value.costUpperBoundUsd)
 187:   )
 188: }
