  69: /**
  70:  * Deterministic context assembly. Priority order is fixed and trimming skips
  71:  * the lowest-priority items first instead of slicing text arbitrarily.
  72:  */
  73: export class DefaultContextEngine implements ContextEngine {
  74:   private readonly tokenBudget: number
  75:   private readonly maxObservations: number
  76:   private readonly maxHistoryItems: number
  77: 
  78:   public constructor(options: DefaultContextEngineOptions = {}) {
