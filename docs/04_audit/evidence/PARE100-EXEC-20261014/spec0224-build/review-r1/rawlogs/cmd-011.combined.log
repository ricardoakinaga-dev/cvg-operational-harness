 298: function optionalItem(item: ContextItem): boolean {
 299:   return ['TRUSTED_KNOWLEDGE', 'RELEVANT_HISTORY', 'OLDER_CONTEXT'].includes(
 300:     item.priority
 301:   )
 302: }
