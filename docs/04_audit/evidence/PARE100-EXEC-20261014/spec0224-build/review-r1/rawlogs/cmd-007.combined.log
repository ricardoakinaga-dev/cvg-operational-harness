 604: export function decodeCompleteCheckpointState(raw: unknown): AgentLoopState {
 605:   try {
 606:     if (typeof raw === 'string') {
 607:       if (Buffer.byteLength(raw) > COMPLETE_CHECKPOINT_STORAGE_MAX_BYTES)
 608:         fail('Physical checkpoint limit')
 609:       boundedJsonText(raw)
 610:       raw = JSON.parse(raw) as unknown
 611:     }
 612:     const wrapper = record({
 613:       storageCodec: one('cvg.checkpoint-state/2'),
 614:       encoding: one('base64'),
 615:       decodedBytes: integer,
 616:       decodedSha256: digest,
 617:       data: str
 618:     })(raw) as CompleteCheckpointStorageState
 619:     if (
 620:       wrapper.decodedBytes > COMPLETE_CHECKPOINT_MAX_BYTES ||
 621:       wrapper.data.length > COMPLETE_CHECKPOINT_DATA_MAX_CHARS
 622:     )
 623:       fail('Physical checkpoint limit')
 624:     if (
 625:       Buffer.byteLength(
 626:         canonicalizeCompleteJson(wrapper, {
 627:           ...LIMITS,
 628:           maxBytes: COMPLETE_CHECKPOINT_STORAGE_MAX_BYTES
 629:         })
 630:       ) > COMPLETE_CHECKPOINT_STORAGE_MAX_BYTES
 631:     )
 632:       fail()
 633:     if (
 634:       wrapper.data.length !== 4 * Math.ceil(wrapper.decodedBytes / 3) ||
 635:       !/^[A-Za-z0-9+/]*={0,2}$/.test(wrapper.data)
 636:     )
 637:       fail('Invalid base64')
