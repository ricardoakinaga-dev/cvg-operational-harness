 518: /** Reject excessive nesting/node counts before JSON.parse allocates a tree. */
 519: function boundedJsonText(raw: string): void {
 520:   let inString = false,
 521:     escaped = false,
 522:     nodes = 0,
 523:     inAtom = false,
 524:     stringStart = 0
 525:   const stack: (Set<string> | null)[] = []
 526:   const value = (): void => {
 527:     if (stack.length > LIMITS.maxDepth || ++nodes > LIMITS.maxNodes)
 528:       fail('JSON complexity limit')
 529:   }
 530:   for (let i = 0; i < raw.length; i++) {
 531:     const char = raw[i]!
 532:     if (inString) {
 533:       if (escaped) escaped = false
 534:       else if (char === '\\') escaped = true
 535:       else if (char === '"') {
 536:         inString = false
 537:         let next = i + 1
 538:         while (next < raw.length && /\s/.test(raw[next]!)) next++
 539:         if (raw[next] === ':') {
 540:           const keys = stack[stack.length - 1]
 541:           if (!keys) fail('Invalid JSON object key')
 542:           const key = JSON.parse(raw.slice(stringStart, i + 1)) as string
 543:           if (keys!.has(key)) fail('Duplicate JSON key')
 544:           keys!.add(key)
 545:           if (keys!.size > LIMITS.maxNodes) fail('JSON node limit')
 546:         } else value()
 547:       }
 548:       continue
 549:     }
 550:     if (char === '"') {
 551:       inString = true
 552:       stringStart = i
 553:       inAtom = false
 554:     } else if (char === '{' || char === '[') {
 555:       value()
 556:       stack.push(char === '{' ? new Set() : null)
 557:       inAtom = false
 558:     } else if (char === '}' || char === ']') {
 559:       stack.pop()
 560:       inAtom = false
 561:     } else if (char === ',' || char === ':' || /\s/.test(char)) inAtom = false
 562:     else if (!inAtom) {
 563:       value()
 564:       inAtom = true
 565:     }
 566:   }
 567: }
