 459: function normalizedState(value: unknown): AgentLoopState {
 460:   preflight(value)
 461:   const state = stateSchema(value) as AgentLoopState
 462:   validateState(state)
 463:   canonicalizeCompleteJson(state, LIMITS)
 464:   return state
 465: }
