 569: /** Bound work before schema normalization. This is a lower-bound measurement,
 570:  * not validation: only the schema may omit an undefined optional field. */
 571: function preflight(value: unknown): void {
 572:   let nodes = 0,
 573:     bytes = 0
 574:   const ancestors = new Set<object>()
 575:   const visit = (input: unknown, depth: number): void => {
 576:     if (input === undefined) return
 577:     if (++nodes > LIMITS.maxNodes || depth > LIMITS.maxDepth)
 578:       fail('Checkpoint complexity limit')
 579:     bytes += typeof input === 'string' ? input.length + 2 : 1
 580:     if (bytes > LIMITS.maxBytes) fail('Checkpoint byte limit')
 581:     if (!input || typeof input !== 'object') return
 582:     if (ancestors.has(input)) fail('Checkpoint cycle')
 583:     ancestors.add(input)
 584:     const array = Array.isArray(input)
 585:     if (array && input.length > LIMITS.maxNodes - nodes)
 586:       fail('Checkpoint node limit')
 587:     const keys = Reflect.ownKeys(input)
 588:     if (keys.length > LIMITS.maxNodes + 1) fail('Checkpoint node limit')
 589:     for (const key of keys) {
 590:       if (array && key === 'length') continue
 591:       if (typeof key !== 'string') fail('Checkpoint symbol')
 592:       const descriptor = Object.getOwnPropertyDescriptor(input, key)
 593:       if (!descriptor || !('value' in descriptor)) fail('Checkpoint accessor')
 594:       if (descriptor.value === undefined) continue
 595:       if (!array) bytes += (key as string).length + 3
 596:       if (bytes > LIMITS.maxBytes) fail('Checkpoint byte limit')
 597:       visit(descriptor.value, depth + 1)
 598:     }
 599:     ancestors.delete(input)
 600:   }
 601:   visit(value, 0)
 602: }
