 497: export function completeCheckpointDigest(unsigned: UnsignedCheckpoint): string {
 498:   return sha(
 499:     'cvg.checkpoint.v2\n' +
 500:       canonicalizeCompleteJson(normalizedUnsigned(unsigned), LIMITS)
 501:   )
 502: }
