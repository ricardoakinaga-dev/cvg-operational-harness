  68: /** Only declared optional internal fields may omit undefined. Arbitrary JSON is never repaired. */
  69: function record(
  70:   required: Record<string, Rule>,
  71:   optional: Record<string, Rule> = {}
  72: ): Rule {
  73:   return (value) => {
  74:     if (!value || typeof value !== 'object' || Array.isArray(value)) fail()
  75:     const prototype = Object.getPrototypeOf(value)
  76:     if (prototype !== Object.prototype && prototype !== null) fail()
  77:     const keys = Reflect.ownKeys(value)
  78:     if (
  79:       keys.length >
  80:       Object.keys(required).length + Object.keys(optional).length
  81:     )
  82:       fail('Unknown checkpoint field')
  83:     const normalized = Object.create(null) as Record<string, unknown>
  84:     for (const key of keys) {
  85:       if (
  86:         typeof key !== 'string' ||
  87:         (!Object.hasOwn(required, key) && !Object.hasOwn(optional, key))
  88:       )
  89:         fail('Unknown checkpoint field')
  90:       const descriptor = Object.getOwnPropertyDescriptor(value, key)
  91:       if (!descriptor || !('value' in descriptor))
  92:         fail('Checkpoint accessor is forbidden')
  93:       if (descriptor.value === undefined && Object.hasOwn(optional, key))
  94:         continue
  95:       normalized[key as string] = (required[key as string] ??
  96:         optional[key as string])!(descriptor.value)
  97:     }
  98:     for (const key of Object.keys(required))
  99:       if (!Object.hasOwn(normalized, key)) fail('Missing checkpoint field')
 100:     return normalized
 101:   }
 102: }
 103: function array(rule: Rule): Rule {
 104:   return (value) => {
 105:     if (
 106:       !Array.isArray(value) ||
 107:       Object.getPrototypeOf(value) !== Array.prototype
 108:     )
 109:       fail()
 110:     const length = Object.getOwnPropertyDescriptor(value, 'length')!
 111:       .value as number
 112:     if (
 113:       length > LIMITS.maxNodes ||
 114:       Reflect.ownKeys(value).length !== length + 1
 115:     )
 116:       fail('Invalid checkpoint array')
 117:     const normalized: unknown[] = []
 118:     for (let i = 0; i < length; i++) {
 119:       const descriptor = Object.getOwnPropertyDescriptor(value, String(i))
 120:       if (!descriptor || !('value' in descriptor))
 121:         fail('Invalid checkpoint array')
 122:       normalized.push(rule(descriptor.value))
 123:     }
 124:     return normalized
 125:   }
