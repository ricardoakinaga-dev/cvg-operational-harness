 660: /** CAS transition validation; cannot erase retained observations or settled receipts. */
 661: export function validateCompleteCheckpointTransition(
 662:   current: ExecutionCheckpoint | null,
 663:   next: ExecutionCheckpoint
 664: ): void {
 665:   if (!current) return
 666:   if (current.checkpointId === next.checkpointId)
 667:     fail('Checkpoint ID must change on every CAS')
 668:   const upgrade =
 669:     current.checkpointVersion === 1 &&
 670:     next.checkpointVersion === 2 &&
 671:     !current.state.observations.some((o) => o.type === 'TOOL_RESULT')
 672:   if (current.checkpointVersion !== next.checkpointVersion && !upgrade)
 673:     fail('Checkpoint mode cannot change through CAS')
 674:   if (next.checkpointVersion !== 2) return
 675:   if (
 676:     current.runtimeProfile !== next.runtimeProfile ||
 677:     current.runtimeVersion !== next.runtimeVersion ||
 678:     current.orchestratorVersion !== next.orchestratorVersion ||
 679:     current.state.capabilityFingerprint !== next.state.capabilityFingerprint ||
 680:     current.state.goal !== next.state.goal ||
 681:     next.stepNumber < current.stepNumber ||
 682:     next.state.toolResultContext!.deliveredThroughStep <
 683:       (current.state.toolResultContext?.deliveredThroughStep ?? 0)
 684:   )
 685:     fail('Checkpoint binding or cursor changed')
 686:   if (upgrade) return
 687:   const accepted = current.state.toolResultContext!.acceptedDecision
 688:   if (
 689:     accepted &&
 690:     next.stepNumber < accepted.stepNumber &&
 691:     canonicalizeCompleteJson(accepted, LIMITS) !==
 692:       canonicalizeCompleteJson(
 693:         next.state.toolResultContext!.acceptedDecision,
 694:         LIMITS
 695:       )
 696:   )
 697:     fail('Accepted decision cannot change before its step completes')
 698:   const nextObservations = new Map(
 699:     next.state.observations.map((o) => [o.observationId, o])
 700:   )
 701:   for (const old of current.state.observations) {
 702:     if (
 703:       old.type === 'TOOL_RESULT' &&
 704:       canonicalizeCompleteJson(
 705:         nextObservations.get(old.observationId),
 706:         LIMITS
 707:       ) !== canonicalizeCompleteJson(old, LIMITS)
 708:     )
 709:       fail('Tool observation retention violated')
 710:   }
 711:   const receipts = new Map(
 712:     next.state.toolResultContext!.decisionAdmissions.map((r) => [
 713:       r.admissionId,
 714:       r
 715:     ])
 716:   )
 717:   for (const old of current.state.toolResultContext!.decisionAdmissions) {
 718:     const updated = receipts.get(old.admissionId)
 719:     if (!updated) fail('Admission retention violated')
 720:     if (old.status === 'RESERVED') {
 721:       const {
 722:         status: _s,
 723:         actual: _a,
 724:         unknownReason: _u,
 725:         resultSha256: _h,
 726:         ...immutable
 727:       } = updated!
 728:       const { status: _old, ...previous } = old
 729:       void _s
 730:       void _a
 731:       void _u
 732:       void _h
 733:       void _old
 734:       if (
 735:         canonicalizeCompleteJson(immutable, LIMITS) !==
 736:         canonicalizeCompleteJson(previous, LIMITS)
 737:       )
 738:         fail('Admission binding changed')
 739:     } else if (
 740:       canonicalizeCompleteJson(old, LIMITS) !==
 741:       canonicalizeCompleteJson(updated, LIMITS)
 742:     )
 743:       fail('Settled admission changed')
 744:   }
