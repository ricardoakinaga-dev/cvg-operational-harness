 307: function validateState(
 308:   state: AgentLoopState,
 309:   binding?: { tenantId: string; executionId: string }
 310: ): void {
 311:   const ctx = state.toolResultContext!
 312:   if (
 313:     !state.resolvedInputs ||
 314:     Array.isArray(state.resolvedInputs) ||
 315:     typeof state.resolvedInputs !== 'object'
 316:   )
 317:     fail()
 318:   if (
 319:     state.pendingStepNumber !== undefined &&
 320:     state.pendingStepNumber !== state.stepNumber + 1 &&
 321:     state.pendingStepNumber !== state.stepNumber
 322:   )
 323:     fail('Invalid pending step')
 324:   const observations = new Set<string>(),
 325:     toolSteps = new Set<number>()
 326:   const executionId =
 327:     binding?.executionId ??
 328:     state.observations[0]?.executionId ??
 329:     ctx.decisionAdmissions[0]?.executionId
 330:   const tenantId = binding?.tenantId ?? ctx.decisionAdmissions[0]?.tenantId
 331:   for (const item of state.observations) {
 332:     if (
 333:       observations.has(item.observationId) ||
 334:       item.stepNumber >
 335:         Math.max(state.stepNumber, state.pendingStepNumber ?? 0) ||
 336:       item.executionId !== executionId
 337:     )
 338:       fail('Observation binding mismatch')
 339:     observations.add(item.observationId)
 340:     if (item.type !== 'TOOL_RESULT') continue
 341:     if (
 342:       item.source !== 'TOOL' ||
 343:       item.trust !== 'UNTRUSTED' ||
 344:       item.stepNumber < 1
 345:     )
 346:       fail('Invalid tool observation')
 347:     toolSteps.add(item.stepNumber)
 348:     const payload = item.payload as Record<string, unknown>
 349:     if (payload?.completion === 'COMPLETE') {
 350:       succeeded(payload)
 351:       const raw = canonicalizeCompleteJson(payload.output)
 352:       if (
 353:         payload.outputBytes !== Buffer.byteLength(raw) ||
 354:         payload.outputSha256 !== sha(raw)
 355:       )
 356:         fail('Complete output integrity mismatch')
 357:     } else if (payload?.completion === 'UNAVAILABLE') unavailable(payload)
 358:     else failed(payload)
 359:   }
 360:   if (
 361:     ctx.deliveredThroughStep > state.stepNumber ||
 362:     (ctx.deliveredThroughStep !== 0 && !toolSteps.has(ctx.deliveredThroughStep))
 363:   )
 364:     fail('Invalid delivery cursor')
 365:   const admissions = new Map<string, (typeof ctx.decisionAdmissions)[number]>(),
 366:     attempts = new Set<string>()
 367:   let pending: string | null = null
 368:   for (const entry of ctx.decisionAdmissions) {
 369:     if (
 370:       admissions.has(entry.admissionId) ||
 371:       entry.stepNumber > state.stepNumber + 1 ||
 372:       entry.tenantId !== tenantId ||
 373:       entry.executionId !== executionId
 374:     )
 375:       fail('Admission binding mismatch')
 376:     const attempt = `${entry.stepNumber}:${entry.attempt}`
 377:     if (attempts.has(attempt)) fail('Duplicate admission attempt')
 378:     attempts.add(attempt)
 379:     admissions.set(entry.admissionId, entry)
 380:     const m = entry.measurement,
 381:       r = entry.reserved
 382:     if (
 383:       r.modelCalls !== 1 ||
 384:       r.inputTokens !== m.inputUpperBoundTokens ||
 385:       r.outputTokens !== 512 ||
 386:       r.costUsd !== m.costUpperBoundUsd ||
 387:       m.inputUpperBoundTokens + 512 > m.contextWindowTokens
 388:     )
 389:       fail('Invalid admission reservation')
 390:     if (entry.status === 'RESERVED') {
 391:       if (
 392:         pending !== null ||
 393:         entry.actual !== undefined ||
 394:         entry.unknownReason !== undefined ||
 395:         entry.resultSha256 !== undefined
 396:       )
 397:         fail('Invalid pending admission')
 398:       pending = entry.admissionId
 399:     } else if (entry.status === 'SETTLED') {
 400:       if (
 401:         !entry.actual ||
 402:         !entry.resultSha256 ||
 403:         entry.unknownReason !== undefined ||
 404:         entry.actual.modelCalls !== 1 ||
 405:         entry.actual.inputTokens > r.inputTokens ||
 406:         entry.actual.outputTokens > r.outputTokens ||
 407:         entry.actual.costUsd > r.costUsd
 408:       )
 409:         fail('Invalid settled admission')
 410:     } else if (
 411:       !entry.unknownReason ||
 412:       (entry.actual !== undefined &&
 413:         entry.unknownReason !== 'ADMISSION_BREACH') ||
 414:       entry.resultSha256 !== undefined
 415:     )
 416:       fail('Invalid unknown admission')
 417:   }
 418:   if (pending !== ctx.pendingDecisionAdmission)
 419:     fail('Pending admission does not match ledger')
 420:   const accepted = ctx.acceptedDecision
 421:   if (accepted) {
 422:     if (
 423:       accepted.stepNumber !== state.stepNumber + 1 &&
 424:       accepted.stepNumber !== state.stepNumber
 425:     )
 426:       fail('Accepted decision step mismatch')
 427:     if (!validateLoopDecision(accepted.decision).valid || pending !== null)
 428:       fail('Invalid accepted decision')
 429:     const ids = new Set(accepted.decisionAdmissionIds)
 430:     if (ids.size !== accepted.decisionAdmissionIds.length)
 431:       fail('Duplicate accepted receipt')
 432:     for (const admissionId of ids) {
 433:       const entry = admissions.get(admissionId)
 434:       if (
 435:         !entry ||
 436:         entry.status !== 'SETTLED' ||
 437:         entry.stepNumber !== accepted.stepNumber
 438:       )
 439:         fail('Accepted receipt binding mismatch')
 440:     }
 441:     const nativeIds = ctx.decisionAdmissions
 442:       .filter((r) => r.stepNumber === accepted.stepNumber)
 443:       .map((r) => r.admissionId)
 444:     if (
 445:       nativeIds.length !== ids.size ||
 446:       nativeIds.some((admissionId) => !ids.has(admissionId))
 447:     )
 448:       fail('Accepted decision omits native receipt')
 449:     if (
 450:       state.pendingDecision &&
 451:       (state.pendingStepNumber !== accepted.stepNumber ||
 452:         canonicalizeCompleteJson(state.pendingDecision, LIMITS) !==
 453:           canonicalizeCompleteJson(accepted.decision, LIMITS))
 454:     )
 455:       fail('Pending and accepted decisions disagree')
 456:   }
 457: }
