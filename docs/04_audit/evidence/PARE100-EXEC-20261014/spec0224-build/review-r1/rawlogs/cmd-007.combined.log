 504: export function encodeCompleteCheckpointState(
 505:   state: AgentLoopState
 506: ): CompleteCheckpointStorageState {
 507:   const raw = canonicalizeCompleteJson(normalizedState(state), LIMITS)
 508:   const bytes = Buffer.from(raw, 'utf8')
 509:   return {
 510:     storageCodec: 'cvg.checkpoint-state/2',
 511:     encoding: 'base64',
 512:     decodedBytes: bytes.length,
 513:     decodedSha256: sha(bytes),
 514:     data: bytes.toString('base64')
 515:   }
 516: }
