 467: function normalizedUnsigned(value: unknown): UnsignedCheckpoint {
 468:   preflight(value)
 469:   const unsigned = unsignedSchema(value) as UnsignedCheckpoint
 470:   validateState(unsigned.state, unsigned)
 471:   canonicalizeCompleteJson(unsigned, LIMITS)
 472:   if (
 473:     unsigned.state.stepNumber !== unsigned.stepNumber ||
 474:     unsigned.budgetUsage.steps < unsigned.stepNumber
 475:   )
 476:     fail('Checkpoint step mismatch')
 477:   const sum = { modelCalls: 0, inputTokens: 0, outputTokens: 0, costUsd: 0 }
 478:   let repairs = 0
 479:   for (const r of unsigned.state.toolResultContext!.decisionAdmissions) {
 480:     for (const key of Object.keys(sum) as (keyof typeof sum)[]) {
 481:       sum[key] +=
 482:         r.status === 'SETTLED'
 483:           ? r.actual![key]
 484:           : Math.max(r.reserved[key], r.actual?.[key] ?? 0)
 485:     }
 486:     if (r.purpose === 'REPAIR') repairs++
 487:   }
 488:   for (const key of Object.keys(sum) as (keyof typeof sum)[]) {
 489:     if (unsigned.budgetUsage[key] + (key === 'costUsd' ? 1e-12 : 0) < sum[key])
 490:       fail('Budget does not cover admission ledger')
 491:   }
 492:   if (unsigned.budgetUsage.decisionRepairs < repairs)
 493:     fail('Repair budget does not cover ledger')
 494:   return unsigned
 495: }
