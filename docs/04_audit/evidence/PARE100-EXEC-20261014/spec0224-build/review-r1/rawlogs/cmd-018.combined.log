1430:   private async dispatch(
1431:     run: LoopRun,
1432:     decision: LoopDecision,
1433:     stepNumber: number
1434:   ): Promise<DispatchOutcome> {
1435:     switch (decision.decisionType) {
1436:       case 'CALL_TOOL':
1437:         return this.dispatchTool(run, decision, stepNumber, false)
1438:       case 'REQUEST_APPROVAL':
1439:         return this.dispatchTool(run, decision, stepNumber, true)
1440:       case 'SEARCH_KNOWLEDGE':
1441:         return this.dispatchKnowledge(run, decision, stepNumber)
1442:       case 'VERIFY':
1443:         return this.dispatchVerify(run, decision, stepNumber)
1444:       case 'REPLAN':
1445:         return this.dispatchReplan(run, decision, stepNumber)
1446:       case 'RESPOND':
1447:         return this.dispatchRespond(run, decision, stepNumber)
1448:       case 'ASK_USER':
1449:         return {
1450:           kind: 'pause',
1451:           pausedKind: 'NEEDS_USER_INPUT',
1452:           decision
1453:         }
1454:       case 'HANDOFF':
1455:         await this.recordStep(run, {
1456:           stepNumber,
1457:           stepType: 'HANDOFF',
1458:           status: 'SUCCEEDED',
1459:           sideEffecting: false,
1460:           reasonCode: decision.reasonCode
1461:         })
1462:         return this.stop(
1463:           'HUMAN_TAKEOVER',
1464:           'Execution handed off to a human operator.'
1465:         )
1466:       case 'STOP':
1467:         await this.recordStep(run, {
1468:           stepNumber,
1469:           stepType: 'STOP',
1470:           status: 'SUCCEEDED',
1471:           sideEffecting: false,
1472:           reasonCode: decision.reasonCode
1473:         })
1474:         return { kind: 'continue' }
1475:     }
1476:   }
