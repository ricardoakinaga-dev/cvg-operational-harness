1351:   /**
1352:    * A non-idempotent tool must never be invoked twice for the same decision;
1353:    * the safe threshold is one repeat (stop before the second effect).
1354:    */
1355:   private effectiveRepeatThreshold(
1356:     run: LoopRun,
1357:     decision: LoopDecision
1358:   ): number {
1359:     if (
1360:       decision.decisionType === 'CALL_TOOL' ||
1361:       decision.decisionType === 'REQUEST_APPROVAL'
1362:     ) {
1363:       const tool = this.options.tools.resolve(
1364:         decision.toolId as string,
1365:         decision.toolVersion
1366:       )
1367:       if (tool && tool.idempotent === false && tool.sideEffect !== 'NONE') {
1368:         return 1
1369:       }
1370:     }
1371:     return this.repeatThreshold
1372:   }
