2006:   /**
2007:    * A terminal stop never leaves its pending tool step open (AUD-0600 F02).
2008:    * A WAITING step never reached its effect (approval wait, or parked by an
2009:    * operator pause), so it closes with the stop's own code. A step still
2010:    * RUNNING here may have started its effect before a crash or a failure
2011:    * after dispatch, so it is closed as `unknown_effect` for reconciliation
2012:    * instead of being declared not executed.
2013:    */
2014:   private async closePendingStep(
2015:     run: LoopRun,
2016:     stopReason: StopReason
2017:   ): Promise<void> {
2018:     const stepNumber = run.state.pendingStepNumber
2019:     if (!stepNumber) return
2020:     const steps = await this.options.stepStore.listSteps(
2021:       run.input.tenantId,
2022:       run.executionId
2023:     )
2024:     const step = steps.find(
2025:       (candidate) =>
2026:         candidate.stepNumber === stepNumber && candidate.stepType === 'TOOL'
2027:     )
2028:     if (!step || (step.status !== 'WAITING' && step.status !== 'RUNNING')) {
2029:       return
2030:     }
2031:     await this.recordStep(run, {
2032:       stepNumber,
2033:       stepType: 'TOOL',
2034:       status: 'FAILED',
2035:       sideEffecting: step.sideEffecting,
2036:       ...(step.reasonCode ? { reasonCode: step.reasonCode } : {}),
2037:       errorCode:
2038:         step.status === 'RUNNING'
2039:           ? 'unknown_effect'
2040:           : stopReason === 'CANCELLED'
2041:             ? 'cancelled'
2042:             : stopReason === 'MAX_DURATION'
2043:               ? 'deadline'
2044:               : 'not_started'
2045:     })
2046:   }
