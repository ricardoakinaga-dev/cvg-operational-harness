 320: export async function dispatchTool(
 321:   ctx: IterativeDispatchContext,
 322:   run: LoopRun,
 323:   decision: LoopDecision,
 324:   stepNumber: number,
 325:   forceApproval: boolean
 326: ): Promise<DispatchOutcome> {
 327:   // A previous successful dispatch is trajectory evidence, not the result
 328:   // of this attempt. Only this dispatch's success may populate toolResult.
 329:   run.lastToolObservation = null
 330:   // A resumed in-flight step was already counted when it reached dispatch.
 331:   const alreadyCounted =
 332:     run.inFlightCounted && run.state.pendingStepNumber === stepNumber
 333:   if (
 334:     !alreadyCounted &&
 335:     run.usage.toolCalls + 1 > run.input.budget.maxToolCalls
 336:   ) {
 337:     return ctx.stop(
 338:       'MAX_TOOL_CALLS',
 339:       'Tool-call budget exhausted before the tool could run.'
 340:     )
 341:   }
 342:   const tool = ctx.options.tools.resolve(
 343:     decision.toolId as string,
 344:     decision.toolVersion
 345:   )
 346:   if (!tool) {
 347:     return ctx.stop(
 348:       'STATE_CONFLICT',
 349:       `Tool "${decision.toolId}" is unavailable.`
 350:     )
 351:   }
 352:   const operationKey = ctx.operationKey(run, stepNumber, tool.id)
 353:   ctx.preflightCompleteTool(run, decision, stepNumber)
 354:   const invocation = {
 355:     toolId: tool.id,
 356:     ...(tool.version ? { toolVersion: tool.version } : {}),
 357:     input: decision.toolInput ?? {},
 358:     operationKey
 359:   }
 360:   if (ctx.remainingDuration(run) <= 0) {
 361:     return ctx.stop(
 362:       'MAX_DURATION',
 363:       'Duration budget exhausted before tool execution.'
 364:     )
 365:   }
 366: 
 367:   const stepId = `step_${run.executionId}_${stepNumber}_tool`
 368:   // A resumed step already holds this step number as a tool step (waiting for
 369:   // approval or in flight), and the dispatch checkpoint opens it as RUNNING;
 370:   // a control that then blocks the call closes that same step instead of
 371:   // recording a second one under the same number, or leaving it open while
 372:   // the checkpoint ends (AUD-0599 F02).
 373:   let stepOpen = run.state.pendingStepNumber === stepNumber
 374:   // Opened as RUNNING by this invocation's dispatch checkpoint.
 375:   let openedHere = false
 376:   // An operator pause proves that nothing ran and nothing stays reserved: the
 377:   // step waits for the resume instead of looking in flight, so a later
 378:   // terminal stop can close it as not executed (AUD-0600 F02).
 379:   const parkForResume = async (): Promise<void> => {
 380:     if (!openedHere) return
 381:     await ctx.recordStep(run, {
 382:       stepNumber,
 383:       stepType: 'TOOL',
 384:       status: 'WAITING',
 385:       sideEffecting: true,
 386:       reasonCode: decision.reasonCode
 387:     })
 388:   }
 389:   const recordDenial = (record: StepRecord): Promise<void> =>
 390:     ctx.recordStep(
 391:       run,
 392:       stepOpen
 393:         ? {
 394:             stepNumber,
 395:             stepType: 'TOOL',
 396:             status: 'FAILED',
 397:             sideEffecting: true,
 398:             reasonCode: decision.reasonCode,
 399:             errorCode: record.errorCode
 400:           }
 401:         : record
 402:     )
 403:   const call: ToolCallState = {
 404:     turn: ctx.turn(run),
 405:     tool,
 406:     invocation,
 407:     needsApproval: forceApproval,
 408:     executionRef: run.executionId
 409:   }
 410:   let policyRecorded = false
 411:   const recordPolicy = async (): Promise<void> => {
 412:     if (policyRecorded || !call.policyDecision) return
 413:     policyRecorded = true
 414:     await ctx.recordObservation(
 415:       run,
 416:       ctx.makeObservation(run, {
 417:         stepId,
 418:         stepNumber,
 419:         type: 'POLICY_DECISION',
 420:         source: 'POLICY',
 421:         trust: 'TRUSTED',
 422:         payload: {
 423:           outcome: call.policyDecision.outcome,
 424:           policyVersion: call.policyDecision.policyVersion
 425:         },
 426:         summary: `Policy outcome ${call.policyDecision.outcome}.`,
 427:         provenance: { sourceId: 'policy-engine' }
 428:       })
 429:     )
 430:   }
 431: 
 432:   // Policy, approval, guards (pause) and cancellation run in the kernel
 433:   // pipeline (SPEC 0181); this loop only adds its checkpoint and its steps.
 434:   const pipeline = await runToolCall(ctx.kernel(run), call, {
 435:     beforeDispatch: async () => {
 436:       await recordPolicy()
 437:       const approvalId = call.grant?.approvalId
 438:       if (
 439:         approvalId &&
 440:         run.state.pendingApprovalId &&
 441:         run.state.pendingApprovalId !== approvalId
 442:       ) {
 443:         return {
 444:           kind: 'stop',
 445:           stopReason: 'STATE_CONFLICT',
 446:           response: 'Approval identity changed while resuming the execution.'
 447:         }
 448:       }
 449:       // Budget accounting is committed with the in-flight decision so a crash
 450:       // cannot replay the same step against an unconsumed counter; the
 451:       // approval is only reserved after this checkpoint.
 452:       if (!alreadyCounted) run.usage.toolCalls += 1
 453:       run.inFlightCounted = false
 454:       // The step is in flight from here: a stop reason left by an earlier
 455:       // approval wait would hide that this call is already counted when the
 456:       // execution resumes (AUD-0598 R02).
 457:       run.state = {
 458:         ...run.state,
 459:         pendingDecision: decision,
 460:         pendingStepNumber: stepNumber,
 461:         ...(approvalId ? { pendingApprovalId: approvalId } : {}),
 462:         stopReason: undefined
 463:       }
 464:       await ctx.persistCheckpoint(run)
 465:       await ctx.recordStep(run, {
 466:         stepNumber,
 467:         stepType: 'TOOL',
 468:         status: 'RUNNING',
 469:         sideEffecting: true,
 470:         reasonCode: decision.reasonCode
 471:       })

