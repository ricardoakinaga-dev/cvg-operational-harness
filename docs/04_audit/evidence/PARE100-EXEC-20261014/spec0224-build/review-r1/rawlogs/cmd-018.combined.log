2048:   private async finalize(
2049:     run: LoopRun,
2050:     outcome: Extract<DispatchOutcome, { kind: 'stop' }>,
2051:     startedAtMs: number
2052:   ): Promise<RuntimeResult> {
2053:     let stopReason: StopReason = outcome.stopReason
2054:     run.usage.activeDurationMs += Date.now() - startedAtMs
2055:     if (!outcome.preserveCheckpoint && TERMINAL_STOPS.has(stopReason)) {
2056:       try {
2057:         await this.closePendingStep(run, stopReason)
2058:       } catch {
2059:         // The open step could not be closed: the terminal checkpoint must not
2060:         // claim a clean stop while the step store disagrees.
2061:         stopReason = 'INSUFFICIENT_EVIDENCE'
2062:       }
2063:     }
2064:     run.state = { ...run.state, stopReason }
2065:     let checkpointProven = true
2066:     if (outcome.preserveCheckpoint) {
2067:       // Intentional no-write: the durable pause must stay resumable after a
2068:       // rejected resume binding.
2069:     } else {
2070:       try {
2071:         await this.persistCheckpoint(run)
2072:       } catch {
2073:         checkpointProven = false
2074:       }
2075:     }
2076:     const claimedReason: StopReason = checkpointProven
2077:       ? stopReason
2078:       : 'INSUFFICIENT_EVIDENCE'
2079:     if (!checkpointProven) {
2080:       run.state = { ...run.state, stopReason: claimedReason }
2081:     }
2082:     const result: RuntimeResult = {
2083:       response: outcome.response,
2084:       stopReason: claimedReason,
2085:       ...(outcome.kind === 'stop' && outcome.approvalId
2086:         ? { approvalId: outcome.approvalId }
2087:         : {}),
2088:       steps: run.usage.steps,
2089:       modelCalls: run.usage.modelCalls,
