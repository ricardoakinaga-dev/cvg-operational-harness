1399:   private remaining(
1400:     run: LoopRun,
1401:     kind: 'knowledge' | 'verification' | 'replan'
1402:   ): number {
1403:     const budget = run.input.budget
1404:     if (kind === 'knowledge') {
1405:       return Math.max(
1406:         0,
1407:         (budget.maxKnowledgeCalls ?? budget.maxSteps) - run.usage.knowledgeCalls
1408:       )
1409:     }
1410:     if (kind === 'verification') {
1411:       return Math.max(
1412:         0,
1413:         (budget.maxVerificationCalls ?? budget.maxSteps) -
1414:           run.usage.verificationCalls
1415:       )
1416:     }
1417:     return Math.max(
1418:       0,
1419:       (budget.maxReplans ?? budget.maxSteps) - run.usage.replans
1420:     )
1421:   }
