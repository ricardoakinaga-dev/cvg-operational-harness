1381:   private allowedDecisionTypes(run: LoopRun): LoopDecision['decisionType'][] {
1382:     const allowed: LoopDecision['decisionType'][] = ['RESPOND', 'ASK_USER']
1383:     if (this.availableTools(run).length > 0) {
1384:       allowed.push('CALL_TOOL', 'REQUEST_APPROVAL')
1385:     }
1386:     if (this.options.knowledge && this.remaining(run, 'knowledge') > 0) {
1387:       allowed.push('SEARCH_KNOWLEDGE')
1388:     }
1389:     if (this.remaining(run, 'verification') > 0) {
1390:       allowed.push('VERIFY')
1391:     }
1392:     if (this.remaining(run, 'replan') > 0) {
1393:       allowed.push('REPLAN')
1394:     }
1395:     allowed.push('HANDOFF', 'STOP')
1396:     return allowed
1397:   }
