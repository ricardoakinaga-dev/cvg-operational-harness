354:       decisionModelSupportsMaxOutputTokens: true
355:     }),
356:     modelGateway: model,
357:     policy: new ScriptedPolicyEngine(),
358:     approvals: new InMemoryApprovalEngine(),
359:     audit,
360:     telemetry
361:   })
362:   const base = phase3RuntimeInput({ tenantId, executionId: input.executionId })
363:   const runtimeInput = {
364:     ...base,
365:     capabilityFingerprint: capabilities.compositionFingerprint(),
366:     agent: phase3AgentProfile({ tools: [toolId] }),
367:     userMessage: 'Echo the full synthetic tool output.',
368:     budget: { ...base.budget, maxTokens: 10_000 }
369:   }
370:   await save(join(dir, `${childRole}.runtime-input.json`), runtimeInput)
