258:         idempotent: true,
259:         requiresApproval: false,
260:         origin: 'core',
261:         providerId: 'synthetic.public.restart',
262:         providerVersion: '1'
263:       },
264:       implementation: {
265:         validateInput: () => true,
266:         validateOutput: () => true,
267:         execute: async (toolInput) => {
268:           const output = (toolInput as { text: string }).text
269:           await appendFile(
270:             join(dir, 'body-markers.jsonl'),
271:             JSON.stringify({
272:               pid: process.pid,
273:               role: childRole,
274:               input: toolInput,
275:               output
276:             }) + '\n'
277:           )
278:           process.stdout.write('PUBLIC224_BODY\n')
279:           return { status: 'SUCCEEDED', output }
280:         }
281:       }
282:     }
283:   ])
284:   const model: ModelGateway = {
285:     complete: async ({ signal: _signal, ...request }: ModelRequest) => {
286:       void _signal
287:       requests.push(structuredClone(request))
288:       await trace()
289:       await appendFile(
290:         join(dir, 'model-markers.jsonl'),
291:         JSON.stringify({ pid: process.pid, role: childRole, request }) + '\n'
292:       )
293:       expect(request.maxOutputTokens).toBe(512)
294:       if (childRole.startsWith('race')) await gate(join(dir, 'race-model.gate'))
295:       const frame = JSON.parse(request.messages[1]!.content)
296:       const observed = frame.items.find(
297:         (i: { value?: { type?: string } }) => i.value?.type === 'TOOL_RESULT'
298:       )
299:       // The resumed answer comes solely from the actual user JSON TOOL_RESULT payload.
300:       const decision = childRole.startsWith('race')
301:         ? {
302:             decisionType: 'RESPOND',
303:             reasonCode: 'GOAL_SATISFIED',
304:             responseText: 'one synthetic race decision'
305:           }
306:         : observed
307:           ? {
308:               decisionType: 'RESPOND',
309:               reasonCode: 'GOAL_SATISFIED',
310:               responseText: observed.value.payload.output
311:             }
312:           : {
313:               decisionType: 'CALL_TOOL',
314:               reasonCode: 'TOOL_REQUIRED',
315:               toolId,
316:               toolVersion: '1',
317:               toolInput: { text: fixture(input.name) }
318:             }
319:       const text = JSON.stringify(decision)
320:       expect(tokens(text)).toBeLessThanOrEqual(request.maxOutputTokens!)
321:       const result = {
322:         text,
323:         provider: 'synthetic.public.restart',
324:         model: 'toy64-v1',
325:         inputTokens: tokens(request),
326:         outputTokens: tokens(text),
327:         costUsd: 0
328:       }
329:       results.push(result)
330:       await trace()
