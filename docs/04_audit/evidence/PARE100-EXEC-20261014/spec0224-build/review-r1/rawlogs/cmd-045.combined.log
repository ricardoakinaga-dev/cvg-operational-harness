382:     throw e
383:   } finally {
384:     await pool.end()
385:   }
386: }
387: async function child(childRole: string, dir: string, inputPath: string) {
388:   const config = process.env.SPEC0224_PUBLIC_CHILD_CONFIG
389:   if (!config) throw new Error('Private child config required')
390:   const argv = [
391:     resolve('node_modules/vitest/vitest.mjs'),
392:     'run',
393:     '--config',
394:     config,
395:     target
396:   ]
397:   const envOverrides = {
398:     SPEC0224_PUBLIC_CHILD_ROLE: childRole,
399:     SPEC0224_PUBLIC_CHILD_DIR: dir,
400:     SPEC0224_PUBLIC_CHILD_INPUT: inputPath
401:   }
402:   const proc = spawn(process.execPath, argv, {
403:     cwd: process.cwd(),
404:     env: { ...process.env, ...envOverrides },
405:     stdio: ['ignore', 'pipe', 'pipe']
406:   })
407:   let stdout = '',
408:     stderr = ''
409:   let readyResolve: (s: string) => void
410:   const ready = new Promise<string>((y) => {
411:     readyResolve = y
412:   })
413:   const timer = setTimeout(() => {
414:     readyResolve('timeout')
415:     proc.kill('SIGKILL')
416:   }, 45000)
417:   proc.stdout.on('data', (b: Buffer) => {
418:     stdout += b.toString()
419:     if (stdout.includes('PUBLIC224_READY')) readyResolve('ready')
420:     else if (stdout.includes('PUBLIC224_FINISHED')) readyResolve('finished')
421:   })
422:   proc.stderr.on('data', (b: Buffer) => {
423:     stderr += b.toString()
424:   })
425:   const done = new Promise<{
426:     code: number | null
427:     signal: NodeJS.Signals | null
428:   }>((yes, no) => {
429:     proc.on('error', no)
430:     proc.on('close', async (code, signal) => {
431:       clearTimeout(timer)
432:       readyResolve('exited')
433:       try {
434:         const emptyStreamsOmitted = []
435:         for (const [name, data] of [
436:           ['stdout', stdout],
437:           ['stderr', stderr]
438:         ]) {
439:           if (data)
440:             await writeFile(join(dir, `${childRole}.${name}.log`), data!)
441:           else emptyStreamsOmitted.push(name)
442:         }
443:         await save(join(dir, `${childRole}.command.json`), {
444:           executable: process.execPath,
445:           argv,
446:           envOverrides,
447:           pid: proc.pid,
448:           code,
449:           signal,
450:           emptyStreamsOmitted
451:         })
452:         yes({ code, signal })
453:       } catch (e) {
454:         no(e)
455:       }
456:     })
457:   })
458:   return { proc, ready, done }
459: }
