346:   const harness = createOperationalHarness({
347:     toolResultContext: { version: 1 },
348:     capabilities,
349:     effectJournal: journal,
350:     stepStore: store,
351:     iterativeOrchestrator: new HybridOrchestrator({
352:       decisionModel: model,
