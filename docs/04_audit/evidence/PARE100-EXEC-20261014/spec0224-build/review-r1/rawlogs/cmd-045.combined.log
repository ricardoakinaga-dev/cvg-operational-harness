171:   const requests: unknown[] = [],
172:     results: unknown[] = [],
173:     casTrace: unknown[] = [],
174:     journalTrace: unknown[] = []
175:   const trace = async () =>
176:     save(join(dir, `${childRole}.trace.json`), {
177:       pid: process.pid,
178:       requests,
179:       results,
180:       casTrace,
181:       journalTrace,
182:       audit: audit.events
183:     })
184:   // Observational wrappers call the native methods unchanged and rethrow native failures.
185:   for (const method of [
186:     'reserve',
187:     'markStarted',
188:     'confirm',
189:     'fail',
190:     'markUncertain',
191:     'get'
192:   ] as const) {
193:     const original = journal[method].bind(journal)
194:     Object.defineProperty(journal, method, {
195:       value: async (...args: unknown[]) => {
196:         try {
197:           const result = await (
198:             original as (...a: unknown[]) => Promise<unknown>
199:           )(...args)
200:           journalTrace.push({ method, args, result })
201:           await trace()
202:           return result
203:         } catch (e) {
204:           journalTrace.push({ method, args, error: errorInfo(e) })
205:           await trace()
206:           throw e
207:         }
208:       }
209:     })
210:   }
211:   const cas = store.compareAndSwapCheckpoint.bind(store)
212:   store.compareAndSwapCheckpoint = async (value) => {
213:     if (childRole.startsWith('race') && value.expected === null) {
214:       await save(join(dir, `${childRole}.initial-ready.json`), {
215:         pid: process.pid,
216:         expected: null
217:       })
218:       process.stdout.write('PUBLIC224_READY INITIAL_CAS\n')
219:       await gate(join(dir, 'race-start.gate'))
220:     }
221:     const result = await cas(value)
222:     casTrace.push({ input: value, result })
223:     await trace()
224:     if (childRole.startsWith('race') && value.expected === null)
225:       await save(join(dir, `${childRole}.initial-cas.json`), {
226:         pid: process.pid,
227:         result
228:       })
229:     const full = value.next.state.observations.find(
230:       (o) =>
231:         o.type === 'TOOL_RESULT' &&
232:         (o.payload as { completion?: string }).completion === 'COMPLETE'
233:     )
234:     if (childRole === 'writer' && result.status === 'APPLIED' && full) {
235:       await save(join(dir, 'committed.json'), {
236:         pid: process.pid,
237:         checkpoint: await store.loadCheckpoint(tenantId, input.executionId),
238:         cas: value,
239:         result
240:       })
241:       process.stdout.write('PUBLIC224_READY COMMITTED_FULL_TOOL_RESULT\n')
242:       await new Promise(() => {
243:         setInterval(() => {}, 1000)
244:       })
245:     }
246:     return result
247:   }
248:   const capabilities = createCapabilityRegistry([
249:     {
250:       descriptor: {
251:         id: toolId,
252:         version: '1',
253:         description: 'Pure synthetic echo',
