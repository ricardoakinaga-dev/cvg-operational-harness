622:         await seed(executionId)
623:         const children: Awaited<ReturnType<typeof child>>[] = []
624:         try {
625:           children.push(
626:             await child('race-a', dir, inputPath),
627:             await child('race-b', dir, inputPath)
628:           )
629:           expect(await Promise.all(children.map((c) => c.ready))).toEqual([
630:             'ready',
