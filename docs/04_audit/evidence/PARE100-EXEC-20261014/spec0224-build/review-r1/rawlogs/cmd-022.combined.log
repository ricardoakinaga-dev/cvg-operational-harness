  97: export async function setPublishedWriteContext(
  98:   client: PostgresQueryable,
  99:   fence: Pick<
 100:     ControlledPublishedDatabaseFence,
 101:     'executionId' | 'workerId' | 'attempt'
 102:   >,
 103:   mode: 'active' | 'settlement' | 'claim' | 'close' | 'cancel' | 'cancel_close'
 104: ): Promise<void> {
 105:   await client.query(
 106:     `SELECT set_config('cvg.published_execution',$1,true),
 107:     set_config('cvg.published_worker',$2,true),set_config('cvg.published_attempt',$3,true),
 108:     set_config('cvg.published_mode',$4,true)`,
 109:     [fence.executionId, fence.workerId, String(fence.attempt), mode]
 110:   )
 111: }
