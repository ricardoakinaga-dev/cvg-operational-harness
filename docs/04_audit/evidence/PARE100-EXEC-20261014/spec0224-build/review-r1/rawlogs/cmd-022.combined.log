 113: export async function boundExecutionIdForOperation(
 114:   client: PostgresQueryable,
 115:   tenantId: string,
 116:   operationKey: string
 117: ): Promise<string | null> {
 118:   const result = await client.query<{ execution_id: string }>(
 119:     `SELECT id AS execution_id FROM operational_executions
 120:      WHERE tenant_id=$1 AND request#>>'{runtime,context,values,adapterVersion}'='controlled-published-v1'
 121:        AND left($2,length(id)+2)=id||':s' LIMIT 1`,
 122:     [tenantId, operationKey]
 123:   )
 124:   return result.rows[0]?.execution_id ?? null
 125: }
