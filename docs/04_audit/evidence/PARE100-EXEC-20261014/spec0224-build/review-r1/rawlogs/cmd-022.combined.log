  75: export function publishedFenceError(code = 'lease_lost'): never {
  76:   throw new OperationalExecutionError(
  77:     code === 'conflict' ? 'conflict' : 'lease_lost',
  78:     'Controlled published execution guard rejected the operation'
  79:   )
  80: }
