 284:   public compareAndSwapCheckpoint(
 285:     input: CheckpointCompareAndSwapInput
 286:   ): Promise<CheckpointCompareAndSwapResult> {
 287:     const tenant = TenantIdSchema.parse(input.tenantId)
 288:     validateCheckpointIntegrity(input.next, input)
 289:     if (
 290:       input.expected &&
 291:       input.expected.checkpointId === input.next.checkpointId
 292:     ) {
 293:       throw new CheckpointError(
 294:         'checkpoint_integrity',
 295:         'CAS requires a fresh checkpoint ID'
 296:       )
 297:     }
 298:     // Snapshot before the first await; callers cannot alter a validated write in flight.
 299:     const next = structuredClone(input.next)
 300:     const expected = input.expected ? { ...input.expected } : null
 301:     const state =
 302:       next.checkpointVersion === 2
 303:         ? encodeCompleteCheckpointState(next.state)
 304:         : next.state
 305:     const values = [
 306:       tenant,
 307:       next.executionId,
 308:       next.checkpointId,
 309:       next.checkpointVersion,
 310:       next.runtimeProfile,
 311:       next.runtimeVersion,
 312:       next.orchestratorVersion,
 313:       next.stepNumber,
 314:       jsonText(state, 'checkpoint state'),
 315:       jsonText(next.budgetUsage, 'checkpoint budget usage'),
 316:       next.digest,
 317:       next.createdAt
 318:     ]
 319:     return this.run(tenant, (client) =>
 320:       transaction(client, async () => {
 321:         const guard = await guardOptionalPublishedWrite(
 322:           client,
 323:           tenant,
 324:           next.executionId,
 325:           this.fence,
 326:           !!next.state.stopReason
 327:         )
 328:         const existing = await client.query<CheckpointRow>(
 329:           `SELECT ${boundedCheckpointColumns} FROM operational_execution_checkpoints
 330:          WHERE tenant_id = $1 AND execution_id = $2 FOR UPDATE`,
 331:           [tenant, next.executionId]
 332:         )
 333:         const row = existing.rows[0]
 334:         const current = row ? mapCheckpoint(row) : null
 335:         if (current)
 336:           validateCheckpointIntegrity(current, {
 337:             tenantId: tenant,
 338:             executionId: next.executionId
 339:           })
 340:         const currentToken = current
 341:           ? { checkpointId: current.checkpointId, digest: current.digest }
 342:           : undefined
 343:         if (
 344:           expected === null
 345:             ? current !== null
 346:             : !current ||
 347:               current.checkpointId !== expected.checkpointId ||
 348:               current.digest !== expected.digest
 349:         ) {
 350:           await guard?.recheck()
 351:           return {
 352:             status: 'CONFLICT',
 353:             ...(currentToken ? { currentToken } : {})
 354:           }
 355:         }
 356:         validateCompleteCheckpointTransition(current, next)
 357:         await guard?.recheck()
 358:         const result =
 359:           expected === null
 360:             ? await client.query(
 361:                 `INSERT INTO operational_execution_checkpoints
 362:           (tenant_id,execution_id,checkpoint_id,checkpoint_version,runtime_profile,runtime_version,
 363:            orchestrator_version,step_number,state,budget_usage,digest,created_at)
 364:           VALUES ($1,$2,$3,$4,$5,$6,$7,$8,$9::jsonb,$10::jsonb,$11,$12)
 365:           ON CONFLICT (tenant_id,execution_id) DO NOTHING RETURNING checkpoint_id`,
 366:                 values
 367:               )
 368:             : await client.query(
 369:                 `UPDATE operational_execution_checkpoints SET
 370:           checkpoint_id=$3,checkpoint_version=$4,runtime_profile=$5,runtime_version=$6,
 371:           orchestrator_version=$7,step_number=$8,state=$9::jsonb,budget_usage=$10::jsonb,digest=$11,created_at=$12
 372:           WHERE tenant_id=$1 AND execution_id=$2 AND checkpoint_id=$13 AND digest=$14
 373:           RETURNING checkpoint_id`,
 374:                 [...values, expected.checkpointId, expected.digest]
 375:               )
 376:         await guard?.recheck()
 377:         return result.rows.length
 378:           ? {
 379:               status: 'APPLIED',
 380:               token: { checkpointId: next.checkpointId, digest: next.digest }
 381:             }
 382:           : { status: 'CONFLICT' }
 383:       })
 384:     )
 385:   }
