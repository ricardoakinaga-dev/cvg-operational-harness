  87: // CASE suppresses oversized JSONB before node-postgres invokes its JSON parser.
  88: // octet_length uses expanded text size, not compressed pg_column_size.
  89: const boundedCheckpointColumns = checkpointColumns.replace(
  90:   'state, budget_usage',
  91:   `
  92:   CASE WHEN checkpoint_version <> 2 OR
  93:     (octet_length(state::text) <= ${COMPLETE_CHECKPOINT_STORAGE_MAX_BYTES}
  94:      AND length(state->>'data') <= ${COMPLETE_CHECKPOINT_DATA_MAX_CHARS})
  95:     THEN state ELSE NULL END AS state,
  96:   CASE WHEN checkpoint_version <> 2 OR octet_length(budget_usage::text) <= 4096
  97:     THEN budget_usage ELSE NULL END AS budget_usage`
  98: )
