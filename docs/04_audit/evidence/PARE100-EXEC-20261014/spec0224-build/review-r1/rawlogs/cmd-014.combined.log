 257:   public saveCheckpoint(checkpoint: ExecutionCheckpoint): Promise<void> {
 258:     if (checkpoint.checkpointVersion === 2)
 259:       throw new CheckpointError(
 260:         'checkpoint_version',
 261:         'V2 checkpoints require CAS'
 262:       )
 263:     const tenant = TenantIdSchema.parse(checkpoint.tenantId)
 264:     validateCheckpointIntegrity(checkpoint, {
 265:       tenantId: checkpoint.tenantId,
 266:       executionId: checkpoint.executionId
 267:     })
 268:     return this.run(tenant, (client) =>
 269:       transaction(client, async () => {
 270:         const guard = await guardOptionalPublishedWrite(
 271:           client,
 272:           tenant,
 273:           checkpoint.executionId,
 274:           this.fence,
 275:           !!checkpoint.state.stopReason
 276:         )
 277:         await guard?.recheck()
 278:         await saveOperationalCheckpointOnClient(client, tenant, checkpoint)
 279:         await guard?.recheck()
 280:       })
