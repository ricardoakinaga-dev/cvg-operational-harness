 423: async function transaction<T>(
 424:   client: PostgresQueryable,
 425:   operation: () => Promise<T>
 426: ): Promise<T> {
 427:   await client.query('BEGIN')
 428:   try {
 429:     const result = await operation()
 430:     await client.query('COMMIT')
 431:     return result
 432:   } catch (error) {
 433:     await client.query('ROLLBACK').catch(() => undefined)
 434:     throw error
 435:   }
 436: }
