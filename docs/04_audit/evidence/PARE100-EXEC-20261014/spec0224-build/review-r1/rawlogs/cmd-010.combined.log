  43: // Explicit toy tokenizer shared by this synthetic provider/counter. No BPE claim.
  44: const tokens = (value: unknown) =>
  45:   Math.ceil(
  46:     Buffer.byteLength(
  47:       canonicalizeCompleteJson(value, {
  48:         maxBytes: 1_000_000,
  49:         maxDepth: 64,
  50:         maxNodes: 1_000_000
  51:       }),
  52:       'utf8'
  53:     ) / 64
  54:   )
  55: const id = 'synthetic.complete.echo'
  56: function lane(
  57:   output: unknown,
  58:   options: {
  59:     counter?: boolean
  60:     maxTokens?: number
  61:     contextEngine?: ContextEngine
  62:     modelFault?: 'throw' | 'usage'
  63:     sideEffect?: 'NONE' | 'WRITE'
  64:     checkpointGuard?: (next: ExecutionCheckpoint) => void
  65:     secondTool?: boolean
  66:     nextOutput?: unknown
  67:     rules?: readonly ((context: StepContext) => LoopDecision | undefined)[]
  68:     echoText?: string
  69:   } = {}
  70: ) {
  71:   const requests: unknown[] = []
  72:   const toolBodies: unknown[] = []
  73:   let bodies = 0
  74:   const capabilities = createCapabilityRegistry([
  75:     {
  76:       descriptor: {
  77:         id,
  78:         version: '1',
  79:         description: 'Pure synthetic complete result',
  80:         inputSchema: { type: 'object' },
  81:         outputSchema: {},
  82:         risk: 'LOW',
  83:         sideEffect: options.sideEffect ?? 'NONE',
  84:         idempotent: true,
  85:         requiresApproval: false,
  86:         origin: 'core',
  87:         providerId: 'synthetic.complete',
  88:         providerVersion: '1'
  89:       },
  90:       implementation: {
  91:         validateInput: () => true,
  92:         validateOutput: () => true,
  93:         execute: async (input) => {
  94:           bodies++
  95:           const deliveredOutput =
  96:             options.echoText === undefined
  97:               ? bodies === 2 && options.nextOutput !== undefined
  98:                 ? options.nextOutput
  99:                 : output
 100:               : (input as { text: string }).text
 101:           toolBodies.push({
 102:             name: id,
 103:             input: structuredClone(input),
 104:             output: deliveredOutput
 105:           })
 106:           return {
 107:             status: 'SUCCEEDED',
 108:             output: deliveredOutput
 109:           }
 110:         }
 111:       }
 112:     }
 113:   ])
 114:   const model: ModelGateway = {
 115:     complete: async ({ signal: _signal, ...request }: ModelRequest) => {
 116:       void _signal
 117:       requests.push(structuredClone(request))
 118:       if (options.modelFault === 'throw')
 119:         throw new Error('synthetic model loss')
 120:       expect(request.maxOutputTokens).toBe(512)
 121:       const frame = JSON.parse(request.messages[1]!.content)
 122:       const observed = frame.items.find(
 123:         (item: { value?: { type?: string } }) =>
 124:           item.value?.type === 'TOOL_RESULT'
 125:       )
 126:       // The answer is derived only from the actual delivered request, never output above.
 127:       const decision = observed
 128:         ? options.secondTool && requests.length === 2
 129:           ? {
 130:               decisionType: 'CALL_TOOL',
 131:               reasonCode: 'TOOL_REQUIRED',
 132:               toolId: id,
 133:               toolVersion: '1',
 134:               toolInput: { round: 2 }
 135:             }
 136:           : {
 137:               decisionType: 'RESPOND',
 138:               reasonCode: 'GOAL_SATISFIED',
 139:               responseText:
 140:                 typeof observed.value.payload.output === 'string'
 141:                   ? observed.value.payload.output
 142:                   : canonicalizeCompleteJson(observed.value.payload.output)
 143:             }
 144:         : {
 145:             decisionType: 'CALL_TOOL',
 146:             reasonCode: 'TOOL_REQUIRED',
 147:             toolId: id,
 148:             toolVersion: '1',
 149:             toolInput:
 150:               options.echoText === undefined ? {} : { text: options.echoText }
 151:           }
 152:       const text = JSON.stringify(decision)
 153:       expect(tokens(text)).toBeLessThanOrEqual(512)
 154:       return {
 155:         text,
 156:         provider: 'synthetic.complete',
 157:         model: 'toy64-v1',
 158:         inputTokens: tokens(request),
 159:         outputTokens: options.modelFault === 'usage' ? 513 : tokens(text),
 160:         costUsd: 0
 161:       }
 162:     }
 163:   }
 164:   const counter: DecisionInputCounter = {
 165:     measure: async (request) => ({
 166:       counterId: 'toy64',
 167:       counterVersion: '1',
 168:       provider: 'synthetic.complete',
 169:       model: 'toy64-v1',
 170:       formattingVersion: '1',
 171:       inputUpperBoundTokens: tokens(request),
 172:       contextWindowTokens: 100_000,
 173:       costUpperBoundUsd: 0
 174:     })
 175:   }
 176:   const steps = new InMemoryExecutionStepStore()
 177:   const cas = steps.compareAndSwapCheckpoint.bind(steps)
 178:   steps.compareAndSwapCheckpoint = async (input) => {
 179:     options.checkpointGuard?.(input.next)
 180:     return cas(input)
 181:   }
 182:   const audit = new RecordingAuditSink()
 183:   const harness = createOperationalHarness({
 184:     toolResultContext: { version: 1 },
 185:     capabilities,
 186:     effectJournal: new InMemoryEffectJournal(),
 187:     stepStore: steps,
 188:     ...(options.contextEngine ? { contextEngine: options.contextEngine } : {}),
 189:     iterativeOrchestrator: new HybridOrchestrator({
 190:       decisionModel: model,
 191:       ...(options.rules ? { rules: options.rules } : {}),
 192:       ...(options.counter === false ? {} : { decisionInputCounter: counter }),
 193:       decisionModelSupportsMaxOutputTokens: true
 194:     }),
 195:     modelGateway: model,
 196:     policy: new ScriptedPolicyEngine(),
 197:     approvals: new InMemoryApprovalEngine(),
 198:     audit,
 199:     telemetry: new RecordingTelemetrySink()
 200:   })
 201:   const base = phase3RuntimeInput()
 202:   const input: RuntimeInput = {
 203:     ...base,
 204:     capabilityFingerprint: capabilities.compositionFingerprint(),
 205:     agent: phase3AgentProfile({ tools: [id] }),
 206:     userMessage: 'Read the synthetic tool and return its full output.',
 207:     budget: { ...base.budget, maxTokens: options.maxTokens ?? 10_000 }
 208:   }
 209:   return {
 210:     harness,
 211:     input,
 212:     requests,
 213:     steps,
 214:     audit,
 215:     toolBodies,
 216:     bodies: () => bodies
 217:   }
 218: }
