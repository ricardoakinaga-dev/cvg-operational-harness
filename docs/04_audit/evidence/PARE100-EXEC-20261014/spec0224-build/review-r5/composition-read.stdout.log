52:    * requested profile here; the worker never selects a runtime class.
53:    */
54:   readonly iterativeOrchestrator?: IterativeOrchestrator
55:   readonly stepStore?: ExecutionStepStore
56:   readonly contextEngine?: ContextEngine
57:   readonly knowledge?: AgenticKnowledgeProvider
58:   readonly sufficiencyEvaluator?: SufficiencyEvaluator
59:   readonly completionEvaluator?: CompletionEvaluator
60:   readonly claimExtractor?: (response: string) => readonly Claim[]
61:   readonly defaultRuntimeProfile?: RuntimeProfile
62:   readonly clock?: () => Date
63:   /** Optional containment gate; absent means fail-closed for contained tools. */
64:   readonly sandbox?: SandboxGate
65: }
