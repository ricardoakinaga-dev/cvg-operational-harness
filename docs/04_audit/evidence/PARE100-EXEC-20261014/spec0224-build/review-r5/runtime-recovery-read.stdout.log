1765:   private evaluatorFor(run: LoopRun): CompletionEvaluator {
1766:     if (this.completionEvaluatorOverride) {
1767:       return this.completionEvaluatorOverride
1768:     }
1769:     const strategy = run.input.agent.completionStrategy ?? 'DETERMINISTIC'
1770:     const cached = this.completionEvaluators.get(strategy)
1771:     if (cached) return cached
1772:     const evaluator = new DeterministicCompletionEvaluator({ strategy })
1773:     this.completionEvaluators.set(strategy, evaluator)
1774:     return evaluator
1775:   }
