1926:     }
1927:   ): Promise<void> {
1928:     const stepId = `step_${run.executionId}_${input.stepNumber}_${input.stepType.toLowerCase()}`
1929:     const terminal = input.status === 'SUCCEEDED' || input.status === 'FAILED'
1930:     const decisionType =
