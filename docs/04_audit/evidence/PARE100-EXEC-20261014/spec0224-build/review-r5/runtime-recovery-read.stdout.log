1792:   /**
1793:    * Post-usage gate for orchestrator-reported usage (PDSH-004). The
1794:    * beginModelRequest pre-model slot already gates the kernel's model call;
1795:    * this catches reported overages so the loop still stops honestly.
1796:    */
1797:   private checkAfterUsage(
1798:     run: LoopRun
1799:   ): { reason: StopReason; response: string } | null {
1800:     if (run.usage.modelCalls > run.input.budget.maxModelCalls) {
1801:       return {
1802:         reason: 'MAX_MODEL_CALLS',
1803:         response: 'Model-call budget exhausted.'
1804:       }
1805:     }
1806:     if (
1807:       run.usage.inputTokens + run.usage.outputTokens >
1808:       run.input.budget.maxTokens
1809:     ) {
1810:       return { reason: 'MAX_TOKENS', response: 'Token budget exhausted.' }
1811:     }
1812:     if (run.usage.costUsd > run.input.budget.maxCostUsd) {
1813:       return { reason: 'MAX_COST', response: 'Cost budget exhausted.' }
1814:     }
1815:     return null
1816:   }
1817: 
1818:   private accountUsage(run: LoopRun, usage: ModelUsage): void {
1819:     run.usage.modelCalls += usage.modelCalls
1820:     run.usage.inputTokens += usage.inputTokens
1821:     run.usage.outputTokens += usage.outputTokens
1822:     run.usage.costUsd += usage.costUsd
1823:   }
1824: 
1825:   private effectiveDuration(run: LoopRun): number {
1826:     return run.usage.activeDurationMs + (Date.now() - run.startedAtMs)
1827:   }
1828: 
1829:   private remainingDuration(run: LoopRun): number {
1830:     return run.input.budget.maxDurationMs - this.effectiveDuration(run)
1831:   }
1832: 
1833:   private makeObservation(
1834:     run: LoopRun,
1835:     input: {
1836:       stepId: string
1837:       stepNumber: number
1838:       type: Observation['type']
1839:       source: Observation['source']
1840:       trust: Observation['trust']
1841:       payload: unknown
1842:       summary: string
1843:       provenance: Observation['provenance']
1844:     }
1845:   ): Observation {
1846:     let payload = input.payload
1847:     if (this.options.toolResultContext && input.type === 'TOOL_RESULT') {
1848:       const value = payload as {
1849:         schemaVersion?: number
1850:         status?: string
1851:         output?: unknown
1852:         error?: unknown
1853:       }
1854:       const tool = this.options.tools.resolve(
1855:         input.provenance.sourceId,
1856:         input.provenance.sourceVersion
1857:       )
1858:       if (!tool)
1859:         throw new ToolResultContextError(
1860:           'STATE_CONFLICT',
1861:           'Tool observation has no native registry binding.',
1862:           'STATE_CONFLICT'
1863:         )
1864:       if (value.schemaVersion !== 1) {
1865:         payload =
1866:           value.status === 'SUCCEEDED'
1867:             ? completeToolPayload(value.output, tool.sideEffect)
1868:             : {
1869:                 schemaVersion: 1,
1870:                 status: value.status === 'REJECTED' ? 'REJECTED' : 'FAILED',
1871:                 sideEffect: tool.sideEffect,
1872:                 completion: 'NOT_APPLICABLE',
1873:                 resultAvailability: 'UNAVAILABLE',
1874:                 error:
1875:                   typeof value.error === 'string'
1876:                     ? value.error.slice(0, 512)
1877:                     : 'tool_failed'
1878:               }
1879:       }
1880:     }
1881:     const observation: Observation = {
1882:       observationId: `obs_${randomUUID()}`,
1883:       executionId: run.executionId,
1884:       stepId: input.stepId,
1885:       stepNumber: input.stepNumber,
1886:       type: input.type,
1887:       source: input.source,
1888:       trust: input.trust,
1889:       payload:
1890:         this.options.toolResultContext && input.type === 'TOOL_RESULT'
1891:           ? payload
1892:           : boundedPayload(payload, this.maxObservationPayloadChars),
1893:       summary: input.summary.slice(0, 500),
1894:       provenance: input.provenance,
1895:       timestamp: this.clock().toISOString()
1896:     }
1897:     if (this.options.toolResultContext && input.type === 'TOOL_RESULT')
1898:       assertCompleteToolObservation(observation)
1899:     return observation
1900:   }
1901: 
1902:   private async recordObservation(
1903:     run: LoopRun,
1904:     observation: Observation
1905:   ): Promise<void> {
1906:     run.observations = this.options.toolResultContext
1907:       ? retainCompleteObservations([...run.observations, observation])
1908:       : [...run.observations, observation].slice(-MAX_CHECKPOINT_OBSERVATIONS)
1909:     run.state = { ...run.state, observations: run.observations }
1910:     await this.safeAudit(run, 'observation.recorded', {
1911:       result: `${observation.source}:${observation.type}`
1912:     })
1913:   }
1914: 
