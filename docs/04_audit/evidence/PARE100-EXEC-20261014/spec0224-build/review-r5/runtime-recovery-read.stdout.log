1613:   private async dispatchVerify(
1614:     run: LoopRun,
1615:     decision: LoopDecision,
1616:     stepNumber: number
1617:   ): Promise<DispatchOutcome> {
1618:     const verificationLimit =
1619:       run.input.budget.maxVerificationCalls ?? run.input.budget.maxSteps
1620:     /* v8 ignore next -- defensive: the allowed-decision gate already stops at the bound */
1621:     if (run.usage.verificationCalls + 1 > verificationLimit) {
1622:       return this.stop(
1623:         'MAX_VERIFICATION_CALLS',
1624:         'Verification budget exhausted.'
1625:       )
1626:     }
1627:     run.usage.verificationCalls += 1
1628:     await this.persistCheckpoint(run)
1629:     const target = decision.verificationTarget as string
1630:     const verification = this.verify(run, target)
1631:     await this.recordObservation(
1632:       run,
1633:       this.makeObservation(run, {
1634:         stepId: `step_${run.executionId}_${stepNumber}_verify`,
1635:         stepNumber,
1636:         type: 'VERIFICATION',
1637:         source: 'SYSTEM',
1638:         trust: 'TRUSTED',
1639:         payload: { target, ...verification },
1640:         summary: `Verification ${verification.valid ? 'passed' : 'failed'} for target ${target}.`,
1641:         provenance: { sourceId: 'runtime-verifier' }
1642:       })
1643:     )
1644:     await this.recordStep(run, {
1645:       stepNumber,
1646:       stepType: 'VERIFY',
1647:       status: verification.valid ? 'SUCCEEDED' : 'FAILED',
1648:       sideEffecting: false,
1649:       reasonCode: decision.reasonCode,
1650:       ...(verification.valid ? {} : { errorCode: 'verification_failed' })
1651:     })
1652:     if (!verification.valid) {
1653:       run.skipEvaluationOnce = true
1654:       const revisionEvaluation = {
1655:         outcome: 'INCOMPLETE' as const,
1656:         reasonCode: 'VERIFICATION_FAILED' as const,
1657:         deterministic: true,
1658:         detail: verification.details.join('; ')
1659:       }
1660:       run.state = { ...run.state, lastEvaluation: revisionEvaluation }
1661:       run.lastEvaluation = revisionEvaluation
1662:     }
1663:     return { kind: 'continue' }
1664:   }
1665: 
1666:   private verify(
1667:     run: LoopRun,
1668:     target: string
1669:   ): { valid: boolean; details: readonly string[] } {
1670:     if (target === 'tool-result') {
1671:       const succeeded =
1672:         run.lastToolObservation !== null &&
1673:         (run.lastToolObservation.payload as { status?: string } | null)
1674:           ?.status === 'SUCCEEDED'
1675:       return {
1676:         valid: succeeded,
1677:         details: succeeded ? [] : ['no successful tool result is available']
1678:       }
1679:     }
1680:     if (target === 'evidence-coverage') {
1681:       const valid = run.lastSufficiency === 'SUFFICIENT'
1682:       return {
1683:         valid,
1684:         details: valid
1685:           ? []
1686:           : [`evidence sufficiency is ${run.lastSufficiency ?? 'unknown'}`]
1687:       }
1688:     }
1689:     if (target === 'response-claims') {
1690:       const validation = this.validateClaims(run, run.responseText ?? '')
1691:       return {
1692:         valid: validation.valid,
1693:         details: validation.unsupportedClaims
1694:       }
1695:     }
1696:     return {
1697:       valid: false,
1698:       details: [`unsupported verification target ${target}`]
1699:     }
1700:   }
1701: 
1702:   private validateClaims(run: LoopRun, responseText: string): ClaimValidation {
1703:     const extractor = this.options.claimExtractor
1704:     if (!extractor || !responseText.trim()) {
1705:       return { valid: true, unsupportedClaims: [] }
1706:     }
1707:     return defaultClaimValidation(extractor(responseText), run.observations)
1708:   }
1709: 
1710:   private async dispatchReplan(
1711:     run: LoopRun,
1712:     decision: LoopDecision,
1713:     stepNumber: number
1714:   ): Promise<DispatchOutcome> {
1715:     const replanLimit = run.input.budget.maxReplans ?? run.input.budget.maxSteps
1716:     /* v8 ignore next -- defensive: the allowed-decision gate already stops at the bound */
1717:     if (run.usage.replans + 1 > replanLimit) {
1718:       return this.stop('MAX_REPLANS', 'Replan budget exhausted.')
1719:     }
1720:     run.usage.replans += 1
1721:     await this.persistCheckpoint(run)
1722:     await this.recordObservation(
1723:       run,
1724:       this.makeObservation(run, {
1725:         stepId: `step_${run.executionId}_${stepNumber}_replan`,
1726:         stepNumber,
1727:         type: 'SYSTEM_EVENT',
1728:         source: 'SYSTEM',
1729:         trust: 'TRUSTED',
1730:         payload: { event: 'replan', reasonCode: decision.reasonCode },
1731:         summary: `Strategy changed: ${decision.reasonCode}.`,
1732:         provenance: { sourceId: 'runtime-replan' }
1733:       })
1734:     )
1735:     await this.recordStep(run, {
1736:       stepNumber,
1737:       stepType: 'MODEL',
1738:       status: 'SUCCEEDED',
1739:       sideEffecting: false,
1740:       reasonCode: decision.reasonCode
1741:     })
1742:     await this.safeAudit(run, 'runtime.replanned', {
1743:       result: decision.reasonCode
1744:     })
1745:     return { kind: 'continue' }
1746:   }
