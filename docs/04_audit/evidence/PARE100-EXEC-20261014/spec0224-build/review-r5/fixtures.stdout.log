199: /** Requires all requested categories to be present before SUFFICIENT. */
200: export class CategorySufficiencyEvaluator implements SufficiencyEvaluator {
201:   public async evaluate(input: {
202:     readonly query: string
203:     readonly requestedCategories: readonly string[]
204:     readonly observations: readonly {
205:       readonly payload: unknown
206:     }[]
207:   }): Promise<SufficiencyEvaluation> {
208:     const found = new Map<string, Set<string>>()
209:     for (const observation of input.observations) {
210:       const payload = observation.payload as {
211:         items?: readonly {
212:           itemId: string
213:           category?: string
214:           sourceId: string
215:         }[]
216:       } | null
217:       for (const item of payload?.items ?? []) {
218:         const category = item.category ?? 'unknown'
219:         const sources = found.get(category) ?? new Set<string>()
220:         sources.add(item.sourceId)
