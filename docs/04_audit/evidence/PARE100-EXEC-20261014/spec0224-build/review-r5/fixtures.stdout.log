158: export interface SyntheticKnowledgeItem {
159:   readonly itemId: string
160:   readonly text: string
161:   readonly sourceId: string
162:   readonly category: string
163: }
164: 
165: export class SyntheticKnowledgeProvider implements AgenticKnowledgeProvider {
166:   public readonly queries: string[] = []
167: 
168:   public constructor(
169:     private readonly catalog: readonly SyntheticKnowledgeItem[]
170:   ) {}
171: 
172:   public async search(
173:     request: KnowledgeSearchRequest
174:   ): Promise<KnowledgeSearchResult> {
175:     this.queries.push(request.query)
176:     const tokens = request.query.toLowerCase().split(/\s+/)
177:     const items = this.catalog.filter((item) => {
178:       const text = `${item.text} ${item.category}`.toLowerCase()
179:       return tokens.some((token) => token.length > 2 && text.includes(token))
180:     })
181:     return {
182:       query: request.query,
183:       items: items.map((item) => ({
184:         itemId: item.itemId,
185:         text: item.text,
186:         sourceId: item.sourceId,
187:         sourceVersion: 'v1',
188:         category: item.category
189:       })),
190:       provenance: items.map((item) => ({
191:         sourceId: item.sourceId,
192:         sourceVersion: 'v1',
193:         category: item.category
194:       }))
195:     }
196:   }
197: }
