243: export interface JournaledToolRegistryOptions {
244:   readonly crashAfterEffectBeforeConfirm?: boolean
245:   /** Binds effect replay to the exact capability composition. */
246:   readonly compositionFingerprint?: string
247:   /** Deterministic seam for synthetic tests; defaults to node:crypto UUIDs. */
248:   readonly attemptIdFactory?: EffectAttemptIdFactory
249: }
250: 
251: // Private executor provenance survives the native descriptor copies used by
252: // complete-result preparation. Caller-provided descriptor fields cannot opt in.
253: const NATIVE_EFFECT_JOURNAL = Symbol('native-effect-journal')
254: 
255: export async function hasNativeEffectReservation(
256:   tool: ToolDefinition | undefined,
257:   tenantId: string,
258:   operationKey: string
259: ): Promise<boolean> {
260:   const journal = tool
261:     ? (Object.getOwnPropertyDescriptor(tool, NATIVE_EFFECT_JOURNAL)?.value as
262:         | EffectJournal
263:         | undefined)
264:     : undefined
265:   if (!journal) return false
266:   const record = await journal.get(tenantId, operationKey)
267:   return (
268:     record !== null &&
269:     record.tenantId === tenantId &&
270:     record.operationKey === operationKey
271:   )
272: }
273: 
274: function proposalHash(
275:   tool: ToolDefinition,
276:   input: unknown,
277:   compositionFingerprint: string | undefined
278: ): string {
279:   return createHash('sha256')
280:     .update(
281:       JSON.stringify({
282:         schemaVersion: 'effect-proposal-v2',
283:         compositionFingerprint: compositionFingerprint ?? null,
284:         tool: {
285:           id: tool.id,
286:           version: tool.version,
287:           sideEffect: tool.sideEffect,
288:           idempotent: tool.idempotent,
289:           providerId:
290:             'providerId' in tool
291:               ? (tool as { providerId?: unknown }).providerId
292:               : undefined,
293:           providerVersion:
294:             'providerVersion' in tool
295:               ? (tool as { providerVersion?: unknown }).providerVersion
296:               : undefined
297:         },
298:         input
299:       })
300:     )
301:     .digest('hex')
302: }
303: 
304: /**
305:  * Wraps only the executor side of a registry. Descriptors remain unchanged,
306:  * policy and approval still run in the harness before this wrapper is called.
307:  */
308: export function createJournaledToolRegistry(
309:   registry: ToolRegistry,
310:   journal: EffectJournal,
311:   options: JournaledToolRegistryOptions = {}
312: ): ToolRegistry {
313:   return {
314:     list: () => registry.list(),
315:     resolve: (toolId, version) => {
316:       const tool = registry.resolve(toolId, version)
317:       if (!tool) return undefined
318:       return journaledTool(tool, journal, options)
319:     }
320:   }
321: }
322: 
323: function journaledTool(
324:   tool: ToolDefinition,
325:   journal: EffectJournal,
326:   options: JournaledToolRegistryOptions
327: ): ToolDefinition {
328:   const compositionFingerprint = options.compositionFingerprint
329:     ? bounded(options.compositionFingerprint, 'compositionFingerprint')
330:     : undefined
331:   const wrapped = {
332:     ...tool,
333:     [NATIVE_EFFECT_JOURNAL]: journal,
334:     execute: async (
335:       input: unknown,
336:       context: ToolExecutionContext
337:     ): Promise<ToolResult> => {
338:       const operationKey = bounded(context.operationKey ?? '', 'operationKey')
339:       const attemptId = createEffectAttemptId(options.attemptIdFactory)
340:       const reservation = await journal.reserve({
341:         tenantId: context.tenantId,
342:         operationKey,
343:         proposalHash: proposalHash(tool, input, compositionFingerprint),
344:         attemptId
345:       })
346:       if (reservation.state === 'CONFIRMED') {
347:         return { status: 'SUCCEEDED', output: reservation.result }
348:       }
349:       if (
350:         reservation.state === 'UNCERTAIN' ||
351:         reservation.state === 'EFFECT_STARTED'
352:       ) {
353:         return {
354:           status: 'REJECTED',
355:           error:
356:             'unknown_effect: explicit reconciliation is required before retry'
357:         }
358:       }
359:       if (reservation.attemptId !== attemptId) {
360:         return {
361:           status: 'REJECTED',
362:           error:
363:             'unknown_effect: an existing reservation requires reconciliation'
364:         }
365:       }
366:       await journal.markStarted({
367:         tenantId: context.tenantId,
368:         operationKey,
369:         attemptId
370:       })
371:       try {
372:         const result = await tool.execute(input, context)
373:         if (
374:           options.crashAfterEffectBeforeConfirm &&
375:           result.status === 'SUCCEEDED'
376:         ) {
377:           await journal.markUncertain({
378:             tenantId: context.tenantId,
379:             operationKey,
380:             attemptId,
381:             reason: 'synthetic crash after effect before confirmation'
382:           })
383:           return {
384:             status: 'REJECTED',
385:             error:
386:               'unknown_effect: synthetic crash after effect before confirmation'
387:           }
388:         }
389:         if (result.status === 'SUCCEEDED') {
390:           await journal.confirm({
391:             tenantId: context.tenantId,
392:             operationKey,
393:             attemptId,
394:             result: result.output
395:           })
396:         } else {
397:           await journal.fail({
398:             tenantId: context.tenantId,
399:             operationKey,
400:             attemptId,
401:             error: result.error ?? 'tool failed'
402:           })
403:         }
404:         return result
405:       } catch (error) {
406:         const message =
407:           error instanceof Error ? error.message : 'tool execution failed'
408:         await journal.markUncertain({
409:           tenantId: context.tenantId,
410:           operationKey,
411:           attemptId,
412:           reason: `unknown effect after executor failure: ${message}`
413:         })
414:         return {
415:           status: 'REJECTED',
416:           error: 'unknown_effect: executor outcome is uncertain'
417:         }
418:       }
419:     }
420:   }
421:   return wrapped
422: }

