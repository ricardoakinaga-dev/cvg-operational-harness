239: /** Validate a custom selector against native items and immutable runtime facts. */
240: export function validateCompleteStepContext(
241:   actual: StepContext,
242:   native: StepContext
243: ): void {
244:   completeSnapshot(actual)
245:   for (const key of [
246:     'executionId',
247:     'tenantId',
248:     'conversationId',
249:     'stepNumber',
250:     'runtimeProfile',
251:     'agentId',
252:     'agentVersion',
253:     'objective',
254:     'instructions',
255:     'goal',
256:     'userMessage',
257:     'stateSummary',
258:     'observations',
259:     'capabilities',
260:     'knowledgeAvailable',
261:     'completionStrategy',
262:     'allowedDecisionTypes',
263:     'budget',
264:     'budgetUsage',
265:     'pendingApprovalId',
266:     'pendingQuestion',
267:     'lastEvaluation',
268:     'correlationId',
269:     'traceId',
270:     'decisionRepair',
271:     'toolResultContext'
272:   ] as const) {
273:     if (
274:       completeSnapshot(actual[key] ?? null) !==
275:       completeSnapshot(native[key] ?? null)
276:     ) {
277:       throw new ToolResultContextError(
278:         'STATE_CONFLICT',
279:         `Context changed native field ${key}.`,
280:         'STATE_CONFLICT'
281:       )
282:     }
283:   }
284:   if (!Number.isSafeInteger(actual.tokenBudget) || actual.tokenBudget < 1) {
285:     throw new ToolResultContextError(
286:       'ADMISSION_UNAVAILABLE',
287:       'Invalid context token bound.'
288:     )
289:   }
290:   const nativeItems = new Map(
291:     native.contextItems.map((value) => [value.contextId, value])
292:   )
293:   const actualIds = new Set<string>()
294:   for (const item of actual.contextItems) {
295:     const expected = nativeItems.get(item.contextId)
296:     if (
297:       actualIds.has(item.contextId) ||
298:       !expected ||
299:       completeSnapshot(item) !== completeSnapshot(expected)
300:     ) {
