1: import { createHash } from 'node:crypto'
2: import type {
3:   CompleteToolObservationPayload,
4:   CompleteJsonValue,
5:   ContextItem,
6:   Observation,
7:   SideEffect,
8:   StepContext,
9:   ToolResult,
10:   ToolRegistry
11: } from '@cvg/harness-contracts'
12: import {
13:   canonicalizeCompleteJson,
14:   COMPLETE_CHECKPOINT_MAX_BYTES,
15:   CompleteJsonError,
16:   MAX_CHECKPOINT_OBSERVATIONS,
17:   ToolResultContextError
18: } from '@cvg/harness-contracts'
19: 
20: const LARGE_LIMITS = {
21:   maxBytes: COMPLETE_CHECKPOINT_MAX_BYTES,
22:   maxDepth: 64,
23:   maxNodes: 1_000_000
24: }
25: 
26: /** Before legacy serialization/validators can coerce or invoke output data. */
27: export function prepareCompleteToolResult(raw: unknown): ToolResult {
28:   let safe: Record<string, unknown>
29:   try {
30:     const text = canonicalizeCompleteJson(raw, LARGE_LIMITS)
31:     safe = JSON.parse(text) as Record<string, unknown>
32:     if (
33:       !safe ||
34:       Array.isArray(safe) ||
35:       !['SUCCEEDED', 'FAILED', 'REJECTED'].includes(safe.status as string)
36:     )
37:       throw new Error('shape')
38:     if (
39:       safe.error !== undefined &&
40:       (typeof safe.error !== 'string' || safe.error.length > 512)
41:     )
42:       throw new Error('error')
43:   } catch {
44:     // The body may already have acted; do not turn capture failure into safe replay.
45:     throw new Error('unknown_effect: complete_result_not_representable')
46:   }
47:   return {
48:     status: safe.status as ToolResult['status'],
49:     ...(Object.hasOwn(safe, 'output') ? { output: safe.output } : {}),
50:     ...(typeof safe.error === 'string' ? { error: safe.error } : {})
51:   }
52: }
53: 
54: export function prepareCompleteToolRegistry(
55:   registry: ToolRegistry
56: ): ToolRegistry {
57:   const prepare = (tool: ReturnType<ToolRegistry['resolve']>) =>
58:     tool
59:       ? {
60:           ...tool,
61:           execute: async (...args: Parameters<typeof tool.execute>) =>
62:             prepareCompleteToolResult(await tool.execute(...args))
63:         }
64:       : undefined
65:   return {
66:     list: () => registry.list().map((tool) => prepare(tool)!),
67:     resolve: (id, version) => prepare(registry.resolve(id, version))
68:   }
69: }
70: 
71: export function completeSnapshot(value: unknown): string {
72:   return canonicalizeCompleteJson(value, LARGE_LIMITS)
73: }
74: 
75: export function completeToolPayload(
76:   output: unknown,
77:   sideEffect: SideEffect
78: ): CompleteToolObservationPayload {
79:   try {
80:     const serialized = canonicalizeCompleteJson(output)
81:     return {
82:       schemaVersion: 1,
83:       status: 'SUCCEEDED',
84:       sideEffect,
85:       completion: 'COMPLETE',
86:       resultAvailability: 'AVAILABLE',
87:       output: JSON.parse(serialized) as CompleteJsonValue,
88:       outputBytes: Buffer.byteLength(serialized, 'utf8'),
89:       outputSha256: createHash('sha256').update(serialized).digest('hex')
90:     }
91:   } catch (error) {
92:     if (!(error instanceof CompleteJsonError)) throw error
93:     return {
94:       schemaVersion: 1,
95:       status: 'SUCCEEDED',
96:       sideEffect,
97:       completion: 'UNAVAILABLE',
98:       resultAvailability: 'UNAVAILABLE',
99:       reason: error.code
100:     }
101:   }
102: }
103: 
104: export function assertCompleteToolObservation(observation: Observation): void {
105:   if (observation.type !== 'TOOL_RESULT') return
106:   const raw = observation.payload
107:   // Validate plain JSON before reading individual fields; never invoke accessors.
108:   completeSnapshot(raw)
109:   const payload = raw as CompleteToolObservationPayload
110:   if (
111:     !payload ||
112:     payload.schemaVersion !== 1 ||
113:     observation.source !== 'TOOL' ||
114:     observation.trust !== 'UNTRUSTED' ||
115:     !['NONE', 'READ', 'WRITE', 'EXTERNAL'].includes(payload.sideEffect)
116:   ) {
117:     throw new ToolResultContextError(
118:       'STATE_CONFLICT',
119:       'Invalid complete tool envelope.',
120:       'STATE_CONFLICT'
121:     )
122:   }
123:   if (payload.status === 'SUCCEEDED' && payload.completion === 'COMPLETE') {
124:     const value = canonicalizeCompleteJson(payload.output)
125:     if (
126:       payload.resultAvailability !== 'AVAILABLE' ||
127:       payload.outputBytes !== Buffer.byteLength(value, 'utf8') ||
128:       payload.outputSha256 !==
129:         createHash('sha256').update(value).digest('hex') ||
130:       Object.keys(payload).sort().join(',') !==
131:         'completion,output,outputBytes,outputSha256,resultAvailability,schemaVersion,sideEffect,status'
132:     ) {
133:       throw new ToolResultContextError(
134:         'STATE_CONFLICT',
135:         'Tool result integrity mismatch.',
136:         'STATE_CONFLICT'
137:       )
138:     }
139:   } else if (
140:     payload.status === 'SUCCEEDED' &&
141:     payload.completion === 'UNAVAILABLE'
142:   ) {
143:     if (
144:       payload.resultAvailability !== 'UNAVAILABLE' ||
145:       !['INVALID_JSON', 'RESULT_TOO_LARGE', 'RESULT_COMPLEXITY'].includes(
146:         payload.reason
147:       ) ||
148:       Object.keys(payload).sort().join(',') !==
149:         'completion,reason,resultAvailability,schemaVersion,sideEffect,status'
150:     ) {
151:       throw new ToolResultContextError(
152:         'STATE_CONFLICT',
153:         'Invalid unavailable result.',
154:         'STATE_CONFLICT'
155:       )
156:     }
157:   } else if (
158:     (payload.status !== 'FAILED' && payload.status !== 'REJECTED') ||
159:     payload.completion !== 'NOT_APPLICABLE' ||
160:     payload.resultAvailability !== 'UNAVAILABLE' ||
161:     typeof payload.error !== 'string' ||
162:     payload.error.length > 512 ||
163:     Object.keys(payload).sort().join(',') !==
164:       'completion,error,resultAvailability,schemaVersion,sideEffect,status'
165:   ) {
166:     throw new ToolResultContextError(
167:       'STATE_CONFLICT',
168:       'Invalid failed tool result.',
169:       'STATE_CONFLICT'
170:     )
171:   }
172: 
173:   const identifiers = [
174:     observation.observationId,
175:     observation.executionId,
176:     observation.stepId,
177:     observation.provenance.sourceId,
178:     observation.provenance.sourceVersion,
179:     observation.provenance.operationKey,
180:     observation.provenance.effectRef
181:   ]
182:   if (
183:     identifiers.some(
184:       (value) =>
185:         value !== undefined &&
186:         (typeof value !== 'string' ||
187:           value.length > 512 ||
188:           value.includes('\0'))
189:     )
190:   ) {
191:     throw new ToolResultContextError(
192:       'STATE_CONFLICT',
193:       'Invalid tool result metadata.',
194:       'STATE_CONFLICT'
195:     )
196:   }
197:   const encoded = completeSnapshot(observation)
198:   const outputBytes =
199:     payload.completion === 'COMPLETE' ? payload.outputBytes : 0
200:   if (Buffer.byteLength(encoded, 'utf8') - outputBytes > 4_096) {
201:     throw new ToolResultContextError(
202:       'CONTEXT_OVERFLOW',
203:       'Tool result metadata exceeds its envelope limit.'
204:     )
205:   }
206: }
