222: export function retainCompleteObservations(
223:   observations: readonly Observation[]
224: ): Observation[] {
225:   const retained = [...observations]
226:   while (retained.length > MAX_CHECKPOINT_OBSERVATIONS) {
227:     const optional = retained.findIndex((value) => value.type !== 'TOOL_RESULT')
228:     if (optional < 0) {
229:       throw new ToolResultContextError(
230:         'CONTEXT_OVERFLOW',
231:         'No checkpoint slot for another complete tool result.'
232:       )
233:     }
234:     retained.splice(optional, 1)
235:   }
236:   return retained
237: }
