304:         'STATE_CONFLICT'
305:       )
306:     }
307:     actualIds.add(item.contextId)
308:   }
309:   for (const item of native.contextItems) {
310:     if (
311:       [
312:         'SYSTEM',
313:         'AGENT_PROFILE',
314:         'CURRENT_GOAL',
315:         'CURRENT_STATE',
316:         'FRESH_TOOL_RESULTS'
317:       ].includes(item.priority) &&
318:       !actualIds.has(item.contextId)
319:     ) {
320:       throw new ToolResultContextError(
321:         'CONTEXT_OVERFLOW',
322:         'A mandatory context item was omitted.'
323:       )
324:     }
325:   }
