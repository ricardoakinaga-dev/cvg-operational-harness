245:         reasonCode: 'CONFLICTING_SOURCES',
246:         missingCategories: [],
247:         conflictingSources: conflicting,
248:         coveredCategories: covered
249:       }
250:     }
251:     return {
252:       level: covered.length > 0 ? 'PARTIAL' : 'INSUFFICIENT',
253:       reasonCode: 'MISSING_CATEGORIES',
254:       missingCategories: missing,
255:       conflictingSources: conflicting,
256:       coveredCategories: covered
257:     }
258:   }
259: }
