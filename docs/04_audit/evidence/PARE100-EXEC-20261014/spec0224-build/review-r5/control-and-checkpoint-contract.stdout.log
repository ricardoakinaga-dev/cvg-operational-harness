350:     kind: 'control',
351:     provides: ['policy'],
352:     requires: ['budget'],
353:     apply(ctx) {
354:       ctx.provide('policy', policy)
355:       ctx.on('tool/pre-execute', async (call, next) => {
356:         const { turn, tool, invocation } = call
357:         let decision
358:         try {
359:           const decisionOrDeadline = await turn.budget.withDeadline(() =>
360:             policy.evaluate({
361:               tenantId: turn.input.tenantId,
362:               agentId: turn.input.agent.id,
363:               action: 'tool.execute',
364:               tool,
365:               invocation,
366:               correlationId: turn.input.correlationId
367:             })
368:           )
369:           if (decisionOrDeadline === DEADLINE) {
370:             return stop(
371:               'MAX_DURATION',
372:               'Duration budget exhausted during policy evaluation.'
373:             )
374:           }
375:           decision = decisionOrDeadline
376:           turn.metadata.policy = decision.outcome
377:           call.policyDecision = decision
378:         } catch (error) {
379:           return stop(
380:             'INSUFFICIENT_EVIDENCE',
381:             `Policy evaluation failed: ${errorMessage(error)}.`,
382:             { cause: 'policy_failed' }
383:           )
384:         }
385:         switch (decision.outcome) {
386:           case 'DENY':
387:             return stop('POLICY_DENIED', decision.reason, {
388:               cause: 'policy_denied'
389:             })
390:           case 'HANDOFF':
391:             return stop('HUMAN_TAKEOVER', decision.reason, {
392:               cause: 'policy_handoff'
393:             })
394:           case 'REQUIRE_APPROVAL':
395:             call.needsApproval = true
396:             break
397:           case 'ALLOW':
398:             break
399:           default:
400:             return stop(
401:               'INSUFFICIENT_EVIDENCE',
402:               'Policy returned an unsupported decision.',
403:               { cause: 'policy_unsupported' }
404:             )
405:         }
406:         return next()
407:       })
408:     }
409:   }
410: }
