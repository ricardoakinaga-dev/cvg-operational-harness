685:           trust: 'UNTRUSTED',
686:           payload: {
687:             status: 'REJECTED',
688:             error: 'approval_confirmation_failed'
689:           },
690:           summary: 'Approval confirmation failed after the effect.',
691:           provenance: {
692:             sourceId: tool.id,
693:             operationKey,
694:             effectRef: operationKey
695:           }
696:         })
697:       )
