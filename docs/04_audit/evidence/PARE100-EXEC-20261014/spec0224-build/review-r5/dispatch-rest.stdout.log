723:               outcome.result.output,
724:               'Tool completed successfully.'
725:             ),
726:         provenance: {
727:           sourceId: tool.id,
728:           ...(tool.version ? { sourceVersion: tool.version } : {}),
729:           operationKey,
730:           effectRef: operationKey
731:         }
732:       })
