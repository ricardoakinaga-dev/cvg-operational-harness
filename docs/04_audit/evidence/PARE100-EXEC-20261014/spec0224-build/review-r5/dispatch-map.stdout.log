37: /**
38:  * Explicit dependency surface for the extracted dispatch domain. The runtime
39:  * builds it from its own private members, so no visibility changes are needed
40:  * on the exported class and the public contract stays identical.
41:  */
42: export interface IterativeDispatchContext {
43:   readonly options: IterativeGovernedRuntimeOptions
44:   readonly maxObservationPayloadChars: number
45:   stop(
46:     stopReason: StopReason,
47:     response: string
48:   ): Extract<DispatchOutcome, { kind: 'stop' }>
49:   operationKey(run: LoopRun, stepNumber: number, toolId: string): string
50:   remainingDuration(run: LoopRun): number
51:   makeObservation(
52:     run: LoopRun,
53:     input: {
54:       stepId: string
55:       stepNumber: number
56:       type: Observation['type']
57:       source: Observation['source']
58:       trust: Observation['trust']
59:       payload: unknown
60:       summary: string
61:       provenance: Observation['provenance']
62:     }
63:   ): Observation
64:   checkAfterUsage(run: LoopRun): { reason: StopReason; response: string } | null
65:   allowedDecisionTypes(run: LoopRun): LoopDecision['decisionType'][]
66:   evaluatorFor(run: LoopRun): CompletionEvaluator
67:   validateClaims(run: LoopRun, responseText: string): ClaimValidation
68:   withDeadline<T>(
69:     operation: Promise<T>,
70:     remainingMs: number
71:   ): Promise<T | typeof DEADLINE_EXCEEDED>
72:   recordObservation(run: LoopRun, observation: Observation): Promise<void>
73:   recordStep(
74:     run: LoopRun,
75:     input: {
76:       stepNumber: number
77:       stepType: ExecutionStep['stepType']
78:       status: ExecutionStep['status']
79:       sideEffecting: boolean
80:       decisionType?: ExecutionStep['decisionType']
81:       reasonCode?: ExecutionStep['reasonCode']
82:       errorCode?: string
83:       observationRefs?: readonly string[]
84:     }
85:   ): Promise<void>
86:   persistCheckpoint(run: LoopRun): Promise<void>
87:   preflightCompleteTool?(
88:     run: LoopRun,
89:     decision: LoopDecision,
90:     stepNumber: number
91:   ): void
92:   safeAudit(
93:     run: LoopRun,
94:     action: string,
95:     extras: { result: string; tool?: string | null }
96:   ): Promise<void>
97:   composeResponse(
98:     run: LoopRun,
99:     decision: LoopDecision
100:   ): Promise<
101:     { response: string } | { stopReason: StopReason; response: string }
102:   >
103:   /** Kernel host and turn view for the shared governed pipelines. */
104:   kernel(run: LoopRun): KernelHost
105:   turn(run: LoopRun): TurnState
106: }
