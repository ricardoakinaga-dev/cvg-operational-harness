    {
      "id": "PAIR-00",
      "inputs": {},
      "expectedObservation": "No escalation argument-pair error",
      "execution": "NOT_RUN"
    },
    {
      "id": "PAIR-01",
      "inputs": {
        "sandboxPermissions": "workspace-write",
        "justification": "required synthetic update"
      },
      "expectedObservation": "Pair accepted; no approval or body execution occurs in validation",
      "execution": "NOT_RUN"
    },
    {
      "id": "PAIR-02",
      "inputs": {
        "sandboxPermissions": "workspace-write"
      },
      "expectedObservation": "Throws before any approval/body",
      "execution": "NOT_RUN"
    },
    {
      "id": "PAIR-03",
      "inputs": {
        "justification": "reason"
      },
      "expectedObservation": "Throws before any approval/body",
      "execution": "NOT_RUN"
    },
    {
      "id": "PAIR-04",
      "inputs": {
        "sandboxPermissions": "workspace-write",
        "justification": " \t\n"
      },
      "expectedObservation": "Throws for empty trimmed reason",
      "execution": "NOT_RUN"
    },
    {
      "id": "PAIR-05",
      "inputs": {
        "sandboxPermissions": "workspace-write",
        "justification": "x"
      },
      "expectedObservation": "Nonempty reason accepted by this helper; do not invent sentence grammar beyond observed code",
      "execution": "NOT_RUN"
    }
  ],
  "knownBadControls": [
    "Validator accepts an unpaired request",
    "Validator silently inserts a justification",
    "Validator starts approval/body while validating"
  ],
  "status": "PROPOSED_NOT_RUN",
  "execution": "NOT_RUN",
  "referencePublicArtifact": "SOURCE_DECLARATION_AUTHENTICATED_PUBLISHED_EXPORT_AND_SOURCE_LIB_CLOSURE_NOT_VERIFIED",
