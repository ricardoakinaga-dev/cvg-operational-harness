1: /**
2:  * Service Definition for the same-world process-confinement capability seam: wrap exact subprocess argv under a
3:  * host-path file policy. Containers, microVMs, and remote execution replace the
4:  * surrounding capability seam instead; this service shares the host kernel and filesystem.
5:  * @module @deepseek-ai/dsh-sandbox
6:  */
7: 
8: import { Context, Service } from '@deepseek-ai/cordis'
9: import { HarnessError } from '@deepseek-ai/dsh-llm'
10: import type { SessionId } from '@deepseek-ai/dsh-session'
11: 
12: export {
13:   ESCALATION_TARGETS,
14:   WIDER_MODES,
15:   approveEscalation,
16:   escalationHintMarker,
17:   sandboxDenialMarker,
18:   sandboxPermissionsDescription,
19:   validateEscalationArgs,
20: } from './escalation.ts'
21: export type { EscalationApproval, EscalationApprover, EscalationOutcome, EscalationRequest } from './escalation.ts'
22: export { canonicalPath, writableRoots } from './roots.ts'
23: 
24: /**
25:  * File-effect policy for confined processes. `read-only` permits only required
26:  * sinks such as `/dev/null`; `workspace-write` also permits the workspace and a
27:  * backend-defined temp area; `danger-full-access` bypasses confinement. Network
28:  * and process visibility are outside this vocabulary.
29:  */
30: export type SandboxMode = 'read-only' | 'workspace-write' | 'danger-full-access'
31: 
32: /** A confining (non-`danger-full-access`) mode — the modes a {@link SandboxPolicy} can carry. */
33: export type ConfinedSandboxMode = Exclude<SandboxMode, 'danger-full-access'>
34: 
35: /**
36:  * The complete file-effect policy resolved for one capability call. The root
37:  * is carried even under modes that do not consume it so callers can resolve
38:  * policy once before choosing the enforcement path.
39:  */
40: export interface SandboxExecutionPolicy {
41:   /** The file-effect mode this execution runs under. */
42:   mode: SandboxMode
43:   /** Absolute root directory `workspace-write` may write under. */
44:   workspaceRoot: string
45:   /**
46:    * Opaque identity of the calling session (the branded `dsh-session`
47:    * SessionId). Backends key per-session state off it (e.g. windows-acl gives
48:    * each live session/workspace pair a random private temp directory and SID,
49:    * while the workspace SID and standing grant remain per-workspace); absent
50:    * for agentless calls, which fall back to per-call backend state.
51:    */
52:   sessionId?: SessionId
53: }
54: 
55: /**
56:  * Enforcement completeness for this host. `partial` means an active backend or
57:  * older kernel ABI cannot govern every promised file effect; callers requiring
58:  * an absolute boundary must not treat it as `full`.
59:  */
60: export type SandboxEnforcement = 'full' | 'partial'
61: 
62: /** Provider facts for the requested confined mode; unknown values make no Host equivalence claim. */
63: export interface SandboxExecutionEnvironment {
64:   /** Selected runner family, without executable arguments or credentials. */
65:   runner: string
66:   /** Selection verdict; unavailable means no confined command can start. */
67:   enforcement: SandboxEnforcement | 'unavailable'
68:   /** Lifetime and sharing of the process temporary area. */
69:   temporaryFiles: 'host' | 'per-call' | 'per-session' | 'unknown'
70:   /** Whether process temporary paths refer to the Host temporary files. */
71:   sharesHostTemporaryFiles: boolean | 'unknown'
72:   /** Host identity preservation or runner-dependent UID/GID mapping. */
73:   identity: 'host' | 'namespace-dependent' | 'restricted-token' | 'unknown'
74: }
75: 
76: /**
77:  * What one confined execution is allowed to touch — carried PER CALL, not
78:  * fixed on the provider: two consumers may confine under different policies
79:  * at the same instant (bash under `read-only` while a confined child agent
80:  * needs its state directory writable), and an approved escalated retry is a
81:  * new call with a wider policy. Defaulting/resolution is an explicit step at
82:  * the consumer boundary; the provider treats the policy as fully specified.
83:  */
84: export interface SandboxPolicy extends SandboxExecutionPolicy {
85:   /** The file-effect mode this execution runs under. */
86:   mode: ConfinedSandboxMode
87: }
88: 
89: /**
90:  * Evidence that identifies a sandbox runner failing before it executes the
91:  * wrapped command. A consumer first applies {@link allowedExitCodes} when
92:  * present, removes {@link informationalLines} by case-insensitive exact line
93:  * equality, then matches {@link fatalSignatures} case-insensitively within
94:  * each remaining stderr line. Exit status alone never proves runner failure.
95:  */
96: export interface RunnerFailureRule {
97:   /** Nonzero process exit codes on which this rule may match; omitted permits any nonzero exit. */
98:   allowedExitCodes?: readonly number[]
99:   /** Non-empty substrings identifying a fatal runner diagnostic on one stderr line. */
100:   fatalSignatures: readonly string[]
101:   /** Benign stderr lines excluded by exact full-line equality before fatal matching. */
102:   informationalLines?: readonly string[]
103: }
104: 
105: /**
106:  * A {@link SandboxProvider.confine} result: the argv to spawn in place of
107:  * the caller's own, plus the enforcement completeness the selected backend
108:  * achieves for it.
109:  */
110: export interface ConfinedArgv {
111:   /** The wrapped argv (runner, profile, separator, then the caller's argv). */
112:   argv: string[]
113:   /** How completely the selected backend enforces the policy's file effects. */
114:   enforcement: SandboxEnforcement
115:   /**
116:    * The selected backend's denial DIALECT: the case-insensitive stderr
117:    * substrings a file effect denied by THIS backend produces (EROFS text
118:    * under bwrap's read-only binds, EACCES under Landlock, EPERM under
119:    * Seatbelt). A consumer that infers denials from a failed run's stderr
120:    * matches against exactly these rather than a cross-backend union — the
121:    * union claims denials a given backend never produces.
122:    */
123:   denialSignatures: readonly string[]
124:   /**
125:    * Structured runner-failure evidence rules. Consumers require a matching
126:    * fatal stderr line (after informational exclusions) and any rule-specific
127:    * exit-code gate before checking denial signatures: runner failure means the
128:    * command never ran, while denial means confinement worked and blocked it.
129:    */
130:   runnerFailureRules: readonly RunnerFailureRule[]
131: }
132: 
133: /**
134:  * Error code for a requested confined mode when no backend is usable. The
135:  * provider fails closed, and `HarnessError` carries the code through
136:  * `tool/result` so callers can distinguish missing confinement from command
137:  * failure.
138:  */
139: export const SANDBOX_UNAVAILABLE = 'SANDBOX_UNAVAILABLE'
140: 
141: /**
142:  * Thrown when {@link SandboxProvider.confine} cannot enforce the requested
143:  * mode. Carries {@link SANDBOX_UNAVAILABLE} through the structured error
144:  * channel.
145:  */
146: export class SandboxUnavailableError extends HarnessError {
147:   constructor(mode: ConfinedSandboxMode, detail?: string) {
148:     super(
149:       `sandbox mode "${mode}" is requested but no sandbox backend is usable on this host; `
150:       + 'refusing to run the command unconfined. Install bubblewrap or run a Landlock-enforcing '
151:       + 'kernel (Linux), ensure sandbox-exec is usable (macOS), or ensure the ACL '
152:       + 'restricted-token runner can start (Windows) — otherwise switch the consumer to '
153:       + 'danger-full-access.'
154:       + (detail === undefined ? '' : ` Runner failure: ${detail}`),
155:       SANDBOX_UNAVAILABLE,
156:     )
157:     this.name = 'SandboxUnavailableError'
158:   }
159: }
160: 
161: declare module '@deepseek-ai/cordis' {
162:   interface Context {
163:     sandbox: SandboxProvider
164:   }
165: }
166: 
167: /**
168:  * Abstract process-sandbox service. {@link confine} must return enforcing argv
169:  * or fail closed at wrap or runner-execution time; silent unconfined passthrough
170:  * is forbidden. Functional probes arbitrate multi-runner chains and may be
171:  * skipped for a sole candidate, whose own refusal remains the fail-closed end.
172:  */
173: export abstract class SandboxProvider extends Service {
174:   /*! v8 ignore next -- abstract service construction is covered through concrete provider packages. */
175:   constructor(ctx: Context) {
176:     super(ctx, 'sandbox')
177:   }
178: 
179:   /**
180:    * Describe the runner selected for a policy without launching a user command.
181:    * Providers may perform bounded selection probes. Absence makes no claim about execution-world semantics.
182:    * @param policy - fully resolved confined policy.
183:    * @returns provider facts, or undefined when the provider offers no descriptor.
184:    */
185:   describe(policy: SandboxPolicy): SandboxExecutionEnvironment | undefined {
186:     void policy
187:     return undefined
188:   }
189: 
190:   /**
191:    * Wrap `argv` so it executes confined under `policy` on this host; the
192:    * caller spawns the returned argv in place of its own.
193:    * @param argv - the exact argv the caller is about to spawn (program plus
194:    *   arguments), NOT a shell string — a shell-shaped consumer passes
195:    *   `['bash', '-c', command]`.
196:    * @param policy - the file-effect policy this execution runs under,
197:    *   carried per call (see {@link SandboxPolicy}).
198:    * @param signal - cancellation while the provider resolves the policy and runner.
199:    * @returns the argv to spawn instead, plus the enforcement completeness
200:    *   the selected backend achieves for it.
201:    */
202:   abstract confine(argv: readonly string[], policy: SandboxPolicy, signal?: AbortSignal): Promise<ConfinedArgv>
203: }
204: 
205: export default SandboxProvider
206: 
207: export { classifyRunnerFailure, isRunnerSpawnFailure, matchesSignature } from './diagnostics.ts'
