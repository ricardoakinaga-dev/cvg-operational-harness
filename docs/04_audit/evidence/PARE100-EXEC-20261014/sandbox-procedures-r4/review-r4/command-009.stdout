439: /* -------------------------------------------------------------------------- */
440: /* Sandbox seam (PDSH-010 / SPEC 0195).                                       */
441: /*                                                                            */
442: /* The sandbox decides under what containment an already-allowed effect runs. */
443: /* It never decides whether the effect is permitted (policy/approval do) and  */
444: /* never downgrades: an unavailable required mode fails closed as a denied    */
445: /* outcome, never as silent in-process execution.                             */
446: /* -------------------------------------------------------------------------- */
447: 
448: export type SandboxMode =
449:   | 'NONE'
450:   | 'IN_PROCESS'
451:   | 'WORKSPACE'
452:   | 'PROCESS'
453:   | 'EGRESS'
454: 
455: /** Resolved containment for one tool call; the only channel to fs/net/exec. */
456: export interface SandboxHandle {
457:   readonly mode: SandboxMode
458:   /** Present only in WORKSPACE; the tenant-scoped writable root. */
459:   readonly workspaceRoot?: string
460:   readonly allowNetwork: boolean
461:   readonly allowSubprocess: boolean
462:   readonly deadlineMs?: number
463: }
464: 
465: export type SandboxGateOutcome =
466:   | {
467:       readonly kind: 'allowed'
468:       readonly mode: SandboxMode
469:       readonly handle: SandboxHandle
470:     }
471:   | { readonly kind: 'denied'; readonly reason: string }
472:   | { readonly kind: 'unavailable'; readonly reason: string }
473: 
474: export interface SandboxPolicy {
475:   readonly requiredMode: SandboxMode
476:   readonly workspaceScoped: boolean
477:   readonly networkAllowed: boolean
478:   readonly subprocessAllowed: boolean
479:   readonly timeoutMs?: number
480: }
481: 
482: export interface SandboxEvaluationInput {
483:   readonly descriptor: ToolDescriptor
484:   readonly context: ToolExecutionContext
485:   readonly policy?: SandboxPolicy
486: }
487: 
488: /** Enforcement port the harness calls between decision and capability body. */
489: export interface SandboxGate {
490:   evaluate(input: SandboxEvaluationInput): Promise<SandboxGateOutcome>
