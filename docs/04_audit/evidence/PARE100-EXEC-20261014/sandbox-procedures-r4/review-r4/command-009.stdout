FILE reference/packages/sandbox/sandbox-local/src/index.ts
404:   /**
405:    * The windows-acl runner argv for one policy. With a calling session (the
406:    * policy's `sessionId`) under workspace-write, the grants are materialized
407:    * once per provider lifetime — the standing workspace-root grant per
408:    * workspace and a revocable, RANDOM private-temp capability per live
409:    * session/workspace pair. The runner receives `--write-sid` plus
410:    * `--temp-write-sid` and grants nothing itself. Agentless workspace-write
411:    * calls pass the ambient temp ROOT and no SID flags: the runner creates and
412:    * removes a random private child directory for that one invocation.
413:    * @param policy - the resolved per-call policy.
414:    * @returns the runner invocation.
415:    */
416:   private windowsAclRunnerArgv(policy: SandboxPolicy): string[] {
417:     const sessionId = policy.sessionId
418:     if (sessionId === undefined || policy.mode === 'read-only') {
419:       return [
420:         ...this.windowsAclRunnerInvocation(),
421:         '--workspace', policy.workspaceRoot,
422:         '--temp', tmpdir(),
423:         '--mode', policy.mode,
424:       ]
425:     }
426:     const temp = this.materializeAclGrant(sessionId, policy.workspaceRoot)
427:     return [
428:       ...this.windowsAclRunnerInvocation(),
429:       '--workspace', policy.workspaceRoot,
430:       '--temp', temp.dir,
431:       '--mode', policy.mode,
432:       '--write-sid', workspaceWriteSid(policy.workspaceRoot),
433:       '--temp-write-sid', temp.writeSid,
434:     ]
435:   }
436: 
437:   /**
438:    * Materialize one workspace-write policy's ACEs once per provider
439:    * lifetime. The workspace SID and standing root grant are shared by the
440:    * workspace. The temp directory is random and carries a distinct SID, so
441:    * another session on the same workspace cannot use the shared workspace
442:    * SID to enter it. A fresh provider always chooses a new path; crash
443:    * residue therefore cannot collide with or authorize a resumed session.
444:    * Fail-closed: a half-materialized temp grant is revoked and its directory
445:    * removed before the error propagates.
446:    * @param sessionId - the policy's calling-session identity.
447:    * @param workspaceRoot - the resolved policy root.
448:    * @returns the pair's private temp directory and write capability.
449:    */
450:   private materializeAclGrant(sessionId: SessionId, workspaceRoot: string): AclTempCapability {
451:     assertTempRootOutsideWorkspace(workspaceRoot, tmpdir())
452:     const writeSid = workspaceWriteSid(workspaceRoot)
453:     if (!this.workspaceGrants.has(workspaceRoot)) {
454:       const grant = AclWriteGrant.create(writeSid)
455:       try {
456:         grant.add(workspaceRoot, true)
457:       } catch (error) {
458:         // Free the SID; a standing ACE (if the apply succeeded before a
459:         // post-apply throw) is the intended end state, not an error
460:         // artifact — nothing to revoke.
461:         try {
462:           grant.dispose()
463:         } catch (cleanupError) {
464:           throw new AggregateError([error, cleanupError], 'sandbox-local windows-acl workspace grant failed and its cleanup also failed')
465:         }
466:         throw error
467:       }
468:       this.workspaceGrants.set(workspaceRoot, grant)
469:     }
470:     const key = JSON.stringify([String(sessionId), workspaceRoot])
471:     const existing = this.tempCapabilities.get(key)
472:     if (existing !== undefined) return existing
473:     const tempDir = mkdtempSync(join(tmpdir(), 'dsh-'))
474:     const tempSid = tempWriteSid(tempDir)
475:     let grant: AclWriteGrant | undefined
476:     try {
477:       grant = AclWriteGrant.create(tempSid)
478:       grant.add(tempDir)
479:     } catch (error) {
480:       const cleanupFailures: unknown[] = []
481:       if (grant !== undefined) {
482:         try {
483:           grant.dispose()
484:         } catch (cleanupError) {
485:           cleanupFailures.push(cleanupError)
486:         }
487:       }
488:       try {
489:         this.removeTempDir(tempDir)
490:       } catch (cleanupError) {
491:         cleanupFailures.push(cleanupError)
492:       }
493:       if (cleanupFailures.length > 0) {
494:         throw new AggregateError([error, ...cleanupFailures], 'sandbox-local windows-acl temp grant materialization failed and its cleanup also failed')
495:       }
496:       throw error
497:     }
498:     const capability = { dir: tempDir, writeSid: tempSid, grant }
499:     this.tempCapabilities.set(key, capability)
500:     return capability
501:   }
502: 
503:   /**
504:    * Dispose every write grant (provider dispose): the revocable temp ACEs
505:    * are revoked, the private temp directories this provider created are
506:    * removed, and every SID allocation is freed; the standing workspace ACEs
507:    * stay (the reuse cache). Cleanup failures are reported, not thrown:
508:    * cordis teardown must not be aborted by grant cleanup. A crash skips all
509:    * of it, but a new provider never reuses the residue's random path or SID;
510:    * OS temp hygiene (or manual removal) eventually reclaims it.
511:    */
512:   private revokeAclGrants(): void {
513:     if (this.workspaceGrants.size === 0 && this.tempCapabilities.size === 0) return
514:     const failures: unknown[] = []
515:     for (const grant of [...this.workspaceGrants.values(), ...[...this.tempCapabilities.values()].map(capability => capability.grant)]) {
516:       try {
517:         grant.dispose()
518:       } catch (error) {
519:         failures.push(error)
520:       }
521:     }
522:     for (const { dir } of this.tempCapabilities.values()) {
523:       try {
524:         this.removeTempDir(dir)
525:       } catch (error) {
526:         failures.push(error)
527:       }
528:     }
529:     this.workspaceGrants.clear()
530:     this.tempCapabilities.clear()
531:     if (failures.length > 0) {
532:       this.ctx.logger.warn(`sandbox-local: windows-acl grant cleanup completed with ${failures.length} failure(s)`)
533:       for (const error of failures) this.ctx.logger.warn(error)
534:     }
535:   }
536: 
537:   /** Remove one provider-owned private temp directory (injectable for cleanup tests). */
538:   private removeTempDir(dir: string): void {
539:     const remove = this.internals.rmTempDir ?? ((path: string) => { rmSync(path, { recursive: true, force: true }) })
540:     remove(dir)
541:   }
542: 
543:   /**
544:    * Resolve which runner confines commands, once, for the provider's
545:    * lifetime: this platform's chain ({@link PLATFORM_CHAINS}), its sole
546:    * candidate selected directly, multiple candidates arbitrated by
547:    * functional probes in chain order. Fail closed when the platform has no
548:    * chain or no candidate passes — the command never runs.
549:    */
550:   private selectRunner(mode: ConfinedSandboxMode): SelectedRunner {
551:     this.selectedRunner ??= this.chainVerdict()
552:     if (this.selectedRunner === 'unavailable') throw new SandboxUnavailableError(mode)
553:     return this.selectedRunner
554:   }
555: 
556:   /** Walk this platform's chain: sole candidate unprobed, several probed in order, none usable → unavailable. */
557:   private chainVerdict(): SelectedRunner | 'unavailable' {
558:     const chain = this.internals.chain ?? PLATFORM_CHAINS[this.internals.platform ?? process.platform] ?? []
559:     const [first, ...rest] = chain
560:     if (first === undefined) return 'unavailable'
561:     // A sole candidate needs no arbitration; its execution-time refusal still fails closed.
562:     if (rest.length === 0) return { runner: first, enforcement: STATIC_ENFORCEMENT[first] }
563:     for (const runner of chain) {
564:       const enforcement = this.probeRunner(runner)
565:       if (enforcement !== 'unusable') return { runner, enforcement }
566:     }
567:     return 'unavailable'
568:   }
569: 
570:   /** One rung's functional probe (each at most once, via the chain walk). */
571:   private probeRunner(runner: SelectedRunner['runner']): SandboxEnforcement | 'unusable' {
572:     // bwrap's mount profile and Seatbelt's deny-file-write* profile govern
573:     // every promised file effect by construction, so their passing probes
574:     // are always full enforcement; the Landlock launcher's probe report
575:     // distinguishes full from per-ABI-partial, while windows-acl is always
576:     // partial for its documented hard-link, unconfined-read, and
577:     // AppContainer-ACL boundaries.
578:     switch (runner) {
579:       case 'bwrap': {
580:         const probe = this.internals.probeBwrap ?? (() => defaultProbeBwrap(this.probeTimeoutMs))
581:         return probe() ? 'full' : 'unusable'
582:       }
583:       case 'landlock': {
584:         const probe = this.internals.probeLandlock ?? (launcher => defaultProbeLandlock(launcher, { timeoutMs: this.probeTimeoutMs }))
585:         return probe(this.landlockLauncher())
586:       }
587:       case 'seatbelt': {
588:         const probe = this.internals.probeSeatbelt ?? (exec => defaultProbeSeatbelt(exec, this.probeTimeoutMs))
589:         return probe(this.seatbeltExec()) ? 'full' : 'unusable'
590:       }
591:       case 'windows-acl': {
592:         const probe = this.internals.probeWindowsAcl
593:           ?? (() => defaultProbeWindowsAcl(this.windowsAclRunnerInvocation(), this.probeTimeoutMs))
594:         return probe() ? 'partial' : 'unusable'
595:       }
596:       default: return assertNever(runner)
597:     }
598:   }
599: 
600:   /** The Landlock launcher to probe and exec (test hook over the resolved one). */
601:   private landlockLauncher(): string {
602:     return this.internals.landlockLauncher ?? landlockLauncherPath()
603:   }
604: 
605:   /** The `sandbox-exec` executable to probe and exec (test hook over the system one). */
606:   private seatbeltExec(): string {
607:     return this.internals.seatbeltExec ?? 'sandbox-exec'
608:   }
609: 
610:   /**
611:    * The windows-acl runner argv prefix: the built lib/runner.js entry when
612:    * present (production), else the package source through tsx (development).
613:    * Pin the source loader and TypeScript paths to this installation, independently
614:    * of target cwd or environment overrides.
615:    * The prefix stays `[node, runner, ...]` — a future native-exe runner keeps
616:    * the same argv contract and only swaps these entries.
617:    */
618:   private windowsAclRunnerInvocation(): string[] {
619:     const override = this.internals.windowsAclRunnerArgs
620:     if (override !== undefined) return override
621:     const builtEntry = this.internals.windowsAclRunnerEntry ?? resolveModulePath('@deepseek-ai/dsh-sandbox-windows-acl/runner')
622:     if (existsSync(builtEntry)) return [process.execPath, builtEntry]
623:     const sourceEntry = fileURLToPath(new URL('../../sandbox-windows-acl/src/runner.ts', import.meta.url))
624:     const sourceConfig = fileURLToPath(new URL('../../../../tsconfig.base.json', import.meta.url))
625:     const registration = `import { register } from ${JSON.stringify(resolveModuleUrl('tsx/esm/api'))}; register({ tsconfig: ${JSON.stringify(sourceConfig)} });`
626:     return [process.execPath, '--import', `data:text/javascript,${encodeURIComponent(registration)}`, sourceEntry]
627:   }
628: }
