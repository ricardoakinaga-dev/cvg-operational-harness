35: /** Preserve execution-world spelling; enforcing providers resolve filesystem identity on their host. */
36: function resolveWorkspaceRoot(path: string): string {
37:   if (!isAbsolute(path)) throw new Error('sandbox-policy: workspace root must be an absolute execution-world path')
38:   return path
39: }
40: 
41: /** Render the policy without claiming which capabilities are mounted. */
42: function renderPolicyContext(policy: SandboxExecutionPolicy): string {
43:   switch (policy.mode) {
44:     case 'read-only':
45:       return 'Current DSH file policy: read-only. Any available operation enforced by the DSH file sandbox cannot modify files in the standing mode. Do not refuse a required modification from this policy alone: try an available tool normally and follow any denial and escalation guidance it returns.'
46:     case 'workspace-write':
47:       return `Current DSH file policy: workspace-write. Any available operation enforced by the DSH file sandbox may modify files under the session workspace: ${JSON.stringify(policy.workspaceRoot)}. Some platform temporary areas may also be writable.`
48:     case 'danger-full-access':
49:       return 'Current DSH file policy: danger-full-access. The DSH file sandbox does not restrict file modifications by available operations.'
50:     /*! v8 ignore next 4 -- SandboxMode is a typed same-process closed union; this branch is only the static exhaustiveness guard. */
51:     default: {
52:       const mode: never = policy.mode
53:       throw new Error(`unreachable sandbox mode: ${String(mode)}`)
54:     }
55:   }
56: }
57: 
58: /** Explain only provider-declared facts; namespace IDs depend on the Host runner installation. */
59: function renderEnvironment(environment: SandboxExecutionEnvironment): string {
60:   const parts = [`Process sandbox runner: ${environment.runner}; enforcement: ${environment.enforcement}.`]
61:   switch (environment.temporaryFiles) {
62:     case 'per-call': parts.push('Process temporary files are private to each command and do not survive into the next command. Use the workspace for files exchanged between commands or filesystem tools.'); break
63:     case 'per-session': parts.push('Process temporary files are private to this session.'); break
64:     case 'host': parts.push('Process temporary paths use the Host filesystem.'); break
65:     case 'unknown': parts.push('The runner does not declare temporary-file sharing or persistence.'); break
66:   }
67:   if (environment.sharesHostTemporaryFiles === false) parts.push('Process temporary files are not the Host temporary files seen by ordinary filesystem tools.')
68:   if (environment.identity === 'namespace-dependent') parts.push('UID and GID visibility depends on the runner user namespace. Host root ownership and supplementary groups may be unmapped; do not assume Host identity checks or chown behave identically.')
69:   if (environment.identity === 'restricted-token') parts.push('Processes use a restricted Windows token.')
70:   return parts.join(' ')
71: }
