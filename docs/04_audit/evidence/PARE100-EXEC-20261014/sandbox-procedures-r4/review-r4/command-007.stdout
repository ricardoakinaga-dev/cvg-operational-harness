86: /**
87:  * Plugin config: the deployment's sandbox default. All optional — `Config`
88:  * supplies the defaults (`mode: 'read-only'` is the fail-safe default; a
89:  * deployment that wants a workspace-writable agent opts in explicitly). The
90:  * runner choice is NOT here (it is the `ctx.sandbox` provider's config), nor
91:  * is any per-family knob: this is the one shared policy home.
92:  */
93: export interface Config {
94:   /** File-sandbox mode a session starts from (default: `read-only`). */
95:   mode?: SandboxMode
96:   /**
97:    * Absolute fallback root for agentless calls and sessions without a cwd (default:
98:    * `process.cwd()`). Normal agent calls use their session cwd instead.
99:    */
100:   workspaceRoot?: string
101: }
102: 
103: /** Inputs that select the sandbox policy for one capability call. */
104: export interface SandboxPolicyRequest {
105:   /** Calling session; its immutable cwd becomes the workspace boundary. */
106:   session?: Session
107:   /** Explicit approved mode override, which outranks session policy. */
108:   mode?: SandboxMode
109: }
110: 
111: /** The sandbox-mode projection's state schema (state equals the public shape). */
112: const sandboxModeStateSchema = zod.union([
113:   zod.literal('read-only'),
114:   zod.literal('workspace-write'),
115:   zod.literal('danger-full-access'),
116: ]).nullable()
117: 
118: type SandboxModeState = zod.infer<typeof sandboxModeStateSchema>
119: declare module '@deepseek-ai/dsh-session-projection/types' {
120:   interface SessionProjectionStateMap {
121:     /** Last logged sandbox-mode override, or null before one (deployment default applies at resolve time). */
122:     sandboxMode: SandboxModeState
123:   }
124: }
125: 
126: /**
127:  * The sandbox-policy service (`ctx.sandboxPolicy`). Owns the deployment
128:  * default mode, fallback workspace root, and current request-time policy
129:  * section. Tool layers call {@link resolve} for each execution so a session's
130:  * mode log and immutable cwd travel together to every enforcing capability.
131:  */
132: export class SandboxPolicyService extends Service {
133:   // Inline schema call: the config catalog walks `static Config` statically.
134:   static Config: z<Config> = z.object({
135:     mode: z.union(['read-only', 'workspace-write', 'danger-full-access'] as const).default('read-only'),
136:     // No schema default: process.cwd() is resolved in the constructor so the
137:     // stored root is always absolute regardless of how it was supplied.
138:     workspaceRoot: z.string(),
139:   })
140: 
141:   static inject = ['sessionProjections']
142: 
143:   /** The deployment default mode — the fallback beneath a session override. */
144:   readonly defaultMode: SandboxMode
145:   /** The absolute `workspace-write` fallback root for calls without a session cwd. */
146:   readonly workspaceRoot: string
147:   private readonly environments = new WeakMap<Session, string>()
148:   constructor(ctx: Context, config: Config) {
149:     super(ctx, 'sandboxPolicy')
150:     // schemastery (static Config) already filled `mode`; the cast records that
151:     // runtime fact. `workspaceRoot` has NO schema default, so its fallback to
152:     // the process cwd is real branching, resolved absolute either way.
153:     this.defaultMode = config.mode as SandboxMode
154:     this.workspaceRoot = resolveWorkspaceRoot(config.workspaceRoot ?? process.cwd())
155: 
156:     ctx.sessionProjections.register({
157:       key: 'sandboxMode',
158:       stateVersion: 1,
159:       stateSchema: sandboxModeStateSchema,
160:       init: () => null,
161:       apply: (state, event) => (event.type === 'sandbox/mode' ? event.data.mode : state),
162:     })
163: 
164:     ctx.inject(['systemPrompt'], (scope: Context) => {
165:       scope.systemPrompt.context({
166:         name: 'sandbox:policy',
167:         order: scope.systemPrompt.getContextOrder('SANDBOX_POLICY'),
168:         text: (context) => {
169:           const session = context.agent?.session
170:           if (session === undefined) return ''
171:           const policy = this.resolve({ session })
172:           const text = renderPolicyContext(policy)
173:           if (policy.mode === 'danger-full-access') return text
174:           const environment = scope.get('sandbox')?.describe({ ...policy, mode: policy.mode })
175:           if (environment === undefined) return text
176:           const data = { mode: policy.mode, environment }
177:           const key = JSON.stringify(data)
178:           if (this.environments.get(session) !== key) {
179:             session.append('sandbox/environment', data)
180:             this.environments.set(session, key)
181:           }
182:           return `${text}\n${renderEnvironment(environment)}`
183:         },
184:       })
185:     })
186:   }
187: 
188:   /**
189:    * Resolve the complete policy for one capability call. An approved explicit
190:    * mode outranks the session's last `sandbox/mode` event, which outranks the
191:    * deployment default. A session cwd is its workspace-write boundary; the
192:    * configured root is the fallback for agentless calls and sessions without a
193:    * cwd.
194:    * @param request - optional session and approved mode override.
195:    * @returns the fully resolved per-call mode and absolute workspace root.
196:    */
197:   resolve(request: SandboxPolicyRequest = {}): SandboxExecutionPolicy {
198:     const { session } = request
199:     return {
200:       mode: request.mode ?? (session === undefined ? undefined : this.overrideOf(session)) ?? this.defaultMode,
201:       workspaceRoot: resolveWorkspaceRoot(session?.header.cwd ?? this.workspaceRoot),
202:       ...session === undefined ? {} : { sessionId: session.id },
203:     }
204:   }
205: 
206:   /**
207:    * Read the session override without applying the deployment default.
208:    * @param session - session whose log supplies the override.
209:    * @returns the last logged mode, or `undefined` without one.
210:    */
211:   overrideOf(session: Session): SandboxMode | undefined {
212:     return this.ctx.sessionProjections.stateOf(session, 'sandboxMode') ?? undefined
213:   }
214: }
215: 
216: export default SandboxPolicyService
FILE reference/packages/sandbox/sandbox-policy/src/session-mode.ts
1: /**
2:  * Per-session sandbox-mode override: the session log as the store. A runtime
3:  * switch (a UI policy control or test scenario) is recorded as one
4:  * `sandbox/mode` event on the session it applies to;
5:  * `effective = projection state ?? the deployment default`, so an override
6:  * survives restart by replay, two sessions can never see each other's state,
7:  * and there is no external config store. The event is log-only (the
8:  * `approval/*` precedent): the policy owner projects the fold into each model
9:  * request, while enforcing tools report operation-specific boundary markers.
10:  * EXECUTION honors the same fold through `ctx.sandboxPolicy.resolve()` — it
11:  * stamps the mode together with the calling session's workspace root onto each
12:  * capability call, weakest-precedence beneath an escalation grant.
13:  *
14:  * The override is policy state shared by every enforcing family (bash and
15:  * filesystem alike), so it lives here in the policy package rather than in any
16:  * one capability's seam.
17:  *
18:  * @module dsh-sandbox-policy/session-mode
19:  */
20: 
21: import type { Session } from '@deepseek-ai/dsh-session'
22: import type { SandboxMode } from '@deepseek-ai/dsh-sandbox'
23: 
24: declare module '@deepseek-ai/dsh-session/types' {
25:   interface SessionEventMap {
26:     /**
27:      * The session's sandbox mode was switched — log-only (like `approval/*`;
28:      * NOT a surface event, carries no `surfaceOp`): durable and replayable,
29:      * never in the model transcript. The LAST such event is the session's
30:      * override (folded by the sandboxMode projection unit). `source: 'delegation'` marks
31:      * an override seeded into a child; an absent source is a runtime switch.
32:      */
33:     'sandbox/mode': {
34:       mode: SandboxMode
35:       /** Marks an override seeded into a child at delegation. */
36:       source?: 'delegation'
37:     }
38:   }
39: }
40: 
41: /** Every {@link SandboxMode}, for option advertisement and runtime validation of untrusted mode strings. */
42: export const SANDBOX_MODES: readonly SandboxMode[] = ['read-only', 'workspace-write', 'danger-full-access']
43: 
44: /**
45:  * THE write path for a session's sandbox-mode override: appends exactly one
46:  * `sandbox/mode` event — the switch IS its event; nothing mutates mode state
47:  * out of band. Takes effect on the session's next confined call (bash or fs)
48:  * — consumers read the shared projection state.
49:  * @param session - the session the override belongs to.
50:  * @param mode - the mode every subsequent confined call in this session runs
51:  *   under (until the next switch).
52:  */
53: export function setSandboxMode(session: Session, mode: SandboxMode): void {
54:   session.append('sandbox/mode', { mode })
55: }
