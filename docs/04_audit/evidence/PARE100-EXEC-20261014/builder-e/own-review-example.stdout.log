import { spawn, type ChildProcessWithoutNullStreams } from 'node:child_process'
import { fileURLToPath } from 'node:url'
import { createSdkClient, createStdioSdkTransport } from '@cvg/sdk'

function waitForExit(
  child: ChildProcessWithoutNullStreams,
  ms: number
): Promise<boolean> {
  if (
    (child.exitCode !== null || child.signalCode !== null) &&
    child.stdin.closed &&
    child.stdout.closed &&
    child.stderr.closed
  )
    return Promise.resolve(true)
  return new Promise((resolve) => {
    const done = (exited: boolean) => {
      clearTimeout(timer)
      child.off('close', exit)
      resolve(exited)
    }
    const exit = () => done(true)
    const timer = setTimeout(() => done(false), ms)
    // close follows exit and the child's stdio handle closure.
    child.once('close', exit)
  })
}

/** Owns only this child; bounded drain, TERM and KILL, with confirmed exit. */
export async function shutdownSdkChild(
  child: ChildProcessWithoutNullStreams
): Promise<void> {
  child.stdin.end()
  if (!(await waitForExit(child, 1000))) {
    child.kill('SIGTERM')
    if (!(await waitForExit(child, 500))) {
      child.kill('SIGKILL')
      if (!(await waitForExit(child, 250)))
        throw new Error('SDK example child did not exit')
    }
  }
  child.stdin.destroy()
  child.stdout.destroy()
  child.stderr.destroy()
  if (
    (child.exitCode === null && child.signalCode === null) ||
    !child.stdin.closed ||
    !child.stdout.closed ||
    !child.stderr.closed
  )
    throw new Error('SDK example child shutdown was not confirmed')
}

export async function runSdkStdioExample() {
  const source = import.meta.url.endsWith('.mts')
  const child = spawn(
    process.execPath,
    [
      ...(source ? ['--import', 'tsx'] : []),
      fileURLToPath(
        new URL(source ? './child.mts' : './child.mjs', import.meta.url)
      )
    ],
    { stdio: ['pipe', 'pipe', 'pipe'] }
  )
  child.on('error', () => {})
  for (const stream of [child.stdin, child.stdout, child.stderr])
    stream.on('error', () => {})
  // Fixed host logs are consumed on stderr; stdout belongs exclusively to wire.
  let stderr = ''
  child.stderr.on('data', (chunk: Buffer) => {
    if (stderr.length < 4096)
      stderr += chunk.toString('utf8').slice(0, 4096 - stderr.length)
  })
  const transport = createStdioSdkTransport({
    input: child.stdout,
    output: child.stdin,
    expectedTenantId: 'sdk_stdio_synthetic',
    requestTimeoutMs: 5000
  })
  try {
    const client = createSdkClient(transport)
    const hello = await client.hello()
    const session = await client.openSession('stdio_session')
    const turn = await client.sendTurn('Olá 🌿', session.sessionId)
    const events = await client.readEvents(session.sessionId)
    return { hello, session, turn, events, stderr }
  } finally {
    await transport.close()
    await shutdownSdkChild(child)
  }
}
/** Synthetic child host: only public CVG roots, no provider or external effect. */
import { createSdk, serveStdioSdk } from '@cvg/sdk'

let event = 0
const sdk = createSdk({
  tenantId: 'sdk_stdio_synthetic',
  modelGateway: {
    complete: async () => ({
      text: 'Resposta sintética stdio: olá 🌿.',
      provider: 'deterministic',
      model: 'keyless-v1',
      inputTokens: 3,
      outputTokens: 4,
      costUsd: 0
    })
  },
  policy: {
    evaluate: async () => ({
      outcome: 'ALLOW',
      reason: 'synthetic',
      policyVersion: 'v1'
    })
  },
  approvals: {
    request: async () => ({
      status: 'DENIED',
      reason: 'synthetic effects disabled'
    })
  },
  clock: () => new Date('2026-10-14T00:00:00.000Z'),
  newEventId: () => `stdio_event_${++event}`,
  newCorrelationId: () => 'stdio_correlation',
  newTraceId: () => 'stdio_trace'
})

// The host owns streams and keeps error listeners after adapter detachment.
process.stdin.on('error', () => {})
process.stdout.on('error', () => {})
process.stderr.on('error', () => {})
const serving = serveStdioSdk({
  input: process.stdin,
  output: process.stdout,
  server: sdk.server,
  onError: ({ kind, code }) => {
    process.stderr.write(`sdk-stdio:${kind}:${code}\n`)
  }
})
process.stderr.write('sdk-stdio-ready\n')
const terminate = () => {
  void serving.close()
}
process.on('SIGTERM', terminate)
await serving.closed
process.off('SIGTERM', terminate)
process.stdin.destroy()
process.stdout.end()
