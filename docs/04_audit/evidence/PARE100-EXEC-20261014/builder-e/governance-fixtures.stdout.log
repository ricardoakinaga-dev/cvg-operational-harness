  readonly observe?: Phase3ToolObserver
}): ToolRegistry {
  const availabilityTool: ToolDefinition = {
    id: PHASE3_TOOL_AVAILABILITY,
    version: 'v1',
    description: 'Checks the synthetic resource availability.',
    inputSchema: { type: 'object' },
