import type { SessionEvent } from '@cvg/harness-contracts'

/**
 * PDSH-023 / SPEC 0204: versioned JSON-RPC 2.0 protocol for integrator SDKs.
 * The transport is always supplied by the host; this package only defines the
 * envelope, the method vocabulary and the stable error codes.
 */

export const SDK_PROTOCOL_VERSION = 1

export const SDK_METHODS = [
  'sdk.hello',
  'session.open',
  'turn.send',
  'session.events'
] as const
export type SdkMethod = (typeof SDK_METHODS)[number]

export const SDK_ERROR_CODES = {
  parse_error: -32700,
  invalid_request: -32600,
  method_not_found: -32601,
  invalid_params: -32602,
  internal_error: -32603,
  unsupported_protocol_version: 1001,
  session_not_found: 1002,
  capability_not_available: 1003
} as const
export type SdkErrorCode =
  (typeof SDK_ERROR_CODES)[keyof typeof SDK_ERROR_CODES]

export interface JsonRpcRequest {
  readonly jsonrpc: '2.0'
  readonly id: string | number
  readonly method: string
  readonly params?: unknown
}

export interface JsonRpcSuccess {
  readonly jsonrpc: '2.0'
  readonly id: string | number
  readonly result: unknown
}

export interface JsonRpcFailure {
  readonly jsonrpc: '2.0'
  readonly id: string | number | null
  readonly error: {
    readonly code: number
    readonly message: string
    readonly data?: unknown
  }
}

export type JsonRpcResponse = JsonRpcSuccess | JsonRpcFailure

/** Method vocabulary this server actually registers in the composition. */
export interface SdkCapabilities {
  readonly sessions: boolean
  readonly events: boolean
  readonly methods: readonly SdkMethod[]
}

export interface SdkHelloParams {
  readonly protocolVersion: number
}

export interface SdkHelloResult {
  readonly protocolVersion: number
  readonly capabilities: SdkCapabilities
}

export interface SessionOpenParams {
  readonly sessionId: string
}

export interface SessionOpenResult {
  readonly sessionId: string
  readonly formatVersion: 1
}

export interface TurnSendParams {
  readonly sessionId?: string
  readonly userMessage: string
}

export interface TurnSendResult {
  readonly stopReason: string
  readonly response: string
  readonly modelCalls: number
  readonly toolCalls: number
  readonly usage: {
    readonly inputTokens: number
    readonly outputTokens: number
    readonly costUsd: number
  }
  readonly sessionId?: string
}

export interface SessionEventsParams {
  readonly sessionId: string
  readonly afterSequence?: number
  readonly limit?: number
}

export interface SessionEventsResult {
  readonly events: readonly SessionEvent[]
}
import type { SessionEvent } from '@cvg/harness-contracts'
import {
  SDK_PROTOCOL_VERSION,
  type JsonRpcRequest,
  type JsonRpcResponse,
  type SdkHelloResult,
  type SessionEventsResult,
  type SessionOpenResult,
  type TurnSendResult
} from './protocol.ts'
import type { SdkServer } from './server.ts'

/** Host-owned transport; this package never opens a socket itself. */
export interface SdkTransport {
  request(request: JsonRpcRequest): Promise<JsonRpcResponse>
}

export class SdkClientError extends Error {
  readonly code: number
  readonly data: unknown

  constructor(code: number, message: string, data?: unknown) {
    super(message)
    this.name = 'SdkClientError'
    this.code = code
    this.data = data
  }
}

export interface SdkReadEventsOptions {
  readonly afterSequence?: number
  readonly limit?: number
}

export interface SdkClient {
  readonly protocolVersion: number
  hello(): Promise<SdkHelloResult>
  openSession(sessionId: string): Promise<SessionOpenResult>
  sendTurn(userMessage: string, sessionId?: string): Promise<TurnSendResult>
  readEvents(
    sessionId: string,
    options?: SdkReadEventsOptions
  ): Promise<readonly SessionEvent[]>
}

export function createInProcessTransport(server: SdkServer): SdkTransport {
  return { request: (request) => server.dispatch(request) }
}

export function createSdkClient(transport: SdkTransport): SdkClient {
  let nextRequestId = 1
  async function call(method: string, params?: unknown): Promise<unknown> {
    const request: JsonRpcRequest = {
      jsonrpc: '2.0',
      id: nextRequestId++,
      method,
      ...(params !== undefined ? { params } : {})
    }
    const response = await transport.request(request)
    if ('error' in response) {
      throw new SdkClientError(
        response.error.code,
        response.error.message,
        response.error.data
      )
    }
    return response.result
  }
  return {
    protocolVersion: SDK_PROTOCOL_VERSION,
    hello: async () =>
      (await call('sdk.hello', {
        protocolVersion: SDK_PROTOCOL_VERSION
      })) as SdkHelloResult,
    openSession: async (sessionId) =>
      (await call('session.open', { sessionId })) as SessionOpenResult,
    sendTurn: async (userMessage, sessionId) =>
      (await call('turn.send', {
        ...(sessionId !== undefined ? { sessionId } : {}),
        userMessage
      })) as TurnSendResult,
    readEvents: async (sessionId, options = {}) => {
      const result = (await call('session.events', {
        sessionId,
        ...options
      })) as SessionEventsResult
      return result.events
    }
  }
}
import { randomUUID } from 'node:crypto'
import {
  SessionEventError,
  createOperationalHarness,
  createSessionKernelLog
} from '@cvg/harness'
import type {
  AgentProfile,
  ApprovalEngine,
  AuditSink,
  ConversationId,
  CorrelationId,
  ExecutionBudget,
  ModelGateway,
  PolicyEngine,
  RuntimeInput,
  RuntimeResult,
  SessionEvent,
  SessionEventStore,
  SessionId,
  TelemetrySink,
  TenantId,
  ToolRegistry,
  TraceId
} from '@cvg/harness-contracts'
import {
  SDK_ERROR_CODES,
  SDK_METHODS,
  SDK_PROTOCOL_VERSION,
  type JsonRpcFailure,
  type JsonRpcResponse,
  type JsonRpcSuccess,
  type SdkCapabilities
} from './protocol.ts'

/** Deterministic fallback budget for one SDK turn. */
export const SDK_DEFAULT_BUDGET: ExecutionBudget = {
  maxSteps: 4,
  maxModelCalls: 2,
  maxToolCalls: 2,
  maxDurationMs: 30_000,
  maxCostUsd: 1,
  maxTokens: 4_000
}

const NOOP_AUDIT: AuditSink = { append: async () => {} }
const NOOP_TELEMETRY: TelemetrySink = { record: () => {} }
const EMPTY_TOOLS: ToolRegistry = { list: () => [], resolve: () => undefined }

const MAX_ID_LENGTH = 200
const MAX_MESSAGE_BYTES = 64 * 1024

export interface SdkServerOptions {
  /** Trusted composition binding; never taken from the request. */
  readonly tenantId: string
  /** Default agent profile; branded fields are completed by the server. */
  readonly agent?: Partial<AgentProfile>
  readonly modelGateway: ModelGateway
  /** Governance stays visible: policy and approvals are required. */
  readonly policy: PolicyEngine
  readonly approvals: ApprovalEngine
  readonly tools?: ToolRegistry
  readonly audit?: AuditSink
  readonly telemetry?: TelemetrySink
  /** Enables `session.open`/`session.events` when provided. */
  readonly sessions?: SessionEventStore
  readonly budget?: ExecutionBudget
  readonly clock?: () => Date
  readonly newEventId?: () => string
  readonly newCorrelationId?: () => string
  readonly newTraceId?: () => string
}

export interface SdkServer {
  readonly capabilities: SdkCapabilities
  /** Never rejects: every failure becomes a JSON-RPC error response. */
  dispatch(payload: unknown): Promise<JsonRpcResponse>
}

class SdkRequestError extends Error {
  readonly code: number

  constructor(code: number, message: string) {
    super(message)
    this.name = 'SdkRequestError'
    this.code = code
  }
}

function asRecord(value: unknown): Record<string, unknown> | undefined {
  if (typeof value !== 'object' || value === null || Array.isArray(value)) {
    return undefined
  }
  return value as Record<string, unknown>
}

function validId(value: unknown): value is string {
  return (
    typeof value === 'string' &&
    value.trim().length > 0 &&
    value.length <= MAX_ID_LENGTH &&
    !value.includes('\u0000')
  )
}

export function createSdkServer(options: SdkServerOptions): SdkServer {
  if (!validId(options.tenantId)) {
    throw new Error('SDK composition requires a tenantId (1..200 chars)')
  }
  const clock = options.clock ?? (() => new Date())
  const newEventId = options.newEventId ?? randomUUID
  const newCorrelationId =
    options.newCorrelationId ?? (() => `sdk_correlation_${randomUUID()}`)
  const newTraceId = options.newTraceId ?? (() => `sdk_trace_${randomUUID()}`)
  const sessions = options.sessions
  const budget = options.budget ?? SDK_DEFAULT_BUDGET
  const tools = options.tools ?? EMPTY_TOOLS
  const audit = options.audit ?? NOOP_AUDIT
  const telemetry = options.telemetry ?? NOOP_TELEMETRY
  const agent = {
    id: 'sdk-agent',
    version: 'v1',
    objective: 'Answer the caller through the governed harness.',
    instructions: [],
    skills: [],
    tools: [],
    policies: [],
    ...options.agent
  } as AgentProfile
  const capabilities: SdkCapabilities = {
    sessions: sessions !== undefined,
    events: sessions !== undefined,
    methods:
      sessions !== undefined
        ? SDK_METHODS
        : SDK_METHODS.filter(
            (method) => method === 'sdk.hello' || method === 'turn.send'
          )
  }

  function requestError(code: number, message: string): SdkRequestError {
    return new SdkRequestError(code, message)
  }

  function mapSessionError(error: unknown): SdkRequestError {
    if (error instanceof SessionEventError) {
      switch (error.code) {
        case 'session_not_open':
          return requestError(
            SDK_ERROR_CODES.session_not_found,
            'Session is not open'
          )
        case 'invalid_session_event':
          return requestError(SDK_ERROR_CODES.invalid_params, error.message)
        default:
          return requestError(SDK_ERROR_CODES.internal_error, error.message)
      }
    }
    return requestError(SDK_ERROR_CODES.internal_error, 'Session store failed')
  }

  async function handleHello(params: unknown): Promise<unknown> {
    const record = asRecord(params)
    if (!record || typeof record.protocolVersion !== 'number') {
      throw requestError(
        SDK_ERROR_CODES.invalid_params,
        'sdk.hello requires a numeric protocolVersion'
      )
    }
    if (record.protocolVersion !== SDK_PROTOCOL_VERSION) {
      throw requestError(
        SDK_ERROR_CODES.unsupported_protocol_version,
        `Unsupported protocol version ${record.protocolVersion}`
      )
    }
    return { protocolVersion: SDK_PROTOCOL_VERSION, capabilities }
  }

  async function handleOpenSession(params: unknown): Promise<unknown> {
    if (sessions === undefined) {
      throw requestError(
        SDK_ERROR_CODES.capability_not_available,
        'session.open requires a composition with sessions'
      )
    }
    const record = asRecord(params)
    const sessionId = record?.sessionId
    if (!validId(sessionId)) {
      throw requestError(
        SDK_ERROR_CODES.invalid_params,
        'session.open requires sessionId (1..200 chars)'
      )
    }
    try {
      await sessions.openSession({
        tenantId: options.tenantId,
        sessionId,
        formatVersion: 1
      })
    } catch (error) {
      throw mapSessionError(error)
    }
    return { sessionId, formatVersion: 1 }
  }

  async function handleTurnSend(params: unknown): Promise<unknown> {
    const record = asRecord(params)
    const userMessage = record?.userMessage
    if (
      typeof userMessage !== 'string' ||
      userMessage.trim().length === 0 ||
      Buffer.byteLength(userMessage, 'utf8') > MAX_MESSAGE_BYTES
    ) {
      throw requestError(
        SDK_ERROR_CODES.invalid_params,
        'turn.send requires userMessage (up to 64 KiB)'
      )
    }
    const rawSessionId = record?.sessionId
    if (rawSessionId !== undefined && !validId(rawSessionId)) {
      throw requestError(
        SDK_ERROR_CODES.invalid_params,
        'turn.send sessionId must be a non-empty string'
      )
    }
    if (sessions !== undefined && rawSessionId === undefined) {
      throw requestError(
        SDK_ERROR_CODES.invalid_params,
        'turn.send requires sessionId when sessions are enabled'
      )
    }
    const sessionId =
      typeof rawSessionId === 'string' ? rawSessionId : undefined
    const correlationId = newCorrelationId()
    const traceId = newTraceId()
    const timestamp = clock().toISOString()
    if (sessions !== undefined && sessionId !== undefined) {
      try {
        await sessions.append({
          tenantId: options.tenantId,
          sessionId,
          formatVersion: 1,
          eventId: newEventId(),
          timestamp,
          correlationId,
          traceId,
          type: 'message/user',
          payload: { text: userMessage }
        })
      } catch (error) {
        throw mapSessionError(error)
      }
    }
    const log =
      sessions !== undefined && sessionId !== undefined
        ? createSessionKernelLog({
            store: sessions,
            tenantId: options.tenantId,
            sessionId,
            formatVersion: 1,
            traceId,
            correlationId,
            eventId: newEventId,
            clock
          })
        : undefined
    const harness = createOperationalHarness({
      modelGateway: options.modelGateway,
      policy: options.policy,
      approvals: options.approvals,
      tools,
      audit,
      telemetry,
      ...(log !== undefined ? { log } : {})
    })
    const input: RuntimeInput = {
      agent,
      tenantId: options.tenantId as TenantId,
      conversationId: (sessionId ??
        `sdk_conversation_${correlationId}`) as ConversationId,
      sessionId: (sessionId ?? `sdk_session_${correlationId}`) as SessionId,
      correlationId: correlationId as CorrelationId,
      traceId: traceId as TraceId,
      userMessage,
      context: { values: {}, sourceIds: [], capturedAt: timestamp },
      state: { version: 0, values: {}, updatedAt: timestamp },
      budget,
      runtimeProfile: 'single_pass'
    }
    let result: RuntimeResult
    try {
      result = await harness.execute(input)
    } catch {
      throw requestError(SDK_ERROR_CODES.internal_error, 'Runtime failed')
    }
    if (
      sessions !== undefined &&
      sessionId !== undefined &&
      result.stopReason === 'COMPLETED'
    ) {
      try {
        await sessions.append({
          tenantId: options.tenantId,
          sessionId,
          formatVersion: 1,
          eventId: newEventId(),
          timestamp: clock().toISOString(),
          correlationId,
          traceId,
          type: 'message/assistant',
          payload: { text: result.response }
        })
      } catch (error) {
        throw mapSessionError(error)
      }
    }
    return {
      stopReason: result.stopReason,
      response: result.response,
      modelCalls: result.modelCalls,
      toolCalls: result.toolCalls,
      usage: result.usage,
      ...(sessionId !== undefined ? { sessionId } : {})
    }
  }

  async function handleSessionEvents(params: unknown): Promise<unknown> {
    if (sessions === undefined) {
      throw requestError(
        SDK_ERROR_CODES.capability_not_available,
        'session.events requires a composition with sessions'
      )
    }
    const record = asRecord(params)
    const sessionId = record?.sessionId
    if (!validId(sessionId)) {
      throw requestError(
        SDK_ERROR_CODES.invalid_params,
        'session.events requires sessionId (1..200 chars)'
      )
    }
    const afterSequence = record?.afterSequence ?? 0
    const limit = record?.limit ?? 100
    if (
      typeof afterSequence !== 'number' ||
      !Number.isSafeInteger(afterSequence) ||
      afterSequence < 0 ||
      typeof limit !== 'number' ||
      !Number.isSafeInteger(limit) ||
      limit < 1 ||
      limit > 500
    ) {
      throw requestError(
        SDK_ERROR_CODES.invalid_params,
        'session.events accepts afterSequence >= 0 and limit 1..500'
      )
    }
    let events: readonly SessionEvent[]
    try {
      events = await sessions.read({
        tenantId: options.tenantId,
        sessionId,
        afterSequence,
        limit
      })
    } catch (error) {
      throw mapSessionError(error)
    }
    return { events }
  }

  function success(id: string | number, result: unknown): JsonRpcSuccess {
    return { jsonrpc: '2.0', id, result }
  }

  function failure(
    id: string | number | null,
    code: number,
    message: string
  ): JsonRpcFailure {
    return { jsonrpc: '2.0', id, error: { code, message } }
  }

  return {
    capabilities,
    async dispatch(payload: unknown): Promise<JsonRpcResponse> {
      const record = asRecord(payload)
      const id =
        record &&
        (typeof record.id === 'string' || typeof record.id === 'number')
          ? record.id
          : null
      if (
        !record ||
        record.jsonrpc !== '2.0' ||
        typeof record.method !== 'string' ||
        record.method.length === 0 ||
        id === null
      ) {
        return failure(
          id,
          SDK_ERROR_CODES.invalid_request,
          'Invalid JSON-RPC request'
        )
      }
      const handlers: Record<string, (params: unknown) => Promise<unknown>> = {
        'sdk.hello': handleHello,
        'session.open': handleOpenSession,
        'turn.send': handleTurnSend,
        'session.events': handleSessionEvents
      }
      const handler = handlers[record.method]
      if (!handler) {
        return failure(
          id,
          SDK_ERROR_CODES.method_not_found,
          `Unknown method ${record.method}`
        )
      }
      try {
        return success(id, await handler(record.params))
      } catch (error) {
        if (error instanceof SdkRequestError) {
          return failure(id, error.code, error.message)
        }
        return failure(
          id,
          SDK_ERROR_CODES.internal_error,
          error instanceof Error ? error.message : 'Internal error'
        )
      }
    }
  }
}
import { InMemorySessionEventStore } from '@cvg/harness'
import type { SessionEvent } from '@cvg/harness-contracts'
import {
  createInProcessTransport,
  createSdkClient,
  type SdkClient,
  type SdkReadEventsOptions
} from './client.ts'
import {
  createSdkServer,
  type SdkServer,
  type SdkServerOptions
} from './server.ts'
import type {
  SdkHelloResult,
  SessionOpenResult,
  TurnSendResult
} from './protocol.ts'

export type SdkCompositionOptions = SdkServerOptions

export interface SdkFacade {
  readonly server: SdkServer
  readonly client: SdkClient
  hello(): Promise<SdkHelloResult>
  openSession(sessionId: string): Promise<SessionOpenResult>
  sendTurn(sessionId: string, userMessage: string): Promise<TurnSendResult>
  readEvents(
    sessionId: string,
    options?: SdkReadEventsOptions
  ): Promise<readonly SessionEvent[]>
}

/**
 * Full SDK composition: session events enabled. The store defaults to the
 * in-memory fixture; hosts inject a durable store for multi-process use.
 */
export function createSdk(options: SdkCompositionOptions): SdkFacade {
  const server = createSdkServer({
    ...options,
    sessions: options.sessions ?? new InMemorySessionEventStore()
  })
  const client = createSdkClient(createInProcessTransport(server))
  return {
    server,
    client,
    hello: () => client.hello(),
    openSession: (sessionId) => client.openSession(sessionId),
    sendTurn: (sessionId, userMessage) =>
      client.sendTurn(userMessage, sessionId),
    readEvents: (sessionId, readOptions) =>
      client.readEvents(sessionId, readOptions)
  }
}

/** Session methods are not part of the minimal composition. */
export type SdkMinimalOptions = Omit<SdkServerOptions, 'sessions'>

export interface SdkMinimalFacade {
  readonly server: SdkServer
  readonly client: SdkClient
  hello(): Promise<SdkHelloResult>
  sendTurn(userMessage: string): Promise<TurnSendResult>
}

/** Minimal SDK composition: stateless turns, no session store. */
export function createSdkMinimal(options: SdkMinimalOptions): SdkMinimalFacade {
  const server = createSdkServer(options)
  const client = createSdkClient(createInProcessTransport(server))
  return {
    server,
    client,
    hello: () => client.hello(),
    sendTurn: (userMessage) => client.sendTurn(userMessage)
  }
}
