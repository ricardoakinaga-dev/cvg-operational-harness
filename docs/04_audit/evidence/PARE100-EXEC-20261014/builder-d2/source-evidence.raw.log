222: export function boundedPayload(value: unknown, maxChars: number): unknown {
223:   let serialized: string
224:   try {
225:     serialized = JSON.stringify(value) ?? ''
226:   } catch {
227:     return '[unserializable payload]'
228:   }
229:   if (serialized.length <= maxChars) return value
230:   return `${serialized.slice(0, maxChars)}…[truncated]`
231: }

