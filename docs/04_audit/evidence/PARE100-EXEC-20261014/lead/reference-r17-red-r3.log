      and isinstance(n.value,(ast.List,ast.Tuple))
      and all(isinstance(x,ast.Constant) and isinstance(x.value,str)
        and re.fullmatch(r'[A-Za-z_][A-Za-z0-9_]{0,199}',x.value) for x in n.value.elts))
  def visit(n):
