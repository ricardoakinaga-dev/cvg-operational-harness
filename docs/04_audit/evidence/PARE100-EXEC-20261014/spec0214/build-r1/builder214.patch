+    }
+  })
+  const store = new InMemoryControlPlaneStore()
+  const agent = await store.createAgent(
+    { tenantId },
+    { slug: 'synthetic-214', name: 'Synthetic', description: 'Synthetic only' }
+  )
+  const version = await store.createVersion(
+    { tenantId },
+    agent.id,
