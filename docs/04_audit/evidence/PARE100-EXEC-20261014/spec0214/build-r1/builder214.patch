+      const io = InvocationEvidenceState.prototype.io
+      vi.spyOn(InvocationEvidenceState.prototype, 'io').mockImplementation(
+        function <T>(
+          this: InvocationEvidenceState,
+          observed: string,
+          operation: () => T | PromiseLike<T>,
+          terminal?: boolean
+        ) {
+          return io.call(
+            this,
+            observed,
+            async () => {
