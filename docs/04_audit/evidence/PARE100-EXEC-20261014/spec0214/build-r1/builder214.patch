+      plugin: 'synthetic.second',
+      version: '1.0.0',
+      enabled: true,
+      allowedTools: ['synthetic_second'],
+      config: {}
+    })
+    f.prepared.input.capabilityGateway = new CapabilityGateway(
+      new PluginRegistry([one, two]),
+      { actorAuthorizer: ({ requiredPermission }) => [requiredPermission] }
