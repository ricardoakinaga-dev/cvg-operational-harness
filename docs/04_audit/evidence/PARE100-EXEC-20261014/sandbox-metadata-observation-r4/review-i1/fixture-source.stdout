48:     userMessage: 'phase 3 controlled fixture',
49:     context: {
50:       values: { fixture: 'phase3' },
51:       sourceIds: ['phase3-fixture'],
52:       capturedAt: '2026-09-15T00:00:00.000Z'
53:     },
54:     state: { version: 1, values: {}, updatedAt: '2026-09-15T00:00:00.000Z' },
55:     budget: {
56:       maxSteps: 8,
57:       maxModelCalls: 4,
58:       maxToolCalls: 4,
59:       maxDurationMs: 30_000,
