  1166	    catalog.summary?.entries !== ids.size ||
  1167	    catalog.summary?.sources !== sources.size
  1168	  )
  1169	    fail('INVALID_CATALOG', 'summary denominator')
  1170	  if (root)
  1171	    inspectReference(root, catalog.reference.commit, catalog.reference.version)
  1172	  return {
  1173	    status: 'VALID_STATIC_CATALOG',
  1174	    parity_status: 'NOT_VERIFIED',
  1175	    entries: ids.size,
  1176	    sources: sources.size
  1177	  }
  1178	}
