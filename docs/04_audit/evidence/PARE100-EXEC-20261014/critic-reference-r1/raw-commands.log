  1180	export function compareCatalogFreeze(frozen, current, options = {}) {
  1181	  validateCatalog(frozen)
  1182	  validateCatalog(current, options)
  1183	  if (
  1184	    json(frozen.reference) !== json(current.reference) ||
  1185	    frozen.owner_map_sha256 !== current.owner_map_sha256
  1186	  )
  1187	    fail('REFERENCE_DRIFT', 'root/pin/version/owner map')
  1188	  const currentEntries = new Map(
  1189	    current.entries.map((entry) => [entry.id, entry])
  1190	  )
  1191	  for (const entry of frozen.entries) {
  1192	    const actual = currentEntries.get(entry.id)
  1193	    if (!actual) fail('REQUIREMENT_REMOVED', entry.id)
  1194	    if (json(entry) !== json(actual)) fail('CONTRACT_DRIFT', entry.id)
  1195	  }
  1196	  if (frozen.catalog_sha256 !== current.catalog_sha256)
  1197	    fail('FREEZE_DRIFT', 'sources/additions/metadata changed')
  1198	  return {
  1199	    status: 'UNCHANGED_STATIC_FREEZE',
  1200	    parity_status: 'NOT_VERIFIED',
  1201	    catalog_sha256: current.catalog_sha256
  1202	  }
  1203	}
