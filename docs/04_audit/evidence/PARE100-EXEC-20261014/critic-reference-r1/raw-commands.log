   642	            type_only: node.isTypeOnly
   643	          })
   644	      } else if (ts.isExportAssignment(node)) {
   645	        add('export', `${prefix}default`, {
   646	          value: staticData(node.expression),
   647	          export_equals: node.isExportEquals
   648	        })
   649	      }
   650	    }
   651	  }
   652	  visitStatements(source.statements, context)
   653	  for (const record of [...records.values()].sort((a, b) =>
   654	    `${a.kind}:${a.symbol}`.localeCompare(`${b.kind}:${b.symbol}`, 'en')
   655	  )) {
   656	    record.declarations.sort((a, b) => json(a).localeCompare(json(b), 'en'))
   657	    emit(record.kind, record.symbol, { declarations: record.declarations })
   658	  }
   659	}
