   697	function extractDocument(text, source, add, owners) {
   698	  const lines = text.split('\n')
   699	  // Generated Cordis/config sections place their source link after or before
   700	  // a fence. Resolve ownership for the entire heading independent of order.
   701	  const linkedSources = new Map()
   702	  let scanHeadings = [],
   703	    scanAnchor
