  1065	    reference: { root: ref.root, commit: ref.commit, version: ref.version },
  1066	    owner_map_sha256: hash(
  1067	      json({
  1068	        ...map,
  1069	        package_owners: [...map.package_owners].sort((a, b) =>
  1070	          a.manifest.localeCompare(b.manifest, 'en')
  1071	        ),
  1072	        additional_surfaces: [...map.additional_surfaces].sort((a, b) =>
  1073	          a.reference_path.localeCompare(b.reference_path, 'en')
  1074	        )
  1075	      })
