   514	        else if (node.body && ts.isModuleDeclaration(node.body))
   515	          visitStatements([node.body], next, true)
   516	      } else if (ts.isInterfaceDeclaration(node)) {
   517	        add(
   518	          /config/i.test(node.name.text)
   519	            ? 'config-interface'
   520	            : /event/i.test(node.name.text)
   521	              ? 'event-interface'
   522	              : 'interface',
   523	          symbol,
   524	          {
   525	            visibility: publicDeclaration ? 'PUBLIC' : 'DECLARED',
   526	            type_parameters: (node.typeParameters ?? []).map(printed),
   527	            heritage: (node.heritageClauses ?? []).map(printed)
   528	          }
