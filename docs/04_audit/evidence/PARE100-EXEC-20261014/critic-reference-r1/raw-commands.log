   492	      shape = {
   493	        ...shape,
   494	        name_resolution: unknown(
   495	          'Computed/destructured declaration name requires semantic/runtime review'
   496	        )
   497	      }
   498	    const key = `${kind}:${symbol}`
   499	    const record = records.get(key) ?? { kind, symbol, declarations: [] }
   500	    record.declarations.push(shape)
   501	    records.set(key, record)
   502	  }
