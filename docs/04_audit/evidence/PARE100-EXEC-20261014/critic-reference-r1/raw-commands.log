   105	      encoding: 'utf8',
   106	      env: {
   107	        ...process.env,
   108	        GIT_AUTHOR_NAME: 'Synthetic',
   109	        GIT_AUTHOR_EMAIL: 'fixture@example.invalid',
   110	        GIT_COMMITTER_NAME: 'Synthetic',
   111	        GIT_COMMITTER_EMAIL: 'fixture@example.invalid',
   112	        GIT_AUTHOR_DATE: '2026-10-14T00:00:00Z',
   113	        GIT_COMMITTER_DATE: '2026-10-14T00:00:00Z'
   114	      }
   115	    }).trim()
   116	  run(['init', '-q', '-b', 'main'])
   117	  // Only disposable synthetic object storage: no project/reference git commit.
   118	  run(['add', '--', ...names])
   119	  const tree = run(['write-tree'])
   120	  const commit = run(['commit-tree', tree], 'synthetic static fixture\n')
   121	  run(['update-ref', 'refs/heads/main', commit])
   122	  return commit
   123	}
