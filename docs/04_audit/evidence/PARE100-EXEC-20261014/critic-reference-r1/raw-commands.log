  1205	export function runCli(args) {
  1206	  const options = new Map()
  1207	  const allowed = [
  1208	    '--root',
  1209	    '--commit',
  1210	    '--version',
  1211	    '--owner-map',
  1212	    '--output',
  1213	    '--freeze'
  1214	  ]
  1215	  if (args.length === 1 && args[0] === '--help') {
  1216	    process.stdout.write(
  1217	      'Usage: node scripts/reference-contract-catalog.mjs --root ABSOLUTE --owner-map MAP.json --output CATALOG.json [--commit SHA --version VERSION --freeze CATALOG.json]\nRead-only static collection. Every functional contract stays NOT_VERIFIED.\n'
  1218	    )
  1219	    return
  1220	  }
  1221	  for (let index = 0; index < args.length; index += 2) {
  1222	    if (
  1223	      !allowed.includes(args[index]) ||
  1224	      options.has(args[index]) ||
  1225	      !args[index + 1] ||
  1226	      args[index + 1].startsWith('--')
  1227	    )
  1228	      fail('CLI_ARGUMENT', args[index])
  1229	    options.set(args[index], args[index + 1])
  1230	  }
  1231	  for (const required of ['--root', '--owner-map', '--output'])
  1232	    if (!options.has(required)) fail('CLI_ARGUMENT', `${required} required`)
  1233	  const root = options.get('--root'),
  1234	    output = path.resolve(options.get('--output'))
  1235	  if (sensitive(output) || !output.endsWith('.json'))
  1236	    fail('UNSAFE_JSON_OUTPUT', output)
  1237	  // Output must not mutate the reference, including through an ancestor symlink.
  1238	  let ancestor = path.dirname(output)
  1239	  while (!fs.existsSync(ancestor)) ancestor = path.dirname(ancestor)
  1240	  const realOutput = path.join(
  1241	    fs.realpathSync(ancestor),
  1242	    path.relative(ancestor, output)
  1243	  )
  1244	  const realRoot = fs.realpathSync(root)
