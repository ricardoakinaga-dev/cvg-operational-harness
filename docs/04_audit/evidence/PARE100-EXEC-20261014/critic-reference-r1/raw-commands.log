  1106	export function validateCatalog(catalog, { root } = {}) {
  1107	  if (
  1108	    catalog?.schema_version !== CATALOG_VERSION ||
  1109	    catalog.parity_status !== 'NOT_VERIFIED' ||
  1110	    !Array.isArray(catalog.entries) ||
  1111	    !Array.isArray(catalog.sources) ||
  1112	    !catalog.entries.length ||
  1113	    !catalog.sources.length
  1114	  )
  1115	    fail('INVALID_CATALOG', 'shape/status')
  1116	  if (
  1117	    !catalog.reference ||
  1118	    !path.isAbsolute(catalog.reference.root ?? '') ||
  1119	    !/^[a-f0-9]{40,64}$/.test(catalog.reference.commit ?? '') ||
  1120	    !catalog.reference.version ||
  1121	    !/^[a-f0-9]{64}$/.test(catalog.owner_map_sha256 ?? '')
  1122	  )
  1123	    fail('INVALID_CATALOG', 'reference/owner identity')
  1124	  if (root && fs.realpathSync(root) !== catalog.reference.root)
  1125	    fail('ROOT_MISMATCH', root)
  1126	  const sources = new Map()
  1127	  for (const source of catalog.sources) {
  1128	    relativePath(source.path)
  1129	    if (sources.has(source.path) || !/^[a-f0-9]{64}$/.test(source.sha256))
  1130	      fail('DUPLICATE_OR_INVALID_SOURCE', source.path)
  1131	    sources.set(source.path, source)
  1132	    if (root && hash(safeRead(root, source.path)) !== source.sha256)
  1133	      fail('SOURCE_DRIFT', source.path)
  1134	  }
  1135	  const ids = new Set()
  1136	  for (const entry of catalog.entries) {
  1137	    if (ids.has(entry.id)) fail('DUPLICATE_ID', entry.id)
  1138	    ids.add(entry.id)
  1139	    const identity = {
  1140	      kind: entry.kind,
  1141	      package: entry.package,
  1142	      source: entry.source,
  1143	      symbol: entry.symbol
  1144	    }
  1145	    if (
  1146	      entry.id !== `contract:${hash(json(identity))}` ||
  1147	      !/^P100-\d{3}$/.test(entry.owner_task) ||
  1148	      entry.parity_status !== 'NOT_VERIFIED'
  1149	    )
  1150	      fail('INVALID_ENTRY', entry.id)
  1151	    if (
  1152	      !sources.has(entry.source) ||
  1153	      sources.get(entry.source).sha256 !== entry.source_sha256
  1154	    )
  1155	      fail('MISSING_SOURCE', entry.source)
  1156	    if (
  1157	      hash(json(entry.shape)) !== entry.contract_sha256 ||
  1158	      entry.extraction_status !==
  1159	        (hasUnknown(entry.shape) ? 'UNKNOWN' : 'STATIC')
