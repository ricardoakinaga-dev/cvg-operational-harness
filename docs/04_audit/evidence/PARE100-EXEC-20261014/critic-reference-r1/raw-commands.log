  1023	        'configuration-data',
  1024	        'data',
  1025	        unknown(
  1026	          'YAML/TOML configuration requires a dedicated schema-aware parser; no interpolation or config execution',
  1027	          {
  1028	            keys: [...text.matchAll(/^([\w.-]+)\s*[:=]/gm)]
  1029	              .map((match) => match[1])
  1030	              .sort()
  1031	          }
  1032	        )
  1033	      )
