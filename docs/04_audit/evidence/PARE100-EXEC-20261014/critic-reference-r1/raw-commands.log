   661	const PYTHON_AST = String.raw`
   662	import ast, json, sys
   663	def typ(n):
   664	  if n is None: return {"status":"UNKNOWN","reason":"No declared Python annotation"}
   665	  allowed=(ast.Name,ast.Attribute,ast.Subscript,ast.Constant,ast.Tuple,ast.List,ast.BinOp,ast.BitOr,ast.Load)
   666	  if not all(isinstance(x,allowed) for x in ast.walk(n)): return {"status":"UNKNOWN","reason":"Dynamic Python annotation/base expression"}
   667	  return ast.unparse(n)
   668	def sig(n):
   669	  args=n.args
   670	  positional=args.posonlyargs+args.args
   671	  defaults=[None]*(len(positional)-len(args.defaults))+args.defaults
   672	  ps=[{"name":a.arg,"type":typ(a.annotation),"optional":d is not None,"positional_only":i<len(args.posonlyargs)} for i,(a,d) in enumerate(zip(positional,defaults))]
   673	  ps += [{"name":a.arg,"type":typ(a.annotation),"optional":d is not None,"keyword_only":True} for a,d in zip(args.kwonlyargs,args.kw_defaults)]
   674	  for a,kind in [(args.vararg,"vararg"),(args.kwarg,"kwarg")]:
   675	    if a: ps.append({"name":a.arg,"type":typ(a.annotation),kind:True})
   676	  return {"parameters":ps,"returns":typ(n.returns),"async":isinstance(n,ast.AsyncFunctionDef)}
   677	out=[]
   678	for item in json.load(sys.stdin):
   679	  rows=[]
   680	  tree=ast.parse(item["text"])
   681	  for n in tree.body:
   682	    if isinstance(n,(ast.FunctionDef,ast.AsyncFunctionDef)) and not n.name.startswith("_"): rows.append(["python-function",n.name,sig(n)])
   683	    elif isinstance(n,ast.ClassDef):
   684	      rows.append(["python-class",n.name,{"bases":[typ(b) for b in n.bases]}])
   685	      for m in n.body:
   686	        if isinstance(m,(ast.FunctionDef,ast.AsyncFunctionDef)) and (not m.name.startswith("_") or m.name=="__init__"): rows.append(["python-method",n.name+"."+m.name,sig(m)])
   687	        elif isinstance(m,ast.AnnAssign) and isinstance(m.target,ast.Name): rows.append(["python-field",n.name+"."+m.target.id,{"type":typ(m.annotation)}])
   688	    elif isinstance(n,ast.ImportFrom): rows.extend([["python-export",a.asname or a.name,{"from":n.module,"level":n.level,"name":a.name}] for a in n.names])
   689	    elif isinstance(n,ast.Assign) and any(isinstance(t,ast.Name) and t.id=="__all__" for t in n.targets):
   690	      try: value=ast.literal_eval(n.value)
   691	      except (ValueError,TypeError): value={"status":"UNKNOWN","reason":"Dynamic __all__"}
   692	      rows.append(["python-exports","__all__",{"names":value}])
   693	  out.append({"path":item["path"],"rows":rows})
   694	json.dump(out,sys.stdout,sort_keys=True)
   695	`
