   939	        [
   940	          'name',
   941	          'version',
   942	          'type',
   943	          'main',
   944	          'module',
   945	          'types',
   946	          'exports',
   947	          'bin',
   948	          'files',
   949	          'engines',
   950	          'peerDependencies'
