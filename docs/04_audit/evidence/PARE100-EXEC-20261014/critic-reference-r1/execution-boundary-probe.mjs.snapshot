const sha=x=>crypto.createHash('sha256').update(x).digest('hex');const manifest='packages/core/probe/package.json';const ownerMap={reference_commit:commit,reference_version:'fixture-v1',inventory_coverage:{packages:1,families:1},family_owners:{core:'P100-012'},package_owners:[{reference_package:'@probe/core',manifest,manifest_sha256:sha(files[manifest]),group:'core',owner_task:'P100-012'}],additional_surfaces:[]}
let status,error;try{status=collectReferenceCatalog({root,expectedCommit:commit,expectedVersion:'fixture-v1',ownerMap}).parity_status}catch(e){error=e.message}
const row={name:'known-bad reference configured fsmonitor execution',expected:'NO_REFERENCE_COMMAND_EXECUTION',actual:fs.existsSync(marker)?'REFERENCE_COMMAND_EXECUTED':'NO_REFERENCE_COMMAND_EXECUTION',passed:!fs.existsSync(marker),root,marker,markerText:fs.existsSync(marker)?fs.readFileSync(marker,'utf8'):null,catalogStatus:status,error};console.log(JSON.stringify(row));fs.writeFileSync(path.join(result,'execution-boundary-probe.json'),JSON.stringify(row,null,2)+'\n');process.exitCode=row.passed?0:1
