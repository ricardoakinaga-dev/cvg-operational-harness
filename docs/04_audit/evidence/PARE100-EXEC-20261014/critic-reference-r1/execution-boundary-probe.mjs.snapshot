const root=fs.mkdtempSync(path.join(base,'execution-fixture-'));const marker=path.join(root,'fsmonitor-executed.txt')
const files={'package.json':'{"name":"@probe/root","version":"fixture-v1"}','packages/core/probe/package.json':'{"name":"@probe/core","main":"src/index.ts"}','packages/core/probe/src/index.ts':'export interface A { safe: true }','contract-monitor.sh':'#!/bin/sh\nprintf "%s\\n" "REFERENCE_COMMAND_EXECUTED" > fsmonitor-executed.txt\nprintf "token\\000"\n'}
