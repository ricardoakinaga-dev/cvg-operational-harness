const run=(args,input)=>execFileSync('git',['-C',root,...args],{input,encoding:'utf8',env:{...process.env,GIT_CONFIG_NOSYSTEM:'1',GIT_CONFIG_GLOBAL:'/dev/null',GIT_AUTHOR_NAME:'Independent',GIT_AUTHOR_EMAIL:'probe@example.invalid',GIT_COMMITTER_NAME:'Independent',GIT_COMMITTER_EMAIL:'probe@example.invalid'}}).trim()
