766: export interface TelemetryCapabilityOptions {
767:   readonly name?: string
768: }
769: 
770: /** Observability never turns a governed result into an error. */
771: export function telemetryCapability(
772:   telemetry: TelemetrySink,
773:   options: TelemetryCapabilityOptions = {}
774: ): KernelPlugin {
775:   const name = options.name ?? 'harness.kernel'
776:   return {
777:     name: 'capability.telemetry',
778:     kind: 'capability',
779:     provides: ['telemetry'],
780:     apply(ctx) {
781:       ctx.provide('telemetry', telemetry)
782:       ctx.on('turn/end', async (turn, result) => {
783:         const event: TelemetryEvent = {
784:           name,
785:           latencyMs: Date.now() - turn.startedAt,
786:           errors: result.stopReason === 'COMPLETED' ? 0 : 1,
787:           costUsd: result.usage.costUsd,
788:           inputTokens: result.usage.inputTokens,
789:           outputTokens: result.usage.outputTokens,
790:           provider: turn.metadata.provider,
791:           toolDurationMs: turn.metadata.toolDurationMs,
792:           steps: result.steps,
793:           traceId: turn.input.traceId,
794:           correlationId: turn.input.correlationId
795:         }
796:         try {
797:           telemetry.record(event)
798:         } catch {
799:           // Observability must not turn a governed result into an error.
800:         }
801:         return result
802:       })
803:     }
804:   }
805: }
