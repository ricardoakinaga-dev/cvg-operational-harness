37: /**
38:  * Single-pass profile, now a thin facade over the plugin kernel (SPEC 0181,
39:  * decision D-0181-3). Governance runs as kernel control plugins; this class
40:  * only keeps the public name and constructor while consumers migrate.
41:  */
42: export class SinglePassGovernedRuntime implements HarnessRuntime {
43:   readonly #kernel: KernelRuntime
44: 
45:   public constructor(options: HarnessRuntimeOptions) {
46:     this.#kernel = createKernelRuntime({
47:       ...options,
48:       eventName: 'harness.single_pass'
49:     })
50:   }
51: 
52:   public execute(input: RuntimeInput): Promise<RuntimeResult> {
53:     return this.#kernel.execute(input)
54:   }
55: }
