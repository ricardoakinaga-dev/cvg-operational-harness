282: export class ScriptedPolicyEngine implements PolicyEngine {
283:   public readonly evaluations: PolicyRequest[] = []
284: 
285:   public constructor(
286:     private readonly deniedTools: readonly string[] = [],
287:     private readonly handoffTools: readonly string[] = [],
288:     private readonly approvalTools: readonly string[] = []
289:   ) {}
290: 
291:   public async evaluate(request: PolicyRequest): Promise<PolicyDecision> {
292:     this.evaluations.push(request)
293:     if (this.deniedTools.includes(request.tool.id)) {
294:       return {
295:         outcome: 'DENY',
296:         reason: `Policy denies ${request.tool.id}.`,
297:         policyVersion: 'synthetic-policy-v1'
298:       }
299:     }
300:     if (this.handoffTools.includes(request.tool.id)) {
301:       return {
302:         outcome: 'HANDOFF',
303:         reason: `Policy requires a human for ${request.tool.id}.`,
304:         policyVersion: 'synthetic-policy-v1'
305:       }
306:     }
307:     if (this.approvalTools.includes(request.tool.id)) {
308:       return {
309:         outcome: 'REQUIRE_APPROVAL',
310:         reason: `Policy requires approval for ${request.tool.id}.`,
311:         policyVersion: 'synthetic-policy-v1'
312:       }
313:     }
314:     return {
315:       outcome: 'ALLOW',
316:       reason: 'Allowed by synthetic policy.',
317:       policyVersion: 'synthetic-policy-v1'
318:     }
319:   }
320: }
