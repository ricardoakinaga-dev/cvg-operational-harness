91: export function createPhase3ToolRegistry(options: {
92:   readonly availability: 'AVAILABLE' | 'UNAVAILABLE'
93:   readonly reserveFails?: boolean
94:   readonly observe?: Phase3ToolObserver
95: }): ToolRegistry {
96:   const availabilityTool: ToolDefinition = {
97:     id: PHASE3_TOOL_AVAILABILITY,
98:     version: 'v1',
99:     description: 'Checks the synthetic resource availability.',
100:     inputSchema: { type: 'object' },
101:     outputSchema: { type: 'object' },
102:     risk: 'LOW',
103:     sideEffect: 'READ',
104:     idempotent: true,
105:     requiresApproval: false,
106:     execute: async (input, context): Promise<ToolResult> => {
107:       options.observe?.({
108:         toolId: availabilityTool.id,
109:         operationKey: context.operationKey ?? '',
110:         input
111:       })
112:       return {
113:         status: 'SUCCEEDED',
114:         output:
115:           options.availability === 'AVAILABLE'
116:             ? { available: true }
117:             : { available: false, reason: 'occupied' }
118:       }
119:     }
120:   }
121:   const reserveTool: ToolDefinition = {
122:     id: PHASE3_TOOL_RESERVE,
123:     version: 'v1',
124:     description: 'Creates a synthetic reservation.',
125:     inputSchema: { type: 'object' },
126:     outputSchema: { type: 'object' },
127:     risk: 'MEDIUM',
128:     sideEffect: 'WRITE',
129:     idempotent: false,
