FILE observe.mts
import type {
  CapabilityDescriptor,
  ModelGateway,
  Orchestrator,
  RuntimeInput,
  SandboxGate,
  SandboxMode,
  ToolDefinition,
  ToolExecutionContext,
  ToolResult,
} from "@cvg/harness-contracts";
import {
  createCapabilityRegistry,
  createOperationalHarness,
  InMemoryEffectJournal,
  InMemoryKernelLog,
} from "../worktree/packages/harness/src/index.ts";
import {
  InMemoryApprovalEngine,
  RecordingAuditSink,
  RecordingTelemetrySink,
  ScriptedPolicyEngine,
  phase3AgentProfile,
  phase3RuntimeInput,
} from "../worktree/packages/harness/src/__tests__/fixtures/phase3-fixtures.ts";

const id = "synthetic.sandbox.metadata";
const version = "1.0.0";
const echo = Object.freeze({ text: "synthetic echo only" });

// Explicitly preserve otherwise non-JSON data; no silent function/undefined loss.
function capture(value: unknown, depth = 0): unknown {
  if (depth > 64) throw new Error("observation depth exceeded");
  if (value === undefined) return { $type: "undefined" };
  if (typeof value === "function") return { $type: "function" };
  if (
    value === null ||
    typeof value === "string" ||
    typeof value === "boolean"
  ) {
    return value;
  }
  if (typeof value === "number" && Number.isFinite(value)) return value;
  if (value instanceof AbortSignal) {
    return {
      $type: "AbortSignal",
      aborted: value.aborted,
      reason: capture(value.reason, depth + 1),
    };
  }
  if (Array.isArray(value))
    return value.map((item) => capture(item, depth + 1));
  if (typeof value !== "object")
    throw new Error("unsupported observation value");
  const proto: unknown = Object.getPrototypeOf(value);
  if (proto !== Object.prototype && proto !== null) {
    throw new Error("unsupported observation object");
  }
  const result: Record<string, unknown> = {};
  for (const key of Reflect.ownKeys(value)) {
    if (typeof key !== "string") throw new Error("unsupported observation key");
    const property = Object.getOwnPropertyDescriptor(value, key);
    if (!property || !("value" in property)) {
      throw new Error("observation getter refused");
    }
    result[key] = capture(property.value, depth + 1);
  }
  return result;
}

async function observe(route: "direct" | "capability", mode: SandboxMode) {
  const caseId = `${route}-${mode}`;
  const bodyCalls: unknown[] = [];
  const gateCalls: unknown[] = [];
  const modelCalls: unknown[] = [];
  const decisions: unknown[] = [];
  const operationKey = `sandbox-metadata-${caseId}`;
  const descriptor: CapabilityDescriptor = {
    id,
    version,
    description: "Synthetic memory-only metadata observation",
    inputSchema: { type: "object", required: ["text"] },
    outputSchema: { type: "object", required: ["text"] },
    risk: "LOW",
    sideEffect: "NONE",
    sandbox: mode,
    idempotent: true,
    requiresApproval: false,
    origin: "core",
    providerId: "synthetic-memory",
    providerVersion: "1.0.0",
  };
  const execute = async (
    input: unknown,
    context: ToolExecutionContext,
  ): Promise<ToolResult> => {
    bodyCalls.push(capture({ input, context }));
    return { status: "SUCCEEDED", output: { ...echo } };
  };
  const registry =
    route === "capability"
      ? createCapabilityRegistry().register({
          descriptor,
          implementation: {
            validateInput: (input) =>
              typeof input === "object" &&
              input !== null &&
              Object.keys(input).length === 1 &&
              (input as Record<string, unknown>).text === echo.text,
            execute,
            validateOutput: (output) =>
              typeof output === "object" &&
              output !== null &&
              Object.keys(output).length === 1 &&
              (output as Record<string, unknown>).text === echo.text,
          },
        })
      : undefined;
  const rawTool: ToolDefinition = { ...descriptor, execute };
  const gate: SandboxGate = {
    evaluate: async (input) => {
      gateCalls.push(capture(input));
      return { kind: "denied", reason: "synthetic deny, no native backend" };
    },
  };
  const modelGateway: ModelGateway = {
    complete: async (request) => {
      modelCalls.push(capture(request));
      throw new Error("This fixture must never call a model");
    },
  };
  const invocation = {
    toolId: id,
    toolVersion: version,
    operationKey,
    input: echo,
  };
  const orchestrator: Orchestrator = {
    decideNextStep: async (input) => {
      const decision = {
        action: "CALL_TOOL" as const,
        toolInvocation: invocation,
      };
      decisions.push(capture({ input, decision }));
      return decision;
    },
  };
  const audit = new RecordingAuditSink();
  const telemetry = new RecordingTelemetrySink();
  const policy = new ScriptedPolicyEngine();
  const approvals = new InMemoryApprovalEngine();
  const journal = new InMemoryEffectJournal();
  const log = new InMemoryKernelLog();
  const harness = createOperationalHarness({
    modelGateway,
    orchestrator,
    policy,
    approvals,
    audit,
    telemetry,
    effectJournal: journal,
    log,
    sandbox: gate,
    ...(registry
      ? { capabilities: registry }
      : {
          tools: {
            list: () => [rawTool],
            resolve: (toolId: string, toolVersion?: string) =>
              toolId === id &&
              (toolVersion === undefined || toolVersion === version)
                ? rawTool
                : undefined,
          },
        }),
  });
  const { executionId: omittedExecutionId, ...base } = phase3RuntimeInput({
    runtimeProfile: "single_pass",
    agent: phase3AgentProfile({ tools: [id] }),
    requestedTool: invocation,
  });
  void omittedExecutionId;
  const input: RuntimeInput = base;
  const nativeInput = capture(input);
  const beforeDescriptor = capture(descriptor);
  const registeredDescriptors = capture(registry?.listDescriptors());
  const nativeResult = await harness.run(input);
  return capture({
    caseId,
    route,
    mode,
    input: nativeInput,
    beforeDescriptor,
    registeredDescriptors,
    submittedDescriptor: registry ? registry.listDescriptors()[0] : rawTool,
    capabilityFingerprint: harness.capabilityFingerprint,
    nativeResult,
    gateCalls,
    bodyCalls,
    modelCalls,
    decisions,
    policyEvaluations: policy.evaluations,
    approvalRequests: approvals.requests,
    auditEvents: audit.events,
    telemetryEvents: telemetry.events,
    kernelLogEvents: log.events,
    journalRecord: await journal.get(input.tenantId, operationKey),
  });
}

const cases = [];
for (const [route, mode] of [
  ["direct", "WORKSPACE"],
  ["capability", "WORKSPACE"],
  ["capability", "NONE"],
] as const) {
  cases.push(await observe(route, mode));
}
process.stdout.write(
  JSON.stringify({
    schema: "cvg-sandbox-metadata-observation-v1",
    boundary: "public source factory, single_pass only",
    syntheticPorts: [
      "orchestrator",
      "model",
      "policy",
      "approval",
      "audit",
      "telemetry",
      "sandbox-deny",
    ],
    cases,
  }) + "\n",
);

FILE validate.py
from pathlib import Path
import argparse
import copy
import hashlib
import json
import re
from datetime import datetime
from common import CAP, P, authority, digest, env_for, equal, integer, load, require, strict_load
from seal import FILES

UNDEFINED = {'$type': 'undefined'}
FUNCTION = {'$type': 'function'}
ECHO = {'text': 'synthetic echo only'}
CASE_IDS = ['direct-WORKSPACE', 'capability-WORKSPACE', 'capability-NONE']
CASE_KEYS = set('caseId route mode input beforeDescriptor registeredDescriptors submittedDescriptor capabilityFingerprint nativeResult gateCalls bodyCalls modelCalls decisions policyEvaluations approvalRequests auditEvents telemetryEvents kernelLogEvents journalRecord'.split())

def timestamp(value):
    require(isinstance(value, str) and re.fullmatch(r'\d{4}-\d\d-\d\dT\d\d:\d\d:\d\d\.\d{3}Z', value), 'timestamp shape')
    return datetime.fromisoformat(value.replace('Z', '+00:00'))

def fingerprint(descriptor):
    serialized = json.dumps({'schemaVersion': 'capability-composition-v1', 'descriptors': [descriptor]}, sort_keys=True, ensure_ascii=False, separators=(',', ':'))
    return hashlib.sha256(serialized.encode()).hexdigest()

def evaluate(data, fixture):
    require(set(data) == {'schema', 'boundary', 'syntheticPorts', 'cases'}, 'observation schema')
    equal(data['schema'], 'cvg-sandbox-metadata-observation-v1', 'schema')
    equal(data['boundary'], 'public source factory, single_pass only', 'boundary')
    equal(data['syntheticPorts'], ['orchestrator', 'model', 'policy', 'approval', 'audit', 'telemetry', 'sandbox-deny'], 'synthetic ports')
    equal([case['caseId'] for case in data['cases']], CASE_IDS, 'case identities')
    results = []
    for case in data['cases']:
        require(set(case) == CASE_KEYS, 'case schema')
        case_id = case['caseId']
        route, mode = case_id.split('-', 1)
        equal(case['route'], route, 'route')
        equal(case['mode'], mode, 'mode')
        original = fixture['cases'][case_id]
        inp = original['input']
        before = original['descriptor']
        equal(case['input'], inp, 'fixed input')
        equal(case['beforeDescriptor'], before, 'fixed descriptor')
        submitted = copy.deepcopy(case['submittedDescriptor'])
        if route == 'direct':
            equal(submitted, {**before, 'execute': FUNCTION}, 'direct tool')
            normalized = before
            equal(case['registeredDescriptors'], UNDEFINED, 'no direct registry')
            equal(case['capabilityFingerprint'], UNDEFINED, 'no direct fingerprint')
        else:
            normalized = case['registeredDescriptors'][0]
            require(len(case['registeredDescriptors']) == 1, 'registry count')
            without_mode = {key: value for key, value in before.items() if key != 'sandbox'}
            # This observation can report preservation or loss, without changing the engine.
            require(normalized == before or normalized == without_mode, 'unexpected normalization')
            equal(normalized, before if 'sandbox' in normalized else without_mode, 'normalized descriptor types')
            equal(submitted, normalized, 'submitted registry descriptor')
            equal(case['capabilityFingerprint'], fingerprint(normalized), 'recomputed capability fingerprint')
        runtime = copy.deepcopy(inp)
        if route == 'capability':
            runtime['capabilityFingerprint'] = fingerprint(normalized)
        invocation = inp['requestedTool']
        tool = {**normalized, 'execute': FUNCTION}
        equal(case['decisions'], [{'input': {'runtime': runtime, 'availableTools': [normalized], 'step': 1},
                                   'decision': {'action': 'CALL_TOOL', 'toolInvocation': invocation}}], 'decision causal payload')
        context = {'tenantId': inp['tenantId'], 'agentId': inp['agent']['id'],
                   'correlationId': inp['correlationId'], 'traceId': inp['traceId'],
                   'operationKey': invocation['operationKey']}
        equal(case['policyEvaluations'], [{'tenantId': inp['tenantId'], 'agentId': inp['agent']['id'],
              'action': 'tool.execute', 'tool': tool, 'invocation': invocation,
              'correlationId': inp['correlationId']}], 'policy causal payload')
        contained = normalized.get('sandbox', 'NONE') != 'NONE'
        equal(case['gateCalls'], [{'descriptor': tool, 'context': context,
              'policy': {'requiredMode': 'WORKSPACE', 'workspaceScoped': True,
                         'networkAllowed': False, 'subprocessAllowed': False}}] if contained else [], 'gate causal payload')
        equal(case['bodyCalls'], [] if contained else [{'input': ECHO, 'context': {**context,
              'signal': {'$type': 'AbortSignal', 'aborted': False, 'reason': UNDEFINED}}}], 'body causal payload')
        equal(case['modelCalls'], [], 'no model')
        equal(case['approvalRequests'], [], 'no approval')
        reason = 'UNSAFE_REQUEST' if contained else 'COMPLETED'
        expected_result = {'response': f'Sandbox denied tool "{before["id"]}": synthetic deny, no native backend.' if contained else json.dumps(ECHO, separators=(',', ':')),
                           'stopReason': reason, 'steps': 1, 'modelCalls': 0, 'toolCalls': 0 if contained else 1,
                           'usage': {'inputTokens': 0, 'outputTokens': 0, 'costUsd': 0}}
        if not contained:
            expected_result['toolResult'] = {'status': 'SUCCEEDED', 'output': ECHO}
        equal(case['nativeResult'], expected_result, 'native result')
        base_log = {'correlationId': inp['correlationId']}
        equal(case['kernelLogEvents'], [
            {'type': 'turn/start', **base_log},
            {'type': 'tool/call', **base_log, 'toolId': before['id'], 'operationKey': invocation['operationKey'], 'input': ECHO},
            {'type': 'tool/result', **base_log, 'toolId': before['id'], 'outcome': 'not_started' if contained else 'succeeded'},
            {'type': 'turn/end', **base_log, 'stopReason': reason}
        ], 'complete kernel log')
        require(len(case['auditEvents']) == 1, 'audit count')
        audit_time = case['auditEvents'][0]['timestamp']
        timestamp(audit_time)
        equal(case['auditEvents'], [{'actor': inp['agent']['id'], 'agent': inp['agent']['id'], 'tenant': inp['tenantId'],
              'action': 'harness.single_pass', 'policy': 'ALLOW', 'approval': None, 'tool': before['id'],
              'result': reason, 'timestamp': audit_time, 'traceId': inp['traceId'], 'correlationId': inp['correlationId']}], 'complete audit payload')
        require(len(case['telemetryEvents']) == 1, 'telemetry count')
        event = case['telemetryEvents'][0]
        require(integer(event['latencyMs']) and integer(event['toolDurationMs']), 'telemetry timing types/range')
        if contained:
            equal(event['toolDurationMs'], 0, 'blocked tool was never dispatched')
        equal(case['telemetryEvents'], [{'name': 'harness.single_pass', 'latencyMs': event['latencyMs'],
              'errors': 1 if contained else 0, 'costUsd': 0, 'inputTokens': 0, 'outputTokens': 0,
              'provider': None, 'toolDurationMs': event['toolDurationMs'], 'steps': 1,
              'traceId': inp['traceId'], 'correlationId': inp['correlationId']}], 'complete telemetry payload')
        journal = case['journalRecord']
        if contained:
            equal(journal, None, 'blocked journal')
        else:
            require(set(journal) == {'tenantId', 'operationKey', 'proposalHash', 'state', 'attemptId', 'createdAt', 'updatedAt', 'result'}, 'journal schema')
            require(re.fullmatch(r'attempt_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}', journal['attemptId']), 'attempt UUID')
            require(timestamp(journal['createdAt']) <= timestamp(journal['updatedAt']), 'journal clock order')
            require(timestamp(journal['updatedAt']) <= timestamp(audit_time), 'journal confirmation precedes turn-end audit; clock anomaly is invalid/inconclusive')
            proposal = {'schemaVersion': 'effect-proposal-v2', 'compositionFingerprint': fingerprint(normalized),
                        'tool': {key: normalized[key] for key in ['id', 'version', 'sideEffect', 'idempotent', 'providerId', 'providerVersion']}, 'input': ECHO}
            expected_proposal = hashlib.sha256(json.dumps(proposal, ensure_ascii=False, separators=(',', ':')).encode()).hexdigest()
            equal(journal['proposalHash'], expected_proposal, 'recomputed journal proposal hash')
            equal(journal, {**journal, 'tenantId': inp['tenantId'], 'operationKey': invocation['operationKey'],
                           'state': 'CONFIRMED', 'result': ECHO}, 'journal causal payload')
        results.append({'case': case_id, 'gateCalls': len(case['gateCalls']), 'bodyCalls': len(case['bodyCalls']), 'stopReason': reason, 'sandbox': normalized.get('sandbox', 'ABSENT')})
    require(results[0]['gateCalls'] == 1 and results[2]['bodyCalls'] == 1, 'control cases')
    return {'controls': 'PASS', 'invariant': 'FAIL' if results[1]['bodyCalls'] else 'PASS_SCOPED',
            'cases': results, 'sameFingerprints': data['cases'][1]['capabilityFingerprint'] == data['cases'][2]['capabilityFingerprint'],
            'fullParity': 'NOT_MEASURED', 'nativeContainment': 'NOT_TESTED', 'ML29': 'NOT_TESTED'}

def validate_run(folder, trusted, expected_authority_sha, receipt_path, expected_receipt_sha):
    require(digest(receipt_path) == expected_receipt_sha, 'untrusted capture receipt')
    receipt = load(receipt_path)
    require(set(receipt) == {'schema', 'run', 'files'} and receipt['schema'] == 'sandbox-observer-receipt-v2', 'receipt schema')
    equal(receipt['run'], str(folder.resolve()), 'receipt run identity')
    require(set(receipt['files']) == FILES, 'receipt membership')
    require({f.name for f in folder.iterdir() if f.is_file()} == FILES, 'run file membership')
    for name in FILES:
        file = folder / name
        require(file.is_file() and not file.is_symlink(), 'capture file must be regular')
        equal(receipt['files'][name], {'sha256': digest(file), 'bytes': file.stat().st_size}, 'trusted capture file ' + name)
    equal(load(folder / 'sources-before.json'), trusted['sources'], 'source before authority')
    equal(load(folder / 'sources-after.json'), trusted['sources'], 'source after authority')
    process = load(folder / 'process.json')
    require(set(process) == {'schema', 'authoritySHA256', 'capture', 'snapshotErrors', 'sourceCount', 'sourcesUnchanged'}, 'process schema')
    equal({k: v for k, v in process.items() if k != 'capture'}, {
        'schema': 'sandbox-observer-process-v2', 'authoritySHA256': expected_authority_sha,
        'snapshotErrors': [], 'sourceCount': len(trusted['sources']), 'sourcesUnchanged': True}, 'process identity')
    c = process['capture']
    require(set(c) == set('argv cwd env pid processGroup spawned exitCode joined remainingProcessGroup subreaper executionElapsedNs cleanupElapsedNs totalElapsedNs deadlineMs outputLimit discardedBytes eof errors descendantsReaped retainedBytes'.split()), 'capture schema')
    equal(c['argv'], trusted['argv'], 'process argv')
    equal(c['cwd'], trusted['cwd'], 'process cwd')
    equal(c['env'], env_for(folder), 'process environment')
    require(integer(c['pid'], 1, 2**31) and type(c['processGroup']) is int and c['pid'] == c['processGroup'], 'process/group identity')
    for name, expected in {'spawned': True, 'exitCode': 0, 'joined': True, 'remainingProcessGroup': False,
                           'subreaper': True, 'deadlineMs': 5000, 'outputLimit': CAP, 'discardedBytes': 0,
                           'eof': {'stdout': True, 'stderr': True}, 'errors': []}.items():
        equal(c[name], expected, 'capture.' + name)
    require(integer(c['executionElapsedNs'], 1, 5000000000), 'absolute execution deadline')
    require(integer(c['cleanupElapsedNs'], 0, 2200000000), 'cleanup deadline')
    equal(c['totalElapsedNs'], c['executionElapsedNs'] + c['cleanupElapsedNs'], 'elapsed accounting')
    require(isinstance(c['descendantsReaped'], list), 'descendants shape')
    pids = []
    for item in c['descendantsReaped']:
        require(set(item) == {'pid', 'waitStatus'} and integer(item['pid'], 1, 2**31) and integer(item['waitStatus'], 0, 65535), 'reaped descendant')
        pids.append(item['pid'])
    require(len(set(pids)) == len(pids) and c['pid'] not in pids, 'reaped identity')
    raw = (folder / 'stdout.txt').read_bytes()
    equal((folder / 'stderr.txt').read_bytes(), b'', 'actual stderr empty')
    require(0 < len(raw) <= CAP, 'stdout bound')
    equal(c['retainedBytes'], len(raw), 'captured byte accounting')
    return evaluate(strict_load(raw), load(P / 'fixture.json'))

if __name__ == '__main__':
    parser = argparse.ArgumentParser()
    parser.add_argument('--run', required=True, type=Path)
    parser.add_argument('--authority', required=True, type=Path)
    parser.add_argument('--authority-sha', required=True)
    parser.add_argument('--receipt', required=True, type=Path)
    parser.add_argument('--receipt-sha', required=True)
    args = parser.parse_args()
    trusted = authority(args.authority, args.authority_sha)
    result = validate_run(args.run.resolve(), trusted, args.authority_sha, args.receipt, args.receipt_sha)
    print(json.dumps(result))

FILE checks.py
from pathlib import Path
import argparse
import copy
import json
import shutil
from common import P, NODE, CAP, authority, digest, env_for, load, put, require, strict_load
from launcher import execute
from run import run
from seal import seal
from validate import evaluate, validate_run

def check(folder, authority_path, authority_sha, out):
    out.mkdir(parents=True, exist_ok=False)
    trusted = authority(authority_path, authority_sha)
    fixture = load(P / 'fixture.json')
    data = load(folder / 'stdout.txt')
    results = []
    mutations = [
        ('missing-target', lambda d: d['cases'].pop(1)),
        ('duplicate-case', lambda d: d['cases'].append(copy.deepcopy(d['cases'][1]))),
        ('lost-telemetry', lambda d: d['cases'][1]['telemetryEvents'].clear()),
        ('malformed-telemetry', lambda d: d['cases'][1]['telemetryEvents'].__setitem__(0, {})),
        ('forged-telemetry', lambda d: d['cases'][1]['telemetryEvents'][0].__setitem__('errors', 42)),
        ('forged-body-count', lambda d: d['cases'][1]['bodyCalls'].clear()),
        ('forged-body-tenant', lambda d: d['cases'][1]['bodyCalls'][0]['context'].__setitem__('tenantId', 'forged')),
        ('forged-body-agent', lambda d: d['cases'][1]['bodyCalls'][0]['context'].__setitem__('agentId', 'forged')),
        ('forged-body-signal', lambda d: d['cases'][1]['bodyCalls'][0]['context']['signal'].__setitem__('aborted', True)),
        ('forged-log-payload', lambda d: d['cases'][1]['kernelLogEvents'][1].__setitem__('input', {'text': 'forged'})),
        ('forged-log-correlation', lambda d: d['cases'][1]['kernelLogEvents'][1].__setitem__('correlationId', 'forged')),
        ('forged-gate-flags', lambda d: d['cases'][0]['gateCalls'][0]['policy'].__setitem__('networkAllowed', True)),
        ('forged-decision-input', lambda d: d['cases'][1]['decisions'][0]['input']['runtime'].__setitem__('userMessage', 'forged')),
        ('forged-fingerprint', lambda d: d['cases'][1].__setitem__('capabilityFingerprint', '0' * 64)),
        ('forged-proposal-hash', lambda d: d['cases'][1]['journalRecord'].__setitem__('proposalHash', '0' * 64)),
        ('boolean-counter', lambda d: d['cases'][1]['nativeResult'].__setitem__('toolCalls', True)),
        ('boolean-timing', lambda d: d['cases'][1]['telemetryEvents'][0].__setitem__('latencyMs', False)),
        ('lost-audit', lambda d: d['cases'][1]['auditEvents'].clear()),
        ('extra-event-field', lambda d: d['cases'][1]['kernelLogEvents'][2].__setitem__('forged', True)),
        ('forged-normalized-mode', lambda d: d['cases'][1]['submittedDescriptor'].__setitem__('sandbox', 'WORKSPACE')),
        ('blocked-tool-duration', lambda d: d['cases'][0]['telemetryEvents'][0].__setitem__('toolDurationMs', 1)),
        ('journal-after-audit', lambda d: (d['cases'][1]['journalRecord'].__setitem__('createdAt', '2099-01-01T00:00:00.000Z'), d['cases'][1]['journalRecord'].__setitem__('updatedAt', '2099-01-01T00:00:00.001Z'))),
        ('audit-before-journal', lambda d: d['cases'][1]['auditEvents'][0].__setitem__('timestamp', '2000-01-01T00:00:00.000Z')),
    ]
    for name, mutate in mutations:
        mutant = copy.deepcopy(data)
        mutate(mutant)
        try:
            evaluate(mutant, fixture)
        except (ValueError, KeyError, IndexError, TypeError):
            results.append({'test': name, 'kind': 'semantic', 'result': 'REJECTED'})
            continue
        raise AssertionError('semantic mutation accepted: ' + name)
    for raw in ['{"cases":[],"cases":[]}', '{"value":NaN}', '{"value":Infinity}']:
        try:
            strict_load(raw)
        except ValueError:
            results.append({'test': raw, 'kind': 'strict-json', 'result': 'REJECTED'})
            continue
        raise AssertionError('ambiguous JSON accepted')
    # Forged copies receive an explicitly test-only trusted receipt so semantic
    # rejection is exercised beyond transport hashes. These are never accepted runs.
    process_mutations = [
        ('empty-source-map', lambda f, p: (put(f/'sources-before.json', {}), put(f/'sources-after.json', {}), p.__setitem__('sourceCount', 0))),
        ('bad-argv', lambda f, p: p['capture'].__setitem__('argv', ['forged'])),
        ('bad-cwd', lambda f, p: p['capture'].__setitem__('cwd', '/forged')),
        ('bad-env', lambda f, p: p['capture']['env'].__setitem__('NODE_OPTIONS', 'forged')),
        ('bad-group', lambda f, p: p['capture'].__setitem__('processGroup', 1)),
        ('boolean-pid', lambda f, p: p['capture'].__setitem__('pid', True)),
        ('bad-deadline', lambda f, p: p['capture'].__setitem__('deadlineMs', 6000)),
        ('bad-duration', lambda f, p: p['capture'].__setitem__('executionElapsedNs', 5000000001)),
        ('missing-duration', lambda f, p: p['capture'].pop('executionElapsedNs')),
        ('hidden-stderr', lambda f, p: (f/'stderr.txt').write_text('concealed stderr')),
        ('unknown-join', lambda f, p: p['capture'].__setitem__('joined', None)),
        ('source-drift', lambda f, p: put(f/'sources-after.json', {})),
    ]
    for name, mutate in process_mutations:
        f = out / name
        shutil.copytree(folder, f)
        process = load(f/'process.json')
        process['capture']['env'] = env_for(f)
        mutate(f, process)
        put(f/'process.json', process)
        receipt = out/(name+'.receipt.json')
        sha = seal(f, receipt)
        try:
            validate_run(f, trusted, authority_sha, receipt, sha)
        except (ValueError, KeyError, IndexError, TypeError):
            results.append({'test': name, 'kind': 'process-semantic', 'result': 'REJECTED'})
            continue
        raise AssertionError('process mutation accepted: ' + name)
    # An unmodified copied run with adjusted private home paths is a positive
    # control for the copied-evidence setup, not an independently captured run.
    positive = out/'copy-positive'
    shutil.copytree(folder, positive)
    process = load(positive/'process.json')
    process['capture']['env'] = env_for(positive)
    put(positive/'process.json', process)
    receipt = out/'copy-positive.receipt.json'
    sha = seal(positive, receipt)
    validate_run(positive, trusted, authority_sha, receipt, sha)
    results.append({'test': 'copied-evidence-harness', 'result': 'PASS_COPY_CONTROL_ONLY'})
    try:
        validate_run(positive, trusted, authority_sha, receipt, '0'*64)
    except ValueError:
        results.append({'test': 'untrusted-receipt', 'result': 'REJECTED'})
    else:
        raise AssertionError('untrusted receipt accepted')
    try:
        authority(authority_path, '0'*64)
    except ValueError:
        results.append({'test': 'untrusted-source-authority', 'result': 'REJECTED'})
    else:
        raise AssertionError('untrusted authority accepted')
    # Controlled children only: close own pipes then wait, flood own stdout,
    # injected read failure, and post-capture snapshot failure.
    lifecycle = []
    fixtures = [
        ('eof-timeout', "require('fs').closeSync(1);require('fs').closeSync(2);setTimeout(()=>{},2000)", 150, CAP, False, 'execution_deadline_after_eof'),
        ('output-cap', "process.stdout.write('x'.repeat(100000));setTimeout(()=>{},2000)", 1000, 1024, False, 'combined_output_cap'),
        ('capture-error', "process.stdout.write('x');setTimeout(()=>{},2000)", 1000, CAP, True, 'synthetic_capture_error'),
    ]
    for name, script, deadline, cap, fault, expected in fixtures:
        f = out/name
        f.mkdir()
        capture, streams = execute([str(NODE), '-e', script], P, env_for(f), deadline, cap, fault)
        put(f/'process.json', capture)
        for key, raw in streams.items():
            (f/(key+'.txt')).write_bytes(raw)
        require(any(expected in error['message'] for error in capture['errors']), name+' fault not observed')
        require(capture['joined'] and capture['remainingProcessGroup'] is False, name+' cleanup')
        require(capture['retainedBytes'] <= cap, name+' retained cap')
        lifecycle.append({'test': name, 'result': 'EXPECTED_FAILURE_RETAINED_AND_JOINED', 'capture': capture})
    def synthetic_driver(argv, cwd, env):
        return execute([str(NODE), '-e', "process.stdout.write('synthetic snapshot fixture')"], cwd, env)
    f = out/'after-snapshot-error'
    good, record = run(f, authority_path, authority_sha, snapshot_fault=True, capture_driver=synthetic_driver)
    require(not good and record['capture']['joined'] and record['capture']['remainingProcessGroup'] is False, 'snapshot fault cleanup')
    require(record['snapshotErrors'][0]['stage'] == 'after' and (f/'stdout.txt').read_bytes(), 'snapshot failure evidence')
    lifecycle.append({'test': 'after-snapshot-error', 'result': 'EXPECTED_FAILURE_RETAINED_AND_JOINED', 'record': record})
    put(out/'results.json', {'validatorControls': results, 'lifecycleControls': lifecycle,
                            'sourceAuthoritySHA256': authority_sha, 'sandboxNativeTests': 0,
                            'productionChanges': 0, 'fullParity': 'NOT_MEASURED'})
    return len(results), len(lifecycle)

if __name__ == '__main__':
    parser = argparse.ArgumentParser()
    parser.add_argument('--run', required=True, type=Path)
    parser.add_argument('--authority', required=True, type=Path)
    parser.add_argument('--authority-sha', required=True)
    parser.add_argument('--out', required=True, type=Path)
    args = parser.parse_args()
    print(check(args.run.resolve(), args.authority, args.authority_sha, args.out.resolve()))

