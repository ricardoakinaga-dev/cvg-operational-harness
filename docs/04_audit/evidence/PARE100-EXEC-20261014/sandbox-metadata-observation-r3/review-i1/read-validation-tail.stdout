162:         require(set(item) == {'pid', 'waitStatus'} and integer(item['pid'], 1, 2**31) and integer(item['waitStatus'], 0, 65535), 'reaped descendant')
163:         pids.append(item['pid'])
164:     require(len(set(pids)) == len(pids) and c['pid'] not in pids, 'reaped identity')
165:     raw = (folder / 'stdout.txt').read_bytes()
166:     equal((folder / 'stderr.txt').read_bytes(), b'', 'actual stderr empty')
167:     require(0 < len(raw) <= CAP, 'stdout bound')
168:     equal(c['retainedBytes'], len(raw), 'captured byte accounting')
169:     return evaluate(strict_load(raw), load(P / 'fixture.json'))
