      "cases": [
        "APP-01",
        "APP-02",
        "APP-03",
        "APP-04",
        "APP-05",
        "APP-06"
      ],
      "source": "reference/sandbox/escalation.ts:99-207",
      "conclusion": "Faithful missing-service/missing-agent fail-closed ordering, one request per widening call, exact caller identity and optional signal forwarding, distinct non-grants and requested mode return on allowed-once. Reason interpolation treats justification as data. No invented helper body execution, local cancellation or durable approval-store behavior.",
      "knownBadDiscrimination": "APP-01/02 require pre-body/pre-request rejection; nonGrantVectors require one captured ask/no wider return/zero future governed body calls; APP-04 captures identity; APP-05 requires a fresh widening approval; APP-06 separates reason text from authority.",
      "futureOnly": "Body-call counters, session persistence and normal CVG controls belong to a future governed journey; helper itself only returns a mode. Human authority cannot be replaced by scripted synthetic outcomes in actual operation."
    },
    {
      "procedure": "SBX04",
      "cases": [
        "TEXT-01",
        "TEXT-02",
        "TEXT-03"
      ],
      "source": "reference/sandbox/escalation.ts:63-97,149-158,203",
      "conclusion": "Faithful denial marker mode, supplied subject/Unicode interpolation and one-shot approval wording. Diagnostic text neither asks approval nor grants/executes an effect. EscalationRequest.subject has its request-specific rejection-message use through related SBX03; it is not falsely asserted to choose the target.",
      "knownBadDiscrimination": "TEXT-01 rejects substituted modes; TEXT-02 rejects subject loss and automatic-grant wording; TEXT-03 requires diagnostic-only treatment.",
      "futureOnly": "Exact runnable public-output comparison is deferred until an authorized boundary exists."
    }
