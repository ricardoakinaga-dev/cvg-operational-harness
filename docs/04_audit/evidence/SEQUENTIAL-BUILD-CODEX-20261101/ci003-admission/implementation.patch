+/**
+ * Admit reporting options for the fixed scheduled-coverage runner.
+ * Scheduling, scope and process environment remain owned by that runner.
+ * Output paths are forwarded literally; their destination is also runner-owned.
+ */
+export function parseScheduledCoverageOptions(argv, env) {
+  if (!Array.isArray(argv)) {
+    throw new TypeError('Coverage arguments must be an array of strings')
+  }
+  if (env === null || typeof env !== 'object' || Array.isArray(env)) {
+    throw new TypeError('Coverage environment must be an object')
+  }
+  if (Reflect.has(env, 'VITEST_MAX_WORKERS')) {
+    throw new Error('VITEST_MAX_WORKERS is not allowed for scheduled coverage')
+  }
+  for (const argument of argv) {
+    if (typeof argument !== 'string') {
+      throw new TypeError('Coverage arguments must be an array of strings')
+    }
+  }
+
+  const admitted = []
+  let hasJsonReporter = false
+  let hasOutputFile = false
+  for (let index = 0; index < argv.length; index += 1) {
+    const argument = argv[index]
+    let option
+    let value
+    if (argument === '--reporter' || argument === '--outputFile') {
+      option = argument
+      index += 1
+      if (index >= argv.length) {
+        throw new Error('Coverage reporting option requires a value')
+      }
+      value = argv[index]
+    } else if (argument.startsWith('--reporter=')) {
+      option = '--reporter'
+      value = argument.slice('--reporter='.length)
+    } else if (argument.startsWith('--outputFile=')) {
+      option = '--outputFile'
+      value = argument.slice('--outputFile='.length)
+    } else {
+      throw new Error('Unsupported scheduled coverage argument')
+    }
+
+    if (option === '--reporter') {
+      if (value !== 'default' && value !== 'json') {
+        throw new Error('Unsupported coverage reporter')
+      }
+      hasJsonReporter ||= value === 'json'
+    } else {
+      if (hasOutputFile) {
+        throw new Error('Coverage outputFile may only be specified once')
+      }
+      if (
+        value.trim().length === 0 ||
+        value.trimStart().startsWith('-') ||
+        /[\u0000-\u001f\u007f-\u009f]/u.test(value)
+      ) {
+        throw new Error('Invalid coverage output filename')
+      }
+      hasOutputFile = true
+    }
+    admitted.push(`${option}=${value}`)
+  }
+  if (hasOutputFile && !hasJsonReporter) {
+    throw new Error('Coverage outputFile requires the json reporter')
+  }
+  return admitted
+}
diff --git a/tests/coverage-profile-options.test.js b/tests/coverage-profile-options.test.js
